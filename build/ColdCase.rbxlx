      <Item class="ModuleScript" referent="69">
        <Properties>
          <string name="Name">BuildAssets</string>
          <string name="Source"><![CDATA[--[[
  COLD CASE · generated models, rebuilt from their uploaded mesh ids.
  Studio keeps ServerStorage.Cosmetics, ServerStorage.Props and
  ReplicatedStorage.PetModels in the place file. A place built by Rojo has
  none of them, so on server start any missing folder is rebuilt from
  AssetManifest with AssetService:CreateMeshPartAsync. Runs before BuildMaps,
  which dresses the maps from ServerStorage.Props.
]]
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Manifest = require(script.Parent.AssetManifest)
local Catalog = require(ReplicatedStorage.Shared.Catalog)

local TIMEOUT = 30 -- seconds; a mesh that never loads falls back like a missing one

local function vector(t: { number }): Vector3
    return Vector3.new(t[1], t[2], t[3])
end

local function meshPart(spec): MeshPart?
    local ok, part = pcall(AssetService.CreateMeshPartAsync, AssetService, spec.mesh)
    if not ok then
        warn("[ColdCase] mesh " .. spec.mesh .. ": " .. tostring(part))
        return nil
    end
    part.TextureID = spec.texture
    part.Size = vector(spec.size)
    part.Anchored = true
    return part
end

local function model(name: string, parts, solid: boolean): Model
    local m = Instance.new("Model")
    m.Name = name
    for _, spec in parts do
        local part = meshPart(spec)
        if part then
            part.CFrame = CFrame.new(vector(spec.offset))
                * CFrame.fromEulerAnglesXYZ(spec.rot[1], spec.rot[2], spec.rot[3])
            part.CanCollide = solid
            part.CanQuery = solid
            part.CanTouch = false
            part.CastShadow = solid
            if spec.light then
                local light = Instance.new("PointLight")
                light.Color = Color3.fromHex(spec.light.colour)
                light.Range = spec.light.range
                light.Brightness = spec.light.brightness
                light.Parent = part
            end
            part.Parent = m
        end
    end
    m.WorldPivot = CFrame.identity
    return m
end

-- Runs every job at once and waits for all of them, or TIMEOUT
local function runAll(jobs: { () -> () })
    local pending = #jobs
    if pending == 0 then
        return
    end
    local done = Instance.new("BindableEvent")
    for _, job in jobs do
        task.spawn(function()
            local ok, err = pcall(job)
            if not ok then
                warn("[ColdCase] asset build: " .. tostring(err))
            end
            pending -= 1
            if pending == 0 then
                done:Fire()
            end
        end)
    end
    if pending > 0 then
        task.delay(TIMEOUT, function()
            done:Fire()
        end)
        done.Event:Wait()
    end
    done:Destroy()
end

-- The Television mesh is a flat-screen; on its own it sits on the floor. Give it
-- a wooden console to stand on, then recentre the model's pivot to the combined
-- bounding box so every placement (lobby and maps) still rests it on the floor.
local function standForTV(m: Model)
    local tv = m:FindFirstChildWhichIsA("BasePart")
    if not tv then
        return
    end
    local sz = tv.Size
    local standH = 3.4
    local cx, cz = tv.Position.X, tv.Position.Z
    tv.Position = Vector3.new(cx, standH + sz.Y / 2, cz)
    local stand = Instance.new("Part")
    stand.Name = "TVStand"
    stand.Anchored = true
    stand.Size = Vector3.new(sz.X + 0.9, standH, math.max(sz.Z + 1.2, 2.6))
    stand.Position = Vector3.new(cx, standH / 2, cz)
    stand.Color = Color3.fromHex("5a3f2a")
    stand.Material = Enum.Material.Wood
    stand.CanCollide = true
    stand.CanQuery = true
    stand.CanTouch = false
    stand.TopSurface = Enum.SurfaceType.Smooth
    stand.BottomSurface = Enum.SurfaceType.Smooth
    stand.Parent = m
    m.WorldPivot = CFrame.new(cx, (standH + sz.Y) / 2, cz)
end

return function()
    local jobs = {}
    local ready: { { folder: Folder, parent: Instance } } = {}

    local function folder(name: string, parent: Instance): Folder?
        if parent:FindFirstChild(name) then
            return nil -- the place file already has them
        end
        local f = Instance.new("Folder")
        f.Name = name
        table.insert(ready, { folder = f, parent = parent })
        return f
    end

    local cosmetics = folder("Cosmetics", ServerStorage)
    if cosmetics then
        for id, spec in Manifest.weapons do
            table.insert(jobs, function()
                local handle = meshPart(spec)
                if not handle then
                    return
                end
                handle.Name = "Handle"
                handle.Anchored = false
                handle.CanCollide = false
                handle.CanQuery = false
                handle.CanTouch = false
                handle.Massless = true
                -- A weapon reads as forged, not moulded: Metal gives the mesh
                -- an environmental sheen under Future lighting instead of the
                -- flat MeshPart default. The baked texture still carries colour.
                handle.Material = Enum.Material.Metal
                local tool = Instance.new("Tool")
                tool.Name = id
                tool.CanBeDropped = false
                tool.RequiresHandle = true
                handle.Parent = tool
                tool.Parent = cosmetics
            end)
        end
    end

    local props = folder("Props", ServerStorage)
    if props then
        for name, parts in Manifest.props do
            table.insert(jobs, function()
                local m = model(name, parts, true)
                if name == "Television" then
                    standForTV(m)
                end
                m.Parent = props
            end)
        end
    end

    local pets = folder("PetModels", ReplicatedStorage)
    if pets then
        for name, parts in Manifest.pets do
            table.insert(jobs, function()
                model(name, parts, false).Parent = pets
            end)
        end
    end

    runAll(jobs)
    -- Parented only once complete, so nothing reads a half-built folder
    for _, entry in ready do
        entry.folder.Parent = entry.parent
    end

    -- Visual-only preview models the client shows in the crate reel, the shop
    -- shelf and the inventory, so a player sees the actual weapon they will
    -- win, not a coloured diamond. A weapon Tool lives in server-only
    -- ServerStorage.Cosmetics; its Handle mesh, cloned here into
    -- ReplicatedStorage, is safe to replicate because it is scenery, not a
    -- usable weapon. Pets already replicate as PetModels.
    if not ReplicatedStorage:FindFirstChild("PreviewModels") then
        local previews = Instance.new("Folder")
        previews.Name = "PreviewModels"
        local cosmeticsFolder = ServerStorage:FindFirstChild("Cosmetics")
        local petModels = ReplicatedStorage:FindFirstChild("PetModels")
        for id, def in Catalog do
            if previews:FindFirstChild(id) then
                continue
            end
            local source: Instance? = nil
            if def.kind == "Knife" or def.kind == "Pistol" then
                local slot = if def.kind == "Knife" then "knife" else "gun"
                local tool = cosmetics
                    and (cosmeticsFolder:FindFirstChild(id) or cosmeticsFolder:FindFirstChild(slot))
                source = tool and tool:FindFirstChild("Handle")
            elseif def.kind == "Pet" then
                source = petModels and petModels:FindFirstChild(id)
            end
            if not source then
                continue
            end
            local preview = Instance.new("Model")
            preview.Name = id
            local body = source:Clone()
            if body:IsA("BasePart") then
                body.Name = "Body"
                body.Anchored = true
                body.CanCollide = false
                body.CanQuery = false
                body.CanTouch = false
                body.CFrame = CFrame.identity
                body.Parent = preview
                preview.PrimaryPart = body
            else
                body.Parent = preview
                for _, d in body:GetDescendants() do
                    if d:IsA("BasePart") then
                        d.Anchored = true
                    end
                end
            end
            preview.Parent = previews
        end
        previews.Parent = ReplicatedStorage
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="70">
        <Properties>
          <string name="Name">BuildLighting</string>
          <string name="Source"><![CDATA[--!strict
--[[
  COLD CASE · lighting. Bright daylight, a warm grade, a little glow on neon.
  Bootstrap runs this on server start, before EventService captures the base
  light levels it restores after Lights Out.

  Never adds an Atmosphere: VisionController draws the vision radius with
  legacy fog, and an Atmosphere disables it. Lighting.Technology cannot be set
  from a script; the place is saved with Future.
]]
local Lighting = game:GetService("Lighting")

local function ensure(className: string, name: string): Instance
    local inst = Lighting:FindFirstChildOfClass(className :: any)
    if not inst then
        inst = Instance.new(className :: any)
        inst.Name = name
        inst.Parent = Lighting
    end
    return inst
end

return function()
    for _, child in Lighting:GetChildren() do
        if child:IsA("Atmosphere") then
            child:Destroy()
        end
    end

    -- Bright and readable, the way the big social-deduction games look: the
    -- drama comes from who is holding the knife, not from squinting.
    -- Lights Out (EventService) drops brightness and ambient from here.
    Lighting.ClockTime = 15
    Lighting.Brightness = 2.1
    Lighting.Ambient = Color3.fromRGB(96, 100, 110)
    Lighting.OutdoorAmbient = Color3.fromRGB(128, 134, 148)
    Lighting.EnvironmentDiffuseScale = 0.35
    Lighting.EnvironmentSpecularScale = 0.8
    Lighting.GlobalShadows = true
    Lighting.ExposureCompensation = -0.1

    local sky = ensure("Sky", "DaySky") :: Sky
    sky.StarCount = 0
    sky.SunAngularSize = 14

    local grade = ensure("ColorCorrectionEffect", "Grade") :: ColorCorrectionEffect
    grade.Saturation = 0.18
    grade.Contrast = 0.1
    grade.TintColor = Color3.fromRGB(255, 252, 245)

    local bloom = ensure("BloomEffect", "Glow") :: BloomEffect
    bloom.Intensity = 0.3
    bloom.Size = 24
    bloom.Threshold = 1.8
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="71">
        <Properties>
          <string name="Name">BuildLobby</string>
          <string name="Source"><![CDATA[--[[
  COLD CASE · lobby dressing. A precinct room around the lobby spawn: brick
  walls, warm lamps, the case board, and furniture from ServerStorage.Props
  when it exists. Bootstrap runs this on server start; it rebuilds cleanly.
  The floor and spawn themselves come from default.project.json.
]]
local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")
local Lobby = require(game.ReplicatedStorage.Shared.Lobby)
local Theme = require(game.ReplicatedStorage.Shared.Theme)

local HEIGHT = 18
local BRICK = Color3.fromHex("cf9a6a")
local LAMP = Color3.fromHex("ffe3b0")

-- { template, x, z, facing } relative to the floor centre; the front of the
-- prop looks along `facing`
local PROPS = {
    -- -Z wall: library and game-room wall. Spaced by real footprints so nothing
    -- clips (the clock and television once sat 2 studs apart and overlapped).
    { "Bookshelf", -46, -57.5, Vector3.zAxis },
    { "GrandfatherClock", -36, -58.5, Vector3.zAxis },
    { "Television", -22, -57.5, Vector3.zAxis },
    { "VendingMachine", 14, -57.5, Vector3.zAxis },
    { "Arcade", 24, -57.5, Vector3.zAxis },
    { "Bookshelf", 40, -57.5, Vector3.zAxis },
    -- Media corner: the red couch sits out in the room facing the television,
    -- instead of alone against a blank wall.
    { "SofaRed", -22, -40, -Vector3.zAxis },
    -- +Z fireplace lounge: the sofa faces the room with the fire as its
    -- backdrop, and an armchair at each end is turned in toward the group -
    -- a conversation set on the rug, not furniture pushed to the walls.
    { "Fireplace", 0, 58, -Vector3.zAxis },
    { "Sofa", 0, 44, -Vector3.zAxis },
    { "Armchair", -11, 40, Vector3.new(0.878, 0, -0.479) },
    { "Armchair", 11, 40, Vector3.new(-0.878, 0, -0.479) },
    -- +X study corner
    { "FilingCabinet", 57.5, -30, -Vector3.xAxis },
    { "FilingCabinet", 57.5, -26.5, -Vector3.xAxis },
    { "WritingDesk", 46, 18, -Vector3.xAxis },
    { "Globe", 50, 32, -Vector3.xAxis },
    { "Bookshelf", 57.5, -50, -Vector3.xAxis },
    -- -X wall
    { "CrateStack", -57.5, 0, -Vector3.xAxis },
    -- corner plants
    { "Plant", -52, -52, Vector3.xAxis },
    { "Plant", 52, -52, -Vector3.xAxis },
    { "Plant", -52, 52, Vector3.xAxis },
}

local function block(
    name: string,
    parent: Instance,
    size: Vector3,
    position: Vector3,
    colour: Color3,
    material: Enum.Material
): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Anchored = true
    p.Size = size
    p.Position = position
    p.Color = colour
    p.Material = material
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

local function caseBoard(parent: Instance, position: Vector3)
    local board = block(
        "CaseBoard",
        parent,
        Vector3.new(24, 10, 0.4),
        position,
        Color3.fromHex("2b2118"),
        Enum.Material.Wood
    )
    local gui = Instance.new("SurfaceGui")
    gui.Face = Enum.NormalId.Back -- +Z, into the room
    gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
    gui.PixelsPerStud = 40
    gui.LightInfluence = 1
    gui.Parent = board

    local title = Instance.new("TextLabel")
    title.BackgroundTransparency = 1
    title.Size = UDim2.fromScale(1, 0.55)
    title.Position = UDim2.fromScale(0, 0.1)
    title.Text = "COLD CASE"
    title.FontFace = Theme.DISPLAY
    title.TextScaled = true
    title.TextColor3 = Theme.INK
    title.Parent = gui

    local line = Instance.new("TextLabel")
    line.BackgroundTransparency = 1
    line.Size = UDim2.fromScale(0.9, 0.18)
    line.Position = UDim2.fromScale(0.05, 0.68)
    line.Text = "One of you has a knife. Nobody knows who."
    line.FontFace = Theme.MONO
    line.TextScaled = true
    line.TextColor3 = Theme.DANGER
    line.Parent = gui
end

-- A trade table: a wooden top on a pedestal with a chair on each side facing
-- across, and a floating sign. Tagged "TradeTable" so TradeTableService opens a
-- trade when both chairs hold a player (the seating is the mutual consent).
local function tradeTable(parent: Instance, centre: Vector3)
    local model = Instance.new("Model")
    model.Name = "TradeTable"
    local topPart = block(
        "Top",
        model,
        Vector3.new(5, 0.3, 3),
        centre + Vector3.new(0, 2, 0),
        Color3.fromHex("6b4f34"),
        Enum.Material.Wood
    )
    block(
        "Leg",
        model,
        Vector3.new(0.9, 2, 0.9),
        centre + Vector3.new(0, 1, 0),
        Color3.fromHex("4a3826"),
        Enum.Material.Wood
    )
    for _, side in { 2.4, -2.4 } do
        local seat = Instance.new("Seat")
        seat.Name = "Chair"
        seat.Anchored = true
        seat.Size = Vector3.new(2, 0.5, 2)
        seat.TopSurface = Enum.SurfaceType.Smooth
        local pos = centre + Vector3.new(0, 1, side)
        seat.CFrame = CFrame.lookAt(pos, Vector3.new(centre.X, pos.Y, centre.Z))
        seat.Color = Color3.fromHex("8a5a3a")
        seat.Material = Enum.Material.Wood
        seat.Parent = model
    end
    local sign = Instance.new("BillboardGui")
    sign.Name = "Sign"
    sign.Size = UDim2.fromOffset(170, 30)
    sign.StudsOffset = Vector3.new(0, 2.4, 0)
    sign.AlwaysOnTop = true
    sign.MaxDistance = 60
    sign.LightInfluence = 0
    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.FontFace = Theme.DISPLAY
    label.TextSize = 16
    label.Name = "Label"
    label.Text = "TRADE · SIT TO DEAL"
    label.TextColor3 = Color3.fromHex("f2a63b")
    label.TextStrokeTransparency = 0.5
    label.Parent = sign
    sign.Adornee = topPart
    sign.Parent = topPart
    -- A visible prompt so the table reads as interactive, not decoration.
    -- TradeTableService seats you here (or says when trading unlocks).
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "TradePrompt"
    prompt.ActionText = "Sit & Trade"
    prompt.ObjectText = "Trade Table"
    prompt.KeyboardKeyCode = Enum.KeyCode.E
    prompt.RequiresLineOfSight = false
    prompt.MaxActivationDistance = 10
    prompt.Parent = topPart
    model.PrimaryPart = topPart
    model.Parent = parent
    CollectionService:AddTag(model, "TradeTable")
end

-- A showcase pedestal: a base, a column and a small top platform, with a prompt
-- to feature your equipped knife on it. Tagged "Pedestal"; PedestalService fills
-- the Owner/OwnerName/Item attributes, and clients render the knife from those.
local function pedestal(parent: Instance, centre: Vector3)
    local model = Instance.new("Model")
    model.Name = "Pedestal"
    block(
        "Base",
        model,
        Vector3.new(2.2, 0.4, 2.2),
        centre + Vector3.new(0, 0.2, 0),
        Color3.fromHex("3a3430"),
        Enum.Material.Slate
    )
    local column = block(
        "Column",
        model,
        Vector3.new(1, 2.4, 1),
        centre + Vector3.new(0, 1.6, 0),
        Color3.fromHex("4a423c"),
        Enum.Material.Slate
    )
    local platform = block(
        "Platform",
        model,
        Vector3.new(1.7, 0.3, 1.7),
        centre + Vector3.new(0, 2.95, 0),
        Color3.fromHex("6b4f34"),
        Enum.Material.Wood
    )
    local prompt = Instance.new("ProximityPrompt")
    prompt.ActionText = "Display Knife"
    prompt.ObjectText = "Pedestal"
    prompt.HoldDuration = 0.3
    prompt.MaxActivationDistance = 8
    prompt.RequiresLineOfSight = false
    prompt.Parent = column
    model.PrimaryPart = platform
    model.Parent = parent
    CollectionService:AddTag(model, "Pedestal")
end

return function()
    local lobby = workspace:FindFirstChild("Lobby")
    local floor = lobby and lobby:FindFirstChild("LobbyFloor")
    if not (floor and floor:IsA("BasePart")) then
        return
    end
    local old = (lobby :: Instance):FindFirstChild("Dressing")
    if old then
        old:Destroy()
    end
    -- The lobby stands where Lobby.FLOOR says, whatever a saved place has.
    -- Anywhere else and a round can load a map around it.
    local home = Vector3.new(Lobby.FLOOR.x, Lobby.FLOOR.y, Lobby.FLOOR.z)
    if (floor.Position - home).Magnitude > 0.5 then
        warn(
            ("[ColdCase] Lobby floor was at %s; moved to %s, clear of the maps"):format(
                tostring(floor.Position),
                tostring(home)
            )
        )
        local model = lobby :: Model
        model:PivotTo(model:GetPivot() + (home - floor.Position))
    end
    local dressing = Instance.new("Folder")
    dressing.Name = "Dressing"

    floor.Material = Enum.Material.WoodPlanks
    floor.Color = Color3.fromHex("a9855c")
    local top = floor.Position + Vector3.new(0, floor.Size.Y / 2, 0)
    local half = floor.Size.X / 2

    local wallY = top.Y + HEIGHT / 2
    for i, spec in
        {
            { Vector3.new(floor.Size.X + 4, HEIGHT, 2), Vector3.new(0, 0, -half - 1) },
            { Vector3.new(floor.Size.X + 4, HEIGHT, 2), Vector3.new(0, 0, half + 1) },
            { Vector3.new(2, HEIGHT, floor.Size.Z), Vector3.new(-half - 1, 0, 0) },
            { Vector3.new(2, HEIGHT, floor.Size.Z), Vector3.new(half + 1, 0, 0) },
        }
    do
        local offset = spec[2]
        block(
            ("Wall_%d"):format(i),
            dressing,
            spec[1],
            Vector3.new(top.X + offset.X, wallY, top.Z + offset.Z),
            BRICK,
            Enum.Material.Brick
        )
    end

    for _, corner in { { -25, -25 }, { 25, -25 }, { -25, 25 }, { 25, 25 } } do
        local lamp = block(
            "Lamp",
            dressing,
            Vector3.new(1.4, 0.7, 1.4),
            Vector3.new(top.X + corner[1], top.Y + HEIGHT - 3, top.Z + corner[2]),
            LAMP,
            Enum.Material.Neon
        )
        lamp.CanCollide = false
        lamp.CanQuery = false
        lamp.CastShadow = false
        local light = Instance.new("PointLight")
        light.Color = LAMP
        light.Range = 48
        light.Brightness = 2
        light.Shadows = true
        light.Parent = lamp
    end

    caseBoard(dressing, Vector3.new(top.X, top.Y + 9, top.Z - half + 0.3))

    -- A floor of laid panels rather than one flat sheet, and a ceiling to
    -- close the room in
    local PANEL = 20
    for x = -half + PANEL / 2, half - PANEL / 2, PANEL do
        for z = -half + PANEL / 2, half - PANEL / 2, PANEL do
            local seamA = block(
                "FloorSeam",
                dressing,
                Vector3.new(PANEL, 0.08, 0.6),
                Vector3.new(top.X + x, top.Y + 0.04, top.Z + z + PANEL / 2),
                Color3.fromHex("6b5740"),
                Enum.Material.WoodPlanks
            )
            local seamB = block(
                "FloorSeam",
                dressing,
                Vector3.new(0.6, 0.08, PANEL),
                Vector3.new(top.X + x + PANEL / 2, top.Y + 0.04, top.Z + z),
                Color3.fromHex("6b5740"),
                Enum.Material.WoodPlanks
            )
            local inlay = block(
                "FloorInlay",
                dressing,
                Vector3.new(PANEL - 6, 0.06, PANEL - 6),
                Vector3.new(top.X + x, top.Y + 0.03, top.Z + z),
                Color3.fromHex("9d8259"),
                Enum.Material.WoodPlanks
            )
            for _, piece in { seamA, seamB, inlay } do
                piece.CanCollide = false
                piece.CanQuery = false
                piece.CastShadow = false
            end
        end
    end
    local ceiling = block(
        "Ceiling",
        dressing,
        Vector3.new(floor.Size.X + 4, 0.6, floor.Size.Z + 4),
        Vector3.new(top.X, top.Y + HEIGHT, top.Z),
        Color3.fromHex("f2efe6"),
        Enum.Material.SmoothPlastic
    )
    ceiling.CanQuery = false

    -- A rug in front of the fireplace
    for _, layer in
        {
            { Vector3.new(26, 0.1, 16), 0.05, Color3.fromHex("8a2a2a") },
            { Vector3.new(24.8, 0.14, 14.8), 0.07, Color3.fromHex("b03a3a") },
        }
    do
        local rug = block(
            "Rug",
            dressing,
            layer[1],
            Vector3.new(top.X, top.Y + layer[2], top.Z + 46),
            layer[3],
            Enum.Material.Fabric
        )
        rug.CanCollide = false
        rug.CanQuery = false
    end

    local templates = ServerStorage:FindFirstChild("Props")
    for _, spec in PROPS do
        local template = templates and templates:FindFirstChild(spec[1])
        if template and template:IsA("Model") then
            local prop = template:Clone()
            for _, d in prop:GetDescendants() do
                if d:IsA("LuaSourceContainer") then
                    d:Destroy()
                elseif d:IsA("BasePart") then
                    d.Anchored = true
                end
            end
            local size = prop:GetExtentsSize()
            local at = Vector3.new(top.X + spec[2], top.Y + size.Y / 2, top.Z + spec[3])
            prop:PivotTo(CFrame.lookAt(at, at + spec[4]))
            prop.Parent = dressing
        end
    end

    -- Two trade tables in the open floor either side of spawn.
    tradeTable(dressing, top + Vector3.new(-17, 0, 16))
    tradeTable(dressing, top + Vector3.new(17, 0, 16))

    -- A row of showcase pedestals along the -X wall.
    for _, z in { -16, 0, 16 } do
        pedestal(dressing, top + Vector3.new(-54, 0, z))
    end

    dressing.Parent = lobby
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="72">
        <Properties>
          <string name="Name">BuildMaps</string>
          <string name="Source"><![CDATA[--[[
  COLD CASE · map builder
  Bootstrap runs this when ServerStorage.Maps is missing, so a fresh
  `rojo build` is playable. From the command bar:
    require(game.ServerStorage.Build.BuildMaps)({ force = true })
  Builds every building in Shared/MapPlan as a Model in ServerStorage.Maps:
  floors and roofs, walls with doorways, railings round stairwells and
  balconies, staircases with steps and banisters, moonlit windows, lamps tagged
  MapLight (Lights Out turns them off), LockdownDoors, SpawnPoints and
  CoinNodes, then furniture from ServerStorage.Props when it exists.
]]
local ServerStorage = game:GetService("ServerStorage")
local MapPlan = require(game.ReplicatedStorage.Shared.MapPlan)
local Shuffle = require(game.ReplicatedStorage.Shared.Shuffle)

local CELL, H = MapPlan.CELL, MapPlan.FLOOR_HEIGHT
local WALL = 1.4 -- interior wall thickness
local SHELL = 2 -- exterior wall thickness
local SLAB = 1
local DOOR_W, DOOR_H = 9, 10
local RAIL_H = 3.6 -- waist high: blocks a stumble, not a jump
local RESERVED_CLEAR = 4.5 -- studs kept free round the centre of a spawn or coin cell (the pad is 8 wide)
local STAIR_W = CELL - 4
local M = Enum.Material

-- Real materials read far better than flat plastic. Pick a floor material from
-- its colour: warm browns become wood planks, low-saturation greys become
-- concrete, and light stone/tile keeps the style's (polished) material.
local function floorMaterialFor(hex: string, fallback: Enum.Material): Enum.Material
    local h, sat, v = Color3.fromHex(hex):ToHSV()
    local deg = h * 360
    if deg >= 18 and deg <= 46 and sat > 0.14 and v < 0.74 then
        return M.WoodPlanks
    end
    if sat < 0.12 and v < 0.63 then
        return M.Concrete
    end
    return fallback
end
local SIDES = { "N", "E", "S", "W" }

-- Per map: shell and wall finishes, then a style per region kind. A style's
-- `props` stand against walls (one per cell at most, `density` of the time),
-- `centre` stands in the room's most open cell, `chairs` seats a table, `rug`
-- lies under the centrepiece, and `againstRail` lets props line railings.
