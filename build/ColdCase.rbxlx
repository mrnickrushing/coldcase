  <Item class="ReplicatedFirst" referent="2">
    <Properties>
      <string name="Name">ReplicatedFirst</string>
    </Properties>
    <Item class="LocalScript" referent="3">
      <Properties>
        <string name="Name">Splash</string>
        <string name="Source"><![CDATA[--!strict
-- ReplicatedFirst/Splash (LocalScript)
-- The first thing a player sees. This runs before ReplicatedStorage has
-- replicated, so it carries its own palette (a copy of Shared/Theme's) and
-- builds its own gui, then holds the screen until the game is really ready:
-- the world loaded, Shared and Remotes here, the fonts and sound cues cached,
-- the profile in and the HUD built. The bar shows that work, not a timer.
local ContentProvider = game:GetService("ContentProvider")
local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

ReplicatedFirst:RemoveDefaultLoadingScreen()

local GROUND = Color3.fromHex("0b0d10")
local PANEL = Color3.fromHex("12151a")
local SUNK = Color3.fromHex("0f1318")
local STROKE = Color3.fromHex("262d36")
local INK = Color3.fromHex("e8e6e1")
local SOFT = Color3.fromHex("a9afb7")
local MUTED = Color3.fromHex("8b9199")
local DIM = Color3.fromHex("7d858f")
local AMBER = Color3.fromHex("f2a63b")
local DISPLAY = Font.new("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold)
local MONO = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Medium)

local MIN_SHOWN = 1.8 -- seconds; a splash that flashes past reads as a glitch
local PATIENCE = 12 -- seconds to wait on any one step before moving on without it

local plr = Players.LocalPlayer
local playerGui = plr:WaitForChild("PlayerGui")

---------------------------------------------------------------- Build
local gui = Instance.new("ScreenGui")
gui.Name = "Splash"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- One canvas so the whole screen fades as a piece at the end
local canvas = Instance.new("CanvasGroup")
canvas.Name = "Canvas"
canvas.Size = UDim2.fromScale(1, 1)
canvas.BackgroundColor3 = GROUND
canvas.BorderSizePixel = 0
canvas.Active = true -- swallow taps: nothing under here is ready to be tapped
canvas.Parent = gui

-- Depth: the dark lifts slightly toward the top, like a lit room seen from a hall
local wash = Instance.new("Frame")
wash.Name = "Wash"
wash.Size = UDim2.fromScale(1, 1)
wash.BackgroundColor3 = PANEL
wash.BorderSizePixel = 0
wash.Parent = canvas
local washGradient = Instance.new("UIGradient")
washGradient.Rotation = 90
washGradient.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.35),
    NumberSequenceKeypoint.new(0.55, 1),
    NumberSequenceKeypoint.new(1, 1),
})
washGradient.Parent = wash

local function label(
    name: string,
    text: string,
    size: number,
    colour: Color3,
    font: Font
): TextLabel
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = text
    l.FontFace = font
    l.TextSize = size
    l.TextColor3 = colour
    l.BackgroundTransparency = 1
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.TextXAlignment = Enum.TextXAlignment.Center
    l.Parent = canvas
    return l
end

-- Everything sits on the centre line, in a column the eye reads top to bottom:
-- the file's caption, the name, an amber mark, the line that sets the tone,
-- then what is being done and the bar that shows it.
local caption = label("Caption", "CASE FILE", 14, MUTED, MONO)
caption.Position = UDim2.fromScale(0.5, 0.355)
caption.Size = UDim2.fromOffset(400, 20)

local title = label("Title", "COLD CASE", 112, INK, DISPLAY)
title.Position = UDim2.fromScale(0.5, 0.445)
title.Size = UDim2.fromOffset(900, 120)
title.TextScaled = true
local titleFit = Instance.new("UITextSizeConstraint")
titleFit.MaxTextSize = 112
titleFit.MinTextSize = 48
titleFit.Parent = title
-- A slow amber sheen crosses the name while the screen holds. A gradient on
-- the text, its offset tweened; the eye reads it as light moving over the sign.
local sheen = Instance.new("UIGradient")
sheen.Color = ColorSequence.new({
    ColorSequenceKeypoint.new(0, INK),
    ColorSequenceKeypoint.new(0.42, INK),
    ColorSequenceKeypoint.new(0.5, AMBER),
    ColorSequenceKeypoint.new(0.58, INK),
    ColorSequenceKeypoint.new(1, INK),
})
sheen.Offset = Vector2.new(-1, 0)
sheen.Parent = title

local mark = Instance.new("Frame")
mark.Name = "Mark"
mark.AnchorPoint = Vector2.new(0.5, 0.5)
mark.Position = UDim2.fromScale(0.5, 0.535)
mark.Size = UDim2.fromOffset(56, 3)
mark.BackgroundColor3 = AMBER
mark.BorderSizePixel = 0
mark.Parent = canvas

local tagline = label("Tagline", "Someone in this house is lying.", 19, SOFT, MONO)
tagline.Position = UDim2.fromScale(0.5, 0.585)
tagline.Size = UDim2.fromOffset(700, 26)

local status = label("Status", "OPENING THE CASE FILE", 13, MUTED, MONO)
status.Position = UDim2.fromScale(0.5, 0.685)
status.Size = UDim2.fromOffset(600, 20)

local track = Instance.new("Frame")
track.Name = "Track"
track.AnchorPoint = Vector2.new(0.5, 0.5)
track.Position = UDim2.fromScale(0.5, 0.725)
track.Size = UDim2.fromOffset(440, 4)
track.BackgroundColor3 = SUNK
track.BorderSizePixel = 0
track.Parent = canvas
local trackStroke = Instance.new("UIStroke")
trackStroke.Color = STROKE
trackStroke.Thickness = 1
trackStroke.Parent = track
local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = AMBER
fill.BorderSizePixel = 0
fill.Parent = track

local version = label("Version", ("v%d"):format(game.PlaceVersion), 12, DIM, MONO)
version.AnchorPoint = Vector2.new(1, 1)
version.Position = UDim2.new(1, -20, 1, -16)
version.Size = UDim2.fromOffset(120, 18)
version.TextXAlignment = Enum.TextXAlignment.Right

-- On a phone the column is the same, only the type a little smaller
local function fit()
    local cam = workspace.CurrentCamera
    local narrow = cam ~= nil and cam.ViewportSize.X < 600
    titleFit.MaxTextSize = if narrow then 72 else 112
    tagline.TextSize = if narrow then 15 else 19
    track.Size = UDim2.fromOffset(if narrow then 260 else 440, 4)
end
fit()
local camera = workspace.CurrentCamera
if camera then
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
end

gui.Parent = playerGui
local shownAt = os.clock()

---------------------------------------------------------------- Motion
local sweeping = true
task.spawn(function()
    while sweeping do
        sheen.Offset = Vector2.new(-1, 0)
        local sweep = TweenService:Create(
            sheen,
            TweenInfo.new(2.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
            { Offset = Vector2.new(1, 0) }
        )
        sweep:Play()
        sweep.Completed:Wait()
        task.wait(1.1)
    end
end)

---------------------------------------------------------------- Progress
-- The bar only ever moves forward, and eases into each new mark
local progress = 0
local function reach(fraction: number)
    progress = math.max(progress, math.clamp(fraction, 0, 1))
    TweenService:Create(
        fill,
        TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.fromScale(progress, 1) }
    ):Play()
end

local function step(text: string)
    status.Text = string.upper(text)
end

step("Opening the case file")
if not game:IsLoaded() then
    game.Loaded:Wait()
end
reach(0.2)

step("Reading the floor plans")
local Shared = ReplicatedStorage:WaitForChild("Shared", PATIENCE)
ReplicatedStorage:WaitForChild("Remotes", PATIENCE)
reach(0.4)

step("Dusting for prints")
-- The two faces the whole game is set in, and every sound cue, so the first
-- round does not stutter loading them
local assets: { Instance } = {}
for _, font in { DISPLAY, MONO } do
    local sample = Instance.new("TextLabel")
    sample.FontFace = font
    sample.Text = "A"
    table.insert(assets, sample)
end
if Shared then
    -- SoundCues returns { cues = ..., ROLE_PITCH = ... }; the cues are what to cache
    local ok, module = pcall(require, Shared:WaitForChild("SoundCues", PATIENCE))
    local cues = if ok and type(module) == "table" then (module :: any).cues else nil
    if type(cues) == "table" then
        for _, cue in cues :: { [string]: any } do
            if type(cue) == "table" and type(cue.soundId) == "string" and cue.soundId ~= "" then
                local sound = Instance.new("Sound")
                sound.SoundId = cue.soundId
                table.insert(assets, sound)
            end
        end
    end
end
local total, loaded = #assets, 0
ContentProvider:PreloadAsync(assets, function()
    loaded += 1
    reach(0.4 + 0.4 * loaded / math.max(total, 1))
end)
reach(0.8)

step("Calling the witnesses")
-- The profile is in once Rank is set; the HUD is up once HudController built it
local deadline = os.clock() + PATIENCE
while plr:GetAttribute("Rank") == nil and os.clock() < deadline do
    task.wait(0.1)
end
playerGui:WaitForChild("RoundHud", PATIENCE)
reach(1)
step("The case is open")

---------------------------------------------------------------- Exit
local remaining = MIN_SHOWN - (os.clock() - shownAt)
if remaining > 0 then
    task.wait(remaining)
end
task.wait(0.3) -- let the bar arrive
sweeping = false
local out = TweenService:Create(
    canvas,
    TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    { GroupTransparency = 1 }
)
out:Play()
out.Completed:Wait()
gui:Destroy()
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ReplicatedStorage" referent="4">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="5">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="Folder" referent="6">
        <Properties>
          <string name="Name">Build</string>
        </Properties>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">BuildHud</string>
            <string name="Source"><![CDATA[--!strict
--[[
  COLD CASE · RoundHud builder (Production Handbook §01)
  HudController calls this at runtime when PlayerGui has no RoundHud, so a
  fresh build needs no manual Studio step. To bake it into StarterGui instead:
    require(game.ReplicatedStorage.Shared.Build.BuildHud)()

  RoundHud (ScreenGui)  IgnoreGuiInset, ResetOnSpawn = false
    Top          (Frame)  StateBox/TimerBox/AliveBox/CoinsBox, each Caption + Value
    RoleTag      (Frame)  RoleName            -- top right, border = role colour
    RoleCard     (Frame)  full-screen dim     -- Card, RoleName, Brief
    EventBanner  (Frame)  Label               -- no background
    Evidence     (Frame)  Title, Line1..Line4 -- bottom left, newest on top
    Action       (Frame)  Weapon, Prompt      -- bottom right
]]
local Theme = require(script.Parent.Parent.Theme)

local function panel(
    name: string,
    parent: Instance,
    size: UDim2,
    pos: UDim2,
    anchor: Vector2?
): Frame
    local f = Instance.new("Frame")
    f.Name = name
    f.Size = size
    f.Position = pos
    f.AnchorPoint = anchor or Vector2.zero
    f.BackgroundColor3 = Theme.GROUND
    f.BackgroundTransparency = 0.18
    f.BorderSizePixel = 0
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 5)
    c.Parent = f
    local s = Instance.new("UIStroke")
    s.Name = "Stroke"
    s.Color = Theme.STROKE
    s.Thickness = 1
    s.Parent = f
    f.Parent = parent
    return f
end

local function label(
    name: string,
    parent: Instance,
    text: string,
    size: number,
    colour: Color3?,
    font: Font?
): TextLabel
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = text
    l.FontFace = font or Theme.MONO
    l.TextSize = size
    l.TextColor3 = colour or Theme.INK
    l.BackgroundTransparency = 1
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Size = UDim2.fromScale(1, 1)
    l.Parent = parent
    return l
end

local function pad(parent: Instance, l: number, t: number, r: number?, b: number?)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, l)
    p.PaddingTop = UDim.new(0, t)
    p.PaddingRight = UDim.new(0, r or 0)
    p.PaddingBottom = UDim.new(0, b or 0)
    p.Parent = parent
end

return function(parent: Instance?): ScreenGui
    parent = parent or game:GetService("StarterGui")
    local old = (parent :: Instance):FindFirstChild("RoundHud")
    if old then
        old:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "RoundHud"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 1

    ---------------------------------------------------------------- Top
    local top = Instance.new("Frame")
    top.Name = "Top"
    top.AnchorPoint = Vector2.new(0.5, 0)
    top.Position = UDim2.new(0.5, 0, 0, 14)
    top.Size = UDim2.new(0, 420, 0, 58)
    top.BackgroundTransparency = 1
    top.Parent = gui

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 10)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = top

    local function stat(
        order: number,
        name: string,
        caption: string,
        value: string,
        colour: Color3,
        size: number
    )
        local f = panel(name .. "Box", top, UDim2.new(0.25, -8, 1, 0), UDim2.new())
        f.LayoutOrder = order
        pad(f, 10, 6, 6)
        local cap = label("Caption", f, caption, 10, Theme.DIM)
        cap.Size = UDim2.new(1, 0, 0, 12)
        local val = label("Value", f, value, size, colour, Theme.DISPLAY)
        val.Position = UDim2.new(0, 0, 0, 13)
        val.Size = UDim2.new(1, 0, 0, 36)
        val.TextScaled = true
        local limit = Instance.new("UITextSizeConstraint")
        limit.MaxTextSize = size
        limit.Parent = val
    end
    stat(1, "State", "ROUND", "LOBBY", Theme.MUTED, 22)
    stat(2, "Timer", "TIME", "—", Theme.INK, 34) -- the only element that changes colour mid-round
    stat(3, "Alive", "ALIVE", "—", Theme.INK, 26)
    stat(4, "Coins", "COINS", "0", Theme.INK, 26)

    ---------------------------------------------------------------- RoleTag
    local roleTag =
        panel("RoleTag", gui, UDim2.new(0, 190, 0, 58), UDim2.new(1, -14, 0, 14), Vector2.new(1, 0))
    pad(roleTag, 12, 6, 12)
    local rtCap = label("Caption", roleTag, "YOUR ROLE", 10, Theme.DIM)
    rtCap.Size = UDim2.new(1, 0, 0, 12)
    rtCap.TextXAlignment = Enum.TextXAlignment.Right
    local rtName = label("RoleName", roleTag, "—", 26, Theme.MUTED, Theme.DISPLAY)
    rtName.Position = UDim2.new(0, 0, 0, 13)
    rtName.Size = UDim2.new(1, 0, 0, 34)
    rtName.TextXAlignment = Enum.TextXAlignment.Right

    ---------------------------------------------------------------- RoleCard
    local dim = Instance.new("Frame")
    dim.Name = "RoleCard"
    dim.Size = UDim2.fromScale(1, 1)
    dim.BackgroundColor3 = Color3.new(0, 0, 0)
    dim.BackgroundTransparency = 0.6
    dim.BorderSizePixel = 0
    dim.Visible = false
    dim.ZIndex = 10
    dim.Parent = gui

    local card = panel(
        "Card",
        dim,
        UDim2.new(0, 520, 0, 300),
        UDim2.fromScale(0.5, 0.5),
        Vector2.new(0.5, 0.5)
    )
    card.BackgroundColor3 = Theme.CARD
    card.BackgroundTransparency = 0
    card.ZIndex = 11
    local sizeLimit = Instance.new("UISizeConstraint")
    sizeLimit.MaxSize = Vector2.new(520, 300)
    sizeLimit.Parent = card

    local youAre = label("YouAre", card, "YOU ARE", 11, Theme.DIM)
    youAre.TextXAlignment = Enum.TextXAlignment.Center
    youAre.Position = UDim2.new(0, 0, 0, 44)
    youAre.Size = UDim2.new(1, 0, 0, 16)
    youAre.ZIndex = 12

    local cardName =
        label("RoleName", dim, "INNOCENT", 76, Theme.ROLE.innocent, Theme.DISPLAY_HEAVY)
    cardName.TextXAlignment = Enum.TextXAlignment.Center
    cardName.AnchorPoint = Vector2.new(0.5, 0.5)
    cardName.Position = UDim2.fromScale(0.5, 0.46)
    cardName.Size = UDim2.new(0, 500, 0, 90)
    cardName.ZIndex = 12

    local brief = label("Brief", dim, "", 15, Theme.SOFT)
    brief.TextXAlignment = Enum.TextXAlignment.Center
    brief.AnchorPoint = Vector2.new(0.5, 0)
    brief.Position = UDim2.new(0.5, 0, 0.5, 40)
    brief.Size = UDim2.new(0, 420, 0, 60)
    brief.TextWrapped = true
    brief.ZIndex = 12

    ---------------------------------------------------------------- EventBanner
    local banner = Instance.new("Frame")
    banner.Name = "EventBanner"
    banner.AnchorPoint = Vector2.new(0.5, 0)
    banner.Position = UDim2.new(0.5, 0, 0, 100)
    banner.Size = UDim2.new(0, 600, 0, 46)
    banner.BackgroundTransparency = 1
    banner.Visible = false
    banner.Parent = gui
    local bl = label("Label", banner, "", 34, Theme.CYAN, Theme.DISPLAY)
    bl.TextXAlignment = Enum.TextXAlignment.Center
    bl.TextStrokeTransparency = 0.7

    ---------------------------------------------------------------- Evidence
    local ev = panel(
        "Evidence",
        gui,
        UDim2.new(0, 340, 0, 150),
        UDim2.new(0, 16, 1, -16),
        Vector2.new(0, 1)
    )
    pad(ev, 13, 11, 11)
    local evList = Instance.new("UIListLayout")
    evList.Padding = UDim.new(0, 5)
    evList.SortOrder = Enum.SortOrder.LayoutOrder
    evList.Parent = ev

    local evTitle = label("Title", ev, "EVIDENCE LOG", 10, Theme.DIM)
    evTitle.Size = UDim2.new(1, 0, 0, 14)
    evTitle.LayoutOrder = 0
    for i = 1, 4 do
        local line = label("Line" .. i, ev, "", 12, Theme.BODY)
        line.Size = UDim2.new(1, 0, 0, 26)
        line.TextWrapped = true
        line.TextYAlignment = Enum.TextYAlignment.Center
        line.LayoutOrder = i
        pad(line, 9, 0)
        local bar = Instance.new("Frame")
        bar.Name = "Bar"
        bar.Size = UDim2.new(0, 2, 1, 0)
        bar.Position = UDim2.new(0, -9, 0, 0)
        bar.BorderSizePixel = 0
        bar.BackgroundColor3 = Theme.CLUE.cold
        bar.Visible = false
        bar.Parent = line
    end

    ---------------------------------------------------------------- Action
    local act =
        panel("Action", gui, UDim2.new(0, 260, 0, 86), UDim2.new(1, -16, 1, -16), Vector2.new(1, 1))
    pad(act, 14, 10, 10)
    local wCap = label("WeaponCaption", act, "EQUIPPED", 9, Theme.DIM)
    wCap.Size = UDim2.new(1, 0, 0, 12)
    local weapon = label("Weapon", act, "—", 22, Theme.MUTED, Theme.DISPLAY)
    weapon.Position = UDim2.new(0, 0, 0, 14)
    weapon.Size = UDim2.new(1, 0, 0, 28)
    local prompt = label("Prompt", act, "—", 13, Theme.INK)
    prompt.Position = UDim2.new(0, 0, 0, 46)
    prompt.Size = UDim2.new(1, 0, 0, 22)

    gui.Parent = parent
    return gui
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">BuildMenus</string>
            <string name="Source"><![CDATA[--[[
  COLD CASE · menu builder (Claude Design's BuildMenus, in the Theme)
  MenuController calls this at runtime with the PlayerGui. To bake the
  screens into StarterGui instead:
    require(game.ReplicatedStorage.Shared.Build.BuildMenus)()

  Every screen is a full-screen Backdrop plus a fixed-size Root with a UIScale
  named Scale, so the controller can shrink the layout to fit a phone.
    LobbyGui      map vote, player list with TRADE, rank bar, Locker, Robux store
    LoadingGui    the scene's name and a bar across the LOADING window
    ResultsGui    reveal, roster, kill timeline, payout, near-miss
    CrateGui      Locker/Seasonal tabs, reel, published odds, direct-buy shelf
    InventoryGui  collection grid, equip, craft, effect re-roll
    TradeGui      escrowed swap with lock/confirm and fairness meter
]]
local Theme = require(script.Parent.Parent.Theme)
local Config = require(script.Parent.Parent.Config)
local Rarities = require(script.Parent.Parent.RarityTable)
local MapPlan = require(script.Parent.Parent.MapPlan)
local Modes = require(script.Parent.Parent.Modes)

local BG = Theme.GROUND
local PANEL = Theme.PANEL
local SUNK = Color3.fromHex("0f1318")
local STROKE = Color3.fromHex("1f252e")
local RAISED = Color3.fromHex("161b22")
local GREEN = Color3.fromHex("4fb0a0")
local ROOT_SIZE = Vector2.new(1040, 640)

local function screen(
    parent: Instance,
    name: string,
    order: number,
    backdrop: number
): (ScreenGui, Frame)
    local old = parent:FindFirstChild(name)
    if old then
        old:Destroy()
    end
    local g = Instance.new("ScreenGui")
    g.Name = name
    g.IgnoreGuiInset = true
    g.ResetOnSpawn = false
    g.Enabled = false
    g.DisplayOrder = order
    g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local back = Instance.new("Frame")
    back.Name = "Backdrop"
    back.Size = UDim2.fromScale(1, 1)
    back.BackgroundColor3 = BG
    back.BackgroundTransparency = backdrop
    back.BorderSizePixel = 0
    back.Active = true -- menus sink input so clicks never reach the world
    back.Parent = g

    local root = Instance.new("Frame")
    root.Name = "Root"
    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
    root.Size = UDim2.fromOffset(ROOT_SIZE.X, ROOT_SIZE.Y)
    root.BackgroundTransparency = 1
    root.Parent = g
    local scale = Instance.new("UIScale")
    scale.Name = "Scale"
    scale.Parent = root

    g.Parent = parent
    return g, root
end

local function frame(
    name: string,
    parent: Instance,
    size: UDim2,
    pos: UDim2?,
    colour: Color3?,
    transparent: boolean?
): Frame
    local f = Instance.new("Frame")
    f.Name = name
    f.Size = size
    f.Position = pos or UDim2.new()
    f.BackgroundColor3 = colour or PANEL
    f.BackgroundTransparency = transparent and 1 or 0
    f.BorderSizePixel = 0
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = f
    f.Parent = parent
    return f
end

local function stroke(f: Instance, colour: Color3?)
    local s = Instance.new("UIStroke")
    s.Name = "Stroke"
    s.Color = colour or STROKE
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
end

local function pad(f: Instance, n: number)
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, n)
    p.PaddingRight = UDim.new(0, n)
    p.PaddingTop = UDim.new(0, n)
    p.PaddingBottom = UDim.new(0, n)
    p.Parent = f
end

local function text(
    name: string,
    parent: Instance,
    str: string,
    size: number,
    colour: Color3?,
    font: Font?,
    align: Enum.TextXAlignment?
): TextLabel
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = str
    l.FontFace = font or Theme.MONO
    l.TextSize = size
    l.TextColor3 = colour or Theme.INK
    l.BackgroundTransparency = 1
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.Size = UDim2.new(1, 0, 0, size + 6)
    l.Parent = parent
    return l
end

local function button(
    name: string,
    parent: Instance,
    str: string,
    size: UDim2,
    fill: Color3?,
    fg: Color3?
): TextButton
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = str
    b.FontFace = Theme.DISPLAY
    b.TextSize = 20
    b.TextColor3 = fg or BG
    b.BackgroundColor3 = fill or Theme.AMBER
    b.Size = size
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    local limit = Instance.new("UITextSizeConstraint")
    limit.MaxTextSize = 20
    limit.Parent = b
    b.TextScaled = true
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = b
    local p = Instance.new("UIPadding")
    p.PaddingLeft = UDim.new(0, 8)
    p.PaddingRight = UDim.new(0, 8)
    p.PaddingTop = UDim.new(0, 6)
    p.PaddingBottom = UDim.new(0, 6)
    p.Parent = b
    b.Parent = parent
    return b
end

local function list(
    parent: Instance,
    dir: Enum.FillDirection?,
    gap: number?,
    align: Enum.HorizontalAlignment?
)
    local l = Instance.new("UIListLayout")
    l.FillDirection = dir or Enum.FillDirection.Vertical
    l.Padding = UDim.new(0, gap or 8)
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.HorizontalAlignment = align or Enum.HorizontalAlignment.Left
    l.Parent = parent
end

local function grid(parent: Instance, cell: UDim2, gap: number)
    local g = Instance.new("UIGridLayout")
    g.CellSize = cell
    g.CellPadding = UDim2.fromOffset(gap, gap)
    g.SortOrder = Enum.SortOrder.LayoutOrder
    g.Parent = parent
end

local function scroller(name: string, parent: Instance, size: UDim2, pos: UDim2): ScrollingFrame
    local s = Instance.new("ScrollingFrame")
    s.Name = name
    s.Size = size
    s.Position = pos
    s.BackgroundTransparency = 1
    s.BorderSizePixel = 0
    s.ScrollBarThickness = 6
    s.CanvasSize = UDim2.new()
    s.AutomaticCanvasSize = Enum.AutomaticSize.Y
    s.Parent = parent
    return s
end

local function header(parent: Instance, kicker: string, title: string)
    local h = frame("Header", parent, UDim2.new(1, 0, 0, 78), nil, nil, true)
    text("Kicker", h, kicker, 11, Theme.AMBER)
    local t = text("Title", h, title, 44, Theme.INK, Theme.DISPLAY_HEAVY)
    t.Position = UDim2.new(0, 0, 0, 20)
    t.Size = UDim2.new(1, 0, 0, 52)
    return h
end

local PLAN_CELL = 8 -- px per map cell on a vote card
local PLAN_ROOM = Color3.fromHex("4a5260")
local PLAN_HALL = Color3.fromHex("2f3640")
local PLAN_OUTDOOR = Color3.fromHex("2f5a55")
local PLAN_OPEN = Color3.fromHex("1c2129")

-- Every floor of a map side by side, lowest first, with the stairs in amber
local function drawPlan(parent: Frame, plan)
    local gw, gd, floors = MapPlan.Size(plan)
    local ramp = MapPlan.Analyse(plan).ramp
    local holder = frame("Plan", parent, UDim2.fromScale(1, 1), nil, nil, true)
    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.VerticalAlignment = Enum.VerticalAlignment.Center
    layout.Padding = UDim.new(0, 8)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = holder
    for f = 1, floors do
        local level = frame(
            "Floor" .. f,
            holder,
            UDim2.fromOffset(gw * PLAN_CELL, gd * PLAN_CELL),
            nil,
            nil,
            true
        )
        level.LayoutOrder = f
        for z = 1, gd do
            for x = 1, gw do
                local ch = MapPlan.Cell(plan, f, x, z)
                if ch == "." then
                    continue
                end
                local colour = PLAN_OPEN
                if ramp[MapPlan.Key(f, x, z)] then
                    colour = Theme.AMBER
                elseif MapPlan.IsWalkable(ch) then
                    local region = plan.regions[ch]
                    colour = if region.outdoor
                        then PLAN_OUTDOOR
                        elseif region.hall then PLAN_HALL
                        else PLAN_ROOM
                end
                local cell = Instance.new("Frame")
                cell.Name = "Cell"
                cell.BorderSizePixel = 0
                cell.BackgroundColor3 = colour
                cell.Size = UDim2.fromOffset(PLAN_CELL - 1, PLAN_CELL - 1)
                cell.Position = UDim2.fromOffset((x - 1) * PLAN_CELL, (z - 1) * PLAN_CELL)
                cell.Parent = level
            end
        end
    end
end

return function(parent: Instance?)
    parent = parent or game:GetService("StarterGui")
    local out = {}

    ------------------------------------------------------------------ LOBBY
    do
        local g, root = screen(parent :: Instance, "LobbyGui", 5, 0.35)
        pad(root, 26)
        local h = header(root, "INTERMISSION", "VOTE THE SCENE")
        local countdown =
            text("Countdown", h, "", 14, Theme.SOFT, Theme.MONO, Enum.TextXAlignment.Right)
        countdown.Position = UDim2.new(0, 0, 0, 2)

        -- Play now (NPCs fill a quiet server) or wait for a round of real players
        local mode = frame(
            "Mode",
            h,
            UDim2.fromOffset(420, Theme.TAP_MIN),
            UDim2.new(1, -420, 1, -Theme.TAP_MIN),
            nil,
            true
        )
        list(mode, Enum.FillDirection.Horizontal, 8)
        for i, spec in { { "PlayNow", "PLAY NOW · NPCS" }, { "Wait", "WAIT FOR PLAYERS" } } do
            local b = button(spec[1], mode, spec[2], UDim2.new(0.5, -4, 1, 0), RAISED, Theme.SOFT)
            b.LayoutOrder = i
            stroke(b)
        end

        local maps = frame("Maps", root, UDim2.new(1, 0, 0, 210), UDim2.new(0, 0, 0, 92), nil, true)
        grid(maps, UDim2.new(1 / 3, -8, 1, 0), 12)
        for i, mapName in Config.MAPS do
            local card = frame("Map" .. i, maps, UDim2.new())
            card:SetAttribute("MapName", mapName)
            card.LayoutOrder = i
            stroke(card)
            local preview = frame("Preview", card, UDim2.new(1, 0, 0, 104), nil, RAISED)
            local plan = MapPlan.MAPS[mapName]
            if plan then
                drawPlan(preview, plan)
            end
            local body =
                frame("Body", card, UDim2.new(1, 0, 1, -104), UDim2.new(0, 0, 0, 104), nil, true)
            pad(body, 12)
            local n = text(
                "MapName",
                body,
                string.upper((mapName:gsub("(%l)(%u)", "%1 %2"))),
                20,
                Theme.INK,
                Theme.DISPLAY
            )
            n.Size = UDim2.new(1, -50, 0, 26)
            local votes =
                text("Votes", body, "0", 13, Theme.AMBER, Theme.MONO, Enum.TextXAlignment.Right)
            votes.Size = UDim2.new(0, 44, 0, 26)
            votes.Position = UDim2.new(1, -44, 0, 0)
            local barBg = frame(
                "BarBg",
                body,
                UDim2.new(1, 0, 0, 4),
                UDim2.new(0, 0, 0, 34),
                Color3.fromHex("1c222a")
            )
            frame("Bar", barBg, UDim2.new(0, 0, 1, 0), nil, Theme.AMBER)
            local vote = button("Vote", body, "VOTE", UDim2.new(1, 0, 0, Theme.TAP_MIN))
            vote.Position = UDim2.new(0, 0, 1, -Theme.TAP_MIN)
        end

        local players = frame("Players", root, UDim2.new(0.48, -6, 0, 214), UDim2.new(0, 0, 0, 316))
        stroke(players)
        pad(players, 14)
        text("Caption", players, "IN LOBBY", 10, Theme.DIM)
        local plist = scroller("List", players, UDim2.new(1, 0, 1, -22), UDim2.new(0, 0, 0, 22))
        list(plist, nil, 6)
        local row = frame("RowTemplate", plist, UDim2.new(1, -8, 0, Theme.TAP_MIN), nil, nil, true)
        row.Visible = false
        local rn = text("PlayerName", row, "", 15, Theme.INK, Theme.DISPLAY)
        rn.Size = UDim2.new(0.38, 0, 1, 0)
        local rr = text("Rank", row, "", 11, Theme.MUTED)
        rr.Position = UDim2.new(0.38, 0, 0, 0)
        rr.Size = UDim2.new(0.3, 0, 1, 0)
        local trade = button("Trade", row, "TRADE", UDim2.new(0.16, -4, 1, 0), RAISED, Theme.CYAN)
        trade.Position = UDim2.new(0.68, 0, 0, 0)
        stroke(trade, Theme.CYAN)
        local report =
            button("Report", row, "REPORT", UDim2.new(0.16, 0, 1, 0), RAISED, Theme.MUTED)
        report.Position = UDim2.new(0.84, 0, 0, 0)
        stroke(report)

        local side = frame("Side", root, UDim2.new(0.52, -6, 0, 214), UDim2.new(0.48, 6, 0, 316))
        stroke(side)
        pad(side, 14)
        text("RankCaption", side, "RANK", 10, Theme.DIM)
        local rank = text("Rank", side, "1 · BYSTANDER", 24, Theme.INK, Theme.DISPLAY)
        rank.Position = UDim2.new(0, 0, 0, 14)
        local xpBg = frame(
            "XpBg",
            side,
            UDim2.new(1, 0, 0, 8),
            UDim2.new(0, 0, 0, 48),
            Color3.fromHex("1c222a")
        )
        frame("Xp", xpBg, UDim2.new(0, 0, 1, 0), nil, Theme.CYAN)
        local xpText = text("XpText", side, "0 / 1200 XP", 11, Theme.DIM)
        xpText.Position = UDim2.new(0, 0, 0, 60)
        local coins = text("Coins", side, "0 COINS", 24, Theme.AMBER, Theme.DISPLAY)
        coins.Position = UDim2.new(0, 0, 0, 82)
        local keys = text("Keys", side, "", 11, Theme.SOFT, Theme.MONO, Enum.TextXAlignment.Right)
        keys.Position = UDim2.new(0, 0, 0, 90)

        local row2 = frame(
            "Buttons",
            side,
            UDim2.new(1, 0, 0, Theme.TAP_MIN),
            UDim2.new(0, 0, 1, -Theme.TAP_MIN),
            nil,
            true
        )
        list(row2, Enum.FillDirection.Horizontal, 8)
        button("OpenCrate", row2, "CRATE", UDim2.new(1 / 3, -6, 1, 0)).LayoutOrder = 1
        local inv = button(
            "OpenInventory",
            row2,
            "COLLECTION",
            UDim2.new(1 / 3, -6, 1, 0),
            RAISED,
            Theme.CYAN
        )
        inv.LayoutOrder = 2
        stroke(inv, Theme.CYAN)
        local modesBtn =
            button("OpenModes", row2, "MODES", UDim2.new(1 / 3, -6, 1, 0), RAISED, Theme.AMBER)
        modesBtn.LayoutOrder = 3
        stroke(modesBtn, Theme.AMBER)

        -- Robux store. Entries with a product id of 0 stay hidden.
        local store = frame(
            "Store",
            root,
            UDim2.new(1, 0, 0, Theme.TAP_MIN),
            UDim2.new(0, 0, 0, 544),
            nil,
            true
        )
        list(store, Enum.FillDirection.Horizontal, 8)
        for i, key in { "vip", "radio", "emotes", "coins2500", "seasonalKey" } do
            local b = button(key, store, "", UDim2.new(1 / 5, -7, 1, 0), RAISED, Theme.SOFT)
            b.LayoutOrder = i
            b.Visible = false
            stroke(b, Color3.fromHex("2b323c"))
        end

        -- Which build is actually running. A place has to be republished
        -- before a merged fix reaches anyone, and from a phone there is no
        -- way to tell whether that happened - a fix looks identical to a fix
        -- that never shipped. PlaceVersion is the number Roblox steps on
        -- every publish, so this line settles it without a rejoin.
        local build = text("Build", root, "", 10, Theme.DIM, Theme.MONO)
        build.TextXAlignment = Enum.TextXAlignment.Right
        build.Position = UDim2.new(0, 0, 0, 600)
        out.lobby = g
    end

    ------------------------------------------------------------------ LOADING
    -- Opaque, above the lobby: it hides the map swap, which floods
    -- replication for the LOADING window. Everything sits on the centre line.
    do
        local g, root = screen(parent :: Instance, "LoadingGui", 6, 0)
        local function centred(l: TextLabel, y: number, width: number, height: number)
            l.AnchorPoint = Vector2.new(0.5, 0.5)
            l.Position = UDim2.fromScale(0.5, y)
            l.Size = UDim2.fromOffset(width, height)
            l.TextXAlignment = Enum.TextXAlignment.Center
        end
        centred(text("Caption", root, "SETTING THE SCENE", 14, Theme.MUTED), 0.36, 600, 22)
        local name = text("MapName", root, "", 64, Theme.INK, Theme.DISPLAY)
        centred(name, 0.46, 900, 80)
        centred(
            text(
                "Sub",
                root,
                "Everyone is being placed. You can move at the reveal.",
                16,
                Theme.SOFT
            ),
            0.56,
            700,
            24
        )
        local barBg = frame("BarBg", root, UDim2.fromOffset(520, 6), nil, SUNK)
        barBg.AnchorPoint = Vector2.new(0.5, 0.5)
        barBg.Position = UDim2.fromScale(0.5, 0.64)
        frame("Bar", barBg, UDim2.fromScale(0, 1), nil, Theme.AMBER)
        out.loading = g
    end

    ------------------------------------------------------------------ RESULTS
    do
        local g = screen(parent :: Instance, "ResultsGui", 6, 0.35)
        local card = g.Root
        card.Size = UDim2.fromOffset(620, 640)
        card.BackgroundColor3 = Theme.CARD
        card.BackgroundTransparency = 0
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = card
        stroke(card, Theme.STROKE)
        card.ClipsDescendants = true

        local banner = frame("Banner", card, UDim2.new(1, 0, 0, 104), nil, Theme.AMBER)
        local bk = text("Kicker", banner, "ROUND OVER", 11, BG)
        bk.Position = UDim2.new(0, 26, 0, 22)
        local bt = text("Title", banner, "YOU WON", 46, BG, Theme.DISPLAY_HEAVY)
        bt.Position = UDim2.new(0, 26, 0, 40)
        bt.Size = UDim2.new(1, -52, 0, 54)

        local reveal = frame(
            "Reveal",
            card,
            UDim2.new(1, 0, 0, 170),
            UDim2.new(0, 0, 0, 104),
            Color3.fromHex("0d1015")
        )
        pad(reveal, 22)
        text("Caption", reveal, "THE REVEAL", 10, Theme.DIM)
        local swatch =
            frame("Swatch", reveal, UDim2.new(0, 48, 0, 48), UDim2.new(0, 0, 0, 22), Theme.DANGER)
        swatch.Rotation = 45
        local killer = text("KillerName", reveal, "—", 32, Theme.DANGER, Theme.DISPLAY_HEAVY)
        killer.Position = UDim2.new(0, 66, 0, 20)
        killer.Size = UDim2.new(1, -66, 0, 38)
        local tally = text("KillerTally", reveal, "", 11, Theme.MUTED)
        tally.Position = UDim2.new(0, 66, 0, 56)
        local roster =
            frame("Roster", reveal, UDim2.new(1, 0, 0, 56), UDim2.new(0, 0, 0, 80), nil, true)
        grid(roster, UDim2.fromOffset(136, 24), 6)

        local lower =
            frame("Lower", card, UDim2.new(1, 0, 1, -274), UDim2.new(0, 0, 0, 274), nil, true)
        pad(lower, 22)
        local blurb = text("Blurb", lower, "", 14, Theme.SOFT)
        blurb.Size = UDim2.new(1, 0, 0, 36)
        blurb.TextWrapped = true

        local tl = frame("Timeline", lower, UDim2.new(1, 0, 0, 96), UDim2.new(0, 0, 0, 40), SUNK)
        stroke(tl)
        pad(tl, 10)
        text("Caption", tl, "KILL TIMELINE", 10, Theme.DIM)
        local tlList = frame("List", tl, UDim2.new(1, 0, 1, -18), UDim2.new(0, 0, 0, 18), nil, true)
        list(tlList, nil, 2)

        local rewards =
            frame("Rewards", lower, UDim2.new(1, 0, 0, 84), UDim2.new(0, 0, 0, 144), nil, true)
        list(rewards, nil, 4)
        for i, spec in
            {
                { "Xp", "EXPERIENCE", Theme.CYAN },
                { "Coins", "COINS BANKED", Theme.AMBER },
                { "Clues", "EVIDENCE READ", Theme.INK },
            }
        do
            local r = frame(spec[1], rewards, UDim2.new(1, 0, 0, 24), nil, nil, true)
            r.LayoutOrder = i
            text("Label", r, spec[2], 11, Theme.MUTED).Size = UDim2.new(1, 0, 1, 0)
            local v = text("Value", r, "0", 20, spec[3], Theme.DISPLAY, Enum.TextXAlignment.Right)
            v.Size = UDim2.new(1, 0, 1, 0)
        end
        local nearMiss = text("NearMiss", lower, "", 13, Theme.SOFT)
        nearMiss.Position = UDim2.new(0, 0, 0, 232)

        local btns = frame(
            "Buttons",
            lower,
            UDim2.new(1, 0, 0, Theme.TAP_MIN),
            UDim2.new(0, 0, 1, -Theme.TAP_MIN),
            nil,
            true
        )
        list(btns, Enum.FillDirection.Horizontal, 10)
        button("NextRound", btns, "NEXT ROUND", UDim2.new(0.5, -5, 1, 0)).LayoutOrder = 1
        local oc = button(
            "OpenCrate",
            btns,
            "OPEN CRATE",
            UDim2.new(0.5, -5, 1, 0),
            Theme.CARD,
            Theme.CYAN
        )
        oc.LayoutOrder = 2
        stroke(oc, Theme.CYAN)
        out.results = g
    end

    ------------------------------------------------------------------ CRATE
    do
        local g, root = screen(parent :: Instance, "CrateGui", 6, 0.06)
        pad(root, 26)
        local h = header(root, "EVIDENCE CRATE", "THE LOCKER")

        local tabs = frame(
            "Tabs",
            h,
            UDim2.new(0, 360, 0, Theme.TAP_MIN),
            UDim2.new(1, -360, 0, 0),
            nil,
            true
        )
        list(tabs, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right)
        for i, key in { "Locker", "Seasonal" } do
            local t =
                button(key, tabs, string.upper(key), UDim2.new(0, 150, 1, 0), RAISED, Theme.MUTED)
            t.LayoutOrder = i
            stroke(t, Color3.fromHex("2b323c"))
        end
        local countdown =
            text("Countdown", h, "", 11, Theme.SOFT, Theme.MONO, Enum.TextXAlignment.Right)
        countdown.Position = UDim2.new(0, 0, 0, 48)

        local reelBox = frame(
            "ReelBox",
            root,
            UDim2.new(1, 0, 0, 182),
            UDim2.new(0, 0, 0, 92),
            Color3.fromHex("0e1116")
        )
        stroke(reelBox)
        reelBox.ClipsDescendants = true
        local reel =
            frame("Reel", reelBox, UDim2.new(0, 5200, 1, -32), UDim2.new(0, 12, 0, 16), nil, true)
        list(reel, Enum.FillDirection.Horizontal, 12)
        local marker =
            frame("Marker", reelBox, UDim2.new(0, 2, 1, 0), UDim2.fromScale(0.5, 0), Theme.AMBER)
        marker.AnchorPoint = Vector2.new(0.5, 0)
        marker.ZIndex = 5

        local won =
            text("WonText", root, "", 28, Theme.DIM, Theme.DISPLAY, Enum.TextXAlignment.Center)
        won.Position = UDim2.new(0, 0, 0, 282)
        won.Size = UDim2.new(1, 0, 0, 40)

        -- Published odds — Roblox requires disclosure for paid random items
        local odds = frame("Odds", root, UDim2.new(0.56, -6, 0, 186), UDim2.new(0, 0, 0, 330))
        stroke(odds)
        pad(odds, 14)
        text("Caption", odds, "PUBLISHED ODDS", 10, Theme.DIM)
        local oddsList =
            frame("List", odds, UDim2.new(1, 0, 1, -22), UDim2.new(0, 0, 0, 22), nil, true)
        list(oddsList, nil, 6)
        for i, r in Rarities do
            local row = frame(r.name, oddsList, UDim2.new(1, 0, 0, 22), nil, nil, true)
            row.LayoutOrder = i
            local n = text("TierName", row, string.upper(r.name), 16, r.colour, Theme.DISPLAY)
            n.Size = UDim2.new(0, 120, 1, 0)
            local p = text("Pct", row, "", 12, Theme.INK)
            p.Position = UDim2.new(0, 124, 0, 0)
            p.Size = UDim2.new(0, 60, 1, 0)
            local barBg = frame(
                "BarBg",
                row,
                UDim2.new(1, -196, 0, 8),
                UDim2.new(0, 188, 0.5, -4),
                Color3.fromHex("1a1f26")
            )
            frame("Bar", barBg, UDim2.fromScale(0, 1), nil, r.colour)
        end

        local shelf = frame("Shelf", root, UDim2.new(0.44, -6, 0, 186), UDim2.new(0.56, 6, 0, 330))
        stroke(shelf)
        pad(shelf, 14)
        text("Caption", shelf, "DIRECT BUY · NO GAMBLE", 10, Theme.DIM)
        local items =
            frame("Items", shelf, UDim2.new(1, 0, 1, -22), UDim2.new(0, 0, 0, 22), nil, true)
        grid(items, UDim2.new(0.25, -6, 1, 0), 8)

        local btns =
            frame("Buttons", root, UDim2.new(1, 0, 0, 46), UDim2.new(0, 0, 1, -46), nil, true)
        list(btns, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
        local balance =
            text("Balance", btns, "0 coins", 14, Theme.SOFT, Theme.MONO, Enum.TextXAlignment.Right)
        balance.Size = UDim2.new(0, 220, 1, 0)
        balance.LayoutOrder = 0
        button("Spin", btns, "SPIN", UDim2.new(0, 280, 1, 0)).LayoutOrder = 1
        local back = button("Close", btns, "BACK", UDim2.new(0, 140, 1, 0), RAISED, Theme.MUTED)
        back.LayoutOrder = 2
        stroke(back, Color3.fromHex("2b323c"))
        out.crate = g
    end

    ------------------------------------------------------------------ MODES
    -- Vote the next round's mode. The room only ever rotated modes on its own;
    -- this is the player-facing pick MenuController drives with ModeTally.
    do
        local g, root = screen(parent :: Instance, "ModesGui", 6, 0.35)
        pad(root, 26)
        local h = header(root, "NEXT ROUND", "PICK THE MODE")
        local note = text(
            "Note",
            h,
            "Most votes wins. No votes and the modes rotate on their own.",
            12,
            Theme.SOFT,
            Theme.MONO,
            Enum.TextXAlignment.Right
        )
        note.Position = UDim2.new(0, 0, 0, 48)

        local scroll = scroller("List", root, UDim2.new(1, 0, 1, -150), UDim2.new(0, 0, 0, 92))
        list(scroll, nil, 10)
        local order = { "classic" }
        for _, id in Modes.ROTATION do
            table.insert(order, id)
        end
        for i, id in order do
            local def = Modes.Get(id)
            local card = frame("Mode_" .. id, scroll, UDim2.new(1, -6, 0, 96), nil, RAISED)
            card:SetAttribute("ModeId", id)
            card.LayoutOrder = i
            stroke(card)
            pad(card, 14)
            local n = text("ModeName", card, string.upper(def.name), 22, Theme.INK, Theme.DISPLAY)
            n.Size = UDim2.new(1, -160, 0, 26)
            local blurb = text("Blurb", card, def.blurb, 13, Theme.SOFT)
            blurb.Position = UDim2.new(0, 0, 0, 30)
            blurb.Size = UDim2.new(1, -160, 0, 38)
            blurb.TextWrapped = true
            blurb.TextYAlignment = Enum.TextYAlignment.Top
            local votes =
                text("Votes", card, "0", 26, Theme.AMBER, Theme.DISPLAY, Enum.TextXAlignment.Right)
            votes.Position = UDim2.new(1, -150, 0, 0)
            votes.Size = UDim2.new(0, 140, 0, 30)
            local vote = button("Vote", card, "VOTE", UDim2.new(0, 140, 0, Theme.TAP_MIN))
            vote.Position = UDim2.new(1, -140, 1, -Theme.TAP_MIN)
        end

        local btns =
            frame("Buttons", root, UDim2.new(1, 0, 0, 46), UDim2.new(0, 0, 1, -46), nil, true)
        list(btns, Enum.FillDirection.Horizontal, 10, Enum.HorizontalAlignment.Center)
        local back = button("Close", btns, "BACK", UDim2.new(0, 160, 1, 0), RAISED, Theme.MUTED)
        stroke(back, Color3.fromHex("2b323c"))
        out.modes = g
    end

    ------------------------------------------------------------------ INVENTORY
    do
        local g, root = screen(parent :: Instance, "InventoryGui", 6, 0.06)
        pad(root, 26)
        header(root, "CASE FILE", "YOUR COLLECTION")
        local summary = text(
            "Summary",
            root,
            "0 owned · 0 coins",
            12,
            Theme.MUTED,
            Theme.MONO,
            Enum.TextXAlignment.Right
        )
        summary.Position = UDim2.new(0, 0, 0, 44)

        local scroll = scroller("Items", root, UDim2.new(1, 0, 1, -196), UDim2.new(0, 0, 0, 90))
        grid(scroll, UDim2.fromOffset(160, 190), 12)
        local card = frame("ItemTemplate", scroll, UDim2.fromOffset(160, 190))
        stroke(card)
        card.Visible = false
        local sw =
            frame("Swatch", card, UDim2.fromOffset(44, 44), UDim2.new(0.5, -22, 0, 18), Theme.DIM)
        sw.Rotation = 45
        local nm =
            text("ItemName", card, "ITEM", 18, Theme.INK, Theme.DISPLAY, Enum.TextXAlignment.Center)
        nm.Position = UDim2.new(0, 0, 0, 72)
        local rar = text("Rarity", card, "", 9, Theme.DIM, Theme.MONO, Enum.TextXAlignment.Center)
        rar.Position = UDim2.new(0, 0, 0, 98)
        local fx = text("Effect", card, "", 9, Theme.SOFT, Theme.MONO, Enum.TextXAlignment.Center)
        fx.Position = UDim2.new(0, 0, 0, 114)
        local select = Instance.new("TextButton")
        select.Name = "Select"
        select.Text = ""
        select.BackgroundTransparency = 1
        select.Size = UDim2.new(1, 0, 1, -Theme.TAP_MIN)
        select.Parent = card
        local eq =
            button("Equip", card, "EQUIP", UDim2.new(1, -16, 0, Theme.TAP_MIN), RAISED, Theme.AMBER)
        eq.Position = UDim2.new(0, 8, 1, -(Theme.TAP_MIN + 6))
        stroke(eq, Color3.fromHex("2b323c"))

        local status = text("Status", root, "", 12, Theme.SOFT)
        status.Position = UDim2.new(0, 0, 1, -76)

        local btns = frame(
            "Buttons",
            root,
            UDim2.new(1, 0, 0, Theme.TAP_MIN),
            UDim2.new(0, 0, 1, -Theme.TAP_MIN),
            nil,
            true
        )
        list(btns, Enum.FillDirection.Horizontal, 10)
        local craft = button("Craft", btns, "CRAFT 5 → 1", UDim2.new(0, 260, 1, 0), RAISED, GREEN)
        craft.LayoutOrder = 1
        stroke(craft, GREEN)
        local reroll =
            button("Reroll", btns, "RE-ROLL EFFECT", UDim2.new(0, 280, 1, 0), RAISED, Theme.MUTED)
        reroll.LayoutOrder = 2
        stroke(reroll, Color3.fromHex("2b323c"))
        button("Close", btns, "BACK", UDim2.new(0, 140, 1, 0), RAISED, Theme.MUTED).LayoutOrder = 3
        out.inventory = g
    end

    ------------------------------------------------------------------ TRADE
    do
        local g, root = screen(parent :: Instance, "TradeGui", 7, 0.06)
        pad(root, 26)
        header(root, "ESCROWED SWAP", "TRADE")
        local note = text(
            "Note",
            root,
            "Any change to either table resets both locks.",
            12,
            Theme.MUTED,
            Theme.MONO,
            Enum.TextXAlignment.Right
        )
        note.Position = UDim2.new(0, 0, 0, 44)

        local function side(name: string, x: number, caption: string)
            local f = frame(
                name,
                root,
                UDim2.new(0.5, -7, 0, 196),
                UDim2.new(x, x == 0 and 0 or 7, 0, 86)
            )
            stroke(f)
            pad(f, 12)
            text("Caption", f, caption, 10, Theme.INK)
            local lock =
                text("Lock", f, "Editing", 11, Theme.MUTED, Theme.MONO, Enum.TextXAlignment.Right)
            lock.Size = UDim2.new(1, 0, 0, 16)
            local slots =
                frame("Slots", f, UDim2.new(1, 0, 0, 132), UDim2.new(0, 0, 0, 22), nil, true)
            grid(slots, UDim2.fromOffset(92, 62), 6)
            local val = text("Value", f, "Table value · 0", 12, Theme.MUTED)
            val.Position = UDim2.new(0, 0, 1, -18)
        end
        side("Mine", 0, "YOUR OFFER")
        side("Theirs", 0.5, "THEIR OFFER")

        local fair = frame("Fairness", root, UDim2.new(1, 0, 0, 62), UDim2.new(0, 0, 0, 292), SUNK)
        stroke(fair)
        pad(fair, 12)
        text("Caption", fair, "FAIRNESS", 10, Theme.DIM)
        local fl = text(
            "Label",
            fair,
            "Empty table",
            10,
            Theme.MUTED,
            Theme.MONO,
            Enum.TextXAlignment.Right
        )
        fl.Size = UDim2.new(1, 0, 0, 14)
        local track = frame(
            "Track",
            fair,
            UDim2.new(1, 0, 0, 10),
            UDim2.new(0, 0, 0, 22),
            Color3.fromHex("1a1f26")
        )
        local centre = frame(
            "Centre",
            track,
            UDim2.new(0, 2, 1, 0),
            UDim2.fromScale(0.5, 0),
            Color3.fromHex("3a4450")
        )
        centre.AnchorPoint = Vector2.new(0.5, 0)
        centre.ZIndex = 2
        frame("Fill", track, UDim2.new(0, 0, 1, 0), UDim2.fromScale(0.5, 0), GREEN)

        local btns = frame(
            "Buttons",
            root,
            UDim2.new(1, 0, 0, Theme.TAP_MIN),
            UDim2.new(0, 0, 0, 364),
            nil,
            true
        )
        list(btns, Enum.FillDirection.Horizontal, 10)
        local lockBtn =
            button("Lock", btns, "LOCK MY OFFER", UDim2.new(0.4, -7, 1, 0), Theme.CARD, Theme.CYAN)
        lockBtn.LayoutOrder = 1
        stroke(lockBtn, Theme.CYAN)
        button(
            "Confirm",
            btns,
            "CONFIRM TRADE",
            UDim2.new(0.4, -7, 1, 0),
            Color3.fromHex("2b323c"),
            BG
        ).LayoutOrder =
            2
        local cancel =
            button("Cancel", btns, "CANCEL", UDim2.new(0.2, -6, 1, 0), RAISED, Theme.MUTED)
        cancel.LayoutOrder = 3
        stroke(cancel, Color3.fromHex("2b323c"))

        local status = text("Status", root, "", 12, Theme.MUTED)
        status.Position = UDim2.new(0, 0, 0, 414)

        local poolBox =
            frame("Pool", root, UDim2.new(1, 0, 1, -440), UDim2.new(0, 0, 0, 440), nil, true)
        text("Caption", poolBox, "YOUR INVENTORY — TAP TO PUT ON THE TABLE", 10, Theme.DIM)
        local pool = scroller("Items", poolBox, UDim2.new(1, 0, 1, -20), UDim2.new(0, 0, 0, 20))
        grid(pool, UDim2.fromOffset(110, 74), 8)
        out.trade = g
    end

    return out
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">BuildNotices</string>
            <string name="Source"><![CDATA[--!strict
--[[
  COLD CASE · NoticeHud builder. Sits above every menu.
    Hint   (TextLabel)  onboarding ghost prompt
    Toast  (TextLabel)  short server notices
]]
local Theme = require(script.Parent.Parent.Theme)

local function label(name: string, parent: Instance, size: number): TextLabel
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = ""
    l.TextSize = size
    l.FontFace = Theme.MONO
    l.TextColor3 = Theme.INK
    l.BackgroundTransparency = 1
    l.TextTransparency = 1
    l.TextStrokeTransparency = 1
    l.Parent = parent
    return l
end

return function(parent: Instance?): ScreenGui
    parent = parent or game:GetService("StarterGui")
    local old = (parent :: Instance):FindFirstChild("NoticeHud")
    if old then
        old:Destroy()
    end

    local gui = Instance.new("ScreenGui")
    gui.Name = "NoticeHud"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 10

    local hint = label("Hint", gui, 18)
    hint.AnchorPoint = Vector2.new(0.5, 1)
    hint.Position = UDim2.new(0.5, 0, 1, -140)
    hint.Size = UDim2.new(0, 520, 0, 30)
    hint.TextColor3 = Theme.SOFT

    local toast = label("Toast", gui, 16)
    toast.AnchorPoint = Vector2.new(0.5, 0)
    toast.Position = UDim2.new(0.5, 0, 0, 160)
    toast.Size = UDim2.new(0.9, 0, 0, 28)
    toast.TextWrapped = true

    gui.Parent = parent
    return gui
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="10">
          <Properties>
            <string name="Name">ItemCard</string>
            <string name="Source"><![CDATA[--!strict
-- One item tile, used by the crate reel, direct-buy shelf, inventory and trade.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Theme = require(script.Parent.Parent.Theme)
local Catalog = require(script.Parent.Parent.Catalog)
local Rarities = require(script.Parent.Parent.RarityTable)

-- Show the real item in a small 3D viewport for every knife, pistol and pet.
-- BuildAssets replicates one model per item into ReplicatedStorage.PreviewModels.
-- Whether an item HAS a mesh is decided from its catalogue kind, not from the
-- folder, so a card built before the folder replicates still gets a viewport
-- (filled once the model arrives) rather than being frozen on a diamond. Only
-- effects, which have no mesh, return false so the caller draws the diamond.
local function hasMesh(id: string): boolean
    local def = Catalog[id]
    return def ~= nil and (def.kind == "Knife" or def.kind == "Pistol" or def.kind == "Pet")
end

local function fill(vp: ViewportFrame, id: string)
    local folder = ReplicatedStorage:WaitForChild("PreviewModels", 15)
    local src = folder and folder:WaitForChild(id, 15)
    if not (src and src:IsA("Model") and vp.Parent) then
        return
    end
    local model = src:Clone()
    local ok, cf, size = pcall(function()
        return model:GetBoundingBox()
    end)
    if not ok then
        model:Destroy()
        return
    end
    local world = Instance.new("WorldModel")
    model.Parent = world
    world.Parent = vp
    local cam = Instance.new("Camera")
    local dist = math.max((size :: Vector3).Magnitude, 1) * 0.95 + 0.5
    local dir = Vector3.new(0.55, 0.4, 1).Unit
    cam.CFrame = CFrame.lookAt((cf :: CFrame).Position + dir * dist, (cf :: CFrame).Position)
    cam.FieldOfView = 40
    vp.CurrentCamera = cam
    cam.Parent = vp

    -- Chroma: the blade cycles through every hue. Runs only while the viewport
    -- is on screen and disconnects itself when it (or the model) goes away.
    if Catalog[id] and Catalog[id].chroma then
        local parts = {}
        for _, d in model:GetDescendants() do
            if d:IsA("BasePart") then
                table.insert(parts, d)
            end
        end
        if model:IsA("BasePart") then
            table.insert(parts, model)
        end
        local conn
        conn = RunService.RenderStepped:Connect(function()
            if not (vp.Parent and model.Parent) then
                conn:Disconnect()
                return
            end
            local colour = Color3.fromHSV((os.clock() * 0.25) % 1, 0.85, 1)
            for _, p in parts do
                p.Color = colour
            end
        end)
    end
end

local function mountPreview(parent: Instance, id: string): boolean
    if not hasMesh(id) then
        return false
    end
    local vp = Instance.new("ViewportFrame")
    vp.Name = "Preview"
    vp.AnchorPoint = Vector2.new(0.5, 0.5)
    vp.Position = UDim2.fromScale(0.5, 0.3)
    vp.Size = UDim2.fromScale(0.66, 0.46)
    vp.BackgroundTransparency = 1
    vp.Ambient = Color3.fromRGB(196, 198, 208)
    vp.LightColor = Color3.fromRGB(255, 250, 238)
    vp.LightDirection = Vector3.new(-0.4, -1, -0.5)
    vp.Parent = parent
    task.spawn(fill, vp, id)
    return true
end

local RARITY_COLOUR = {}
for _, r in Rarities do
    RARITY_COLOUR[r.name] = r.colour
end

local function label(
    name: string,
    parent: Instance,
    text: string,
    font: Font,
    maxSize: number,
    colour: Color3
)
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = text
    l.FontFace = font
    l.TextColor3 = colour
    l.BackgroundTransparency = 1
    l.TextScaled = true
    local limit = Instance.new("UITextSizeConstraint")
    limit.MaxTextSize = maxSize
    limit.Parent = l
    l.Parent = parent
    return l
end

-- `button` adds a transparent full-size TextButton named Button on top
local function ItemCard(parent: Instance, id: string, size: UDim2?, button: boolean?): Frame
    local def = Catalog[id]
    local colour = def and RARITY_COLOUR[def.rarity] or Theme.DIM

    local f = Instance.new("Frame")
    f.Name = "Card"
    f.Size = size or UDim2.fromOffset(132, 150)
    f.BackgroundColor3 = Color3.fromHex("131820")
    f.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = f
    local stroke = Instance.new("UIStroke")
    stroke.Name = "Stroke"
    stroke.Color = colour
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = f

    if not mountPreview(f, id) then
        -- No mesh for this item (an effect): the rarity diamond stands in
        local swatch = Instance.new("Frame")
        swatch.Name = "Swatch"
        swatch.AnchorPoint = Vector2.new(0.5, 0.5)
        swatch.Position = UDim2.fromScale(0.5, 0.3)
        swatch.Size = UDim2.fromScale(0.28, 0.28)
        swatch.SizeConstraint = Enum.SizeConstraint.RelativeYY
        swatch.Rotation = 45
        swatch.BackgroundColor3 = colour
        swatch.BorderSizePixel = 0
        swatch.Parent = f
    end

    local name = label("ItemName", f, def and def.name or "?", Theme.DISPLAY, 18, Theme.INK)
    name.Position = UDim2.fromScale(0.05, 0.54)
    name.Size = UDim2.fromScale(0.9, 0.18)

    local rarity =
        label("Rarity", f, def and string.upper(def.rarity) or "", Theme.MONO, 10, colour)
    rarity.Position = UDim2.fromScale(0.05, 0.74)
    rarity.Size = UDim2.fromScale(0.9, 0.11)

    if button then
        local b = Instance.new("TextButton")
        b.Name = "Button"
        b.Text = ""
        b.BackgroundTransparency = 1
        b.Size = UDim2.fromScale(1, 1)
        b.ZIndex = 2
        b.Parent = f
    end

    f.Parent = parent
    return f
end

return {
    new = ItemCard,
    -- Adds a 3D preview viewport to any card frame that has room for one,
    -- returning true for a knife, pistol or pet and false for an effect so the
    -- caller can leave its own swatch showing. Used by the inventory tiles,
    -- which are cloned from a template rather than built by `new`.
    mount = mountPreview,
    RARITY_COLOUR = RARITY_COLOUR,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[--!strict
-- The 24 launch items plus seasonal drops. Rarity, kind and value are FIXED
-- per item — never roll a name and a rarity independently.
-- `season` marks an item that only drops from that season's crate and is
-- retired forever when the season closes (see Shared/LiveOps).
return {
    -- Common
    -- `starter` items are given, never dropped: pulling the thing you already
    -- own on round one is the worst possible first crate.
    ash = { name = "Ash", kind = "Knife", rarity = "Common", value = 40, starter = true },
    tallow = { name = "Tallow", kind = "Knife", rarity = "Common", value = 40 },
    ledger = { name = "Ledger", kind = "Pistol", rarity = "Common", value = 40, starter = true },
    scrap = { name = "Scrap", kind = "Pistol", rarity = "Common", value = 40 },
    matchstick = { name = "Matchstick", kind = "Effect", rarity = "Common", value = 60 },
    gutter = { name = "Gutter", kind = "Knife", rarity = "Common", value = 40 },
    -- Uncommon
    ember = { name = "Ember", kind = "Knife", rarity = "Uncommon", value = 180 },
    hollow = { name = "Hollow", kind = "Knife", rarity = "Uncommon", value = 180 },
    static = { name = "Static", kind = "Effect", rarity = "Uncommon", value = 220 },
    brassnine = { name = "Brass Nine", kind = "Pistol", rarity = "Uncommon", value = 180 },
    moth = { name = "Moth", kind = "Pet", rarity = "Uncommon", value = 260 },
    palefox = { name = "Pale Fox", kind = "Knife", rarity = "Uncommon", value = 200 },
    -- Rare
    nocturne = { name = "Nocturne", kind = "Knife", rarity = "Rare", value = 900 },
    ivory = { name = "Ivory", kind = "Pistol", rarity = "Rare", value = 850 },
    longnight = { name = "Longnight", kind = "Knife", rarity = "Rare", value = 1100 },
    frostbite = { name = "Frostbite", kind = "Effect", rarity = "Rare", value = 1000 },
    copperhead = { name = "Copperhead", kind = "Pistol", rarity = "Rare", value = 850 },
    widowspeak = { name = "Widow's Peak", kind = "Pet", rarity = "Rare", value = 1300 },
    -- Legendary
    verdict = { name = "Verdict", kind = "Knife", rarity = "Legendary", value = 4200 },
    cinder = { name = "Cinder", kind = "Knife", rarity = "Legendary", value = 4500 },
    nightjar = { name = "Nightjar", kind = "Pistol", rarity = "Legendary", value = 5000 },
    bellwether = { name = "Bellwether", kind = "Effect", rarity = "Legendary", value = 4800 },
    -- Godly
    coldsnap = { name = "Coldsnap", kind = "Knife", rarity = "Godly", value = 22000 },
    thealibi = { name = "The Alibi", kind = "Pistol", rarity = "Godly", value = 28000 },

    -- Ancient · chroma. The rarest pull (~0.2%): a top mesh whose blade cycles
    -- through every hue. `chroma` is read by ItemCard and CosmeticService.
    eclipse = { name = "Eclipse", kind = "Knife", rarity = "Ancient", value = 60000, chroma = true },
    prism = { name = "Prism", kind = "Pistol", rarity = "Ancient", value = 65000, chroma = true },

    -- VIP exclusive. `vip` items never drop from a crate or craft; the VIP pass
    -- mints exactly one, once, when the pass is owned (see MonetizationService).
    regalia = { name = "Regalia", kind = "Effect", rarity = "Legendary", value = 5000, vip = true },

    -- Season One · The Long Night. Values are placeholders until the
    -- market sets them; the handbook does not price seasonals.
    vigil = { name = "Vigil", kind = "Knife", rarity = "Rare", value = 1200, season = "S1" },
    hoarfrost = {
        name = "Hoarfrost",
        kind = "Pistol",
        rarity = "Rare",
        value = 1200,
        season = "S1",
    },
    thelongnightfx = {
        name = "The Long Night",
        kind = "Effect",
        rarity = "Legendary",
        value = 5000,
        season = "S1",
    },
    nightwatch = {
        name = "Nightwatch",
        kind = "Pet",
        rarity = "Legendary",
        value = 5000,
        season = "S1",
    },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">CombatFx</string>
          <string name="Source"><![CDATA[--!strict
-- COLD CASE · combat feedback. A red spray where a blow lands and a muzzle
-- flash when a gun fires, spawned server-side so every client sees them. Both
-- self-clean through Debris. The impact keeps LightEmission 0 and is lit by the
-- scene, so it shows in daylight but stays dark during Lights Out - it must
-- never light a kill for someone who otherwise could not see. The muzzle flash
-- is self-bright: a gun is already the loudest, most-revealing act in a round
-- (gun_fire carries 220 studs), so its flash giving the shooter away fits.
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local CombatFx = {}

local IMPACT = "rbxasset://textures/particles/smoke_main.dds"
local FLASH = "rbxasset://textures/particles/fire_main.dds"

local function anchor(position: Vector3): Part
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Massless = true
    p.Transparency = 1
    p.Size = Vector3.new(0.2, 0.2, 0.2)
    p.CFrame = CFrame.new(position)
    return p
end

-- A short crimson spray at the point a blow lands.
function CombatFx.Impact(position: Vector3)
    local p = anchor(position + Vector3.new(0, 2, 0))
    local e = Instance.new("ParticleEmitter")
    e.Texture = IMPACT
    e.Color = ColorSequence.new(Color3.fromRGB(150, 22, 22), Color3.fromRGB(88, 10, 10))
    e.Transparency = NumberSequence.new(0.1, 1)
    e.Size = NumberSequence.new(0.7, 0.15)
    e.Lifetime = NumberRange.new(0.3, 0.6)
    e.Speed = NumberRange.new(7, 13)
    e.SpreadAngle = Vector2.new(180, 180)
    e.Acceleration = Vector3.new(0, -34, 0)
    e.Rate = 0
    e.LightEmission = 0
    e.LightInfluence = 1
    e.Parent = p
    p.Parent = Workspace
    e:Emit(18)
    Debris:AddItem(p, 0.8)
end

-- A brief bright flash just ahead of the muzzle.
function CombatFx.Muzzle(origin: Vector3, direction: Vector3)
    if direction.Magnitude < 1e-3 then
        return
    end
    local p = anchor(origin + direction.Unit * 1.6)
    local e = Instance.new("ParticleEmitter")
    e.Texture = FLASH
    e.Color = ColorSequence.new(Color3.fromRGB(255, 232, 150), Color3.fromRGB(255, 158, 40))
    e.Transparency = NumberSequence.new(0, 1)
    e.Size = NumberSequence.new(2.4, 0.2)
    e.Lifetime = NumberRange.new(0.06, 0.1)
    e.Speed = NumberRange.new(0, 2)
    e.SpreadAngle = Vector2.new(28, 28)
    e.Rate = 0
    e.LightEmission = 1
    e.LightInfluence = 0
    e.Parent = p
    p.Parent = Workspace
    e:Emit(6)
    Debris:AddItem(p, 0.2)
end

-- A small gold sparkle when a coin is collected. Self-bright so it reads as a
-- reward pop; brief and self-cleaning.
function CombatFx.Pickup(position: Vector3)
    local pt = anchor(position + Vector3.new(0, 1, 0))
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    e.Color = ColorSequence.new(Color3.fromRGB(255, 214, 92), Color3.fromRGB(242, 166, 59))
    e.Transparency = NumberSequence.new(0.05, 1)
    e.Size = NumberSequence.new(0.5, 0.05)
    e.Lifetime = NumberRange.new(0.25, 0.5)
    e.Speed = NumberRange.new(3, 6)
    e.SpreadAngle = Vector2.new(180, 180)
    e.Acceleration = Vector3.new(0, -12, 0)
    e.Rate = 0
    e.LightEmission = 0.6
    e.LightInfluence = 0
    e.Parent = pt
    pt.Parent = Workspace
    e:Emit(12)
    Debris:AddItem(pt, 0.6)
end

-- Becoming the hero: a rising cyan-and-gold flare when a player takes the
-- dropped pistol. A public, loud moment already (gun_pickup), so a bright pop
-- fits; brief and self-cleaning.
function CombatFx.Hero(position: Vector3)
    local pt = anchor(position + Vector3.new(0, 2, 0))
    local e = Instance.new("ParticleEmitter")
    e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    e.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(55, 188, 240)),
        ColorSequenceKeypoint.new(0.6, Color3.fromRGB(255, 214, 92)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 214, 92)),
    })
    e.Transparency = NumberSequence.new(0.05, 1)
    e.Size = NumberSequence.new(0.6, 0.05)
    e.Lifetime = NumberRange.new(0.4, 0.8)
    e.Speed = NumberRange.new(6, 11)
    e.SpreadAngle = Vector2.new(60, 60)
    e.Acceleration = Vector3.new(0, 6, 0)
    e.Rate = 0
    e.LightEmission = 0.6
    e.LightInfluence = 0
    e.Parent = pt
    pt.Parent = Workspace
    e:Emit(26)
    Debris:AddItem(pt, 0.9)
end

return CombatFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- COLD CASE · every tuning number lives here
return {
    -- Round
    INTERMISSION = 15, -- the lobby: vote, then NPCs fill the round and it starts on its own
    LOADING_TIME = 3,
    REVEAL_TIME = 4,
    RESOLUTION_TIME = 6,
    KILLCAM_TIME = 2.5, -- of RESOLUTION_TIME, before the results screen
    -- Four to five minutes. At 110-150s a family round was over before anyone
    -- had crossed the building twice, and a player killed early sat out longer
    -- than they had played; a later pass added a minute to every tier for more
    -- time to investigate and hunt.
    ROUND_LENGTH_SMALL = 240, -- fewer than 8 players; the buildings are big
    ROUND_LENGTH = 260,
    ROUND_LENGTH_LARGE = 300, -- 12+ players
    ROUND_SMALL_UNDER = 8, -- below this headcount a round uses the small length
    ROUND_LARGE_AT = 12, -- at or above it, the large one
    MIN_PLAYERS = 4,
    MODE_ROTATE_EVERY = 4, -- every Nth round runs a special mode (see Shared/Modes)
    -- The server cap. It mirrors the place's server size, which is set on the
    -- Creator Dashboard (it is not a place-file property: Rojo drops a
    -- Players.MaxPlayers entry without a word). Every headcount threshold
    -- below is checked against it.
    MAX_PLAYERS = 12,
    SPAWN_MIN_SEP = 60,
    WEAPON_GRACE = 4, -- no kills for the first 4 seconds

    -- Role scaling
    SECOND_MURDERER_AT = 12,
    -- Was 14, which no server could ever reach: the cap is 12, so a second
    -- sheriff never once appeared. Matched to the second murderer so a full
    -- lobby scales both sides together instead of only the killers.
    SECOND_SHERIFF_AT = 12,
    -- A medic can revive a person or an NPC, so a solo round of NPCs still
    -- deals the role at this headcount.
    MEDIC_AT = 6,
    SNITCH_AT = 6,
    SNITCH_REVEAL_AT = 30, -- seconds remaining
    -- The snitch's deduction: examining bodies builds a suspect board, and once
    -- they have read this many bodies (or the reveal fires) they may EXPOSE the
    -- real killer to everyone. One use; naming does not end the round.
    SNITCH_EXPOSE_CLUES = 3,
    SNITCH_EXPOSE_HIGHLIGHT = 4, -- seconds the named killer glows red to all
    MURDERER_COOLOFF = 3, -- rounds of reduced odds after being murderer

    -- Combat
    KNIFE_RANGE = 12,
    PING_ALLOWANCE = 2, -- extra studs the server grants on top of KNIFE_RANGE
    KNIFE_COOLDOWN = 1.1,
    THROW_COOLDOWN = 8,
    THROW_SPEED = 90,
    THROW_MAX_FLIGHT = 1.2, -- seconds before a thrown knife drops
    GUN_COOLDOWN = 0.75,
    GUN_RANGE = 300,
    GUN_PICKUP_RANGE = 10,
    -- Who may take a fallen sheriff's pistol and become the hero. Every
    -- unarmed civilian role, not innocents alone: a medic or a snitch standing
    -- over the gun could see it and not pick it up, which reads as the game
    -- being broken. A murderer never takes it, and a sheriff or hero is armed
    -- already. The client greys the prompt by this table and the server
    -- re-checks it in RoleService:MakeHero.
    PISTOL_ROLES = { innocent = true, medic = true, snitch = true },
    SHERIFF_MISFIRE_KILLS_SELF = true,
    WEAPON_DRAW_TIME = 1.2, -- weapons are carried hidden and drawn only while used

    -- Evidence
    BODY_CLUE_WINDOW = 20,
    EXAMINE_TIME = 1.5,
    EXAMINE_RANGE = 14,
    EXAMINE_REWARD = 15,
    DRAG_TIME = 2,
    WITNESS_LOS_TIME = 1.0, -- seconds of unbroken line of sight for a witness clue
    WITNESS_WINDOW = 10, -- ...that must end within this many seconds of the death
    SIGHTLINE_RANGE = 90,
    SIGHTLINE_SAMPLE = 0.25,

    -- Abilities
    REVIVE_CHANNEL = 3,
    REVIVE_MOVE_TOLERANCE = 3, -- studs; moving further breaks the channel
    REVIVE_COINS = 60,
    REVIVE_XP = 40,
    WALKSPEED = 16, -- base speed; what DRAG_WALKSPEED is restored back to
    DRAG_WALKSPEED = 8,
    DRAG_SOUND_INTERVAL = 0.8,

    -- Vision (client-side radius, in studs)
    VISION_NORMAL = 130, -- past the 60 stud median sightline, short of the 240 longest
    VISION_DARK = 88,
    VISION_SURGE = 130,
    VISION_HARDCORE = 70, -- reduced sight the whole round in Hardcore mode
    FOG_NAMETAG_RANGE = 40,

    -- Events
    EVENT_AT_PCT = 0.45,
    LIGHTS_OUT_DUR = 13,
    LOCKDOWN_DUR = 20,
    FOG_DUR = 18,
    LAST_CALL_AT = 30,

    -- Economy
    STARTING_COINS = 100, -- below CRATE_COST so the second crate is locked in round two
    COIN_PICKUP = 5,
    COIN_PICKUP_RANGE = 7,
    COINS_SURVIVE = 40,
    COINS_WIN = 90,
    COINS_LOSS = 30,
    CRATE_COST = 250,
    SEASONAL_COST = 600,
    CRAFT_DUPES = 5,
    CRAFT_FEE = 150,
    DIRECT_BUY_MARKUP = 1.6, -- direct buy is the impatience tax
    REROLL_COST = 300,
    MAX_TRADE_OFFER = 8, -- items one side may put on the table; both ends read this
    DISCOUNT_RANK = 25,
    DISCOUNT_AMOUNT = 25, -- coins off every crate
    LAST_CALL_MULT = 2,
    FRIEND_COIN_BONUS = 0.25, -- +25% when a friend is in the server
    STREAK_COINS_PER_DAY = 50,
    STREAK_COINS_MAX = 400,
    VIP_DAILY_BONUS = 150, -- coins a VIP owner is handed once per day at login
    VIP_SKIN = "regalia", -- the VIP-exclusive aura, minted once on ownership

    -- Progression
    XP_WIN = 120,
    XP_LOSS = 45,
    XP_SURVIVE = 60,
    XP_PER_CLUE = 10,
    XP_PER_RANK = 1200,
    RANK_GIFT_AT = 5,
    RANK_GIFT_RARITY = "Rare",

    -- Anti-exploit
    REMOTE_CALLS_PER_SEC = 20, -- hard ceiling per player, across every RemoteEvent
    REMOTE_STRIKES_TO_KICK = 5, -- seconds over the ceiling...
    REMOTE_STRIKE_WINDOW = 10, -- ...within this many seconds
    -- Tighter ceilings for single remotes, on top of the global one (calls/sec).
    -- Every client->server remote carries one, as defence in depth: each already
    -- has a stronger server-side gate (a role, a cooldown, a coin cost, a
    -- channel), but a dedicated cap is a backstop if a gate is ever weakened, and
    -- keeps one spammed remote from eating the whole global 20/sec budget. Values
    -- sit well above any legitimate rate, so real play never trips them.
    REMOTE_LIMITS = {
        RequestStab = 4,
        RequestShoot = 4,
        RequestThrow = 2,
        RequestExamine = 6,
        RequestPickup = 4,
        RequestCoin = 30,
        RequestVote = 4,
        RequestCrate = 3,
        RequestBuy = 3,
        RequestReroll = 3,
        RequestCraft = 3,
        RequestEquip = 8,
        RequestTrade = 10,
        RequestRadio = 2,
        RequestEmote = 3,
        RequestReport = 2,
        RequestRevive = 4,
        RequestDrag = 6,
        RequestSpectate = 4,
        RequestLobbyMode = 4,
        RequestExpose = 2, -- one use a round; a low cap is only anti-spam
        RequestAccuse = 4, -- Whodunnit: change your vote, not spam it
        RequestModeVote = 4, -- lobby: change your next-mode pick, not spam it
        HintSeen = 5,
    },

    -- Social: Radio and Emote passes, reports
    RADIO_COOLDOWN = 3,
    RADIO_MAX_CHARS = 100,
    EMOTE_COOLDOWN = 2,
    EMOTES = { "wave", "point", "shrug", "laugh", "panic" },
    REPORT_REASONS = { "exploiting", "harassment", "other" },

    -- NPCs fill a quiet server so one person can play (BotService)
    BOTS_ENABLED = true,
    BOT_FILL_TO = 6, -- players who chose Play now + NPCs, while humans < MIN_PLAYERS
    BOT_ROUND_REWARD = 1, -- coins and XP scale in a round with NPCs (1 = full pay)
    -- Paced to the longer round: at {9, 16} and {6, 11} an NPC murderer had
    -- cleared most of a six-seat round inside 90 seconds, and a lone human
    -- standing still to read a prompt was its first mark within 15.
    BOT_FIRST_HUNT = { 20, 35 }, -- seconds before an NPC murderer first strikes
    BOT_HUNT_PAUSE = { 14, 24 }, -- seconds between an NPC murderer's kills
    BOT_REACTION = { 0.9, 1.6 }, -- seconds before an NPC sheriff fires on a killer
    BOT_SIGHT = 70, -- studs an NPC can witness a kill from
    BOT_STROLL_SPEED = 11, -- NPCs walk; they only run to chase or flee
    BOT_CHASE_GIVE_UP = 12, -- seconds an NPC murderer chases one target

    -- Analytics
    HEATMAP_CELL = 80, -- studs per death-position grid cell

    MAPS = { "BlackwoodManor", "RustedPier", "CityArchive" }, -- layouts live in Shared/MapPlan
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">CosmeticFx</string>
          <string name="Source"><![CDATA[--!strict
-- Particle looks for Effect items (worn as an aura at the feet) and knife
-- effects (Shop.EFFECTS, on the blade while it is drawn). Built-in particle
-- textures only. Nothing here glows: LightEmission is 0 so a cosmetic never
-- helps anyone see during Lights Out.
local SPARKLES = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

export type Fx = {
    texture: string,
    colour: Color3,
    rate: number,
    lifetime: NumberRange,
    size: number,
    speed: NumberRange,
    spread: number?,
    accel: Vector3?,
    transparency: number?,
}

local CosmeticFx = {}

CosmeticFx.AURA = {
    matchstick = {
        texture = FIRE,
        colour = Color3.fromHex("f29a3b"),
        rate = 4,
        lifetime = NumberRange.new(0.4, 0.8),
        size = 0.35,
        speed = NumberRange.new(1, 2),
        accel = Vector3.new(0, 3, 0),
    },
    static = {
        texture = SPARKLES,
        colour = Color3.fromHex("37bcf0"),
        rate = 8,
        lifetime = NumberRange.new(0.15, 0.3),
        size = 0.4,
        speed = NumberRange.new(2, 4),
        spread = 180,
    },
    frostbite = {
        texture = SPARKLES,
        colour = Color3.fromHex("cfe8ff"),
        rate = 5,
        lifetime = NumberRange.new(1, 1.6),
        size = 0.3,
        speed = NumberRange.new(0.5, 1),
        accel = Vector3.new(0, -1, 0),
        spread = 180,
    },
    bellwether = {
        texture = SPARKLES,
        colour = Color3.fromHex("f2c14e"),
        rate = 3,
        lifetime = NumberRange.new(1.2, 1.8),
        size = 0.6,
        speed = NumberRange.new(0.5, 1),
        accel = Vector3.new(0, 1, 0),
        spread = 180,
    },
    -- Design Bible: frost prints that fade over four seconds
    thelongnightfx = {
        texture = SMOKE,
        colour = Color3.fromHex("bcd4ea"),
        rate = 2,
        lifetime = NumberRange.new(4, 4),
        size = 0.9,
        speed = NumberRange.new(0, 0),
        transparency = 0.6,
    },
    -- VIP exclusive: a steady rise of gold motes, denser than Bellwether so it
    -- reads as regalia. LightEmission stays 0 like every aura (no Lights Out edge).
    regalia = {
        texture = SPARKLES,
        colour = Color3.fromHex("f2c14e"),
        rate = 7,
        lifetime = NumberRange.new(1, 1.5),
        size = 0.5,
        speed = NumberRange.new(0.5, 1),
        accel = Vector3.new(0, 1.6, 0),
        spread = 180,
    },
} :: { [string]: Fx }

CosmeticFx.KNIFE = {
    ember = {
        texture = FIRE,
        colour = Color3.fromHex("f29a3b"),
        rate = 10,
        lifetime = NumberRange.new(0.2, 0.4),
        size = 0.2,
        speed = NumberRange.new(0.5, 1),
    },
    frost = {
        texture = SPARKLES,
        colour = Color3.fromHex("cfe8ff"),
        rate = 8,
        lifetime = NumberRange.new(0.4, 0.8),
        size = 0.2,
        speed = NumberRange.new(0.2, 0.5),
        spread = 180,
    },
    static = {
        texture = SPARKLES,
        colour = Color3.fromHex("37bcf0"),
        rate = 14,
        lifetime = NumberRange.new(0.1, 0.2),
        size = 0.25,
        speed = NumberRange.new(1, 2),
        spread = 180,
    },
    ash = {
        texture = SMOKE,
        colour = Color3.fromHex("6f7883"),
        rate = 6,
        lifetime = NumberRange.new(0.8, 1.2),
        size = 0.4,
        speed = NumberRange.new(0.3, 0.6),
        transparency = 0.5,
    },
    gold = {
        texture = SPARKLES,
        colour = Color3.fromHex("f2c14e"),
        rate = 8,
        lifetime = NumberRange.new(0.4, 0.7),
        size = 0.25,
        speed = NumberRange.new(0.3, 0.6),
        spread = 180,
    },
} :: { [string]: Fx }

function CosmeticFx.Emitter(fx: Fx): ParticleEmitter
    local e = Instance.new("ParticleEmitter")
    e.Name = "CosmeticFx"
    e.Texture = fx.texture
    e.Color = ColorSequence.new(fx.colour)
    e.Rate = fx.rate
    e.Lifetime = fx.lifetime
    e.Size = NumberSequence.new(fx.size, 0)
    e.Speed = fx.speed
    e.SpreadAngle = Vector2.new(fx.spread or 25, fx.spread or 25)
    e.Acceleration = fx.accel or Vector3.zero
    e.Transparency = NumberSequence.new(fx.transparency or 0.2, 1)
    e.LightEmission = 0
    e.LightInfluence = 1
    return e
end

return CosmeticFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">FibreBands</string>
          <string name="Source"><![CDATA[--!strict
-- Buckets a colour into a broad fabric band for the fibre clue.
-- A clue must narrow the field, never name one person.
-- Pure module: takes HSV in 0..1 (Color3:ToHSV), no Roblox services.
local FibreBands = {}

type Band = { name: string, h: { number }, s: { number }, v: { number } }

-- First match wins, so the achromatic bands come before the hued ones
FibreBands.BANDS = {
    { name = "black", h = { 0, 360 }, s = { 0, 1 }, v = { 0, 0.12 } },
    { name = "dark grey", h = { 0, 360 }, s = { 0, 0.15 }, v = { 0.12, 0.45 } },
    { name = "mid grey", h = { 0, 360 }, s = { 0, 0.15 }, v = { 0.45, 0.75 } },
    { name = "off-white", h = { 0, 360 }, s = { 0, 0.15 }, v = { 0.75, 1 } },
    { name = "deep navy", h = { 200, 260 }, s = { 0.15, 1 }, v = { 0.12, 0.5 } },
    { name = "rust red", h = { 340, 20 }, s = { 0.15, 1 }, v = { 0.12, 0.8 } },
    { name = "warm brown", h = { 20, 45 }, s = { 0.15, 1 }, v = { 0.12, 0.65 } },
    { name = "olive", h = { 60, 150 }, s = { 0.15, 1 }, v = { 0.12, 0.65 } },
} :: { Band }

local function within(x: number, range: { number }): boolean
    return x >= range[1] and x <= range[2]
end

function FibreBands.Describe(h: number, s: number, v: number): string
    local deg = (h % 1) * 360
    for _, band in FibreBands.BANDS do
        local lo, hi = band.h[1], band.h[2]
        -- A range like 340..20 wraps through red
        local inHue = if lo <= hi then deg >= lo and deg <= hi else deg >= lo or deg <= hi
        if inHue and within(s, band.s) and within(v, band.v) then
            return band.name .. " fabric"
        end
    end
    return (v < 0.4 and "dark" or "light") .. " fabric"
end

return FibreBands
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">LiveOps</string>
          <string name="Source"><![CDATA[--!strict
-- COLD CASE · the ninety-day live-ops calendar as data.
-- Pure module: no Roblox services, so it runs under Lune tests too.
-- Every gate takes a launch day number; the server decides what "today" is.
local LiveOps = {}

-- The launch moment in UTC epoch seconds; days roll over at this time of day.
-- While nil the game is pre-launch and every gate reads day 0.
LiveOps.LAUNCH_UTC = 1788998400 :: number? -- 2026-09-10 00:00 UTC

LiveOps.TRADING_UNLOCK_DAY = 28
LiveOps.FOURTH_MAP_DAY = 45
LiveOps.DUOS_DAY = 90

export type Season = {
    id: string,
    name: string,
    opensDay: number,
    closesDay: number, -- first day the season is retired
    crateId: string,
    crateCost: number,
}

LiveOps.SEASONS = {
    {
        id = "S1",
        name = "The Long Night",
        opensDay = 14,
        -- The handbook says both "retired forever on day 90" (14 + a 76-day
        -- countdown) and "Day 76 · Season One closes". Day 90 is used here.
        closesDay = 90,
        crateId = "seasonal",
        -- The server charges this; the lobby quotes Config.SEASONAL_COST as a
        -- pre-replication fallback, so the two must agree. This module cannot
        -- read Config - it requires nothing so Lune can load it, and
        -- `script.Parent` is nil there - so a test pins the two numbers instead.
        crateCost = 600,
    },
} :: { Season }

LiveOps.COIN_BOOSTS = {
    { name = "Double coin weekend", fromDay = 60, toDay = 62, multiplier = 2 },
}

function LiveOps.DayAt(now: number, launchUtc: number?): number
    if not launchUtc or now < launchUtc then
        return 0
    end
    return math.floor((now - launchUtc) / 86400)
end

function LiveOps.IsTradingOpen(day: number): boolean
    return day >= LiveOps.TRADING_UNLOCK_DAY
end

function LiveOps.GetSeason(id: string): Season?
    for _, s in LiveOps.SEASONS do
        if s.id == id then
            return s
        end
    end
    return nil
end

function LiveOps.ActiveSeason(day: number): Season?
    for _, s in LiveOps.SEASONS do
        if day >= s.opensDay and day < s.closesDay then
            return s
        end
    end
    return nil
end

-- A season that has closed never drops again. There is no override for this.
function LiveOps.IsRetired(seasonId: string?, day: number): boolean
    if not seasonId then
        return false
    end
    local s = LiveOps.GetSeason(seasonId)
    return s == nil or day >= s.closesDay
end

function LiveOps.DaysLeftInSeason(day: number): number?
    local s = LiveOps.ActiveSeason(day)
    return s and (s.closesDay - day) or nil
end

function LiveOps.CoinMultiplier(day: number): number
    local m = 1
    for _, b in LiveOps.COIN_BOOSTS do
        if day >= b.fromDay and day <= b.toDay then
            m = math.max(m, b.multiplier)
        end
    end
    return m
end

return LiveOps
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Lobby</string>
          <string name="Source"><![CDATA[--!strict
-- Who plays the next round. Everyone waits for real players until they say
-- otherwise: a family joins one at a time, and nobody should be swept into
-- a round before the rest are in. Once the group is there, each presses
-- PLAY NOW (NPCs fill the seats), and the round is exactly those people.
-- Pure, so RoundService decides with it and the lobby countdown mirrors it.
local Lobby = {}

-- Where the lobby floor stands. The maps load at the origin, the largest of
-- them 243 studs across, so the lobby lives far down -Z where no map can
-- reach it. default.project.json places the part there; BuildLobby moves it
-- back if a saved place has it anywhere else. One saved place had it dragged
-- to the origin, and every round then loaded a mansion around the lobby: its
-- brick walls stood through the cellar and its floor sat a stud above the
-- cellar's, reading as brick half walls and a floor that had sunk.
Lobby.FLOOR = { x = 0, y = -1, z = -900 }

export type Plan = {
    start: boolean, -- a round starts when the countdown ends
    full: boolean, -- enough real players: everyone plays, nobody waits
    npcs: number, -- NPC seats in the round
}

-- humans: everyone in the lobby; ready: those who pressed PLAY NOW. The
-- countdown runs only once someone has, and only they play; everyone else
-- keeps waiting in the lobby.
function Lobby.Plan(
    humans: number,
    ready: number,
    minPlayers: number,
    fillTo: number,
    botsEnabled: boolean
): Plan
    if humans >= minPlayers then
        return { start = true, full = true, npcs = 0 }
    end
    if not botsEnabled or ready < 1 then
        return { start = false, full = false, npcs = 0 }
    end
    local npcs = math.max(0, fillTo - ready)
    return { start = ready + npcs >= minPlayers, full = false, npcs = npcs }
end

return Lobby
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MapPlan</string>
          <string name="Source"><![CDATA[--[[
  COLD CASE · map plans. Every map is a building of stacked floors drawn as
  character grids, one character per CELL-stud square. Pure data plus the rules
  that turn it into walls, doorways, railings and stairs, so BuildMaps builds
  from it, the lobby vote cards draw it, and the Lune tests prove that every
  room can be reached.

  One character per cell, floor 1 lowest:
    .       nothing: outside, or solid ground around a cellar
    ^       open to the floor below: a stairwell or a double-height room
    letter  a walkable cell of that region (regions are named per map)

  Neighbouring cells of different regions get a wall with a doorway in every
  straight stretch; a room and the outside get an exterior wall (a railing when
  the region is outdoors); a walkable cell beside a ^ gets a railing.

  A stair climbs from `floor` to the floor above over `len` cells heading `dir`
  from its bottom cell (x, z). The cell before the bottom (the approach) shares
  their region; on the floor above the stair's cells are ^ and the cell past the
  top (the arrival) is walkable.
]]
local MapPlan = {}

MapPlan.CELL = 20 -- studs per plan cell
MapPlan.FLOOR_HEIGHT = 16 -- studs from one floor to the next
MapPlan.SPAWNS = 14 -- a full server is 12; the extra two keep the spread honest
MapPlan.COINS = 18

export type Region = { name: string, style: string, hall: boolean?, outdoor: boolean? }
export type Stair = { floor: number, x: number, z: number, dir: string, len: number }
export type Plan = {
    indoor: boolean,
    underground: number, -- floors below ground level, which get no windows
    floors: { { string } },
    regions: { [string]: Region },
    stairs: { Stair },
}

MapPlan.DIRS = {
    N = { 0, -1 },
    S = { 0, 1 },
    E = { 1, 0 },
    W = { -1, 0 },
}

