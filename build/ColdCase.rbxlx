      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--!strict
-- Fixed one-second window rate limiter with strike tracking.
-- Pure module (no Roblox services) so it can be unit tested under Lune.
local RateLimiter = {}
RateLimiter.__index = RateLimiter

export type RateLimiter = typeof(setmetatable(
    {} :: {
        limit: number,
        strikesToKick: number,
        strikeWindow: number,
        state: { [any]: { sec: number, count: number, struck: boolean, strikes: { number } } },
    },
    RateLimiter
))

function RateLimiter.new(
    limitPerSec: number,
    strikesToKick: number,
    strikeWindow: number
): RateLimiter
    return setmetatable({
        limit = limitPerSec,
        strikesToKick = strikesToKick,
        strikeWindow = strikeWindow,
        state = {},
    }, RateLimiter)
end

-- Returns allowed, shouldKick
function RateLimiter.Hit(self: RateLimiter, key: any, now: number): (boolean, boolean)
    local st = self.state[key]
    if not st then
        st = { sec = -1, count = 0, struck = false, strikes = {} }
        self.state[key] = st
    end

    local sec = math.floor(now)
    if sec ~= st.sec then
        st.sec, st.count, st.struck = sec, 0, false
    end
    st.count += 1
    if st.count <= self.limit then
        return true, false
    end

    if not st.struck then
        st.struck = true
        table.insert(st.strikes, sec)
        local cutoff = sec - self.strikeWindow
        while #st.strikes > 0 and st.strikes[1] <= cutoff do
            table.remove(st.strikes, 1)
        end
    end
    return false, #st.strikes >= self.strikesToKick
end

function RateLimiter.Remove(self: RateLimiter, key: any)
    self.state[key] = nil
end

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">RemoteSetup</string>
          <string name="Source"><![CDATA[--!strict
-- Creates every RemoteEvent in ReplicatedStorage.Remotes. Idempotent.
-- Bootstrap calls it on server start; it can also be run from the command bar:
--   require(game.ReplicatedStorage.Shared.RemoteSetup)()
local NAMES = {
    -- server -> client
    -- (RoundState is not a remote: the round phase is a ReplicatedStorage
    -- attribute, which every client reads via GetAttributeChangedSignal.)
    "RoleAssigned",
    "Clue",
    "RoundOver",
    "RoundReward",
    "EventFired",
    "DataChanged",
    "CrateResult",
    "TradeUpdate",
    "TradeComplete",
    "AliveChanged",
    "VoteTally",
    "PlayCue",
    "Notify",
    "AbilityState",
    "CosmeticChanged",
    "ShopResult",
    "Spectate",
    "RadioMessage",
    "EmotePlayed",
    "KillConfirm",
    "Deduction", -- snitch-only: the suspect board and expose availability
    "Expose", -- all clients: the killer has been named, highlight them
    "Leaderboard", -- all clients: the top wins / killers / richest boards
    "AccuseTally", -- Whodunnit: who is accused of the murder, and by how many
    "ModeTally", -- lobby: how many have voted for each next-round mode
    -- client -> server (every one is rate-limited and re-validated)
    "RequestStab",
    "RequestThrow",
    "RequestShoot",
    "RequestExamine",
    "RequestPickup",
    "RequestCoin",
    "RequestVote",
    "RequestCrate",
    "RequestTrade",
    "HintSeen",
    "RequestRevive",
    "RequestDrag",
    "RequestCraft",
    "RequestEquip",
    "RequestBuy",
    "RequestReroll",
    "RequestRadio",
    "RequestEmote",
    "RequestReport",
    "RequestSpectate",
    "RequestLobbyMode",
    "RequestExpose", -- snitch blows the whistle: name the killer to everyone
    "RequestAccuse", -- Whodunnit: name a living suspect as the killer
    "RequestModeVote", -- lobby: vote which mode runs next round
}

return function()
    local rs = game:GetService("ReplicatedStorage")
    local folder = rs:FindFirstChild("Remotes")
    local isNew = folder == nil
    if isNew then
        folder = Instance.new("Folder")
        folder.Name = "Remotes"
    end
    for _, n in NAMES do
        if not folder:FindFirstChild(n) then
            local ev = Instance.new("RemoteEvent")
            ev.Name = n
            ev.Parent = folder
        end
    end
    -- Parent last so clients receive the folder with every remote already in it
    if isNew then
        folder.Parent = rs
    end
    return folder
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Shop</string>
          <string name="Source"><![CDATA[--!strict
-- Direct buys, effect re-rolls and crate pricing, shared so the client shows
-- exactly the prices the server charges.
local Catalog = require(script.Parent.Catalog)
local Config = require(script.Parent.Config)
local Progression = require(script.Parent.Progression)

local Shop = {}

-- Direct-buy shelf. Priced above crate expected value on purpose: buying
-- outright is the impatience tax, not the cheap route.
Shop.SHELF = { "ember", "nocturne", "ivory", "verdict" }

-- Knife effects a re-roll can land on. Pure visual churn.
Shop.EFFECTS = { "none", "ember", "frost", "static", "ash", "gold" }

function Shop.PriceOf(id: string): number?
    local def = Catalog[id]
    if not def then
        return nil
    end
    return math.floor(def.value * Config.DIRECT_BUY_MARKUP)
end

function Shop.CratePrice(baseCost: number, rank: number): number
    return Progression.CratePrice(baseCost, rank, Config.DISCOUNT_RANK, Config.DISCOUNT_AMOUNT)
end

-- Which equipped slot an item kind occupies. The server decides whether an
-- equip is legal and the client decides whether to draw "EQUIPPED"; a fifth
-- kind known to only one of them is an item that equips but never looks it.
Shop.SLOT_FOR_KIND = { Knife = "knife", Pistol = "gun", Effect = "effect", Pet = "pet" }

-- Total catalogue value of one side of a trade. The client draws the fairness
-- meter from this and the server logs the completed trade with it, so the two
-- must not drift or players see a bar that disagrees with the record.
function Shop.ValueOf(entries: { { id: string } }): number
    local total = 0
    for _, entry in entries do
        local item = Catalog[entry.id]
        total += item and item.value or 0
    end
    return total
end

return Shop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Shuffle</string>
          <string name="Source"><![CDATA[--!strict
-- Fisher-Yates, once, instead of four hand-written copies.
-- Pure module: requires nothing, so Lune can test it.
--
-- Both functions take an optional Random. Pass one where the result has to be
-- reproducible - BuildMaps seeds off the map name so the same map always
-- dresses itself the same way - and leave it out for ordinary gameplay
-- randomness, which uses math.random as before.
local Shuffle = {}

-- Anything that can draw an integer in a range. Only NextInteger is ever
-- called, so a Roblox Random and a plain table are interchangeable here -
-- production seeds a real Random off the map name, and the tests pass a stub
-- because Lune has no Random datatype.
--
-- Deliberately structural rather than `Random | Generator`: a union of two
-- function types is uncallable ("unable to determine the appropriate result
-- type"), so the one caller holding a real Random casts at its call site.
export type Generator = { NextInteger: (any, number, number) -> number }

-- Shuffles in place and returns the same table, so it can be used either way.
function Shuffle.Shuffle<T>(t: { T }, rng: Generator?): { T }
    for i = #t, 2, -1 do
        local j = if rng then rng:NextInteger(1, i) else math.random(i)
        t[i], t[j] = t[j], t[i]
    end
    return t
end

-- Leaves the original untouched.
function Shuffle.Shuffled<T>(t: { T }, rng: Generator?): { T }
    return Shuffle.Shuffle(table.clone(t), rng)
end

return Shuffle
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">SoundCues</string>
          <string name="Source"><![CDATA[--!strict
-- COLD CASE · the twenty-two sound cues from the production handbook.
-- In a deduction game sound is information, so every cue has a deliberate
-- range. `range = nil` is 2D (local to one client). A number is the audible
-- radius in studs: the server only tells clients inside that radius, so an
-- exploiter cannot read a map-wide list of where every knife swing happened.
--
-- Sounds come from the Roblox Creator Store, almost all from the licensed Pro
-- Sound Effects and APM Music libraries (gun_fire is DocInk's own upload).
-- An empty `soundId` is skipped silently. Swap ids here; nothing else changes.
export type Cue = {
    group: string,
    range: number?,
    volume: number,
    soundId: string,
    desc: string,
}

local cues: { [string]: Cue } = {
    -- ROUND
    round_reveal = {
        group = "ROUND",
        volume = 0.8,
        soundId = "rbxassetid://9038130941",
        desc = "Single struck piano note, long decay, under the role card. Pitch per role.",
    },
    round_start = {
        group = "ROUND",
        volume = 0.7,
        soundId = "rbxassetid://9043340902",
        desc = "A distant door closing. Dry, no reverb tail.",
    },
    timer_30 = {
        group = "ROUND",
        volume = 0.5,
        soundId = "rbxassetid://9120098166",
        desc = "Low clock tick once per second, fading in over the last 30s.",
    },
    round_win = {
        group = "ROUND",
        volume = 0.8,
        soundId = "rbxassetid://94590027038118",
        desc = "Warm brass swell, 1.5s. Only major-key sound.",
    },
    round_lose = {
        group = "ROUND",
        volume = 0.8,
        soundId = "rbxassetid://1837830084",
        desc = "Sub-bass drop with a tape stop. Short.",
    },

    -- COMBAT
    knife_swing = {
        group = "COMBAT",
        range = 40,
        volume = 0.6,
        soundId = "rbxassetid://9120972444",
        desc = "Air displacement, no metal ring. Hearable but not obvious.",
    },
    knife_hit = {
        group = "COMBAT",
        range = 70,
        volume = 1.0,
        soundId = "rbxassetid://9113480915",
        desc = "Heavy dull impact, wet transient. Loudest diegetic sound.",
    },
    knife_throw = {
        group = "COMBAT",
        range = 55,
        volume = 0.8,
        soundId = "rbxassetid://9114156616",
        desc = "Rising whistle over 0.4s. Gives the target a chance to react.",
    },
    gun_fire = {
        group = "COMBAT",
        range = 220,
        volume = 1.0,
        soundId = "rbxassetid://17761500292",
        desc = "Sharp crack, long slap-back. Everyone knows roughly where.",
    },
    gun_pickup = {
        group = "COMBAT",
        range = 25,
        volume = 0.7,
        soundId = "rbxassetid://9113104176",
        desc = "Metallic scrape and hammer cock. Signals a hero nearby.",
    },
    misfire_death = {
        group = "COMBAT",
        volume = 0.9,
        soundId = "rbxassetid://9125626779",
        desc = "Reverse cymbal into silence. The sheriff knows what they did.",
    },

    -- EVIDENCE
    body_drop = {
        group = "EVIDENCE",
        range = 60,
        volume = 0.8,
        soundId = "rbxassetid://9113480917",
        desc = "Soft collapse, then a beat of nothing.",
    },
    examine_start = {
        group = "EVIDENCE",
        range = 15,
        volume = 0.5,
        soundId = "rbxassetid://9117233449",
        desc = "Paper rustle under the 1.5s channel. Investigating is public.",
    },
    clue_found = {
        group = "EVIDENCE",
        volume = 0.7,
        soundId = "rbxassetid://1841210107",
        desc = "Three ascending marimba notes, one per clue line.",
    },
    trail_cold = {
        group = "EVIDENCE",
        volume = 0.6,
        soundId = "rbxassetid://9120887046",
        desc = "A single flat low tone.",
    },
    body_drag = {
        group = "EVIDENCE",
        range = 35,
        volume = 0.9,
        soundId = "rbxassetid://9125883698",
        desc = "Continuous scrape. Deliberately loud.",
    },

    -- EVENTS & META
    lights_out = {
        group = "EVENTS",
        volume = 0.9,
        soundId = "rbxassetid://9113112330",
        desc = "Power-down whine over 1.2s, then room tone drops to almost nothing.",
    },
    power_surge = {
        group = "EVENTS",
        volume = 0.8,
        soundId = "rbxassetid://9114237487",
        desc = "Electrical arcing, irregular. Never loops cleanly.",
    },
    -- The 2D layer everyone hears is played by EventService alongside the
    -- per-door positional cues. It is not a flag here: AudioService:Emit
    -- range-filters on purpose, and broadcasting from inside it would send
    -- one layer per door and undo that.
    lockdown = {
        group = "EVENTS",
        range = 80,
        volume = 0.9,
        soundId = "rbxassetid://9114143852",
        desc = "Four bolts throwing in sequence, each at its real door position.",
    },
    crate_spin = {
        group = "META",
        volume = 0.6,
        soundId = "rbxassetid://9116784575",
        desc = "Ratcheting tick that slows with the reel; pitch rises on the last three.",
    },
    crate_godly = {
        group = "META",
        volume = 0.9,
        soundId = "rbxassetid://1841760054",
        desc = "Held choral chord with a bell. Legendary and Godly only.",
    },
    trade_complete = {
        group = "META",
        volume = 0.6,
        soundId = "rbxassetid://9114144264",
        desc = "Two short clicks, like a case latching.",
    },
}

-- round_reveal pitch per role, so players hear their role before reading it
local ROLE_PITCH = {
    innocent = 1.0,
    sheriff = 1.26,
    murderer = 0.75,
    hero = 1.5,
    medic = 1.12,
    snitch = 0.89,
}

return {
    cues = cues,
    ROLE_PITCH = ROLE_PITCH,
}
]]></string>
        </Properties>
