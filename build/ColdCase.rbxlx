                props = { "FilingCabinet", "WritingDesk", "KitchenCounter" },
                density = 0.45,
                centre = "DiningTable",
            },
            carrels = {
                wall = "c0b088",
                floor = "a9855c",
                floorMaterial = M.WoodPlanks,
                props = { "WritingDesk" },
                density = 0.7,
            },
        },
    },
}

local function part(
    name: string,
    parent: Instance,
    size: Vector3,
    cf: CFrame,
    colour: Color3,
    material: Enum.Material?
): Part
    local p = Instance.new("Part")
    p.Name = name
    p.Anchored = true
    p.Size = size
    p.CFrame = cf
    p.Color = colour
    p.Material = material or M.SmoothPlastic
    p.TopSurface = Enum.SurfaceType.Smooth
    p.BottomSurface = Enum.SurfaceType.Smooth
    p.Parent = parent
    return p
end

-- Decoration never collides, casts no shadow and is invisible to raycasts, so
-- it can never block a route, a shot or a witness sightline
local function deco(
    name: string,
    parent: Instance,
    size: Vector3,
    cf: CFrame,
    colour: Color3,
    material: Enum.Material?
): Part
    local p = part(name, parent, size, cf, colour, material)
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    return p
end

-- World coordinate of grid line `line` across `cells` cells centred on 0
local function lineAt(line: number, cells: number): number
    return (line - cells / 2) * CELL
end

-- A box `length` along `along`, `thickness` across it
local function boxSize(along: Vector3, length: number, height: number, thickness: number): Vector3
    return if along.X ~= 0
        then Vector3.new(length, height, thickness)
        else Vector3.new(thickness, height, length)
end

local function faceToward(v: Vector3): Enum.NormalId
    if v.X > 0.5 then
        return Enum.NormalId.Right
    elseif v.X < -0.5 then
        return Enum.NormalId.Left
    elseif v.Z > 0.5 then
        return Enum.NormalId.Back
    end
    return Enum.NormalId.Front
end

-- Greedy rectangles over the cells `keyOf` gives a key, one per run of equal keys
local function rectangles(gw: number, gd: number, keyOf: (number, number) -> string?)
    local used = {}
    local out = {}
    for z = 1, gd do
        for x = 1, gw do
            local key = keyOf(x, z)
            if key == nil or used[z * 1000 + x] then
                continue
            end
            local x1 = x
            while x1 < gw and not used[z * 1000 + x1 + 1] and keyOf(x1 + 1, z) == key do
                x1 += 1
            end
            local z1 = z
            while z1 < gd do
                local fits = true
                for xx = x, x1 do
                    if used[(z1 + 1) * 1000 + xx] or keyOf(xx, z1 + 1) ~= key then
                        fits = false
                        break
                    end
                end
                if not fits then
                    break
                end
                z1 += 1
            end
            for zz = z, z1 do
                for xx = x, x1 do
                    used[zz * 1000 + xx] = true
                end
            end
            table.insert(out, { x0 = x, z0 = z, x1 = x1, z1 = z1, key = key })
        end
    end
    return out
end

local function rectPart(
    name: string,
    model: Model,
    gw: number,
    gd: number,
    r,
    y: number,
    colour,
    material,
    thickness: number?
)
    local size = Vector3.new((r.x1 - r.x0 + 1) * CELL, thickness or SLAB, (r.z1 - r.z0 + 1) * CELL)
    local centre = Vector3.new(
        (lineAt(r.x0 - 1, gw) + lineAt(r.x1, gw)) / 2,
        y,
        (lineAt(r.z0 - 1, gd) + lineAt(r.z1, gd)) / 2
    )
    return part(name, model, size, CFrame.new(centre), colour, material)
end

---------------------------------------------------------------- Floors and roofs
local function slabs(model: Model, plan, analysis, theme): BasePart?
    local gw, gd, floors = MapPlan.Size(plan)
    local first: BasePart? = nil
    for f = 1, floors do
        local base = (f - 1) * H
        for _, r in
            rectangles(gw, gd, function(x, z)
                local ch = MapPlan.Cell(plan, f, x, z)
                return if MapPlan.IsWalkable(ch) then plan.regions[ch].style else nil
            end)
        do
            local style = theme.styles[r.key] or theme.styles.hall
            local p = rectPart(
                "Floor",
                model,
                gw,
                gd,
                r,
                base - SLAB / 2,
                Color3.fromHex(style.floor),
                floorMaterialFor(style.floor, style.floorMaterial)
            )
            first = first or p
        end
        for _, r in
            rectangles(gw, gd, function(x, z)
                return if analysis.roof[MapPlan.Key(f, x, z)] then "roof" else nil
            end)
        do
            rectPart(
                "Roof",
                model,
                gw,
                gd,
                r,
                base + H - SLAB / 2,
                Color3.fromHex(theme.roof),
                theme.roofMaterial
            )
        end
        if theme.ceiling then
            for _, r in
                rectangles(gw, gd, function(x, z)
                    -- A stairwell or a double-height hall is still a room
                    -- from below: without a panel over its ^ cells the room
                    -- looks up at the raw underside of the slab or roof above
                    local ch = MapPlan.Cell(plan, f, x, z)
                    local space = if ch == "^" then MapPlan.OpensInto(plan, f, x, z) else ch
                    if
                        not space
                        or not MapPlan.IsWalkable(space)
                        or plan.regions[space].outdoor
                    then
                        return nil
                    end
                    local covered = analysis.roof[MapPlan.Key(f, x, z)]
                        or MapPlan.IsWalkable(MapPlan.Cell(plan, f + 1, x, z))
                    return if covered then "ceiling" else nil
                end)
            do
                local ceiling = rectPart(
                    "Ceiling",
                    model,
                    gw,
                    gd,
                    r,
                    base + H - SLAB - 0.15,
                    Color3.fromHex(theme.ceiling),
                    theme.ceilingMaterial,
                    0.3
                )
                ceiling.CanCollide = false
                ceiling.CanQuery = false
                ceiling.CastShadow = false
            end
        end
    end
    return first
end

-- A big floor lit flat by the sun reads as a blank sheet, whatever colour it
-- is painted. A darker inlay inside each room, and a seam along the cell grid,
-- give the eye something to measure the space by.
local function floorDetail(model: Model, plan, analysis, theme)
    local gw, gd, floors = MapPlan.Size(plan)
    for f = 1, floors do
        local base = (f - 1) * MapPlan.FLOOR_HEIGHT
        for z = 1, gd do
            for x = 1, gw do
                local ch = MapPlan.Cell(plan, f, x, z)
                if not MapPlan.IsWalkable(ch) or analysis.ramp[MapPlan.Key(f, x, z)] then
                    continue
                end
                local style = theme.styles[plan.regions[ch].style]
                if not style then
                    continue
                end
                local shade = Color3.fromHex(style.floor)
                local h, s, v = shade:ToHSV()
                local cx, _, cz = MapPlan.Position(plan, f, x, z)
                -- A seam on the cell's own edges, drawn just proud of the floor.
                -- The cross seam stops short of the corners, where it would lie
                -- on the neighbouring cell's seam and flicker.
                for _, seam in { { CELL, 0.6, 0, CELL / 2 }, { 0.6, CELL - 1.2, CELL / 2, 0 } } do
                    deco(
                        "FloorSeam",
                        model,
                        Vector3.new(seam[1], 0.08, seam[2]),
                        CFrame.new(cx + seam[3], base + 0.04, cz + seam[4]),
                        Color3.fromHSV(h, s, math.max(0, v * 0.78)),
                        M.SmoothPlastic
                    )
                end
                -- An inlaid panel in the middle of the cell
                deco(
                    "FloorInlay",
                    model,
                    Vector3.new(CELL - 7, 0.06, CELL - 7),
                    CFrame.new(cx, base + 0.03, cz),
                    Color3.fromHSV(h, math.min(1, s * 1.25), math.max(0, v * 0.88)),
                    M.SmoothPlastic
                )
            end
        end
    end
end

---------------------------------------------------------------- Walls, doorways, railings
-- An edge's middle at floor level, the axis it runs along, and the axis that
-- points from its low side (a) to its high side (b)
local function edgeFrame(plan, e): (Vector3, Vector3, Vector3)
    local gw, gd = MapPlan.Size(plan)
    local base = (e.floor - 1) * H
    if e.axis == "x" then
        return Vector3.new(lineAt(e.line, gw), base, lineAt(e.index - 0.5, gd)),
            Vector3.zAxis,
            Vector3.xAxis
    end
    return Vector3.new(lineAt(e.index - 0.5, gw), base, lineAt(e.line, gd)),
        Vector3.xAxis,
        Vector3.zAxis
end

-- Walls facing the outdoors are finished like the shell
local function look(plan, e): string
    if e.kind == "railing" then
        return "railing"
    elseif e.kind == "exterior" then
        return "shell"
    end
    local ra, rb = plan.regions[e.a], plan.regions[e.b]
    if (ra and ra.outdoor) or (rb and rb.outdoor) then
        return "shell"
    end
    return "wall"
end

local function finish(theme, lookName: string): (number, Color3, Enum.Material)
    if lookName == "shell" then
        return SHELL, Color3.fromHex(theme.shell), theme.shellMaterial
    end
    return WALL, Color3.fromHex(theme.wall), theme.wallMaterial
end

-- Where a wall stands, measured from its floor surface: from the middle of
-- its own slab to the middle of the slab above, so both ends are buried.
-- Built from the floor surface up to the storey line instead, a wall's top
-- face lay in the very plane of the floor above, and wherever nothing stood
-- on it upstairs the two z-fought - a flickering line of brick through the
-- floor along every wall below, reading as a floor that had sunk. Ended at
-- the slab's underside it would flicker with the ceiling the same way. Where
-- there is no slab - a stairwell, a double-height hall - the storeys' walls
-- meet edge to edge with no bare strip between.
local WALL_BOTTOM, WALL_TOP = -SLAB / 2, H - SLAB / 2

-- `grounded` is false for a stretch with no floor at its foot: the shell
-- carrying on past a stairwell or a double-height room.
local function solidWall(
    model: Model,
    theme,
    lookName: string,
    mid: Vector3,
    along: Vector3,
    length: number,
    grounded: boolean
)
    local t, colour, material = finish(theme, lookName)
    part(
        if lookName == "shell" then "Shell" else "Wall",
        model,
        boxSize(along, length + t, WALL_TOP - WALL_BOTTOM, t),
        CFrame.new(mid + Vector3.new(0, (WALL_BOTTOM + WALL_TOP) / 2, 0)),
        colour,
        material
    )
    if theme.trim then
        local wood = Color3.fromHex(theme.trim)
        -- With a liner, every trim stands proud of the wall skin (0.3 deep); a
        -- cornice flush with the skin face z-fights it and flickers.
        local band = t + (if theme.liner then 1 else 0.4)
        -- A skirting and a dado rail are set by the height of a floor, so they
        -- belong only on a stretch that has one. Carried on past a stairwell
        -- they hung in mid-air along the storey line, reading as a floor that
        -- had dropped away. A cornice belongs to the ceiling and always runs.
        if grounded then
            deco(
                "Skirting",
                model,
                boxSize(along, length, 1, band),
                CFrame.new(mid + Vector3.new(0, 0.5, 0)),
                wood,
                M.Wood
            )
        end
        deco(
            "Cornice",
            model,
            boxSize(along, length, 0.6, band + 0.2),
            CFrame.new(mid + Vector3.new(0, H - SLAB - 0.45, 0)),
            wood,
            M.Wood
        )
        if theme.dado and grounded then
            deco(
                "DadoRail",
                model,
                boxSize(along, length, 0.5, band),
                CFrame.new(mid + Vector3.new(0, 4.2, 0)),
                Color3.fromHex(theme.dado),
                M.Wood
            )
        end
    end
end

local function railing(model: Model, theme, mid: Vector3, along: Vector3, length: number)
    local colour, material = Color3.fromHex(theme.rail), theme.railMaterial
    -- An invisible waist-high barrier: stops a stumble, not a jump, a shot or a look
    local barrier = part(
        "Railing",
        model,
        boxSize(along, length, RAIL_H, 0.5),
        CFrame.new(mid + Vector3.new(0, RAIL_H / 2, 0)),
        colour,
        material
    )
    barrier.Transparency = 1
    barrier.CanQuery = false
    barrier.CastShadow = false
    deco(
        "Handrail",
        model,
        boxSize(along, length + 0.4, 0.35, 0.6),
        CFrame.new(mid + Vector3.new(0, RAIL_H, 0)),
        colour,
        material
    )
    deco(
        "Kickrail",
        model,
        boxSize(along, length, 0.3, 0.4),
        CFrame.new(mid + Vector3.new(0, 0.5, 0)),
        colour,
        material
    )
    local count = math.max(1, math.floor(length / 4))
    for i = 0, count do
        local offset = -length / 2 + i * (length / count)
        deco(
            "Baluster",
            model,
            Vector3.new(0.3, RAIL_H, 0.3),
            CFrame.new(mid + along * offset + Vector3.new(0, RAIL_H / 2, 0)),
            colour,
            material
        )
    end
end

local function doorway(model: Model, plan, theme, e)
    local centre, along = edgeFrame(plan, e)
    local t, colour, material = finish(theme, look(plan, e))
    -- Jambs from the doorway to the cell corner, and a lintel over the gap
    local from, to = DOOR_W / 2, CELL / 2 + t / 2
    for _, sign in { -1, 1 } do
        part(
            "Wall",
            model,
            boxSize(along, to - from, WALL_TOP - WALL_BOTTOM, t),
            CFrame.new(
                centre
                    + along * (sign * (from + to) / 2)
                    + Vector3.new(0, (WALL_BOTTOM + WALL_TOP) / 2, 0)
            ),
            colour,
            material
        )
    end
    part(
        "Lintel",
        model,
        boxSize(along, DOOR_W, WALL_TOP - DOOR_H, t),
        CFrame.new(centre + Vector3.new(0, (DOOR_H + WALL_TOP) / 2, 0)),
        colour,
        material
    )
    local wood = Color3.fromHex(theme.trim or theme.rail)
    -- Proud of the wall skin, never flush with it
    local frameBand = t + (if theme.liner then 1 else 0.5)
    for _, sign in { -1, 1 } do
        deco(
            "DoorFrame",
            model,
            boxSize(along, 0.6, DOOR_H, frameBand),
            CFrame.new(centre + along * (sign * (DOOR_W / 2 - 0.3)) + Vector3.new(0, DOOR_H / 2, 0)),
            wood,
            M.Wood
        )
    end
    deco(
        "DoorFrame",
        model,
        boxSize(along, DOOR_W, 0.6, frameBand),
        CFrame.new(centre + Vector3.new(0, DOOR_H - 0.3, 0)),
        wood,
        M.Wood
    )
    if e.lockdown then
        -- EventService swings these shut for a Lockdown
        local door = part(
            "Door",
            model,
            boxSize(along, DOOR_W, DOOR_H, 0.6),
            CFrame.new(centre + Vector3.new(0, DOOR_H / 2, 0)),
            Color3.fromHex("5b3a24"),
            M.Wood
        )
        door.CanCollide = false
        door.Transparency = 1
        door:AddTag("LockdownDoor")
    end
end

local function edges(model: Model, plan, analysis, theme)
    local run = nil
    local function flush()
        if not run then
            return
        end
        local centre, along = edgeFrame(plan, run.edge)
        local length = run.count * CELL
        local mid = centre + along * ((run.count - 1) * CELL / 2)
        if run.look == "railing" then
            railing(model, theme, mid, along, length)
        else
            solidWall(model, theme, run.look, mid, along, length, run.grounded)
        end
        run = nil
    end
    for _, e in analysis.edges do
        if e.kind == "door" then
            flush()
            doorway(model, plan, theme, e)
        elseif e.kind == "open" then
            flush()
        else
            local lookName = look(plan, e)
            -- Nobody stands at the foot of a wall with a hole on both sides of
            -- it: the shell carrying on past a stairwell. A run breaks where
            -- that changes, so its trim is right along its whole length.
            local grounded = MapPlan.IsWalkable(e.a) or MapPlan.IsWalkable(e.b)
            if
                run
                and run.look == lookName
                and run.grounded == grounded
                and run.edge.floor == e.floor
                and run.edge.axis == e.axis
                and run.edge.line == e.line
                and run.last + 1 == e.index
            then
                run.count += 1
                run.last = e.index
            else
                flush()
                run = { edge = e, count = 1, last = e.index, look = lookName, grounded = grounded }
            end
        end
    end
    flush()
end

-- Every room paints its own walls: a coloured skin on each face, so a room
-- reads as a room and neighbouring rooms never share a colour by accident
local function skins(model: Model, plan, analysis, theme)
    if not theme.liner then
        return
    end
    local function solid(edge): boolean
        return edge ~= nil
            and (edge.kind == "wall" or edge.kind == "exterior" or edge.kind == "door")
    end
    local function edgeAt(f: number, axis: string, line: number, index: number)
        return analysis.byId[MapPlan.EdgeId(f, axis, line, index)]
    end
    -- How far past the cell corner this side's skin must run at one end of
    -- the wall. Every wall is built half a thickness long at each end so two
    -- meeting at a corner close it, and inside a room that overlap is buried
    -- in the other wall. Where the wall turns away from this room instead -
    -- the inside corner of an L-shaped corridor - or stops at a railing or
    -- open floor, that stub stands out into the room with its bare brick
    -- showing, so the skin runs on to wrap it.
    local function extension(e, side, low: boolean): (number, boolean)
        local ax, az, bx, bz = MapPlan.EdgeCells(e)
        local cx, cz, ox, oz = ax, az, bx, bz
        if side.face > 0 then
            cx, cz, ox, oz = bx, bz, ax, az
        end
        local own, other, onward
        if e.axis == "x" then
            local vz = if low then e.index - 1 else e.index
            own = edgeAt(e.floor, "z", vz, cx)
            other = edgeAt(e.floor, "z", vz, ox)
            onward = edgeAt(e.floor, "x", e.line, if low then e.index - 1 else e.index + 1)
        else
            local vx = if low then e.index - 1 else e.index
            own = edgeAt(e.floor, "x", vx, cz)
            other = edgeAt(e.floor, "x", vx, oz)
            onward = edgeAt(e.floor, "z", e.line, if low then e.index - 1 else e.index + 1)
        end
        if solid(own) then
            return 0, false
        end
        if solid(onward) then
            -- The wall carries straight on. Where a shell gives way to a
            -- thinner wall its stub reaches half a shell past the corner,
            -- and its face lands exactly flush with the thin wall's skin,
            -- flickering. The thicker skin runs on over the stub instead.
            local t = finish(theme, look(plan, e))
            local onwardT = finish(theme, look(plan, onward))
            return if onwardT < t then t / 2 else 0, false
        end
        if solid(other) then
            -- Reach the outer face of the skin on the wall the corner turns into
            local t = finish(theme, look(plan, other))
            return t / 2 + 0.45, false
        end
        local t = finish(theme, look(plan, e))
        return t / 2, true
    end
    for _, e in analysis.edges do
        if e.kind ~= "exterior" and e.kind ~= "wall" and e.kind ~= "door" then
            continue
        end
        local centre, along, across = edgeFrame(plan, e)
        -- The wall this edge actually got: an interior edge beside an outdoor
        -- region is built shell-thick, and a skin sized for a thin wall would
        -- sit inside it with its face flush to the wall's, flickering.
        local thickness = finish(theme, look(plan, e))
        local ax, az, bx, bz = MapPlan.EdgeCells(e)
        local sides = {
            { ch = e.a, face = -1, x = ax, z = az },
            { ch = e.b, face = 1, x = bx, z = bz },
        }
        local capped = false
        for _, side in sides do
            -- A ^ cell is the head of the room below, so line the wall in that
            -- room's colour. Skipping it left the bare shell facing indoors:
            -- across a stairwell you looked at raw exterior brick starting at
            -- the storey line, which reads as a floor that has dropped away.
            local below = if side.ch == "^"
                then MapPlan.OpensInto(plan, e.floor, side.x, side.z)
                else nil
            local ch: string = below or side.ch
            local region = plan.regions[ch]
            if not region or region.outdoor then
                continue
            end
            local style = theme.styles[region.style]
            local colour = Color3.fromHex((style and style.wall) or theme.wall)
            local material = (style and style.wallMaterial) or theme.wallMaterial
            local offset = across * side.face * (thickness / 2 + 0.15)
            -- The skin covers the wall's whole height, slab to slab. Its ends
            -- are buried in the slabs where there are any, and where there
            -- are none - a stairwell, a double-height hall - it meets the
            -- skin of the storey above with no bare strip between.
            local bottom, top = WALL_BOTTOM, WALL_TOP
            local extLow, freeLow = extension(e, side, true)
            local extHigh, freeHigh = extension(e, side, false)
            local function panel(from: number, to: number)
                deco(
                    "WallSkin",
                    model,
                    boxSize(along, to - from, top - bottom, 0.3),
                    CFrame.new(
                        centre
                            + offset
                            + along * ((from + to) / 2)
                            + Vector3.new(0, (bottom + top) / 2, 0)
                    ),
                    colour,
                    material
                )
            end
            if e.kind == "door" then
                -- Skin the jambs and the panel over the door too, so a room's
                -- colour runs unbroken past its doorways
                local from, to = DOOR_W / 2, CELL / 2
                panel(-to - extLow, -from)
                panel(from, to + extHigh)
                deco(
                    "WallSkin",
                    model,
                    boxSize(along, DOOR_W, top - DOOR_H, 0.3),
                    CFrame.new(centre + offset + Vector3.new(0, (DOOR_H + top) / 2, 0)),
                    colour,
                    material
                )
            else
                panel(-CELL / 2 - extLow, CELL / 2 + extHigh)
            end
            -- A wall that simply stops - at a railing, or beside open floor -
            -- shows its end. Cap it in the first room's colour, wide enough
            -- to close both side skins.
            for _, at in { { sign = -1, free = freeLow }, { sign = 1, free = freeHigh } } do
                if capped or not at.free then
                    continue
                end
                deco(
                    "WallSkin",
                    model,
                    boxSize(along, 0.3, top - bottom, thickness + 0.9),
                    CFrame.new(
                        centre
                            + along * (at.sign * (CELL / 2 + thickness / 2 + 0.15))
                            + Vector3.new(0, (bottom + top) / 2, 0)
                    ),
                    colour,
                    material
                )
            end
            capped = true
        end
    end
end

---------------------------------------------------------------- Windows
local function windows(model: Model, plan, analysis, theme)
    if not theme.windows then
        return
    end
    local frame = Color3.fromHex(theme.trim or theme.rail)
    for _, e in analysis.edges do
        if e.kind ~= "exterior" or e.floor <= plan.underground or e.index % 2 == 0 then
            continue
        end
        local inside = if MapPlan.IsWalkable(e.a)
            then -1
            elseif MapPlan.IsWalkable(e.b) then 1
            else 0
        local region = plan.regions[if inside < 0 then e.a else e.b]
        if inside == 0 or (region and region.outdoor) then
            continue
        end
        local centre, along, across = edgeFrame(plan, e)
        local inward = across * inside
        local at = centre + inward * (SHELL / 2 + 0.45) + Vector3.new(0, H * 0.5, 0)
        local glass = deco(
            "Window",
            model,
            boxSize(along, 8, 8, 0.2),
            CFrame.new(at),
            Color3.fromHex("aecbe8"),
            M.Glass
        )
        -- Real daytime glass: see partly through it, a glassy sheen, and soft
        -- cool daylight rather than a saturated blue "moonlit" panel. Kept
        -- semi-opaque so a blackout does not blow out through it.
        glass.Transparency = 0.42
        glass.Reflectance = 0.12
        local light = Instance.new("SurfaceLight")
        light.Face = faceToward(inward)
        light.Color = Color3.fromHex("dbe8f7")
        light.Brightness = 1
        light.Range = 22
        light.Angle = 80
        light.Parent = glass
        for _, bar in
            {
                { 9, 0.6, 0, 4.2 },
                { 9, 0.6, 0, -4.2 },
                { 0.6, 9, 4.2, 0 },
                { 0.6, 9, -4.2, 0 },
                { 0.3, 8, 0, 0 },
            }
        do
            deco(
                "WindowFrame",
                model,
                boxSize(along, bar[1], bar[2], 0.5),
                CFrame.new(at + inward * 0.15 + along * bar[3] + Vector3.new(0, bar[4], 0)),
                frame,
                M.Wood
            )
        end
    end
end

---------------------------------------------------------------- Stairs
local function staircase(model: Model, plan, theme, s)
    local base = (s.floor - 1) * H
    local first, last = s.cells[1], s.cells[#s.cells]
    local ax, _, az = MapPlan.Position(plan, s.floor, first.x, first.z)
    local bx, _, bz = MapPlan.Position(plan, s.floor, last.x, last.z)
    local dir = Vector3.new(s.dx, 0, s.dz)
    local run = s.len * CELL
    local centre = Vector3.new((ax + bx) / 2, base, (az + bz) / 2)
    local wood = Color3.fromHex(theme.stair)

    -- Real steps rather than a ramp: a humanoid walks up a 0.8-stud riser
    -- without jumping, pathfinding reads them, and the top lands flush with
    -- the floor above
    local steps = s.len * 10
    local rise, depth = H / steps, run / steps
    local bottom = centre - dir * (run / 2)
    for i = 1, steps do
        local height = i * rise
        local at = bottom + dir * ((i - 0.5) * depth) + Vector3.new(0, height / 2, 0)
        part(
            "Step",
            model,
            if dir.X ~= 0
                then Vector3.new(depth, height, STAIR_W)
                else Vector3.new(STAIR_W, height, depth),
            CFrame.new(at),
            wood,
            floorMaterialFor(theme.stair, theme.stairMaterial)
        )
    end

    -- A banister down each side, so nobody walks off the steps
    local slope = dir * run + Vector3.new(0, H, 0)
    local side = Vector3.new(-s.dz, 0, s.dx)
    for _, sign in { -1, 1 } do
        local mid = centre
            + side * (sign * (STAIR_W / 2 + 0.3))
            + Vector3.new(0, H / 2 + RAIL_H / 2, 0)
        local banister = part(
            "Banister",
            model,
            Vector3.new(0.5, RAIL_H, slope.Magnitude),
            CFrame.lookAt(mid, mid + slope.Unit),
            Color3.fromHex(theme.rail),
            theme.railMaterial
        )
        banister.CanQuery = false
    end
end

---------------------------------------------------------------- Lamps
local function lamps(model: Model, plan, analysis, theme)
    local gw, gd, floors = MapPlan.Size(plan)
    local colour = Color3.fromHex(theme.lamp)
    local count = 0

    local function light(lamp: BasePart, range: number)
        count += 1
        lamp:AddTag("MapLight")
        local l = Instance.new("PointLight")
        l.Color = colour
        l.Range = range
        l.Brightness = 1.5
        l.Shadows = count % 3 == 0 -- a few shadow casters keep phones smooth
        l.Parent = lamp
    end

    local function hang(f: number, x: number, z: number, drop: number, range: number)
        local cx, base, cz = MapPlan.Position(plan, f, x, z)
        local ceiling = base + H - SLAB
        local y = ceiling - drop
        -- A warm bulb under a shade, not a bare glowing cube. The bulb keeps the
        -- MapLight tag (light() tags it) so Lights Out still douses it.
        local bulb =
            deco("Lamp", model, Vector3.new(1, 1, 1), CFrame.new(cx, y, cz), colour, M.Neon)
        bulb.Shape = Enum.PartType.Ball
        deco(
            "LampShade",
            model,
            Vector3.new(2.1, 0.45, 2.1),
            CFrame.new(cx, y + 0.6, cz),
            Color3.fromHex("2a2018"),
            M.Metal
        )
        deco(
            "LampCord",
            model,
            Vector3.new(0.15, drop - 0.3, 0.15),
            CFrame.new(cx, (ceiling + y + 0.85) / 2, cz),
            Color3.fromHex("1a1a1a"),
            M.Metal
        )
        light(bulb, range)
    end

    local lit, fallback = {}, {}
    for f = 1, floors do
        for z = 1, gd do
            for x = 1, gw do
                local ch = MapPlan.Cell(plan, f, x, z)
                local key = MapPlan.Key(f, x, z)
                if ch == "^" then
                    -- Chandeliers down the middle of double-height rooms
                    if analysis.roof[key] and x % 2 == 0 and z % 2 == 0 then
                        hang(f, x, z, 3, 44)
                    end
                    continue
                end
                if not MapPlan.IsWalkable(ch) or analysis.ramp[key] then
                    continue
                end
                local region = plan.regions[ch]
                if region.outdoor then
                    -- Lamp posts along the railings, every third cell
                    if (x + z) % 3 ~= 0 then
                        continue
                    end
                    for _, side in SIDES do
                        if MapPlan.EdgeKind(analysis, f, x, z, side) == "railing" then
                            local d = MapPlan.DIRS[side]
                            local cx, base, cz = MapPlan.Position(plan, f, x, z)
                            local at = Vector3.new(cx, base, cz)
                                + Vector3.new(d[1], 0, d[2]) * (CELL / 2 - 1.2)
                            local post = part(
                                "LampPost",
                                model,
                                Vector3.new(0.6, 10, 0.6),
                                CFrame.new(at + Vector3.new(0, 5, 0)),
                                Color3.fromHex("2b2f33"),
                                M.Metal
                            )
                            post.CanQuery = false
                            local lamp = deco(
                                "Lamp",
                                model,
                                Vector3.new(1.3, 1.3, 1.3),
                                CFrame.new(at + Vector3.new(0, 10.3, 0)),
                                colour,
                                M.Neon
                            )
                            lamp.Shape = Enum.PartType.Ball
                            deco(
                                "LampCap",
                                model,
                                Vector3.new(1.7, 0.4, 1.7),
                                CFrame.new(at + Vector3.new(0, 11.15, 0)),
                                Color3.fromHex("2b2f33"),
                                M.Metal
                            )
                            light(lamp, 36)
                            break
                        end
                    end
                    continue
                end
                local covered = analysis.roof[key]
                    or MapPlan.IsWalkable(MapPlan.Cell(plan, f + 1, x, z))
                if not covered then
                    continue
                end
                local group = f .. ch
                fallback[group] = fallback[group] or { x = x, z = z }
                if x % 2 == 1 and z % 2 == 1 then
                    hang(f, x, z, 1.6, 30)
                    lit[group] = true
                end
            end
        end
    end
    -- Every room gets at least one light
    for group, cell in fallback do
        if not lit[group] then
            hang(tonumber(string.match(group, "^%d+")) :: number, cell.x, cell.z, 1.6, 30)
        end
    end
end

---------------------------------------------------------------- Furniture and dressing
local function dressRooms(
    model: Model,
    plan,
    analysis,
    theme,
    reserved: { [string]: boolean },
    rng: Random
)
    local folder = ServerStorage:FindFirstChild("Props")
    local gw, gd, floors = MapPlan.Size(plan)

    local function template(name: string?): Model?
        local t = folder and name and folder:FindFirstChild(name)
        return if t and t:IsA("Model") then t else nil
    end

    local function place(t: Model, cf: CFrame)
        local prop = t:Clone()
        for _, d in prop:GetDescendants() do
            if d:IsA("LuaSourceContainer") then
                d:Destroy() -- set dressing never runs code
            elseif d:IsA("BasePart") then
                d.Anchored = true
            end
        end
        prop:PivotTo(cf)
        prop.Parent = model
    end

    local function rug(cf: CFrame, colourHex: string)
        local colour = Color3.fromHex(colourHex)
        local h, s, v = colour:ToHSV()
        deco(
            "RugBorder",
            model,
            Vector3.new(15.2, 0.1, 11.2),
            cf * CFrame.new(0, 0.05, 0),
            Color3.fromHSV(h, s, v * 0.55),
            M.Fabric
        )
        deco("Rug", model, Vector3.new(14, 0.14, 10), cf * CFrame.new(0, 0.07, 0), colour, M.Fabric)
    end

    -- Pass one: each standable cell's four edges, and each room's most open cell
    local cells = {}
    local centreCell = {}
    for f = 1, floors do
        for z = 1, gd do
            for x = 1, gw do
                local ch = MapPlan.Cell(plan, f, x, z)
                local key = MapPlan.Key(f, x, z)
                if not MapPlan.IsWalkable(ch) or analysis.ramp[key] or analysis.approach[key] then
                    continue
                end
                local kinds, passage, rail, openSides = {}, false, false, 0
                for _, side in SIDES do
                    local kind = MapPlan.EdgeKind(analysis, f, x, z, side)
                    kinds[side] = kind
                    passage = passage or kind == "door" or kind == "open"
                    rail = rail or kind == "railing"
                    if kind == "none" then
                        openSides += 1
                    end
                end
                local info = {
                    f = f,
                    x = x,
                    z = z,
                    ch = ch,
                    kinds = kinds,
                    passage = passage,
                    rail = rail,
                    openSides = openSides,
                }
                table.insert(cells, info)
                local style = theme.styles[plan.regions[ch].style]
                local wantsCentre = style
                    and (
                        style.centre
                        or style.rug
                        or (theme.rugs and theme.rugs[plan.regions[ch].style])
                    )
                if wantsCentre and not passage and not rail and not reserved[key] then
                    local group = f .. ch
                    local best = centreCell[group]
                    if not best or openSides > best.openSides then
                        centreCell[group] = { info = info, openSides = openSides }
                    end
                end
            end
        end
    end

    -- Pass two: centrepieces, pieces against walls, paintings
    for _, info in cells do
        local region = plan.regions[info.ch]
        local style = theme.styles[region.style]
        if not style then
            continue
        end
        local cx, base, cz = MapPlan.Position(plan, info.f, info.x, info.z)
        local against: { [string]: boolean } = {}

        local best = centreCell[info.f .. info.ch]
        local centrepiece = best and best.info == info and template(style.centre)
        local roomRug = style.rug or (theme.rugs and theme.rugs[region.style])
        if best and best.info == info and not centrepiece and roomRug then
            -- A rug on its own in the middle of the room
            rug(CFrame.new(cx, base, cz), roomRug)
        end
        if centrepiece then
            local size = centrepiece:GetExtentsSize()
            local turn = CFrame.Angles(0, if rng:NextNumber() < 0.5 then 0 else math.pi / 2, 0)
            local cf = CFrame.new(cx, base + size.Y / 2, cz) * turn
            place(centrepiece, cf)
            if roomRug then
                rug(CFrame.new(cx, base, cz) * turn, roomRug)
            end
            local chair = style.chairs and template("DiningChair")
            if chair then
                local chairSize = chair:GetExtentsSize()
                for _, spot in { { -0.25, 1 }, { 0.25, 1 }, { -0.25, -1 }, { 0.25, -1 } } do
                    local at = cf:PointToWorldSpace(
                        Vector3.new(
                            size.X * spot[1],
                            0,
                            spot[2] * (size.Z / 2 + chairSize.Z / 2 + 0.6)
                        )
                    )
                    at = Vector3.new(at.X, base + chairSize.Y / 2, at.Z)
                    place(chair, CFrame.lookAt(at, Vector3.new(cx, at.Y, cz)))
                end
            end
        elseif
            not info.passage
            and (style.againstRail or not info.rail)
            and #style.props > 0
            and rng:NextNumber() < math.min(0.9, (style.density or 0) * 1.25)
        then
            -- One piece with its back to a wall (or a railing, outdoors)
            -- Random has NextInteger but is nominally typed, so it does not
            -- match Shuffle.Generator structurally. The seed still decides the
            -- order, which is what keeps a map dressing itself the same way.
            local order = Shuffle.Shuffled(SIDES, rng :: any)
            for _, side in order do
                local kind = info.kinds[side]
                if
                    not (
                        kind == "wall"
                        or kind == "exterior"
                        or (style.againstRail and kind == "railing")
                    )
                then
                    continue
                end
                local t = template(style.props[rng:NextInteger(1, #style.props)])
                if t then
                    local size = t:GetExtentsSize()
                    local d = MapPlan.DIRS[side]
                    local out = Vector3.new(d[1], 0, d[2])
                    local along = Vector3.new(-d[2], 0, d[1])
                    local thickness = if kind == "exterior"
                        then SHELL
                        elseif kind == "railing" then 0.6
                        else WALL
                    -- A spawn pad or coin sits in the middle of a reserved
                    -- cell; a deep piece (a bed, a crate stack) with its
                    -- back to the wall would reach into it, so try another
                    if
                        reserved[MapPlan.Key(info.f, info.x, info.z)]
                        and CELL / 2 - thickness / 2 - size.Z - 0.3 < RESERVED_CLEAR
                    then
                        continue
                    end
                    local slack = math.max(0, CELL / 2 - size.X / 2 - 2)
                    local at = Vector3.new(cx, base + size.Y / 2, cz)
                        + out * (CELL / 2 - thickness / 2 - size.Z / 2 - 0.3)
                        + along * rng:NextNumber(-slack, slack)
                    place(t, CFrame.lookAt(at, at - out))
                    against[side] = true
                end
                break
            end
        end

        -- A working room is full: crates and stock stand out on the floor too,
        -- but only in cells open on all four sides, so every piece can be
        -- walked around
        if
            style.clutter
            and not centrepiece
            and info.openSides == 4
            and next(against) == nil
            and not reserved[MapPlan.Key(info.f, info.x, info.z)]
            and #style.props > 0
            and rng:NextNumber() < style.clutter
        then
            local piece = template(style.props[rng:NextInteger(1, #style.props)])
            if piece then
                local size = piece:GetExtentsSize()
                local at = Vector3.new(
                    cx + rng:NextNumber(-3.5, 3.5),
                    base + size.Y / 2,
                    cz + rng:NextNumber(-3.5, 3.5)
                )
                place(piece, CFrame.new(at) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
            end
        end

        -- Pictures on the walls: interior walls, and exterior walls with no
        -- window on them (windows hang on every other exterior edge, above
        -- ground). Each sits on the room face of the wall skin, frame slab
        -- behind and canvas proud of it, never over a doorway, never where
        -- furniture stands against the wall.
        local pictured: { [string]: boolean } = {}
        local pics = theme.pictures
        if pics and not region.outdoor then
            for _, side in SIDES do
                local kind = info.kinds[side]
                if kind ~= "wall" and kind ~= "exterior" then
                    continue
                end
                if against[side] or rng:NextNumber() > pics.chance then
                    continue
                end
                local edge = analysis.byId[MapPlan.SideEdgeId(info.f, info.x, info.z, side)]
                local windowed = kind == "exterior"
                    and theme.windows
                    and info.f > plan.underground
                    and edge ~= nil
                    and edge.index % 2 == 1
                if windowed then
                    continue
                end
                local d = MapPlan.DIRS[side]
                local out = Vector3.new(d[1], 0, d[2])
                local along = Vector3.new(-d[2], 0, d[1])
                -- The wall this edge was actually built with (an interior
                -- edge beside an outdoor region is shell-thick), and so
                -- the skin's room face, measured from the cell centre
                local t = if edge then finish(theme, look(plan, edge)) else WALL
                local skinFace = CELL / 2 - t / 2 - 0.3
                local frameDepth, canvasDepth = 0.35, 0.12
                local frameAt = Vector3.new(cx, base + 7.5, cz)
                    + out * (skinFace - frameDepth / 2 + 0.02)
                deco(
                    "PaintingFrame",
                    model,
                    boxSize(along, pics.width, pics.height, frameDepth),
                    CFrame.new(frameAt),
                    Color3.fromHex(pics.frame),
                    pics.frameMaterial or M.Wood
                )
                local canvasAt = Vector3.new(cx, base + 7.5, cz)
                    + out * (skinFace - frameDepth + 0.02 - canvasDepth / 2)
                deco(
                    "Painting",
                    model,
                    boxSize(along, pics.width - 1, pics.height - 1, canvasDepth),
                    CFrame.new(canvasAt),
                    Color3.fromHex(pics.canvases[rng:NextInteger(1, #pics.canvases)])
                )
                pictured[side] = true
            end
        end

        -- A runner down a straight stretch of corridor: open at both ends,
        -- walled at both sides, no rug or centrepiece here
        if
            theme.runner
            and region.hall
            and not region.outdoor
            and not style.centre
            and not roomRug
        then
            local k = info.kinds
            local function solidSide(kk)
                return kk == "wall" or kk == "exterior" or kk == "door"
            end
            local axis = if k.N == "none"
                    and k.S == "none"
                    and solidSide(k.E)
                    and solidSide(k.W)
                then Vector3.zAxis
                elseif
                    k.E == "none"
                    and k.W == "none"
                    and solidSide(k.N)
                    and solidSide(k.S)
                then Vector3.xAxis
                else nil
            if axis then
                local colour = Color3.fromHex(theme.runner)
                local h, sat, v = colour:ToHSV()
                deco(
                    "RunnerBorder",
                    model,
                    boxSize(axis, CELL, 0.1, 6.2),
                    CFrame.new(cx, base + 0.05, cz),
                    Color3.fromHSV(h, sat, v * 0.55),
                    M.Fabric
                )
                deco(
                    "Runner",
                    model,
                    boxSize(axis, CELL, 0.14, 5),
                    CFrame.new(cx, base + 0.07, cz),
                    colour,
                    M.Fabric
                )
            end
        end

        -- Curtains either side of a window, hung from a rod above it, only
        -- where nothing stands against that wall
        if theme.curtain and not region.outdoor then
            for _, side in SIDES do
                if info.kinds[side] ~= "exterior" or against[side] then
                    continue
                end
                local edge = analysis.byId[MapPlan.SideEdgeId(info.f, info.x, info.z, side)]
                local windowed = theme.windows
                    and info.f > plan.underground
                    and edge ~= nil
                    and edge.index % 2 == 1
                if not windowed then
                    continue
                end
                local d = MapPlan.DIRS[side]
                local out = Vector3.new(d[1], 0, d[2])
                local along = Vector3.new(-d[2], 0, d[1])
                local t = finish(theme, look(plan, edge))
                local skinFace = CELL / 2 - t / 2 - 0.3
                local depth = 0.35
                local colour = Color3.fromHex(theme.curtain)
                -- From just above the dado rail to the rod above the window
                for _, sign in { -1, 1 } do
                    deco(
                        "Curtain",
                        model,
                        boxSize(along, 1.4, 8.4, depth),
                        CFrame.new(
                            Vector3.new(cx, base + 4.6 + 4.2, cz)
                                + out * (skinFace - depth / 2 + 0.02)
                                + along * (sign * 5.3)
                        ),
                        colour,
                        M.Fabric
                    )
                end
                local rod = deco(
                    "CurtainRod",
                    model,
                    -- A cylinder's length runs along its X axis; it is
                    -- turned to lie along the wall below
                    Vector3.new(12.4, 0.35, 0.35),
                    CFrame.new(Vector3.new(cx, base + 13.1, cz) + out * (skinFace - 0.45)),
                    Color3.fromHex("3a3532"),
                    M.Metal
                )
                rod.Shape = Enum.PartType.Cylinder
                if along.Z ~= 0 then
                    rod.CFrame = rod.CFrame * CFrame.Angles(0, math.rad(90), 0)
                end
            end
        end

        -- A stopped clock high on one interior wall of a working room
        if theme.clocks and theme.clocks[region.style] and not region.outdoor then
            local wallSides = {}
            for _, side in SIDES do
                if info.kinds[side] == "wall" and not against[side] and not pictured[side] then
                    table.insert(wallSides, side)
                end
            end
            if #wallSides > 0 and rng:NextNumber() < 0.15 then
                local side = wallSides[rng:NextInteger(1, #wallSides)]
                local d = MapPlan.DIRS[side]
                local out = Vector3.new(d[1], 0, d[2])
                local along = Vector3.new(-d[2], 0, d[1])
                local edge = analysis.byId[MapPlan.SideEdgeId(info.f, info.x, info.z, side)]
                local t = if edge then finish(theme, look(plan, edge)) else WALL
                local skinFace = CELL / 2 - t / 2 - 0.3
                local centre = Vector3.new(cx, base + 10.5, cz)
                local facing = CFrame.fromMatrix(Vector3.zero, out, Vector3.yAxis)
                local rim = deco(
                    "ClockRim",
                    model,
                    Vector3.new(0.25, 2.6, 2.6),
                    CFrame.new(centre + out * (skinFace - 0.125 + 0.02)) * facing.Rotation,
                    Color3.fromHex("2a2622"),
                    M.Metal
                )
                rim.Shape = Enum.PartType.Cylinder
                local face = deco(
                    "ClockFace",
                    model,
                    Vector3.new(0.1, 2.2, 2.2),
                    CFrame.new(centre + out * (skinFace - 0.25 - 0.05 + 0.02)) * facing.Rotation,
                    Color3.fromHex("f2ede0"),
                    M.SmoothPlastic
                )
                face.Shape = Enum.PartType.Cylinder
                local handDepth = skinFace - 0.3 - 0.03 + 0.02
                deco(
                    "ClockHand",
                    model,
                    boxSize(along, 0.14, 0.95, 0.06),
                    CFrame.new(centre + out * handDepth + Vector3.new(0, 0.42, 0)),
                    Color3.fromHex("2a2622")
                )
                deco(
                    "ClockHand",
                    model,
                    boxSize(along, 0.75, 0.14, 0.06),
                    CFrame.new(centre + out * handDepth + along * 0.33),
                    Color3.fromHex("2a2622")
                )
                pictured[side] = true
            end
        end

        -- A bin in an inside corner: two solid sides meeting, no furniture
        -- against either, never a spawn or coin cell. It stands on the floor
        -- and clear of both skins, and a corner is never a doorway.
        -- Outdoors it stands where a railing corner would hold it, on the
        -- decks and roofs that also take furniture against a rail.
        local bin = theme.bin
        if
            bin
            and (not region.outdoor or style.againstRail)
            and not reserved[MapPlan.Key(info.f, info.x, info.z)]
            and rng:NextNumber() < (if region.hall then 0.5 else 0.3)
        then
            local corners = { { "N", "E" }, { "E", "S" }, { "S", "W" }, { "W", "N" } }
            local open = {}
            for _, c in corners do
                local k1, k2 = info.kinds[c[1]], info.kinds[c[2]]
                local function solidSide(k)
                    return k == "wall"
                        or k == "exterior"
                        or k == "door"
                        or (region.outdoor and k == "railing")
                end
                if solidSide(k1) and solidSide(k2) and not against[c[1]] and not against[c[2]] then
                    table.insert(open, c)
                end
            end
            if #open > 0 then
                local c = open[rng:NextInteger(1, #open)]
                local r = bin.diameter / 2
                local at = Vector3.new(cx, base + bin.height / 2, cz)
                for _, side in c do
                    local d = MapPlan.DIRS[side]
                    local edge = analysis.byId[MapPlan.SideEdgeId(info.f, info.x, info.z, side)]
                    local t = if info.kinds[side] == "railing"
                        then 0.6
                        elseif edge then finish(theme, look(plan, edge))
                        else WALL
                    local skinFace = CELL / 2 - t / 2 - 0.3
                    at += Vector3.new(d[1], 0, d[2]) * (skinFace - r - 0.35)
                end
                local upright = CFrame.Angles(0, 0, math.rad(90))
                local body = part(
                    "Bin",
                    model,
                    Vector3.new(bin.height, bin.diameter, bin.diameter),
                    CFrame.new(at) * upright,
                    Color3.fromHex(bin.colour),
                    bin.material
                )
                body.Shape = Enum.PartType.Cylinder
                local rim = deco(
                    "BinRim",
                    model,
                    Vector3.new(0.3, bin.diameter + 0.3, bin.diameter + 0.3),
                    CFrame.new(at.X, base + bin.height - 0.15, at.Z) * upright,
                    Color3.fromHex(bin.rim),
                    bin.rimMaterial
                )
                rim.Shape = Enum.PartType.Cylinder
                if bin.lid then
                    local lid = deco(
                        "BinLid",
                        model,
                        Vector3.new(0.25, bin.diameter + 0.2, bin.diameter + 0.2),
                        CFrame.new(at.X, base + bin.height + 0.125, at.Z) * upright,
                        Color3.fromHex(bin.rim),
                        bin.rimMaterial
                    )
                    lid.Shape = Enum.PartType.Cylinder
                    deco(
                        "BinLid",
                        model,
                        Vector3.new(0.6, 0.4, 0.6),
                        CFrame.new(at.X, base + bin.height + 0.45, at.Z),
                        Color3.fromHex(bin.rim),
                        bin.rimMaterial
                    )
                end
            end
        end
    end
end

---------------------------------------------------------------- Doormats
-- A mat just inside every doorway, on each indoor side of it
local function doormats(model: Model, plan, analysis, theme)
    if not theme.mat then
        return
    end
    local colour = Color3.fromHex(theme.mat)
    for _, e in analysis.edges do
        if e.kind ~= "door" then
            continue
        end
        local centre, along, across = edgeFrame(plan, e)
        local t = finish(theme, look(plan, e))
        for _, side in { { ch = e.a, face = -1 }, { ch = e.b, face = 1 } } do
            local region = plan.regions[side.ch]
            if not region or region.outdoor then
                continue
            end
            deco(
                "Doormat",
                model,
                boxSize(along, 5.5, 0.1, 3),
                CFrame.new(
                    centre
                        + across * side.face * (t / 2 + 0.3 + 0.3 + 1.5)
                        + Vector3.new(0, 0.05, 0)
                ),
                colour,
                M.Fabric
            )
        end
    end
end

---------------------------------------------------------------- Waterfront
-- Rusted Pier stands on pilings over open water
local function waterfront(model: Model, plan)
    local gw, gd = MapPlan.Size(plan)
    local water = deco(
        "Water",
        model,
        Vector3.new(gw * CELL + 1000, 1, gd * CELL + 1000),
        CFrame.new(0, -4, 0),
        Color3.fromHex("2f86c4"),
        M.Glass
    )
    water.Transparency = 0.28
    water.Reflectance = 0.15

    -- Corners of the boardwalk get short pilings; corners under the deck where
    -- no boardwalk stands get tall ones
    local posts: { [string]: boolean } = {}
    for z = 1, gd do
        for x = 1, gw do
            local low = MapPlan.IsWalkable(MapPlan.Cell(plan, 1, x, z))
            local high = MapPlan.Cell(plan, 2, x, z) ~= "."
            if low or high then
                for _, c in { { x - 1, z - 1 }, { x, z - 1 }, { x - 1, z }, { x, z } } do
                    local id = c[1] .. ":" .. c[2]
                    posts[id] = (posts[id] or false) or low
                end
            end
        end
    end
    local wood = Color3.fromHex("3a2f24")
    for id, short in posts do
        local cx, cz = string.match(id, "^(%-?%d+):(%-?%d+)$")
        local top = if short then -SLAB else H - SLAB
        local bottom = -12
        deco(
            "Piling",
            model,
            Vector3.new(1.2, top - bottom, 1.2),
            CFrame.new(
                lineAt(tonumber(cx) :: number, gw),
                (top + bottom) / 2,
                lineAt(tonumber(cz) :: number, gd)
            ),
            wood,
            M.Wood
        )
    end
end

---------------------------------------------------------------- Build
local function build(mapName: string, plan, theme): Model
    local model = Instance.new("Model")
    model.Name = mapName
    local analysis = MapPlan.Analyse(plan)
    for _, problem in analysis.problems do
        warn(("[ColdCase] %s plan: %s"):format(mapName, problem))
    end

    model.PrimaryPart = slabs(model, plan, analysis, theme)
    edges(model, plan, analysis, theme)
    floorDetail(model, plan, analysis, theme)
    skins(model, plan, analysis, theme)
    windows(model, plan, analysis, theme)
    doormats(model, plan, analysis, theme)
    for _, s in analysis.stairs do
        staircase(model, plan, theme, s)
    end
    lamps(model, plan, analysis, theme)
    if theme.water then
        waterfront(model, plan)
    end

    local points = MapPlan.Points(plan, analysis)
    local reserved = {}
    for i, c in points.spawns do
        reserved[MapPlan.Key(c.f, c.x, c.z)] = true
        local x, y, z = MapPlan.Position(plan, c.f, c.x, c.z)
        local p = part(
            ("Spawn_%02d"):format(i),
            model,
            Vector3.new(8, 0.4, 8),
            CFrame.new(x, y + 0.2, z),
            Color3.fromHex("37bcf0")
        )
        -- A marker, not scenery: invisible, and never in the way of a shot
        p.CanCollide = false
        p.CanQuery = false
        p.Transparency = 1
        p:AddTag("SpawnPoint")
    end
    for i, c in points.coins do
        reserved[MapPlan.Key(c.f, c.x, c.z)] = true
        local x, y, z = MapPlan.Position(plan, c.f, c.x, c.z)
        -- A real coin, not a flat marker: a thin gold disc stood on edge, its
        -- round faces pointing along X so it shows a face then its edge as the
        -- client spins it. Still Neon so it stays findable across a dark room.
        local p = part(
            ("Coin_%02d"):format(i),
            model,
            Vector3.new(0.4, 2.2, 2.2),
            CFrame.new(x, y + 2.7, z),
            Color3.fromHex("f2a63b"),
            M.Neon
        )
        p.Shape = Enum.PartType.Cylinder
        p.CanCollide = false
        p.CanQuery = false
        p:SetAttribute("NodeId", i)
        p:AddTag("CoinNode")
    end

    dressRooms(model, plan, analysis, theme, reserved, Random.new(#mapName * 7919))
    return model
end

return function(opts: { force: boolean? }?)
    local force = opts and opts.force

    -- A Maps folder saved into the place file is generated code that has
    -- stopped tracking its generator. Reused blindly, every later change in
    -- this file is ignored in silence and the maps keep the shape they had
    -- when they were baked - a geometry fix can be written, reviewed, merged
    -- and published without ever reaching the game. So a baked folder is kept
    -- only while it still belongs to the running place; republish and it is
    -- rebuilt. A folder built at run time never outlives its server.
    -- An unpublished place (Studio, a local file, the test build) has place
    -- version 0 forever, so a folder saved into it would match on every start
    -- and never be rebuilt: the walkthrough of 2026-09-22 found a place file
    -- carrying maps baked before the furniture existed, so no round ever had
    -- any. Only a published server may keep a folder, and only its own.
    local folder = ServerStorage:FindFirstChild("Maps")
    if
        folder
        and not force
        and game.PlaceVersion > 0
        and folder:GetAttribute("PlaceVersion") == game.PlaceVersion
    then
        return folder
    end
    if folder then
        folder:Destroy()
    end
    folder = Instance.new("Folder")
    folder.Name = "Maps"

    for mapName, plan in MapPlan.MAPS do
        local theme = THEMES[mapName]
        if theme then
            build(mapName, plan, theme).Parent = folder
        else
            warn("[ColdCase] no theme for map " .. mapName)
        end
    end

    if not ServerStorage:FindFirstChild("BodyTemplate") then
        -- A body reads as a person, not a red brick: a figure collapsed on its
        -- back, head, torso, two arms and two legs in skin and clothing tones,
        -- lying flat with a little asymmetry so it looks fallen, not laid out.
        -- Cloned whole by EvidenceService and dropped at the death spot; the
        -- Torso stays the PrimaryPart so the existing pivot maths is unchanged.
        local body = Instance.new("Model")
        body.Name = "BodyTemplate"
        local SKIN = Color3.fromHex("e0a878")
        local SHIRT = Color3.fromHex("59616e")
        local PANTS = Color3.fromHex("32363c")
        local limbs: { BasePart } = {}
        local function limb(name: string, size: Vector3, cf: CFrame, colour: Color3)
            local p = part(name, body, size, cf, colour)
            table.insert(limbs, p)
            return p
        end
        -- The figure lies along Z: head toward -Z, feet toward +Z, thin in Y.
        local torso = limb("Torso", Vector3.new(2, 0.9, 2.7), CFrame.new(0, 0.5, 0), SHIRT)
        limb("Head", Vector3.new(1.3, 1.2, 1.3), CFrame.new(0.15, 0.55, -2.1), SKIN).Shape =
            Enum.PartType.Ball
        limb(
            "ArmLeft",
            Vector3.new(0.7, 0.65, 2.3),
            CFrame.new(-1.35, 0.45, -0.4) * CFrame.Angles(0, math.rad(18), 0),
            SKIN
        )
        limb(
            "ArmRight",
            Vector3.new(0.7, 0.65, 2.3),
            CFrame.new(1.4, 0.45, 0.2) * CFrame.Angles(0, math.rad(-9), 0),
            SKIN
        )
        limb(
            "LegLeft",
            Vector3.new(0.8, 0.75, 2.7),
            CFrame.new(-0.55, 0.45, 2.6) * CFrame.Angles(0, math.rad(11), 0),
            PANTS
        )
        limb(
            "LegRight",
            Vector3.new(0.8, 0.75, 2.7),
            CFrame.new(0.65, 0.45, 2.5) * CFrame.Angles(0, math.rad(-6), 0),
            PANTS
        )
        for _, p in limbs do
            p.CanCollide = false
        end
        body.PrimaryPart = torso
        body.Parent = ServerStorage
    end

    folder:SetAttribute("PlaceVersion", game.PlaceVersion)
    folder.Parent = ServerStorage
    return folder
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="73">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="74">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="75">
        <Properties>
          <string name="Name">ClientBootstrap</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/ClientBootstrap (LocalScript)
local Controllers = script.Parent:WaitForChild("Controllers")
for _, module in Controllers:GetChildren() do
    if module:IsA("ModuleScript") then
        task.spawn(function()
            local ok, err = pcall(require, module)
            if not ok then
                warn("[ColdCase] " .. module.Name .. ": " .. tostring(err))
            end
        end)
    end
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="76">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--!strict
-- What this client knows about itself. Controllers read and subscribe here
-- instead of each listening to the same remotes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local ClientState = {
    role = nil :: string?,
    loaded = false,
    data = {
        coins = 0,
        xp = 0,
        rank = 1,
        inventory = {},
        equipped = { knife = "ash", gun = "ledger" },
        hintsSeen = {},
    },
    prompt = "—",
    screen = nil :: string?,
    spectating = false,
    killcam = false,
}

local listeners: { [string]: { (any) -> () } } = {}

function ClientState.On(key: string, fn: (any) -> ())
    listeners[key] = listeners[key] or {}
    table.insert(listeners[key], fn)
end

function ClientState.Set(key: string, value: any)
    if ClientState[key] == value and type(value) ~= "table" then
        return
    end
    ClientState[key] = value
    local list = listeners[key]
    if not list then
        return
    end
    for _, fn in list do
        task.spawn(fn, value)
    end
end

function ClientState.GetRoundState(): string
    return ReplicatedStorage:GetAttribute("RoundState") or "INTERMISSION"
end

-- DataChanged carries either the full profile or a partial update
Remotes.DataChanged.OnClientEvent:Connect(function(patch)
    for k, v in patch do
        ClientState.data[k] = v
    end
    ClientState.loaded = true
    ClientState.Set("data", ClientState.data)
end)

Remotes.RoleAssigned.OnClientEvent:Connect(function(role)
    ClientState.Set("role", role)
end)

ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if ClientState.GetRoundState() == "INTERMISSION" then
        ClientState.Set("role", nil)
    end
end)

return ClientState
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="77">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="78">
          <Properties>
            <string name="Name">AccuseController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/AccuseController
-- Whodunnit only: a panel to name the killer. Every living player sees the
-- living suspects with a running vote count; tap one to accuse (tap again to
-- change). A majority conviction of the real murderer wins the round. The server
-- (WhodunnitService) owns the tally and pushes it over AccuseTally.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local latest: { suspects: { string }, counts: { [string]: number } } =
    { suspects = {}, counts = {} }
local myVote: string? = nil

local gui = Instance.new("ScreenGui")
gui.Name = "AccuseGui"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = plr:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0, 0.5)
panel.Position = UDim2.new(0, 16, 0.5, 0)
panel.Size = UDim2.fromOffset(210, 300)
panel.BackgroundColor3 = Theme.CARD
panel.BackgroundTransparency = 0.05
panel.BorderSizePixel = 0
panel.Parent = gui
do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = panel
    local s = Instance.new("UIStroke")
    s.Color = Theme.DANGER
    s.Transparency = 0.3
    s.Parent = panel
    local pad = Instance.new("UIPadding")
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
    pad.Parent = panel
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 4)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = panel
end

local title = Instance.new("TextLabel")
title.LayoutOrder = 0
title.BackgroundTransparency = 1
title.Size = UDim2.new(1, 0, 0, 18)
title.FontFace = Theme.DISPLAY
title.TextSize = 15
title.TextColor3 = Theme.DANGER
title.TextXAlignment = Enum.TextXAlignment.Left
title.Text = "WHODUNNIT · NAME THE KILLER"
title.TextWrapped = true
title.Parent = panel

local rowsHolder = Instance.new("Frame")
rowsHolder.Name = "Rows"
rowsHolder.LayoutOrder = 1
rowsHolder.BackgroundTransparency = 1
rowsHolder.Size = UDim2.new(1, 0, 1, -22)
rowsHolder.Parent = panel
do
    local rl = Instance.new("UIListLayout")
    rl.Padding = UDim.new(0, 4)
    rl.SortOrder = Enum.SortOrder.LayoutOrder
    rl.Parent = rowsHolder
end

local function accuse(name: string)
    myVote = name
    Remotes.RequestAccuse:FireServer(name)
end

local function render()
    for _, c in rowsHolder:GetChildren() do
        if c:IsA("TextButton") then
            c:Destroy()
        end
    end
    local order = 0
    for _, name in latest.suspects do
        if name == plr.Name then
            continue -- you cannot accuse yourself
        end
        order += 1
        local count = latest.counts[name] or 0
        local mine = myVote == name
        local row = Instance.new("TextButton")
        row.Name = name
        row.LayoutOrder = order
        row.Size = UDim2.new(1, 0, 0, 28)
        row.AutoButtonColor = false
        row.BackgroundColor3 = mine and Theme.DANGER or Theme.PANEL
        row.BackgroundTransparency = mine and 0.35 or 0
        row.BorderSizePixel = 0
        row.FontFace = Theme.MONO
        row.TextSize = 13
        row.TextColor3 = Theme.INK
        row.Text = ""
        row.Parent = rowsHolder
        local rc = Instance.new("UICorner")
        rc.CornerRadius = UDim.new(0, 4)
        rc.Parent = row
        local nm = Instance.new("TextLabel")
        nm.BackgroundTransparency = 1
        nm.Position = UDim2.fromOffset(8, 0)
        nm.Size = UDim2.new(1, -44, 1, 0)
        nm.FontFace = Theme.MONO
        nm.TextSize = 13
        nm.TextColor3 = Theme.INK
        nm.TextXAlignment = Enum.TextXAlignment.Left
        nm.TextTruncate = Enum.TextTruncate.AtEnd
        nm.Text = name
        nm.Parent = row
        local ct = Instance.new("TextLabel")
        ct.BackgroundTransparency = 1
        ct.AnchorPoint = Vector2.new(1, 0)
        ct.Position = UDim2.new(1, -8, 0, 0)
        ct.Size = UDim2.fromOffset(30, 28)
        ct.FontFace = Theme.DISPLAY
        ct.TextSize = 15
        ct.TextColor3 = count > 0 and Theme.DANGER or Theme.DIM
        ct.Text = tostring(count)
        ct.Parent = row
        row.Activated:Connect(function()
            accuse(name)
            render()
        end)
    end
end

local function visible(): boolean
    return ReplicatedStorage:GetAttribute("Mode") == "whodunnit"
        and ClientState.GetRoundState() == "ACTIVE"
        and ClientState.role ~= nil
        and not ClientState.spectating
        and ClientState.screen == nil
end

local function refresh()
    gui.Enabled = visible()
end

Remotes.AccuseTally.OnClientEvent:Connect(function(payload)
    latest = payload or { suspects = {}, counts = {} }
    -- your vote is void once its target is gone
    if myVote and not table.find(latest.suspects, myVote) then
        myVote = nil
    end
    render()
    refresh()
end)

for _, key in { "role", "screen", "spectating" } do
    ClientState.On(key, refresh)
end
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(refresh)
ReplicatedStorage:GetAttributeChangedSignal("Mode"):Connect(function()
    if ReplicatedStorage:GetAttribute("Mode") ~= "whodunnit" then
        myVote = nil
    end
    refresh()
end)

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="79">
          <Properties>
            <string name="Name">ChatTagController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/ChatTagController
-- A gold [VIP] tag and gold name in chat for anyone who owns the VIP pass.
-- VIP is a public player attribute the server sets (MonetizationService); this
-- is cosmetic only and reads it the same way any client can.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local VIP_GOLD = "f2c14e"

TextChatService.OnIncomingMessage = function(message: TextChatMessage)
    local source = message.TextSource
    if not source then
        return nil -- system lines have no sender
    end
    local sender = Players:GetPlayerByUserId(source.UserId)
    if not (sender and sender:GetAttribute("Vip")) then
        return nil
    end
    local props = Instance.new("TextChatMessageProperties")
    -- Prepend the tag and wrap the existing name prefix so both read gold
    props.PrefixText = ('<font color="#%s">[VIP] %s</font>'):format(VIP_GOLD, message.PrefixText)
    return props
end

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="80">
          <Properties>
            <string name="Name">CoinController</string>
            <string name="Source"><![CDATA[--!strict
-- Asks for a coin when standing on a node. Sends a node id — never an amount.
-- The server measures against its own copy of the character, which trails
-- the client by the player's ping, so an ask can be refused while the client
-- already stands on the coin. Keep asking, at a polite interval, until the
-- node is gone or the player walks away.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local lastAsked: { [BasePart]: number } = {}
local CoinController = {}
local RETRY_INTERVAL = 0.5

task.spawn(function()
    while true do
        task.wait(0.15)
        if ClientState.GetRoundState() ~= "ACTIVE" or not ClientState.role then
            continue
        end
        local char = plr.Character
        if not char then
            continue
        end
        local here = char:GetPivot().Position
        local now = os.clock()
        for _, node in CollectionService:GetTagged("CoinNode") do
            if not (node:IsA("BasePart") and node:IsDescendantOf(workspace)) then
                continue
            end
            if (node.Position - here).Magnitude > Config.COIN_PICKUP_RANGE then
                continue
            end
            if now - (lastAsked[node] or 0) >= RETRY_INTERVAL then
                lastAsked[node] = now
                Remotes.RequestCoin:FireServer(node:GetAttribute("NodeId"))
            end
        end
    end
end)

-- Spin and bob every coin node, purely local. The disc turns about the vertical
-- axis so it shows a face then its edge, and rides a slow sine so it reads as a
-- floating pickup, not a decal. Anchored server parts, so this stays on the
-- client and never touches the server's static pickup position. Runs only while
-- a round is live - the only time coin nodes exist - so the lobby pays nothing.
local baseY: { [BasePart]: number } = {}
RunService.Heartbeat:Connect(function()
    if ClientState.GetRoundState() ~= "ACTIVE" then
        return
    end
    local t = os.clock()
    for _, node in CollectionService:GetTagged("CoinNode") do
        if node:IsA("BasePart") and node:IsDescendantOf(workspace) then
            local by = baseY[node]
            if not by then
                by = node.Position.Y
                baseY[node] = by
            end
            local bob = math.sin(t * 2.2 + node.Position.X * 0.1) * 0.4
            node.CFrame = CFrame.new(node.Position.X, by + bob, node.Position.Z)
                * CFrame.Angles(0, t * 2.4, 0)
        end
    end
end)

-- One handler clears both per-node tables when a coin is collected or the round ends.
CollectionService:GetInstanceRemovedSignal("CoinNode"):Connect(function(node)
    lastAsked[node :: BasePart] = nil
    baseY[node :: BasePart] = nil
end)

return CoinController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="81">
          <Properties>
            <string name="Name">CombatFeelController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/CombatFeelController
-- COLD CASE · combat feel. Client-only feedback that makes a blow land:
--   * a camera kick (Humanoid.CameraOffset, so it never fights the camera),
--     shared out so InputController can kick on firing and stabbing;
--   * a hitmarker + "ELIMINATED" line when you kill someone - the server
--     tells the killer through KillConfirm;
--   * a red vignette + heavier kick when you die.
-- Nothing here is authoritative. It only reacts to what the server decided.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Theme"))

local plr = Players.LocalPlayer
local playerGui = plr:WaitForChild("PlayerGui")

-- A crisp 2D tick on a confirmed kill. Built-in sound so it is always
-- present; swap SoundId for a curated asset later (as the fonts note).
local SoundService = game:GetService("SoundService")
local killTick = Instance.new("Sound")
killTick.Name = "KillConfirmTick"
killTick.SoundId = "rbxasset://sounds/electronicpingshort.wav"
killTick.Volume = 0.7
killTick.Parent = SoundService

local CombatFeel = {}

---------------------------------------------------------------- camera kick
local shake = { start = 0, dur = 0, mag = 0 }

local function humanoid(): Humanoid?
    local c = plr.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

-- A decaying random kick. Overlapping calls take the stronger, longer one.
function CombatFeel.Kick(magnitude: number, duration: number)
    local now = os.clock()
    if magnitude >= shake.mag or now + duration > shake.start + shake.dur then
        shake = { start = now, dur = duration, mag = magnitude }
    end
end

RunService.RenderStepped:Connect(function()
    local hum = humanoid()
    if not hum then
        return
    end
    local t = os.clock() - shake.start
    if t >= shake.dur then
        if hum.CameraOffset.Magnitude > 0.01 then
            hum.CameraOffset = hum.CameraOffset * 0.5
        else
            hum.CameraOffset = Vector3.zero
        end
        return
    end
    local m = shake.mag * (1 - t / shake.dur)
    hum.CameraOffset = Vector3.new(
        (math.random() - 0.5) * 2 * m,
        (math.random() - 0.5) * 2 * m,
        (math.random() - 0.5) * 2 * m * 0.5
    )
end)

---------------------------------------------------------------- overlay gui
local gui = Instance.new("ScreenGui")
gui.Name = "CombatFeel"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 20
gui.Parent = playerGui

-- Red vignette: an image-free tint that flashes and fades on death
local vignette = Instance.new("Frame")
vignette.Name = "Vignette"
vignette.Size = UDim2.fromScale(1, 1)
vignette.BackgroundColor3 = Theme.DANGER
vignette.BackgroundTransparency = 1
vignette.BorderSizePixel = 0
vignette.ZIndex = 1
vignette.Parent = gui

-- Hitmarker: four ticks forming an X, popped on a kill
local marker = Instance.new("Frame")
marker.Name = "Hitmarker"
marker.AnchorPoint = Vector2.new(0.5, 0.5)
marker.Position = UDim2.fromScale(0.5, 0.5)
marker.Size = UDim2.fromOffset(34, 34)
marker.BackgroundTransparency = 1
marker.ZIndex = 3
marker.Visible = false
marker.Parent = gui
for _, rot in { 45, 135, 225, 315 } do
    local tick = Instance.new("Frame")
    tick.AnchorPoint = Vector2.new(0.5, 0.5)
    tick.Position = UDim2.fromScale(0.5, 0.5)
    tick.Size = UDim2.fromOffset(3, 12)
    tick.BackgroundColor3 = Theme.INK
    tick.BorderSizePixel = 0
    tick.Rotation = rot
    tick.ZIndex = 3
    -- push each tick outward along its rotation
    local rad = math.rad(rot)
    tick.Position = UDim2.new(0.5, math.sin(rad) * 12, 0.5, -math.cos(rad) * 12)
    tick.Parent = marker
end

-- "ELIMINATED · ROLE" line under the hitmarker
local killText = Instance.new("TextLabel")
killText.Name = "KillText"
killText.AnchorPoint = Vector2.new(0.5, 0.5)
killText.Position = UDim2.fromScale(0.5, 0.58)
killText.Size = UDim2.fromOffset(360, 28)
killText.BackgroundTransparency = 1
killText.FontFace = Theme.DISPLAY
killText.TextSize = 20
killText.TextColor3 = Theme.INK
killText.TextTransparency = 1
killText.Text = ""
killText.ZIndex = 3
killText.Parent = gui

local ROLE_COLOUR = Theme.ROLE

---------------------------------------------------------------- death flash
local function flashDeath()
    CombatFeel.Kick(0.6, 0.4)
    vignette.BackgroundTransparency = 0.35
    TweenService:Create(
        vignette,
        TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { BackgroundTransparency = 1 }
    ):Play()
end

local function watchCharacter(char: Model)
    local hum = char:WaitForChild("Humanoid", 5)
    if hum and hum:IsA("Humanoid") then
        hum.Died:Connect(flashDeath)
    end
end
if plr.Character then
    task.spawn(watchCharacter, plr.Character)
end
plr.CharacterAdded:Connect(watchCharacter)

---------------------------------------------------------------- kill confirm
local function confirmKill(victimRole: string?)
    CombatFeel.Kick(0.24, 0.15)
    killTick.TimePosition = 0
    killTick:Play()
    -- hitmarker pop
    marker.Visible = true
    marker.Size = UDim2.fromOffset(20, 20)
    for _, tick in marker:GetChildren() do
        if tick:IsA("Frame") then
            tick.BackgroundTransparency = 0
        end
    end
    TweenService
        :Create(marker, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(40, 40),
        })
        :Play()
    task.delay(0.28, function()
        for _, tick in marker:GetChildren() do
            if tick:IsA("Frame") then
                TweenService:Create(tick, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
                    :Play()
            end
        end
    end)
    -- kill line
    local role = victimRole and victimRole:upper() or "TARGET"
    killText.Text = if victimRole == "infected"
        then "INFECTED · +1 HUNTER"
        else "ELIMINATED · " .. role
    killText.TextColor3 = (victimRole and ROLE_COLOUR[victimRole]) or Theme.INK
    killText.TextTransparency = 0
    killText.Position = UDim2.fromScale(0.5, 0.58)
    TweenService
        :Create(killText, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            TextTransparency = 1,
            Position = UDim2.fromScale(0.5, 0.55),
        })
        :Play()
end

Remotes:WaitForChild("KillConfirm").OnClientEvent:Connect(confirmKill)

return CombatFeel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="82">
          <Properties>
            <string name="Name">CompassController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/CompassController
-- A heading ribbon across the top of the screen so players can orient
-- themselves - find their way back to the lobby, call out a direction, or say
-- which way the killer ran. Purely cosmetic: it reads the camera's facing and
-- draws N/E/S/W ticks that scroll as you turn. Hidden while a full-screen menu
-- is open. Client-only; the server never sees or trusts it.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Theme = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Theme"))
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local CompassController = {}

local WIDTH = 300 -- ribbon window width in pixels
local ARC = 160 -- how many degrees of heading the window spans
local PX_PER_DEG = WIDTH / ARC

-- Eight cardinal/inter-cardinal marks. Heading 0 = facing -Z (north), matching
-- the clue directions EvidenceService reports, so "north" means the same thing.
local MARKS = {
    { deg = 0, label = "N" },
    { deg = 45, label = "NE" },
    { deg = 90, label = "E" },
    { deg = 135, label = "SE" },
    { deg = 180, label = "S" },
    { deg = 225, label = "SW" },
    { deg = 270, label = "W" },
    { deg = 315, label = "NW" },
}

local gui = Instance.new("ScreenGui")
gui.Name = "ColdCaseCompass"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true -- share the HUD's coordinate space so it sits under it
gui.DisplayOrder = 12
gui.Enabled = false
gui.Parent = plr:WaitForChild("PlayerGui")

local window = Instance.new("Frame")
window.Name = "Window"
window.AnchorPoint = Vector2.new(0.5, 0)
-- Just below the round stat bar (Top: y 14..72), so it never overlaps it.
window.Position = UDim2.new(0.5, 0, 0, 78)
window.Size = UDim2.fromOffset(WIDTH, 28)
window.BackgroundColor3 = Theme.GROUND
window.BackgroundTransparency = 0.35
window.BorderSizePixel = 0
window.ClipsDescendants = true
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = window
local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromHex("1f252e")
stroke.Parent = window
window.Parent = gui

-- One reusable label per mark; RenderStepped only moves them.
local labels: { [number]: TextLabel } = {}
for i, mark in MARKS do
    local l = Instance.new("TextLabel")
    l.Name = mark.label
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.Position = UDim2.new(0.5, 0, 0.5, 0)
    l.Size = UDim2.fromOffset(40, 24)
    l.BackgroundTransparency = 1
    l.Text = mark.label
    l.FontFace = Theme.DISPLAY
    l.TextSize = if #mark.label == 1 then 18 else 12
    l.TextColor3 = if mark.label == "N" then Theme.AMBER else Theme.SOFT
    l.Parent = window
    labels[i] = l
end

-- Centre pointer: a small notch marking the heading you actually face.
local pointer = Instance.new("Frame")
pointer.Name = "Pointer"
pointer.AnchorPoint = Vector2.new(0.5, 1)
pointer.Position = UDim2.new(0.5, 0, 1, 0)
pointer.Size = UDim2.fromOffset(2, 12)
pointer.BackgroundColor3 = Theme.AMBER
pointer.BorderSizePixel = 0
pointer.Parent = window

-- Signed shortest angle from heading to a mark, in [-180, 180].
local function delta(markDeg: number, heading: number): number
    local d = (markDeg - heading + 540) % 360 - 180
    return d
end

RunService.RenderStepped:Connect(function()
    local cam = workspace.CurrentCamera
    local shown = cam ~= nil and plr.Character ~= nil and ClientState.screen == nil
    gui.Enabled = shown
    if not shown then
        return
    end
    local look = (cam :: Camera).CFrame.LookVector
    local heading = math.deg(math.atan2(look.X, -look.Z)) % 360
    for i, mark in MARKS do
        local off = delta(mark.deg, heading) * PX_PER_DEG
        local l = labels[i]
        l.Position = UDim2.new(0.5, off, 0.5, 0)
        -- fade the ones near the clipped edges so the ribbon reads cleanly
        l.TextTransparency = math.clamp((math.abs(off) - WIDTH / 2 + 30) / 30, 0, 1)
    end
end)

return CompassController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">DeductionController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/DeductionController
-- The snitch's suspect board (right edge, ACTIVE round only) and the one-use
-- EXPOSE button. Also the universal receiver for an Expose: when the killer is
-- named, EVERY client shows the banner and lights the killer up in red.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local DeductionController = {}

local BAR_COLOUR = {
    [0] = Theme.DIM, -- cleared
    [1] = Theme.SOFT, -- unknown
    [2] = Theme.AMBER, -- person of interest
    [3] = Theme.DANGER, -- likely
    [4] = Theme.DANGER, -- near-certain
}

local latest: { suspects: { any }, canExpose: boolean, used: boolean } =
    { suspects = {}, canExpose = false, used = false }

---------------------------------------------------------------- Board UI
local gui = Instance.new("ScreenGui")
gui.Name = "DeductionGui"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = plr:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Name = "Board"
panel.AnchorPoint = Vector2.new(1, 0.5)
panel.Position = UDim2.new(1, -16, 0.5, 0)
panel.Size = UDim2.fromOffset(224, 300)
panel.BackgroundColor3 = Theme.CARD
panel.BackgroundTransparency = 0.06
panel.BorderSizePixel = 0
panel.Parent = gui
do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = panel
    local s = Instance.new("UIStroke")
    s.Color = Theme.STROKE
    s.Parent = panel
    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = panel
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 6)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = panel
end

local function label(name: string, order: number, size: number, colour: Color3, font): TextLabel
    local l = Instance.new("TextLabel")
    l.Name = name
    l.LayoutOrder = order
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, 0, 0, size)
    l.FontFace = font
    l.TextSize = size
    l.TextColor3 = colour
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = panel
    return l
end

label("Title", 1, 14, Theme.INK, Theme.DISPLAY).Text = "INFORMANT · SUSPECTS"
local hint = label("Hint", 2, 12, Theme.DIM, Theme.MONO)
hint.Text = "Examine bodies to gather clues."

local rowsHolder = Instance.new("Frame")
rowsHolder.Name = "Rows"
rowsHolder.LayoutOrder = 3
rowsHolder.BackgroundTransparency = 1
rowsHolder.Size = UDim2.new(1, 0, 0, 176)
rowsHolder.Parent = panel
do
    local rl = Instance.new("UIListLayout")
    rl.Padding = UDim.new(0, 4)
    rl.SortOrder = Enum.SortOrder.LayoutOrder
    rl.Parent = rowsHolder
end

local expose = Instance.new("TextButton")
expose.Name = "Expose"
expose.LayoutOrder = 4
expose.Size = UDim2.new(1, 0, 0, Theme.TAP_MIN)
expose.AutoButtonColor = false
expose.BorderSizePixel = 0
expose.FontFace = Theme.DISPLAY
expose.TextSize = 16
expose.Text = "EXPOSE THE KILLER"
expose.TextColor3 = Theme.GROUND
expose.BackgroundColor3 = Theme.DANGER
expose.Parent = panel
do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = expose
end

local function renderRows()
    for _, ch in rowsHolder:GetChildren() do
        if ch:IsA("Frame") then
            ch:Destroy()
        end
    end
    hint.Visible = #latest.suspects == 0
    for i, s in latest.suspects do
        local colour = BAR_COLOUR[s.bar] or Theme.SOFT
        local row = Instance.new("Frame")
        row.LayoutOrder = i
        row.Size = UDim2.new(1, 0, 0, 26)
        row.BackgroundColor3 = Theme.PANEL
        row.BorderSizePixel = 0
        row.Parent = rowsHolder
        local rc = Instance.new("UICorner")
        rc.CornerRadius = UDim.new(0, 4)
        rc.Parent = row
        -- confidence fill behind the text
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(s.bar / 4, 0, 1, 0)
        fill.BackgroundColor3 = colour
        fill.BackgroundTransparency = 0.72
        fill.BorderSizePixel = 0
        fill.Parent = row
        local fc = Instance.new("UICorner")
        fc.CornerRadius = UDim.new(0, 4)
        fc.Parent = fill
        local nm = Instance.new("TextLabel")
        nm.BackgroundTransparency = 1
        nm.Position = UDim2.fromOffset(8, 0)
        nm.Size = UDim2.new(0.5, -8, 1, 0)
        nm.FontFace = Theme.MONO
        nm.TextSize = 13
        nm.TextColor3 = Theme.INK
        nm.TextXAlignment = Enum.TextXAlignment.Left
        nm.TextTruncate = Enum.TextTruncate.AtEnd
        nm.Text = s.name
        nm.Parent = row
        local lb = Instance.new("TextLabel")
        lb.BackgroundTransparency = 1
        lb.AnchorPoint = Vector2.new(1, 0)
        lb.Position = UDim2.new(1, -8, 0, 0)
        lb.Size = UDim2.new(0.5, -8, 1, 0)
        lb.FontFace = Theme.MONO
        lb.TextSize = 11
        lb.TextColor3 = colour
        lb.TextXAlignment = Enum.TextXAlignment.Right
        lb.Text = string.upper(s.label)
        lb.Parent = row
    end
end

local function renderExpose()
    if latest.used then
        expose.Text = "EXPOSED"
        expose.BackgroundColor3 = Theme.STROKE
        expose.TextColor3 = Theme.DIM
        expose.Active = false
    elseif latest.canExpose then
        expose.Text = "EXPOSE THE KILLER"
        expose.BackgroundColor3 = Theme.DANGER
        expose.TextColor3 = Theme.GROUND
        expose.Active = true
    else
        expose.Text = "NOT ENOUGH YET"
        expose.BackgroundColor3 = Theme.PANEL
        expose.TextColor3 = Theme.DIM
        expose.Active = false
    end
end

expose.Activated:Connect(function()
    if latest.canExpose and not latest.used then
        Remotes.RequestExpose:FireServer()
    end
end)

local function visible(): boolean
    return ClientState.role == "snitch"
        and ClientState.GetRoundState() == "ACTIVE"
        and not ClientState.spectating
        and ClientState.screen == nil
end

local function refresh()
    gui.Enabled = visible()
end

-- Correct state before any server push: an empty board and a gated button, so
-- the snitch never sees EXPOSE lit until they have actually earned it.
renderRows()
renderExpose()

Remotes.Deduction.OnClientEvent:Connect(function(payload)
    latest = payload
    renderRows()
    renderExpose()
    refresh()
end)

for _, key in { "role", "screen", "spectating" } do
    ClientState.On(key, refresh)
end
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(refresh)

---------------------------------------------------------------- Expose (all clients)
local function charFor(name: string): Model?
    for _, p in Players:GetPlayers() do
        if p.Name == name and p.Character then
            return p.Character
        end
    end
    for _, model in CollectionService:GetTagged("BotCharacter") do
        if model:IsA("Model") and (model:GetAttribute("BotName") == name or model.Name == name) then
            return model
        end
    end
    return nil
end

local banner = Instance.new("ScreenGui")
banner.Name = "ExposeBanner"
banner.ResetOnSpawn = false
banner.DisplayOrder = 20
banner.Enabled = false
banner.Parent = plr:WaitForChild("PlayerGui")
local bannerLabel = Instance.new("TextLabel")
bannerLabel.AnchorPoint = Vector2.new(0.5, 0)
bannerLabel.Position = UDim2.fromScale(0.5, 0.14)
bannerLabel.Size = UDim2.fromOffset(720, 56)
bannerLabel.BackgroundTransparency = 1
bannerLabel.FontFace = Theme.DISPLAY
bannerLabel.TextSize = 40
bannerLabel.TextColor3 = Theme.DANGER
bannerLabel.TextStrokeTransparency = 0.4
bannerLabel.Text = ""
bannerLabel.Parent = banner

local bannerToken = 0

Remotes.Expose.OnClientEvent:Connect(function(names: { string }, seconds: number)
    if type(names) ~= "table" or #names == 0 then
        return
    end
    bannerLabel.Text = ("THE KILLER: %s"):format(table.concat(names, " & "))
    banner.Enabled = true
    bannerToken += 1
    local mine = bannerToken
    task.delay(seconds, function()
        if bannerToken == mine then
            banner.Enabled = false
        end
    end)
    for _, name in names do
        local char = charFor(name)
        if char then
            local old = char:FindFirstChild("ExposeGlow")
            if old then
                old:Destroy()
            end
            local hl = Instance.new("Highlight")
            hl.Name = "ExposeGlow"
            hl.FillColor = Theme.DANGER
            hl.OutlineColor = Theme.DANGER
            hl.FillTransparency = 0.4
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Adornee = char
            hl.Parent = char
            task.delay(seconds, function()
                if hl.Parent then
                    hl:Destroy()
                end
            end)
        end
    end
end)

return DeductionController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">HudController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/HudController
-- Drives RoundHud (Handbook §01). Builds it at runtime if StarterGui has none.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local BuildHud = require(Shared.Build.BuildHud)
local ClientState = require(script.Parent.Parent.ClientState)

local ROLE_BRIEF = {
    innocent = "Survive. Read the bodies. Feed the gun.",
    sheriff = "The only honest gun here. Be certain.",
    murderer = "Take your time. Everyone is watching.",
    hero = "You took the pistol. Finish it.",
    medic = "One revive. Spend it well.",
    snitch = "They know you now. Run or fight.",
    assassin = "Free-for-all. Hunt your target. Last blade wins.",
}
local STATE_LABEL = {
    INTERMISSION = "LOBBY",
    LOADING = "LOADING",
    REVEAL = "REVEAL",
    ACTIVE = "LIVE",
    RESOLUTION = "VERDICT",
}
local EMPTY = "—"

local plr = Players.LocalPlayer
local playerGui = plr:WaitForChild("PlayerGui")
local gui = playerGui:FindFirstChild("RoundHud") or BuildHud(playerGui)
local HudController = {}

-- The HUD belongs to the round: a menu covers the screen, so it steps aside
ClientState.On("screen", function(screen)
    gui.Enabled = screen == nil
end)
gui.Enabled = ClientState.screen == nil

local top = gui.Top
local roleTag = gui.RoleTag
local roleCard = gui.RoleCard
local banner = gui.EventBanner
local evidence = gui.Evidence
local action = gui.Action
-- On touch the bottom-right corner belongs to the jump button and the action
-- buttons round it, so the weapon/prompt panel sits at the bottom centre
if game:GetService("UserInputService").TouchEnabled then
    action.AnchorPoint = Vector2.new(0.5, 1)
    action.Position = UDim2.new(0.5, 0, 1, -16)
end

-- A brief colour-coded pulse when an event fires, on its own full-screen
-- layer so it covers the top inset too. Fades fast; it dramatises the onset
-- without hiding anything.
local EVENT_TINT = {
    LIGHTS_OUT = Color3.fromRGB(4, 6, 12),
    POWER_SURGE = Theme.AMBER,
    LOCKDOWN = Theme.DANGER,
    FOG_BANK = Color3.fromRGB(150, 170, 186),
    LAST_CALL = Theme.DANGER,
}
local flashGui = Instance.new("ScreenGui")
flashGui.Name = "EventFlash"
flashGui.ResetOnSpawn = false
flashGui.IgnoreGuiInset = true
flashGui.DisplayOrder = 5
flashGui.Parent = playerGui
local flash = Instance.new("Frame")
flash.Size = UDim2.fromScale(1, 1)
flash.BackgroundColor3 = Color3.new(0, 0, 0)
flash.BackgroundTransparency = 1
flash.BorderSizePixel = 0
flash.Parent = flashGui

local function pulseEvent(id: string)
    local tint = EVENT_TINT[id]
    if not tint then
        return
    end
    flash.BackgroundColor3 = tint
    flash.BackgroundTransparency = 0.5
    TweenService:Create(
        flash,
        TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { BackgroundTransparency = 1 }
    ):Play()
end

---------------------------------------------------------------- Evidence log
-- Four lines max (two on narrow screens), newest on top, clears on round start
local entries: { { text: string, kind: string } } = {}
local narrow = false

local function renderEvidence()
    local visibleLines = narrow and 2 or 4
    for i = 1, 4 do
        local line = evidence["Line" .. i]
        local e = entries[i]
        line.Text = e and e.text or ""
        line.Bar.Visible = e ~= nil
        line.Bar.BackgroundColor3 = e and (Theme.CLUE[e.kind] or Theme.CLUE.cold) or Theme.CLUE.cold
        line.Visible = i <= visibleLines
    end
end

local function pushClue(text: string, kind: string)
    table.insert(entries, 1, { text = text, kind = kind })
    while #entries > 4 do
        table.remove(entries)
    end
    renderEvidence()
end

Remotes.Clue.OnClientEvent:Connect(function(clues)
    if clues.cold then
        pushClue("The trail has gone cold.", "cold")
        return
    end
    -- Insert in reverse so one examination still reads top-down
    for i = #clues, 1, -1 do
        pushClue(clues[i].text, clues[i].kind)
    end
end)

-- Radio pass broadcasts, filtered by the server
Remotes.RadioMessage.OnClientEvent:Connect(function(from: string, message: string)
    pushClue(("RADIO · %s: %s"):format(from, message), "radio")
end)

---------------------------------------------------------------- Roles
local cardToken = 0

local function paintRole(role: string?)
    local colour = role and Theme.ROLE[role] or Theme.MUTED
    roleTag.RoleName.Text = role and string.upper(role) or EMPTY
    roleTag.RoleName.TextColor3 = colour
    roleTag.Stroke.Color = role and colour or Theme.STROKE
end

Remotes.RoleAssigned.OnClientEvent:Connect(function(role: string, counterpart: string?)
    paintRole(role)

    if counterpart then
        -- The snitch reveal lands mid-round: never block the centre during ACTIVE
        local text = role == "snitch" and ("The murderer is %s. They know you."):format(counterpart)
            or ("%s is the snitch. They know."):format(counterpart)
        pushClue(text, "witness")
        return
    end
    if ClientState.GetRoundState() == "ACTIVE" then
        return -- promoted to hero mid-round; the RoleTag is enough
    end

    local colour = Theme.ROLE[role] or Theme.ROLE.innocent
    roleCard.RoleName.Text = string.upper(role)
    roleCard.RoleName.TextColor3 = colour
    roleCard.Brief.Text = ROLE_BRIEF[role] or ""
    roleCard.Card.Stroke.Color = colour
    roleCard.Visible = true
    cardToken += 1
    local mine = cardToken
    task.delay(Config.REVEAL_TIME, function()
        if cardToken == mine then
            roleCard.Visible = false
        end
    end)
end)

---------------------------------------------------------------- Action panel
local function renderAction()
    local role = ClientState.role
    local equipped = ClientState.data.equipped or {}
    local weaponId = nil
    if role == "murderer" then
        weaponId = equipped.knife
    elseif role == "sheriff" or role == "hero" then
        weaponId = equipped.gun
    end
    local item = weaponId and Catalog[weaponId]
    action.Weapon.Text = item and string.upper(item.name) or EMPTY
    action.Weapon.TextColor3 = item and Theme.INK or Theme.MUTED
    local prompt = ClientState.prompt
    action.Prompt.Text = (prompt and prompt ~= "") and prompt or EMPTY
end

ClientState.On("role", function(role)
    if not role then
        paintRole(nil)
        roleCard.Visible = false
    end
    renderAction()
end)
ClientState.On("prompt", renderAction)
ClientState.On("data", function(data)
    top.CoinsBox.Value.Text = tostring(data.coins or 0)
    renderAction()
end)

---------------------------------------------------------------- Top bar
Remotes.AliveChanged.OnClientEvent:Connect(function(n)
    top.AliveBox.Value.Text = tostring(n)
end)

local function onState()
    local state = ClientState.GetRoundState()
    top.StateBox.Value.Text = STATE_LABEL[state] or state
    if state == "REVEAL" then
        entries = {}
        renderEvidence()
    elseif state == "INTERMISSION" then
        top.AliveBox.Value.Text = EMPTY
    end
    if state ~= "REVEAL" then
        roleCard.Visible = false
    end
end
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(onState)
onState()

local accum = 0
RunService.Heartbeat:Connect(function(dt)
    accum += dt
    if accum < 0.1 then
        return
    end
    accum = 0
    local state = ClientState.GetRoundState()
    local left = math.max(
        0,
        math.ceil((ReplicatedStorage:GetAttribute("RoundEnds") or 0) - workspace:GetServerTimeNow())
    )
    local timer = top.TimerBox.Value
    timer.Text = left > 0 and tostring(left) or EMPTY
    -- The only HUD element allowed to change colour mid-round
    timer.TextColor3 = (state == "ACTIVE" and left < 20) and Theme.DANGER or Theme.INK
end)

---------------------------------------------------------------- Event banner
-- Fades in over 0.4s, holds, fades out. No background frame.
local bannerToken = 0
local FADE = TweenInfo.new(0.4)

Remotes.EventFired.OnClientEvent:Connect(function(id: string)
    if id == "CLEAR" then
        return
    end
    pulseEvent(id)
    bannerToken += 1
    local mine = bannerToken
    local label = banner.Label
    label.Text = (string.gsub(id, "_", " "))
    label.TextTransparency = 1
    label.TextStrokeTransparency = 1
    banner.Visible = true
    TweenService:Create(label, FADE, { TextTransparency = 0, TextStrokeTransparency = 0.7 }):Play()
    task.delay(3.2, function()
        if bannerToken ~= mine then
            return
        end
        local out =
            TweenService:Create(label, FADE, { TextTransparency = 1, TextStrokeTransparency = 1 })
        out:Play()
        out.Completed:Wait()
        if bannerToken == mine then
            banner.Visible = false
        end
    end)
end)

---------------------------------------------------------------- Layout
-- Evidence collapses under 500px. Top slides left of RoleTag when the screen
-- is too narrow to centre it without overlap.
local function fit()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end
    local vp = camera.ViewportSize
    narrow = vp.X < Theme.NARROW_WIDTH
    evidence.Size = narrow and UDim2.new(0, 240, 0, 96) or UDim2.new(0, 340, 0, 150)

    local tagWidth = narrow and 150 or 190
    roleTag.Size = UDim2.new(0, tagWidth, 0, 58)
    if vp.X >= 420 + 2 * (tagWidth + 24) then
        top.AnchorPoint = Vector2.new(0.5, 0)
        top.Position = UDim2.new(0.5, 0, 0, 14)
        top.Size = UDim2.new(0, 420, 0, 58)
    else
        top.AnchorPoint = Vector2.zero
        top.Position = UDim2.new(0, 14, 0, 14)
        top.Size = UDim2.new(0, math.clamp(vp.X - tagWidth - 38, 160, 420), 0, 58)
    end
    renderEvidence()
end

local viewportConn
local function watchCamera()
    if viewportConn then
        viewportConn:Disconnect()
    end
    local camera = workspace.CurrentCamera
    if camera then
        viewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
    end
    fit()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()
renderAction()

return HudController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">InputController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/InputController
-- The client only asks; the server decides. Client cooldowns here are
-- cosmetic — they exist so honest players never brush the remote rate limit.
local CollectionService = game:GetService("CollectionService")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Config = require(ReplicatedStorage:WaitForChild("Shared").Config)
local Theme = require(ReplicatedStorage.Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)
local CombatFeel = require(script.Parent.CombatFeelController)

local plr = Players.LocalPlayer
local InputController = {}
local lastUse: { [string]: number } = {}
local ability: { text: string, untilTime: number }? = nil
local reviveSpent = false -- the medic gets one per round; the prompt stops offering it

local function isTouch(): boolean
    return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
end

local function cooled(action: string, cooldown: number): boolean
    local t = os.clock()
    if t - (lastUse[action] or 0) < cooldown then
        return false
    end
    lastUse[action] = t
    return true
end

local function myPosition(): Vector3?
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return nil
    end
    return (char :: Model):GetPivot().Position
end

local function inRound(): boolean
    return ClientState.GetRoundState() == "ACTIVE" and ClientState.role ~= nil
end

-- The unarmed civilian roles, the ones that may take a fallen sheriff's
-- pistol. The server decides for real (RoleService:MakeHero); this only keeps
-- the prompt honest. It used to read `role == "innocent"`, so a medic or a
-- snitch standing on the gun got no prompt and USE did nothing at all.
local PISTOL_ROLES: { [string]: boolean } = Config.PISTOL_ROLES :: any
local function canTakePistol(role: string?): boolean
    return role ~= nil and PISTOL_ROLES[role] == true
end

-- A Player, or an NPC's character model (the server resolves either)
local function nearestTarget(origin: Vector3): Instance?
    local best, bestDist = nil, Config.KNIFE_RANGE
    local function consider(target: Instance, char: Model?)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            local d = ((char :: Model):GetPivot().Position - origin).Magnitude
            if d < bestDist then
                best, bestDist = target, d
            end
        end
    end
    for _, other in Players:GetPlayers() do
        if other ~= plr then
            consider(other, other.Character)
        end
    end
    for _, model in CollectionService:GetTagged("BotCharacter") do
        if model:IsA("Model") then
            consider(model, model)
        end
    end
    return best
end

local function nearestTagged(tag: string, origin: Vector3, range: number): Instance?
    local best, bestDist = nil, range
    for _, inst in CollectionService:GetTagged(tag) do
        if inst:IsDescendantOf(workspace) then
            local pos = if inst:IsA("Model")
                then inst:GetPivot().Position
                else (inst :: BasePart).Position
            local d = (pos - origin).Magnitude
            if d < bestDist then
                best, bestDist = inst, d
            end
        end
    end
    return best
end

local function aimAt(screenX: number, screenY: number): Vector3
    local cam = workspace.CurrentCamera
    local ray = cam:ViewportPointToRay(screenX, screenY)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { plr.Character :: Model }
    local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    return hit and hit.Position or (ray.Origin + ray.Direction * 1000)
end

local function aimPoint(): Vector3
    if isTouch() then
        local vp = workspace.CurrentCamera.ViewportSize
        return aimAt(vp.X / 2, vp.Y / 2)
    end
    local m = UserInputService:GetMouseLocation()
    return aimAt(m.X, m.Y)
end

-- Aim assist for guns and thrown knives. On a phone the shot went to dead
-- screen-centre with no crosshair, so unless a target was perfectly centred you
-- missed and "nothing happened". This snaps the shot onto the nearest character
-- close to where you are aiming (players and NPCs), within a cone and in range.
-- The server still re-validates the hit and applies the sheriff's misfire rule,
-- so this only helps you point - it can't fake a kill.
local function assistedAim(range: number): Vector3?
    local cam = workspace.CurrentCamera
    if not cam then
        return nil
    end
    local vp = cam.ViewportSize
    local center = Vector2.new(vp.X, vp.Y) / 2
    local limit = math.min(vp.X, vp.Y) * 0.22 -- how far off centre we still help
    local eye = cam.CFrame.Position
    local best, bestPixels = nil, limit
    local function consider(char: Model?)
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char
            and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
        if not (hum and hum.Health > 0 and root and root:IsA("BasePart")) then
            return
        end
        local pos = root.Position + Vector3.new(0, 0.5, 0)
        if (pos - eye).Magnitude > range then
            return
        end
        local sp, onScreen = cam:WorldToViewportPoint(pos)
        if not onScreen or sp.Z <= 0 then
            return
        end
        local pixels = (Vector2.new(sp.X, sp.Y) - center).Magnitude
        if pixels < bestPixels then
            best, bestPixels = pos, pixels
        end
    end
    for _, other in Players:GetPlayers() do
        if other ~= plr then
            consider(other.Character)
        end
    end
    for _, model in CollectionService:GetTagged("BotCharacter") do
        if model:IsA("Model") then
            consider(model)
        end
    end
    return best
end

---------------------------------------------------------------- Actions
local function interact()
    local pos = myPosition()
    if not (pos and inRound()) then
        return
    end
    local role = ClientState.role
    if role == "murderer" or role == "assassin" then
        local target = nearestTarget(pos)
        if target then
            if cooled("knife", Config.KNIFE_COOLDOWN) then
                Remotes.RequestStab:FireServer(target)
                CombatFeel.Kick(0.15, 0.12)
            end
            return
        end
    end
    -- The pistol is offered before the body, because a fallen sheriff leaves
    -- both in the same spot and EXAMINE_RANGE (14) reaches further than
    -- GUN_PICKUP_RANGE (10): anyone close enough to take the gun is also close
    -- enough to examine the body, so the body won every press and the gun
    -- could not be picked up at all. Taking it destroys it, so the press after
    -- examines as usual.
    if canTakePistol(role) and nearestTagged("DroppedPistol", pos, Config.GUN_PICKUP_RANGE) then
        if cooled("pickup", 0.5) then
            Remotes.RequestPickup:FireServer()
        end
        return
    end
    local body = nearestTagged("Body", pos, Config.EXAMINE_RANGE)
    if body then
        if cooled("examine", Config.EXAMINE_TIME) then
            Remotes.RequestExamine:FireServer(body)
        end
    end
end

local function fire()
    local role = ClientState.role
    if
        (role == "sheriff" or role == "hero")
        and inRound()
        and myPosition()
        and cooled("gun", Config.GUN_COOLDOWN)
    then
        local aim = isTouch() and (assistedAim(Config.GUN_RANGE) or aimPoint()) or aimPoint()
        Remotes.RequestShoot:FireServer(aim)
        CombatFeel.Kick(0.26, 0.15)
    end
end

local function throw()
    if
        (ClientState.role == "murderer" or ClientState.role == "assassin")
        and inRound()
        and myPosition()
        and cooled("throw", Config.THROW_COOLDOWN)
    then
        local reach = Config.THROW_MAX_FLIGHT * Config.THROW_SPEED
        local aim = isTouch() and (assistedAim(reach) or aimPoint()) or aimPoint()
        Remotes.RequestThrow:FireServer(aim)
        CombatFeel.Kick(0.19, 0.13)
    end
end

local function revive()
    local pos = myPosition()
    if ClientState.role ~= "medic" or not (pos and inRound()) then
        return
    end
    -- Only a body a revive could still land on carries Revivable: a person's,
    -- not an NPC's, and not one somebody has already examined. Pressing REVIVE
    -- over anything else now says why rather than doing nothing.
    local body = nearestTagged("Revivable", pos, Config.EXAMINE_RANGE)
    if reviveSpent or not body then
        local text = if reviveSpent
            then "Revive already used"
            elseif nearestTagged("Body", pos, Config.EXAMINE_RANGE) then "Nothing to bring back"
            else "No body within reach"
        ability = { text = text, untilTime = os.clock() + 1.5 }
        return
    end
    if cooled("revive", 1) then
        Remotes.RequestRevive:FireServer(body)
    end
end

local function dragStart()
    local pos = myPosition()
    if not (pos and inRound()) then
        return
    end
    local body = nearestTagged("Body", pos, Config.EXAMINE_RANGE)
    if not body then
        ability = { text = "No body within reach", untilTime = os.clock() + 1.5 }
        return
    end
    if cooled("drag", 0.3) then
        Remotes.RequestDrag:FireServer(body, false)
    end
end

local function dragStop()
    Remotes.RequestDrag:FireServer(nil, true)
end

---------------------------------------------------------------- Touch buttons
-- On-screen buttons are our own, not ContextActionService's. Its buttons take
-- fixed pixel offsets inside Roblox's touch frame, and on a large tablet the
-- jump button is bigger and sits further in, so fixed offsets land on top of
-- it. These are laid out from the real jump button's screen rectangle, in an
-- arc to its left, and laid out again whenever it or the viewport moves.
local touchGui: ScreenGui? = nil
local touchButtons: { [string]: TextButton } = {}
local touchOrder: { string } = {}
local heldInputs: { [InputObject]: () -> () } = {}
local watchedJump: GuiObject? = nil

local function isPress(input: InputObject): boolean
    return input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1
end

local function touchRoot(): ScreenGui
    if touchGui then
        return touchGui
    end
    local gui = Instance.new("ScreenGui")
    gui.Name = "ColdCaseTouch"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true -- so absolute screen coordinates map straight onto it
    gui.DisplayOrder = 5
    gui.Parent = plr:WaitForChild("PlayerGui")
    touchGui = gui
    return gui
end

local function jumpButton(): GuiObject?
    local pg = plr:FindFirstChild("PlayerGui")
    local touch = pg and pg:FindFirstChild("TouchGui")
    local frame = touch and touch:FindFirstChild("TouchControlFrame")
    local jump = frame and frame:FindFirstChild("JumpButton")
    return if jump and jump:IsA("GuiObject") then jump else nil
end

local layoutTouch -- defined below; the jump-button watcher calls it

local function watchJump(jump: GuiObject)
    if watchedJump == jump then
        return
    end
    watchedJump = jump
    jump:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        layoutTouch()
    end)
    jump:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        layoutTouch()
    end)
end

layoutTouch = function()
    local n = #touchOrder
    if n == 0 then
        return
    end
    local cam = workspace.CurrentCamera
    local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
    local jump = jumpButton()
    local centre: Vector2, jumpSize: number
    if jump and jump.AbsoluteSize.X > 0 then
        watchJump(jump)
        centre = jump.AbsolutePosition + jump.AbsoluteSize / 2
        jumpSize = jump.AbsoluteSize.X
    else
        -- Roblox's own sizes: 120px on a large screen, 70px on a phone
        jumpSize = if math.min(vp.X, vp.Y) > 600 then 120 else 70
        centre = Vector2.new(vp.X - 20 - jumpSize / 2, vp.Y - 20 - jumpSize / 2)
    end
    local gap = 12
    -- From due left of the jump button round to straight above it
    local step = if n > 1 then math.min(math.rad(50), math.rad(90) / (n - 1)) else 0
    local size = math.clamp(math.floor(jumpSize * 0.62), Theme.TAP_MIN, 80)
    local radius = 0
    while true do
        radius = jumpSize / 2 + size / 2 + gap
        if n > 1 then
            -- Never so tight that neighbours on the arc touch
            radius = math.max(radius, (size + gap) / (2 * math.sin(step / 2)))
        end
        -- The leftmost button stays inside the reach the social dock budgets for
        local reach = vp.X - (centre.X - radius - size / 2)
        if reach <= Theme.TOUCH_REACH or size <= Theme.TAP_MIN then
            break
        end
        size -= 2
    end
    for i, name in touchOrder do
        local button = touchButtons[name]
        if button then
            local angle = math.pi - (i - 1) * step
            local at = centre + Vector2.new(math.cos(angle), -math.sin(angle)) * radius
            button.Size = UDim2.fromOffset(size, size)
            button.Position = UDim2.fromOffset(math.round(at.X), math.round(at.Y))
            button.TextSize = math.floor(size * 0.22)
        end
    end
end

local function touchButton(name: string, title: string, onBegin, onEnd): TextButton
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = title
    b.FontFace = Theme.DISPLAY
    b.TextColor3 = Theme.INK
    b.BackgroundColor3 = Theme.GROUND
    b.BackgroundTransparency = 0.25
    b.AutoButtonColor = false
    b.AnchorPoint = Vector2.new(0.5, 0.5)
    b.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0.5, 0)
    corner.Parent = b
    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.INK
    stroke.Transparency = 0.55
    stroke.Thickness = 2
    stroke.Parent = b
    b.InputBegan:Connect(function(input)
        if not isPress(input) then
            return
        end
        b.BackgroundTransparency = 0.05
        if onEnd then
            heldInputs[input] = function()
                b.BackgroundTransparency = 0.25
                onEnd()
            end
        else
            task.delay(0.12, function()
                b.BackgroundTransparency = 0.25
            end)
        end
        onBegin()
    end)
    return b
end

-- A held button (DRAG) releases wherever the finger lifts, on the button or off it
UserInputService.InputEnded:Connect(function(input)
    local release = heldInputs[input]
    if release then
        heldInputs[input] = nil
        release()
    end
end)

local function setTouchTitle(name: string, title: string)
    local button = touchButtons[name]
    if button then
        button.Text = title
    end
end

---------------------------------------------------------------- Bindings
-- Keyboard and gamepad always; on-screen buttons only for the actions the
-- current role can take, sized to the 44px tap minimum.
local function bind(name: string, onBegin, onEnd, title: string, ...: Enum.KeyCode)
    ContextActionService:BindAction(name, function(_, inputState)
        if inputState == Enum.UserInputState.Begin then
            onBegin()
        elseif
            onEnd
            and (inputState == Enum.UserInputState.End or inputState == Enum.UserInputState.Cancel)
        then
            onEnd()
        end
        return Enum.ContextActionResult.Sink
    end, false, ...)
    if UserInputService.TouchEnabled then
        local button = touchButton(name, title, onBegin, onEnd)
        button.Parent = touchRoot()
        touchButtons[name] = button
        table.insert(touchOrder, name)
    end
end

local ACTIONS = { "CC_Interact", "CC_Fire", "CC_Throw", "CC_Drag", "CC_Revive" }

local function refreshBindings()
    local role = ClientState.role
    for _, name in ACTIONS do
        ContextActionService:UnbindAction(name)
    end
    for _, button in touchButtons do
        button:Destroy()
    end
    touchButtons, touchOrder = {}, {}
    for input, release in heldInputs do
        heldInputs[input] = nil
        release()
    end
    reviveSpent = false -- a fresh role is a fresh round
    if not role then
        return
    end
    bind("CC_Interact", interact, nil, "USE", Enum.KeyCode.E, Enum.KeyCode.ButtonX)
    bind("CC_Drag", dragStart, dragStop, "DRAG", Enum.KeyCode.F, Enum.KeyCode.ButtonB)
    if role == "sheriff" or role == "hero" then
        bind("CC_Fire", fire, nil, "FIRE", Enum.KeyCode.ButtonR2)
    elseif role == "murderer" or role == "assassin" then
        bind("CC_Throw", throw, nil, "THROW", Enum.KeyCode.Q, Enum.KeyCode.ButtonY)
    elseif role == "medic" then
        bind("CC_Revive", revive, nil, "REVIVE", Enum.KeyCode.R, Enum.KeyCode.ButtonY)
    end
    layoutTouch()
end
ClientState.On("role", refreshBindings)

local camera = workspace.CurrentCamera
if camera then
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutTouch)
end
-- Roblox builds its touch frame after the character spawns, so lay out again
-- once the jump button exists
plr:WaitForChild("PlayerGui").DescendantAdded:Connect(function(d)
    if d.Name == "JumpButton" then
        task.defer(layoutTouch)
    end
end)

UserInputService.InputBegan:Connect(function(input, processed)
    if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
        fire()
    end
end)

---------------------------------------------------------------- Ability feedback
Remotes.AbilityState.OnClientEvent:Connect(function(kind: string, duration: number)
    local now = os.clock()
    if kind == "revive_start" then
        ability = { text = "Reviving… hold still", untilTime = now + duration }
    elseif kind == "revive_failed" then
        ability = { text = "Revive broken — you moved", untilTime = now + 1.5 }
    elseif kind == "revive_done" then
        reviveSpent = true
        ability = { text = "Revived", untilTime = now + 1.5 }
    elseif kind == "drag_start" then
        ability = { text = "Taking hold…", untilTime = now + duration }
    elseif kind == "dragging" then
        ability = {
            text = (isTouch() and "Release DRAG" or "Release F") .. " · dragging",
            untilTime = math.huge,
        }
    elseif kind == "drag_stop" then
        ability = nil
    end
end)

---------------------------------------------------------------- Context prompt
---------------------------------------------------------------- aim reticle
-- A crosshair at screen centre for phone players: touch shots fire at the
-- centre, so without this you aimed at nothing and missed. Shown only while
-- armed and in a round, and hidden behind any open menu.
local reticleDot: Frame? = nil
local function reticle(): Frame
    if reticleDot and reticleDot.Parent then
        return reticleDot
    end
    local g = Instance.new("ScreenGui")
    g.Name = "ColdCaseReticle"
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    g.DisplayOrder = 15
    g.Parent = plr:WaitForChild("PlayerGui")
    local dot = Instance.new("Frame")
    dot.Name = "Dot"
    dot.AnchorPoint = Vector2.new(0.5, 0.5)
    dot.Position = UDim2.fromScale(0.5, 0.5)
    dot.Size = UDim2.fromOffset(6, 6)
    dot.BackgroundColor3 = Theme.INK
    dot.BackgroundTransparency = 0.1
    dot.BorderSizePixel = 0
    dot.Visible = false
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = dot
    for _, rot in { 0, 90, 180, 270 } do
        local tick = Instance.new("Frame")
        tick.AnchorPoint = Vector2.new(0.5, 0.5)
        tick.Size = UDim2.fromOffset(2, 9)
        tick.Rotation = rot
        tick.BackgroundColor3 = Theme.INK
        tick.BackgroundTransparency = 0.4
        tick.BorderSizePixel = 0
        local rad = math.rad(rot)
        tick.Position = UDim2.new(0.5, math.sin(rad) * 12, 0.5, -math.cos(rad) * 12)
        tick.Parent = dot
    end
    dot.Parent = g
    reticleDot = dot
    return dot
end
local AIMS: { [string]: boolean } =
    { sheriff = true, hero = true, murderer = true, assassin = true }

-- The touch USE button relabels to what it will do, like the E prompt does
local shownTitle: string, shownFor: string? = "USE", nil

task.spawn(function()
    while true do
        task.wait(0.1)
        local text, title = "—", "USE"
        local pos = myPosition()
        local role = ClientState.role
        if ability and os.clock() > ability.untilTime then
            ability = nil
        end
        if not inRound() then
            ability = nil
        end

        if pos and role and inRound() then
            local touch = isTouch()
            local use = touch and "USE" or "E"
            local body = nearestTagged("Body", pos, Config.EXAMINE_RANGE)
            local revivable = role == "medic"
                and not reviveSpent
                and nearestTagged("Revivable", pos, Config.EXAMINE_RANGE) ~= nil
            local pistol = canTakePistol(role)
                and nearestTagged("DroppedPistol", pos, Config.GUN_PICKUP_RANGE) ~= nil
            -- Same order as interact(): the pistol first, since it and the
            -- body it fell beside are both within reach at once. A medic keeps
            -- the revive hint either way - REVIVE is its own button.
            if role == "murderer" and nearestTarget(pos) then
                text, title = use .. " · stab", "STAB"
            elseif pistol and revivable then
                text = ("%s · revive   %s · take pistol"):format(touch and "REVIVE" or "R", use)
                title = "TAKE"
            elseif pistol then
                text, title = use .. " · take pistol", "TAKE"
            elseif revivable then
                text = ("%s · revive   %s · examine"):format(touch and "REVIVE" or "R", use)
                title = "EXAMINE"
            elseif body then
                text = ("%s · examine   %s · drag"):format(use, touch and "DRAG" or "F")
                title = "EXAMINE"
            elseif role == "sheriff" or role == "hero" then
                text = (touch and "FIRE" or "Click") .. " · shoot"
            elseif role == "murderer" then
                text = (touch and "THROW" or "Q") .. " · throw knife"
            end
        end
        if ability then
            text = ability.text
        end
        ClientState.Set("prompt", text)

        -- Phone crosshair: visible only while armed, in a round, no menu open.
        reticle().Visible = isTouch()
            and role ~= nil
            and AIMS[role :: string] == true
            and inRound()
            and ClientState.screen == nil

        -- A role change rebinds the button, which resets it to USE
        if role ~= shownFor then
            shownFor, shownTitle = role, "USE"
        end
        if role and title ~= shownTitle then
            shownTitle = title
            setTouchTitle("CC_Interact", title)
        end
    end
end)

-- The server draws weapons when they are used. The hotbar would let a player
-- hold one out, and a knife in hand names the murderer.
pcall(function()
    game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

return InputController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">KillCamController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/KillCamController
-- Design Bible · Resolution: "Killer revealed, kill-cam, payout." When a round
-- ends, the camera circles the murderer's last kill for a few seconds before
-- the results screen. It only runs after RoundOver, when every role is public.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local KillCamController = {}

local gui = Instance.new("ScreenGui")
gui.Name = "KillCam"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Enabled = false
gui.DisplayOrder = 20
gui.Parent = plr:WaitForChild("PlayerGui")

local function bar(anchorY: number): Frame
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0, anchorY)
    f.Position = UDim2.fromScale(0, anchorY)
    f.Size = UDim2.fromScale(1, 0.13)
    f.BackgroundColor3 = Theme.GROUND
    f.BorderSizePixel = 0
    f.Parent = gui
    return f
end
bar(0)
local bottom = bar(1)

local function label(text: string, size: number, colour: Color3, font: Font, y: number): TextLabel
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.AnchorPoint = Vector2.new(0.5, 0.5)
    l.Position = UDim2.fromScale(0.5, y)
    l.Size = UDim2.new(1, -40, 0, size + 6)
    l.Text = text
    l.TextSize = size
    l.TextColor3 = colour
    l.FontFace = font
    l.Parent = bottom
    return l
end
local kicker = label("KILL-CAM", 12, Theme.AMBER, Theme.MONO, 0.28)
local title = label("—", 30, Theme.ROLE.murderer, Theme.DISPLAY, 0.66)

local function lastKill(reveal, timeline)
    local isMurderer = {}
    for name, role in reveal do
        if role == "murderer" then
            isMurderer[name] = true
        end
    end
    for i = #timeline, 1, -1 do
        local e = timeline[i]
        if e.killer and isMurderer[e.killer] and typeof(e.pos) == "Vector3" then
            return e
        end
    end
    return nil
end

local function finish()
    gui.Enabled = false
    local camera = workspace.CurrentCamera
    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    end
    ClientState.Set("killcam", false)
end

Remotes.RoundOver.OnClientEvent:Connect(function(_winner, _reason, reveal, timeline)
    local kill = lastKill(reveal or {}, timeline or {})
    if not kill then
        return
    end
    ClientState.Set("killcam", true)
    kicker.Text = "KILL-CAM"
    title.Text = ("%s  ·  %s"):format(string.upper(kill.killer), string.upper(kill.victim))
    gui.Enabled = true

    local centre = kill.pos + Vector3.new(0, 1.5, 0)
    local started = os.clock()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        local t = os.clock() - started
        local camera = workspace.CurrentCamera
        if t >= Config.KILLCAM_TIME or not camera then
            conn:Disconnect()
            finish()
            return
        end
        -- Re-asserted every frame: the spectator camera hands back control at round end
        local angle = t * 0.6
        camera.CameraType = Enum.CameraType.Scriptable
        camera.CFrame = CFrame.lookAt(
            centre + Vector3.new(math.cos(angle) * 16, 9, math.sin(angle) * 16),
            centre
        )
    end)
end)

return KillCamController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">LeaderboardController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/LeaderboardController
-- A toggleable global-leaderboard panel shown in the lobby: top round wins, top
-- murderer escapes, and richest collections. The server pushes the data over the
-- Leaderboard remote (LeaderboardService); this only renders it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local ORDER = { "wins", "killer", "worth" }

local function commas(n: number): string
    local s = tostring(math.floor(n))
    return (s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
end

local gui = Instance.new("ScreenGui")
gui.Name = "LeaderboardGui"
gui.DisplayOrder = 15
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = plr:WaitForChild("PlayerGui")

local toggle = Instance.new("TextButton")
toggle.Name = "Toggle"
toggle.AnchorPoint = Vector2.new(0, 0)
toggle.Position = UDim2.fromOffset(16, 70)
toggle.Size = UDim2.fromOffset(150, Theme.TAP_MIN)
toggle.BackgroundColor3 = Theme.CARD
toggle.BorderSizePixel = 0
toggle.FontFace = Theme.DISPLAY
toggle.TextSize = 15
toggle.TextColor3 = Theme.AMBER
toggle.Text = "LEADERBOARD"
toggle.Parent = gui
do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = toggle
    local s = Instance.new("UIStroke")
    s.Color = Theme.AMBER
    s.Transparency = 0.4
    s.Parent = toggle
end

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0, 0)
panel.Position = UDim2.fromOffset(16, 70 + Theme.TAP_MIN + 8)
panel.Size = UDim2.fromOffset(300, 430)
panel.BackgroundColor3 = Theme.CARD
panel.BackgroundTransparency = 0.03
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = gui
do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = panel
    local s = Instance.new("UIStroke")
    s.Color = Theme.STROKE
    s.Parent = panel
    local pad = Instance.new("UIPadding")
    pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10)
    pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
    pad.Parent = panel
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 10)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = panel
end

-- One section per board, rebuilt on each payload.
local sections: { [string]: Frame } = {}
for i, key in ORDER do
    local section = Instance.new("Frame")
    section.Name = key
    section.LayoutOrder = i
    section.BackgroundTransparency = 1
    section.Size = UDim2.new(1, 0, 0, 132)
    section.Parent = panel
    local sl = Instance.new("UIListLayout")
    sl.Padding = UDim.new(0, 2)
    sl.SortOrder = Enum.SortOrder.LayoutOrder
    sl.Parent = section
    sections[key] = section
end

local function label(parent: Instance, order: number, size: number, colour: Color3, font): TextLabel
    local l = Instance.new("TextLabel")
    l.LayoutOrder = order
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(1, 0, 0, size + 2)
    l.FontFace = font
    l.TextSize = size
    l.TextColor3 = colour
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function renderBoard(key: string, board: any)
    local section = sections[key]
    for _, c in section:GetChildren() do
        if c:IsA("TextLabel") then
            c:Destroy()
        end
    end
    label(section, 1, 14, Theme.AMBER, Theme.DISPLAY).Text = (board and board.title) or key
    local rows = (board and board.rows) or {}
    if #rows == 0 then
        label(section, 2, 12, Theme.DIM, Theme.MONO).Text = "no scores yet"
        return
    end
    for i, row in rows do
        local line = label(section, i + 1, 13, Theme.INK, Theme.MONO)
        line.Text = ("%d  %-14s %s"):format(i, row.name:sub(1, 14), commas(row.value))
    end
end

Remotes.Leaderboard.OnClientEvent:Connect(function(payload)
    for _, key in ORDER do
        renderBoard(key, payload and payload[key])
    end
end)

toggle.Activated:Connect(function()
    panel.Visible = not panel.Visible
end)

-- Only in the lobby: hidden the moment a round is live or a full menu is open.
local function refresh()
    local inLobby = ClientState.GetRoundState() == "INTERMISSION"
    gui.Enabled = inLobby
    if not inLobby then
        panel.Visible = false
    end
end
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(refresh)
ClientState.On("screen", refresh)
refresh()

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">MenuController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/MenuController
-- Drives LobbyGui, ResultsGui, CrateGui and InventoryGui (TradeController
-- owns TradeGui). Builds every menu at runtime.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local Catalog = require(Shared.Catalog)
local Rarities = require(Shared.RarityTable)
local Shop = require(Shared.Shop)
local Progression = require(Shared.Progression)
local Lobby = require(Shared.Lobby)
local Modes = require(Shared.Modes)
local LiveOps = require(Shared.LiveOps)
local Products = require(Shared.Products)
local BuildMenus = require(Shared.Build.BuildMenus)
local ItemCard = require(Shared.Build.ItemCard)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local pg = plr:WaitForChild("PlayerGui")
local guis = BuildMenus(pg)
local lobby = guis.lobby.Root
local results = guis.results.Root
local crate = guis.crate.Root
local inv = guis.inventory.Root
local modes = guis.modes.Root
local MenuController = {}

local RARITY_COLOUR = ItemCard.RARITY_COLOUR

-- 60000 -> "60,000", so item values and inventory worth read at a glance.
local function commas(n: number): string
    local s = tostring(math.floor(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    return (out:gsub("^,", ""))
end
local GREEN = Color3.fromHex("4fb0a0")
local QUIET_STROKE = Color3.fromHex("1f252e")
local RAISED = Color3.fromHex("161b22")
local current: string? = nil

local function data()
    return ClientState.data
end

local function setEnabled(b: TextButton, on: boolean)
    b.AutoButtonColor = on
    b.BackgroundTransparency = on and 0 or 0.5
    b.TextTransparency = on and 0 or 0.45
end

local function show(name: string?)
    current = name
    for key, g in guis do
        g.Enabled = key == name
    end
    ClientState.Set("screen", name)
end
ClientState.ShowScreen = show

local function mmss(t: number): string
    t = math.floor(t)
    return ("%d:%02d"):format(t // 60, t % 60)
end

---------------------------------------------------------------- Lobby
local myVote: string? = nil
local tally: { [string]: number } = {}

local function renderVotes()
    local total = 0
    for _, n in tally do
        total += n
    end
    local open = ClientState.GetRoundState() == "INTERMISSION"
    for i, mapName in Config.MAPS do
        local card = lobby.Maps["Map" .. i]
        local n = tally[mapName] or 0
        card.Body.Votes.Text = tostring(n)
        card.Body.BarBg.Bar.Size = UDim2.fromScale(total > 0 and n / total or 0, 1)
        card.Stroke.Color = mapName == myVote and Theme.AMBER or QUIET_STROKE
        local vote = card.Body.Vote
        vote.Text = if not open then "CLOSED" elseif mapName == myVote then "VOTED" else "VOTE"
        setEnabled(vote, open)
    end
end

for i, mapName in Config.MAPS do
    lobby.Maps["Map" .. i].Body.Vote.Activated:Connect(function()
        if ClientState.GetRoundState() ~= "INTERMISSION" then
            return
        end
        myVote = mapName
        Remotes.RequestVote:FireServer(mapName)
        renderVotes()
    end)
end
Remotes.VoteTally.OnClientEvent:Connect(function(t)
    tally = t
    renderVotes()
end)

------------------------------------------------------------ Mode vote (MODES)
-- The next round's mode is a lobby vote now, not just the silent rotation.
local modeOrder = { "classic" }
for _, id in Modes.ROTATION do
    table.insert(modeOrder, id)
end
local myMode: string? = nil
local modeTally: { [string]: number } = {}

local function renderModes()
    local open = ClientState.GetRoundState() == "INTERMISSION"
    local leader, leaderN = nil, 0
    for id, n in modeTally do
        if n > leaderN then
            leader, leaderN = id, n
        end
    end
    for _, id in modeOrder do
        local card = modes.List:FindFirstChild("Mode_" .. id)
        if card then
            card.Votes.Text = tostring(modeTally[id] or 0)
            local isLeader = leaderN > 0 and id == leader
            card.Stroke.Color = if id == myMode
                then Theme.AMBER
                elseif isLeader then GREEN
                else QUIET_STROKE
            local vote = card.Vote
            vote.Text = if not open then "CLOSED" elseif id == myMode then "VOTED" else "VOTE"
            setEnabled(vote, open)
        end
    end
end

for _, id in modeOrder do
    local card = modes.List:FindFirstChild("Mode_" .. id)
    if card then
        card.Vote.Activated:Connect(function()
            if ClientState.GetRoundState() ~= "INTERMISSION" then
                return
            end
            myMode = id
            Remotes.RequestModeVote:FireServer(id)
            renderModes()
        end)
    end
end
Remotes.ModeTally.OnClientEvent:Connect(function(t)
    modeTally = t
    -- An empty tally means the round consumed the votes, so our pick is spent.
    local any = false
    for _ in t do
        any = true
        break
    end
    if not any then
        myMode = nil
    end
    renderModes()
end)

local reported: { [number]: boolean } = {} -- UserIds this client has reported

local function renderPlayers()
    local listFrame = lobby.Players.List
    local template = listFrame.RowTemplate
    for _, c in listFrame:GetChildren() do
        if c:IsA("Frame") and c ~= template then
            c:Destroy()
        end
    end
    local tradingOpen = ReplicatedStorage:GetAttribute("TradingOpen") == true
    local opensDay = ReplicatedStorage:GetAttribute("TradingOpensDay") or LiveOps.TRADING_UNLOCK_DAY
    local everyone = Players:GetPlayers()
    table.sort(everyone, function(a, b)
        return (a:GetAttribute("Rank") or 1) > (b:GetAttribute("Rank") or 1)
    end)
    for i, other in everyone do
        local row = template:Clone()
        row.Name = tostring(other.UserId)
        row.Visible = true
        row.LayoutOrder = i
        local rank = other:GetAttribute("Rank") or 1
        row.PlayerName.Text = other == plr and (other.DisplayName .. " (you)") or other.DisplayName
        row.Rank.Text = if other:GetAttribute("WaitForPlayers") == false
            then ("RANK %d · %s"):format(rank, string.upper(Progression.TitleFor(rank)))
            else ("RANK %d · WAITING"):format(rank)
        row.Trade.Visible = other ~= plr
        -- PolicyService: paid item trading is not allowed in some regions
        local canTrade = tradingOpen and plr:GetAttribute("PaidItemTradingAllowed") == true
        row.Trade.Text = if not tradingOpen
            then ("DAY %d"):format(opensDay)
            elseif canTrade then "TRADE"
            else "N/A"
        setEnabled(row.Trade, canTrade)
        row.Trade.Activated:Connect(function()
            if ReplicatedStorage:GetAttribute("TradingOpen") and other.Parent then
                Remotes.RequestTrade:FireServer("open", other)
                row.Trade.Text = "ASKED"
            end
        end)

        row.Report.Visible = other ~= plr
        row.Report.Text = reported[other.UserId] and "REPORTED" or "REPORT"
        setEnabled(row.Report, not reported[other.UserId])
        local armed = false
        row.Report.Activated:Connect(function()
            if reported[other.UserId] or other.Parent ~= Players then
                return
            end
            if not armed then
                -- One tap arms it, a second sends: a report is never an accident
                armed = true
                row.Report.Text = "CHEATING?"
                task.delay(3, function()
                    if armed and not reported[other.UserId] then
                        armed = false
                        row.Report.Text = "REPORT"
                    end
                end)
                return
            end
            reported[other.UserId] = true
            Remotes.RequestReport:FireServer(other, "exploiting")
            row.Report.Text = "REPORTED"
            setEnabled(row.Report, false)
        end)
        row.Parent = listFrame
    end
end

local function watchPlayer(other: Player)
    other:GetAttributeChangedSignal("Rank"):Connect(renderPlayers)
    other:GetAttributeChangedSignal("WaitForPlayers"):Connect(renderPlayers)
end
Players.PlayerAdded:Connect(function(other)
    watchPlayer(other)
    renderPlayers()
end)
Players.PlayerRemoving:Connect(function()
    task.defer(renderPlayers)
end)
for _, other in Players:GetPlayers() do
    watchPlayer(other)
end
ReplicatedStorage:GetAttributeChangedSignal("TradingOpen"):Connect(renderPlayers)

local STORE = {
    vip = { def = Products.PASSES.vip, pass = true },
    radio = { def = Products.PASSES.radio, pass = true },
    emotes = { def = Products.PASSES.emotes, pass = true },
    coins2500 = { def = Products.PRODUCTS.coins2500 },
    seasonalKey = { def = Products.PRODUCTS.seasonalKey },
}

local function renderSide()
    local d = data()
    local side = lobby.Side
    local rank = d.rank or 1
    local coins = d.coins or 0
    side.Rank.Text = ("%d · %s"):format(rank, string.upper(Progression.TitleFor(rank)))
    side.XpBg.Xp.Size = UDim2.fromScale(math.clamp((d.xp or 0) / Config.XP_PER_RANK, 0, 1), 1)
    side.XpText.Text = ("%d / %d XP"):format(d.xp or 0, Config.XP_PER_RANK)
    side.Coins.Text = ("%d COINS"):format(coins)
    side.Keys.Text = (d.seasonalKeys or 0) > 0 and ("SEASONAL KEYS · %d"):format(d.seasonalKeys)
        or ""

    -- The gap between what they have and what they want, legible from round two
    local price = Shop.CratePrice(Config.CRATE_COST, rank)
    side.Buttons.OpenCrate.Text = coins >= price and ("CRATE · %d"):format(price)
        or ("CRATE · %d/%d"):format(coins, price)

    for key, entry in STORE do
        local b = lobby.Store[key]
        local def = entry.def
        -- A key only opens a random crate, so it is not offered where those are restricted
        local restricted = key == "seasonalKey"
            and plr:GetAttribute("PaidRandomItemsRestricted") ~= false
        b.Visible = def.id ~= 0 and not restricted
        local owned = entry.pass and d.passes and d.passes[key]
        b.Text = owned and (string.upper(def.name) .. " · OWNED")
            or ("%s · %d R$"):format(string.upper(def.name), def.price)
        setEnabled(b, not owned)
    end
end

for key, entry in STORE do
    lobby.Store[key].Activated:Connect(function()
        local def = entry.def
        if def.id == 0 then
            return
        end
        if entry.pass then
            if not (data().passes and data().passes[key]) then
                MarketplaceService:PromptGamePassPurchase(plr, def.id)
            end
        else
            MarketplaceService:PromptProductPurchase(plr, def.id)
        end
    end)
end

-- Wait for a round of real players (every visit starts here, so nobody is
-- swept into a round before their group is in) or press PLAY NOW · NPCS.
-- Held for this visit. `waiting` is true until the server says otherwise.
local waiting = plr:GetAttribute("WaitForPlayers") ~= false

local function renderMode()
    local mode = lobby.Header.Mode
    for _, entry in { { mode.PlayNow, not waiting }, { mode.Wait, waiting } } do
        local b, on = entry[1], entry[2]
        b.BackgroundColor3 = if on then Theme.AMBER else RAISED
        b.TextColor3 = if on then Theme.GROUND else Theme.SOFT
        b.Stroke.Color = if on then Theme.AMBER else QUIET_STROKE
    end
end

local function choose(wait: boolean)
    if wait == waiting then
        return
    end
    waiting = wait
    renderMode()
    Remotes.RequestLobbyMode:FireServer(if wait then "wait" else "play")
end
lobby.Header.Mode.PlayNow.Activated:Connect(function()
    choose(false)
end)
lobby.Header.Mode.Wait.Activated:Connect(function()
    choose(true)
end)
plr:GetAttributeChangedSignal("WaitForPlayers"):Connect(function()
    waiting = plr:GetAttribute("WaitForPlayers") ~= false
    renderMode()
end)
renderMode()

-- Stamped once: the place version cannot change under a running client.
lobby.Build.Text = ("BUILD %d"):format(game.PlaceVersion)

local countdownAccum = 0
RunService.Heartbeat:Connect(function(dt)
    countdownAccum += dt
    if countdownAccum < 0.25 or current ~= "lobby" then
        return
    end
    countdownAccum = 0
    local left = math.max(
        0,
        math.ceil((ReplicatedStorage:GetAttribute("RoundEnds") or 0) - workspace:GetServerTimeNow())
    )
    local everyone = Players:GetPlayers()
    local ready = 0
    for _, other in everyone do
        local waits = if other == plr
            then waiting
            else other:GetAttribute("WaitForPlayers") ~= false
        if not waits then
            ready += 1
        end
    end
    -- Mirrors RoundService, which decides with the same Lobby.Plan. RoundEnds
    -- is 0 while the lobby idles with no countdown.
    local plan =
        Lobby.Plan(#everyone, ready, Config.MIN_PLAYERS, Config.BOT_FILL_TO, Config.BOTS_ENABLED)
    local armed = (ReplicatedStorage:GetAttribute("RoundEnds") or 0) > 0
    local label
    if ClientState.GetRoundState() ~= "INTERMISSION" then
        label = ("ROUND IN PROGRESS · %ds"):format(left)
    elseif not armed then
        label = ("WAITING FOR PLAYERS · %d/%d"):format(#everyone, Config.MIN_PLAYERS)
    elseif plan.full then
        label = ("STARTS IN %ds"):format(left)
    elseif waiting then
        label = ("NEXT ROUND IN %ds · YOU ARE WAITING"):format(left)
    else
        label = ("STARTS IN %ds · %d NPCS JOIN"):format(left, plan.npcs)
    end
    lobby.Header.Countdown.Text = label
end)

---------------------------------------------------------------- Loading
-- The scene's name and a bar across the LOADING window, so the map swap reads
-- as a beat of the game rather than a stall with a bare HUD
local loading = guis.loading.Root

local function renderLoadingName()
    local mapName = ReplicatedStorage:GetAttribute("RoundMap")
    loading.MapName.Text = if type(mapName) == "string"
        then string.upper((mapName:gsub("(%l)(%u)", "%1 %2")))
        else ""
end
ReplicatedStorage:GetAttributeChangedSignal("RoundMap"):Connect(renderLoadingName)
renderLoadingName()

RunService.Heartbeat:Connect(function()
    if current ~= "loading" then
        return
    end
    local left = (ReplicatedStorage:GetAttribute("RoundEnds") or 0) - workspace:GetServerTimeNow()
    local done = math.clamp(1 - left / Config.LOADING_TIME, 0, 1)
    loading.BarBg.Bar.Size = UDim2.fromScale(done, 1)
end)

---------------------------------------------------------------- Results
local BLURB = {
    killed = "The murderer is down. Everyone still standing walks out.",
    wiped = "No one left to tell it. The murderer walks.",
    time = "Time ran out. The survivors make it to dawn.",
    left = "The murderer bolted. Case closed, nobody caught.",
    convicted = "The town named the killer. Justice, by vote.",
    lastStanding = "Last blade standing. The rest are on the floor.",
}
local lastReward = nil
local pendingResults = false

-- KillCamController holds the screen for a few seconds before the verdict
ClientState.On("killcam", function(on)
    if not on and pendingResults then
        pendingResults = false
        show("results")
    end
end)

local function renderReward()
    local r = lastReward
    local rw = results.Lower.Rewards
    rw.Xp.Value.Text = r and ("+%d"):format(r.xp) or "—"
    rw.Coins.Value.Text = r and ("+%d"):format(r.coins) or "—"
    rw.Clues.Value.Text = r and tostring(r.clues or 0) or "—"
    -- Near-miss messaging: honest, and only when they cannot afford a crate
    results.Lower.NearMiss.Text = (r and r.short > 0)
            and ("You were %d coins short."):format(r.short)
        or ""
end

Remotes.RoundReward.OnClientEvent:Connect(function(reward)
    lastReward = reward
    renderReward()
end)

Remotes.RoundOver.OnClientEvent:Connect(function(winner: string, reason: string, reveal, timeline)
    reveal = reveal or {}
    timeline = timeline or {}

    local banner = results.Banner
    local role = ClientState.role
    if role then
        local won = ((role == "murderer") and "murderer" or "innocents") == winner
        banner.BackgroundColor3 = won and Theme.AMBER or Theme.DANGER
        banner.Title.Text = won and "YOU WON" or "YOU LOST"
        banner.Title.TextColor3 = Theme.GROUND
    else
        banner.BackgroundColor3 = Theme.STROKE
        banner.Title.Text = winner == "murderer" and "THE MURDERER WINS" or "THE INNOCENTS WIN"
        banner.Title.TextColor3 = Theme.INK
    end

    local murderers, isMurderer = {}, {}
    for name, r in reveal do
        if r == "murderer" then
            table.insert(murderers, name)
            isMurderer[name] = true
        end
    end
    table.sort(murderers)

    local dead, kills = {}, 0
    for _, e in timeline do
        if e.method == "revived" then
            dead[e.victim] = nil
        else
            dead[e.victim] = true
            if e.killer and isMurderer[e.killer] then
                kills += 1
            end
        end
    end

    local rv = results.Reveal
    rv.KillerName.Text = #murderers > 0 and string.upper(table.concat(murderers, " & ")) or "—"
    rv.KillerTally.Text = ("%s · %d eliminated"):format(
        #murderers > 1 and "were the murderers" or "was the murderer",
        kills
    )

    for _, c in rv.Roster:GetChildren() do
        if c:IsA("Frame") then
            c:Destroy()
        end
    end
    local names = {}
    for name in reveal do
        table.insert(names, name)
    end
    table.sort(names)
    for i, name in names do
        local r = reveal[name]
        local chip = Instance.new("Frame")
        chip.LayoutOrder = i
        chip.BackgroundColor3 = Theme.PANEL
        chip.BorderSizePixel = 0
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 4)
        corner.Parent = chip
        local s = Instance.new("UIStroke")
        s.Color = r == "murderer" and Theme.DANGER or QUIET_STROKE
        s.Parent = chip
        local l = Instance.new("TextLabel")
        l.RichText = true
        local label = ("%s  %s"):format(name, string.upper(r))
        l.Text = dead[name] and ("<s>" .. label .. "</s>") or label
        l.FontFace = Theme.MONO
        l.TextSize = 10
        l.TextColor3 = Theme.ROLE[r] or Theme.BODY
        l.TextTransparency = dead[name] and 0.4 or 0
        l.BackgroundTransparency = 1
        l.Size = UDim2.fromScale(1, 1)
        l.Parent = chip
        chip.Parent = rv.Roster
    end

    local lower = results.Lower
    lower.Blurb.Text = BLURB[reason] or ""
    local tlList = lower.Timeline.List
    for _, c in tlList:GetChildren() do
        if c:IsA("TextLabel") then
            c:Destroy()
        end
    end
    local lines = {}
    for _, e in timeline do
        if e.method == "revived" then
            table.insert(lines, ("%s  %s was revived"):format(mmss(e.at), e.victim))
        else
            table.insert(
                lines,
                ("%s  %s eliminated %s"):format(mmss(e.at), e.killer or "?", e.victim)
            )
        end
    end
    if #lines == 0 then
        lines = { "No one died." }
    end
    for i = math.max(1, #lines - 3), #lines do
        local l = Instance.new("TextLabel")
        l.LayoutOrder = i
        l.Text = lines[i]
        l.FontFace = Theme.MONO
        l.TextSize = 12
        l.TextColor3 = Theme.BODY
        l.TextXAlignment = Enum.TextXAlignment.Left
        l.BackgroundTransparency = 1
        l.Size = UDim2.new(1, 0, 0, 16)
        l.Parent = tlList
    end

    renderReward()
    task.defer(function()
        if ClientState.killcam then
            pendingResults = true
        else
            show("results")
        end
    end)
end)

---------------------------------------------------------------- Crate
local CARD_W, CARD_GAP, WIN_INDEX, REEL_CARDS = 132, 12, 28, 34
local crateId = "locker"
local spinning, reelRunning, spinToken = false, false, 0

local function seasonOpen(): boolean
    return ReplicatedStorage:GetAttribute("SeasonId") ~= nil
end

-- Client mirror of the server's pools: starters never drop, seasonals only
-- from their own crate
local function poolIds(id: string): { string }
    local season = ReplicatedStorage:GetAttribute("SeasonId")
    local out = {}
    for cid, item in Catalog do
        if item.starter then
            continue
        end
        if
            (id == "seasonal" and item.season ~= nil and item.season == season)
            or (id ~= "seasonal" and not item.season)
        then
            table.insert(out, cid)
        end
    end
    table.sort(out)
    return out
end

local function renderOdds()
    local present = {}
    for _, id in poolIds(crateId) do
        present[Catalog[id].rarity] = true
    end
    local total = 0
    for _, r in Rarities do
        if present[r.name] then
            total += r.weight
        end
    end
    for _, r in Rarities do
        local row = crate.Odds.List[r.name]
        local pct = (present[r.name] and total > 0) and (r.weight / total * 100) or 0
        row.Visible = present[r.name] == true
        row.Pct.Text = (math.floor(pct) == pct) and ("%d%%"):format(pct) or ("%.1f%%"):format(pct)
        row.BarBg.Bar.Size = UDim2.fromScale(pct / 100, 1)
    end
end

local function renderCrate(): boolean
    if crateId == "seasonal" and not seasonOpen() then
        crateId = "locker"
    end
    local d = data()
    local coins = d.coins or 0
    local seasonName = ReplicatedStorage:GetAttribute("SeasonName") or "Seasonal"
    local header = crate.Header

    header.Title.Text = crateId == "seasonal" and string.upper(seasonName) or "THE LOCKER"
    header.Tabs.Seasonal.Visible = seasonOpen()
    header.Tabs.Seasonal.Text = string.upper(seasonName)
    for _, key in { "Locker", "Seasonal" } do
        local selected = string.lower(key) == crateId
        header.Tabs[key].Stroke.Color = selected and Theme.AMBER or Color3.fromHex("2b323c")
        header.Tabs[key].TextColor3 = selected and Theme.AMBER or Theme.MUTED
    end
    local daysLeft = ReplicatedStorage:GetAttribute("SeasonDaysLeft")
    header.Countdown.Text = (seasonOpen() and daysLeft)
            and ("%s RETIRES FOREVER IN %d DAYS"):format(string.upper(seasonName), daysLeft)
        or ""
    crate.Odds.Caption.Text = "PUBLISHED ODDS · " .. header.Title.Text
    renderOdds()

    local base = crateId == "seasonal"
            and (ReplicatedStorage:GetAttribute("SeasonCrateCost") or Config.SEASONAL_COST)
        or Config.CRATE_COST
    local price = Shop.CratePrice(base, d.rank or 1)
    local keys = d.seasonalKeys or 0
    local spin = crate.Buttons.Spin
    local canSpin = false
    if spinning then
        spin.Text = "ROLLING…"
    elseif plr:GetAttribute("PaidRandomItemsRestricted") ~= false then
        -- Unset while the server's policy lookup is pending; the server fails closed too
        spin.Text = "NOT AVAILABLE IN YOUR REGION"
    elseif crateId == "seasonal" and keys > 0 then
        spin.Text = ("SPIN · USE KEY (%d)"):format(keys)
        canSpin = true
    elseif coins >= price then
        spin.Text = ("SPIN · %d COINS"):format(price)
        canSpin = true
    else
        spin.Text = ("NEED %d MORE"):format(price - coins)
    end
    setEnabled(spin, canSpin)
    crate.Buttons.Balance.Text = ("%d coins"):format(coins)

    for _, card in crate.Shelf.Items:GetChildren() do
        local id = card:GetAttribute("ItemId")
        if id then
            local p = Shop.PriceOf(id) :: number
            card.Price.Text = ("BUY · %d"):format(p)
            card.Price.TextColor3 = coins >= p and Theme.AMBER or Theme.DIM
        end
    end
    return canSpin
end

local function crateMessage(message: string, colour: Color3)
    crate.WonText.Text = message
    crate.WonText.TextColor3 = colour
end

for i, id in Shop.SHELF do
    local card = ItemCard.new(crate.Shelf.Items, id, nil, true)
    card.LayoutOrder = i
    card:SetAttribute("ItemId", id)
    local price = Instance.new("TextLabel")
    price.Name = "Price"
    price.FontFace = Theme.MONO
    price.TextScaled = true
    price.BackgroundTransparency = 1
    price.Position = UDim2.fromScale(0.05, 0.87)
    price.Size = UDim2.fromScale(0.9, 0.1)
    price.Parent = card
    card.Button.Activated:Connect(function()
        local p = Shop.PriceOf(id) :: number
        if (data().coins or 0) >= p then
            Remotes.RequestBuy:FireServer(id)
        else
            crateMessage(("You are %d coins short."):format(p - (data().coins or 0)), Theme.DANGER)
        end
    end)
end

local function spinReel(res)
    local reel = crate.ReelBox.Reel
    for _, c in reel:GetChildren() do
        if c:IsA("Frame") then
            c:Destroy()
        end
    end
    local ids = poolIds(res.crateId or "locker")
    if #ids == 0 then
        ids = { res.id }
    end
    -- Decoys, with the item the server actually granted at WIN_INDEX
    for i = 1, REEL_CARDS do
        local id = (i == WIN_INDEX) and res.id or ids[math.random(#ids)]
        ItemCard.new(reel, id, UDim2.fromOffset(CARD_W, 150)).LayoutOrder = i
    end
    reel.Position = UDim2.new(0, 12, 0, 16)
    crateMessage("ROLLING…", Theme.DIM)
    reelRunning, spinning = true, true
    renderCrate()

    task.wait() -- let layout settle so the box width is real
    local scale = math.max(crate.Scale.Scale, 0.01)
    local boxWidth = crate.ReelBox.AbsoluteSize.X / scale
    if boxWidth <= 0 then
        boxWidth = 988
    end
    local winCentre = 12 + (WIN_INDEX - 1) * (CARD_W + CARD_GAP) + CARD_W / 2
    local jitter = math.random(-46, 46)
    local tween = TweenService:Create(
        reel,
        TweenInfo.new(5.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Position = UDim2.new(0, boxWidth / 2 - winCentre + jitter, 0, 16) }
    )
    tween:Play()
    tween.Completed:Wait()

    local def = Catalog[res.id]
    crateMessage(
        ("%s · %s"):format(string.upper(def and def.name or "?"), string.upper(res.rarity)),
        RARITY_COLOUR[res.rarity] or Theme.INK
    )
    reelRunning, spinning = false, false
    renderCrate()
end

Remotes.CrateResult.OnClientEvent:Connect(function(res)
    if res.announce or res.gift or res.crafted then
        return -- NoticeController toasts these
    end
    local st = ClientState.GetRoundState()
    if ClientState.role and st ~= "INTERMISSION" and st ~= "RESOLUTION" then
        return -- never pull a participant out of a live round
    end
    crateId = res.crateId or "locker"
    show("crate")
    task.spawn(spinReel, res)
end)

crate.Buttons.Spin.Activated:Connect(function()
    if spinning or not renderCrate() then
        return
    end
    spinning = true
    spinToken += 1
    local mine = spinToken
    Remotes.RequestCrate:FireServer(crateId)
    renderCrate()
    -- The server rejects silently in some cases; do not leave the button stuck
    task.delay(4, function()
        if spinToken == mine and spinning and not reelRunning then
            spinning = false
            renderCrate()
        end
    end)
end)

crate.Header.Tabs.Locker.Activated:Connect(function()
    if not spinning then
        crateId = "locker"
        renderCrate()
    end
end)
crate.Header.Tabs.Seasonal.Activated:Connect(function()
    if not spinning and seasonOpen() then
        crateId = "seasonal"
        renderCrate()
    end
end)
crate.Buttons.Close.Activated:Connect(function()
    show(nil) -- back to the walkable room
end)
for _, attr in { "SeasonId", "SeasonDaysLeft", "SeasonCrateCost" } do
    ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(function()
        if current == "crate" then
            renderCrate()
        end
    end)
end

---------------------------------------------------------------- Inventory
local selected: string? = nil
local renderedInventory, renderedEquipped = nil, nil

-- Starters are owned by everyone and live outside the saved inventory
local function entries()
    local out = { { uid = "ash", id = "ash" }, { uid = "ledger", id = "ledger" } }
    for _, item in data().inventory or {} do
        table.insert(out, item)
    end
    return out
end

local function countOf(id: string): number
    local n = 0
    for _, item in data().inventory or {} do
        if item.id == id then
            n += 1
        end
    end
    return n
end

local function selectedEntry()
    for _, e in entries() do
        if e.uid == selected then
            return e
        end
    end
    return nil
end

local function renderInventoryButtons()
    local e = selectedEntry()
    local def = e and Catalog[e.id]
    local craft, reroll = inv.Buttons.Craft, inv.Buttons.Reroll
    if plr:GetAttribute("PaidRandomItemsRestricted") ~= false then
        -- Both hand out random results for coins; restricted in some regions
        craft.Text = "CRAFTING NOT AVAILABLE"
        reroll.Text = "RE-ROLL NOT AVAILABLE"
        setEnabled(craft, false)
        setEnabled(reroll, false)
        return
    end
    if def and not def.starter then
        local n = countOf(e.id)
        local ready = n >= Config.CRAFT_DUPES
        craft.Text = ready and ("CRAFT %d → 1 · %d"):format(Config.CRAFT_DUPES, Config.CRAFT_FEE)
            or ("CRAFT · %d/%d %s"):format(n, Config.CRAFT_DUPES, string.upper(def.name))
        setEnabled(craft, ready)
    else
        craft.Text = ("CRAFT %d → 1"):format(Config.CRAFT_DUPES)
        setEnabled(craft, false)
    end
    local isKnife = def ~= nil and def.kind == "Knife" and not def.starter
    reroll.Text = isKnife and ("RE-ROLL EFFECT · %d"):format(Config.REROLL_COST)
        or "RE-ROLL EFFECT"
    setEnabled(reroll, isKnife)
end

local function renderInventory()
    local d = data()
    renderedInventory, renderedEquipped = d.inventory, d.equipped
    local scroll = inv.Items
    local template = scroll.ItemTemplate
    for _, c in scroll:GetChildren() do
        if c:IsA("Frame") and c ~= template then
            c:Destroy()
        end
    end
    inv.Summary.Text = ("%d owned · worth %s · %d coins"):format(
        #(d.inventory or {}),
        commas(Shop.ValueOf(d.inventory or {})),
        d.coins or 0
    )

    for i, e in entries() do
        local def = Catalog[e.id]
        if not def then
            continue
        end
        local card = template:Clone()
        card.Name = e.uid
        card.Visible = true
        card.LayoutOrder = i
        local colour = RARITY_COLOUR[def.rarity] or Theme.DIM
        card.Swatch.BackgroundColor3 = colour
        -- Show the real weapon or pet; only an effect keeps the diamond swatch
        if ItemCard.mount(card, e.id) then
            card.Swatch.Visible = false
        end
        card.ItemName.Text = def.name
        card.Rarity.Text = ("%s · %s · %s"):format(
            def.starter and "STARTER" or string.upper(def.rarity),
            string.upper(def.kind),
            commas(def.value or 0)
        )
        card.Rarity.TextColor3 = colour
        card.Effect.Text = (def.kind == "Knife" and not def.starter)
                and ("EFFECT · %s"):format(string.upper(e.effect or "none"))
            or ""
        local slot = Shop.SLOT_FOR_KIND[def.kind]
        local equipped = d.equipped ~= nil and slot ~= nil and d.equipped[slot] == e.id
        card.Equip.Text = equipped and "EQUIPPED" or "EQUIP"
        setEnabled(card.Equip, not equipped)
        card.Stroke.Color = e.uid == selected and Theme.INK or QUIET_STROKE
        card.Select.Activated:Connect(function()
            selected = e.uid
            renderInventory()
        end)
        card.Equip.Activated:Connect(function()
            selected = e.uid
            Remotes.RequestEquip:FireServer(e.uid)
        end)
        card.Parent = scroll
    end
    renderInventoryButtons()
end

inv.Buttons.Craft.Activated:Connect(function()
    local e = selectedEntry()
    if e and not Catalog[e.id].starter then
        Remotes.RequestCraft:FireServer(e.id)
    end
end)
inv.Buttons.Reroll.Activated:Connect(function()
    local e = selectedEntry()
    if e and not Catalog[e.id].starter then
        Remotes.RequestReroll:FireServer(e.uid)
    end
end)
inv.Buttons.Close.Activated:Connect(function()
    show(nil) -- back to the walkable room
end)

lobby.Side.Buttons.OpenCrate.Activated:Connect(function()
    show("crate")
    renderCrate()
end)
lobby.Side.Buttons.OpenInventory.Activated:Connect(function()
    inv.Status.Text = ""
    show("inventory")
    renderInventory()
end)
lobby.Side.Buttons.OpenModes.Activated:Connect(function()
    show("modes")
    renderModes()
end)
modes.Buttons.Close.Activated:Connect(function()
    show(nil) -- back to the walkable room
end)
results.Lower.Buttons.NextRound.Activated:Connect(function()
    show(nil) -- back to the walkable room
end)
results.Lower.Buttons.OpenCrate.Activated:Connect(function()
    show("crate")
    renderCrate()
end)

Remotes.ShopResult.OnClientEvent:Connect(function(ok: boolean, message: string)
    local colour = ok and GREEN or Theme.DANGER
    if current == "crate" then
        crateMessage(message, colour)
        if not reelRunning then
            spinning = false
        end
        renderCrate()
    elseif current == "inventory" then
        inv.Status.Text = message
        inv.Status.TextColor3 = colour
    end
end)

ClientState.On("data", function(d)
    renderSide()
    if current == "crate" then
        renderCrate()
    elseif current == "inventory" then
        if d.inventory ~= renderedInventory or d.equipped ~= renderedEquipped then
            renderInventory()
        else
            inv.Summary.Text = ("%d owned · worth %s · %d coins"):format(
                #(d.inventory or {}),
                commas(Shop.ValueOf(d.inventory or {})),
                d.coins or 0
            )
        end
    end
end)

-- Regional policy arrives from the server shortly after join
for _, attr in { "PaidRandomItemsRestricted", "PaidItemTradingAllowed" } do
    plr:GetAttributeChangedSignal(attr):Connect(function()
        renderPlayers()
        renderSide()
        if current == "crate" then
            renderCrate()
        elseif current == "inventory" then
            renderInventoryButtons()
        end
    end)
end

---------------------------------------------------------------- Flow + layout
local function onState()
    local st = ClientState.GetRoundState()
    if st == "INTERMISSION" then
        myVote, tally, lastReward = nil, {}, nil
        myMode, modeTally = nil, {}
        -- MM2-style: land in the walkable room, not a menu. The ☰ LOBBY MENU
        -- button opens the vote/store on demand.
        if current == "results" or current == "loading" then
            show(nil)
        end
    elseif st == "LOADING" then
        show("loading")
    elseif st == "REVEAL" then
        show(nil)
    elseif st == "ACTIVE" then
        if ClientState.role then
            show(nil)
        elseif current == nil then
            show("lobby") -- spectators and late joiners wait in the lobby menus
        end
    end
    renderVotes()
    renderModes()
end
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(onState)

-- Every Root is a fixed canvas; shrink it to fit phones
local function fit()
    local camera = workspace.CurrentCamera
    if not camera then
        return
    end
    local vp = camera.ViewportSize
    for _, g in guis do
        local root = g.Root
        local size = root.Size
        -- Fill the screen up to 1.5x native: at 1x the 1040x640 canvas floated
        -- small in the middle of a tablet with wide empty margins and read as
        -- broken. Now it grows to fill a big screen (capped so a large desktop
        -- monitor does not blow it up), and still shrinks to fit a small phone -
        -- a floor of 0.35 once left it hanging off the side, so there is none.
        root.Scale.Scale = math.min((vp.X - 24) / size.X.Offset, (vp.Y - 24) / size.Y.Offset, 1.5)
    end
end
local viewportConn
local function watchCamera()
    if viewportConn then
        viewportConn:Disconnect()
    end
    local camera = workspace.CurrentCamera
    if camera then
        viewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)
    end
    fit()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

-- Walkable lobby. The vote/store menu used to seal the room off (its backdrop
-- sinks input and dims the world), so the trade tables, pedestals and knife
-- showcase were unreachable - you never saw the room. Now the menu can be
-- dismissed to walk it, and a persistent button brings it back.
do
    local function skin(inst: GuiObject, colour: Color3, textColour: Color3)
        inst.BackgroundColor3 = colour
        inst.BorderSizePixel = 0
        inst.FontFace = Theme.DISPLAY
        inst.TextColor3 = textColour
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = inst
        local stroke = Instance.new("UIStroke")
        stroke.Color = Theme.STROKE
        stroke.Parent = inst
    end

    -- "Walk lobby" closes the menu to the room. Parented to the lobby Root so it
    -- rides above the menu; ZIndex keeps it on top.
    local walk = Instance.new("TextButton")
    walk.Name = "WalkLobby"
    walk.AnchorPoint = Vector2.new(1, 0)
    walk.Position = UDim2.new(1, -16, 0, 16)
    walk.Size = UDim2.fromOffset(160, 40)
    walk.ZIndex = 20
    walk.TextSize = 15
    walk.Text = "✕  WALK LOBBY"
    skin(walk, Theme.CARD, Theme.AMBER)
    walk.Parent = lobby
    walk.Activated:Connect(function()
        show(nil)
    end)

    -- A persistent bar, shown while walking the lobby, to reopen the menu.
    local bar = Instance.new("ScreenGui")
    bar.Name = "LobbyBar"
    bar.ResetOnSpawn = false
    bar.IgnoreGuiInset = true
    bar.DisplayOrder = 8
    bar.Enabled = false
    bar.Parent = pg
    local menuBtn = Instance.new("TextButton")
    menuBtn.AnchorPoint = Vector2.new(0.5, 1)
    menuBtn.Position = UDim2.new(0.5, 0, 1, -18)
    menuBtn.Size = UDim2.fromOffset(210, 46)
    menuBtn.TextSize = 18
    menuBtn.Text = "☰  LOBBY MENU"
    skin(menuBtn, Theme.AMBER, Theme.GROUND)
    menuBtn.Parent = bar
    menuBtn.Activated:Connect(function()
        show("lobby")
    end)

    -- A prominent GAME MODE button in the walkable room: mode selection was
    -- otherwise buried inside the menu. Shows the mode currently winning the
    -- vote (or the next one) and opens the MODES vote panel directly.
    local modeBtn = Instance.new("TextButton")
    modeBtn.AnchorPoint = Vector2.new(0.5, 1)
    modeBtn.Position = UDim2.new(0.5, 0, 1, -18 - 46 - 8)
    modeBtn.Size = UDim2.fromOffset(210, 40)
    modeBtn.TextSize = 15
    skin(modeBtn, Theme.CARD, Theme.AMBER)
    modeBtn.Parent = bar
    modeBtn.Activated:Connect(function()
        show("modes")
        renderModes()
    end)

    -- INVENTORY in the walkable room too: your unlocked weapons live in the
    -- collection, and this opens it straight to equip them without the menu.
    local invBtn = Instance.new("TextButton")
    invBtn.AnchorPoint = Vector2.new(0.5, 1)
    invBtn.Position = UDim2.new(0.5, 0, 1, -18 - 46 - 8 - 40 - 8)
    invBtn.Size = UDim2.fromOffset(210, 40)
    invBtn.TextSize = 15
    invBtn.Text = "🎒  INVENTORY"
    skin(invBtn, Theme.CARD, Theme.CYAN)
    invBtn.Parent = bar
    invBtn.Activated:Connect(function()
        inv.Status.Text = ""
        show("inventory")
        renderInventory()
    end)

    local function modeButtonText(): string
        local leader, best = nil, 0
        for id, n in modeTally do
            if n > best then
                leader, best = id, n
            end
        end
        if leader then
            return ("🎮  %s  ▸"):format(string.upper(Modes.Get(leader).name))
        end
        return "🎮  PICK GAME MODE"
    end
    modeBtn.Text = modeButtonText()
    Remotes.ModeTally.OnClientEvent:Connect(function()
        modeBtn.Text = modeButtonText()
    end)

    local function refreshBar()
        -- Show the reopen buttons only in the lobby with the menu dismissed.
        bar.Enabled = ClientState.GetRoundState() == "INTERMISSION" and ClientState.screen == nil
        modeBtn.Text = modeButtonText()
    end
    ClientState.On("screen", refreshBar)
    ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(refreshBar)
    refreshBar()
end

renderPlayers()
renderSide()
renderVotes()
renderModes()
onState()

return MenuController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">NoticeController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/NoticeController
-- Ghost hints (Handbook §02) and short toasts, drawn above every menu.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local BuildNotices = require(Shared.Build.BuildNotices)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local playerGui = plr:WaitForChild("PlayerGui")
local gui = playerGui:FindFirstChild("NoticeHud") or BuildNotices(playerGui)
local NoticeController = {}
local FADE = TweenInfo.new(0.35)

---------------------------------------------------------------- Toasts
local queue: { string } = {}
local toasting = false

local function toast(text: string)
    table.insert(queue, text)
    if toasting then
        return
    end
    toasting = true
    task.spawn(function()
        while #queue > 0 do
            gui.Toast.Text = table.remove(queue, 1)
            TweenService
                :Create(gui.Toast, FADE, { TextTransparency = 0, TextStrokeTransparency = 0.7 })
                :Play()
            task.wait(2.6)
            local out = TweenService:Create(
                gui.Toast,
                FADE,
                { TextTransparency = 1, TextStrokeTransparency = 1 }
            )
            out:Play()
            out.Completed:Wait()
        end
        toasting = false
    end)
end

Remotes.Notify.OnClientEvent:Connect(toast)

Remotes.CrateResult.OnClientEvent:Connect(function(r)
    if r.announce then
        toast(("%s pulled %s · %s"):format(r.player, r.item, string.upper(r.rarity)))
    elseif r.crafted then
        local item = Catalog[r.id]
        toast(
            ("CRAFTED %s · %s"):format(
                item and string.upper(item.name) or "?",
                string.upper(r.rarity)
            )
        )
    end
    -- Own pulls spin on the crate screen; rank gifts arrive with a Notify
end)

Remotes.ShopResult.OnClientEvent:Connect(function(_ok, message: string)
    -- The crate and inventory screens show these inline
    if ClientState.screen ~= "crate" and ClientState.screen ~= "inventory" then
        toast(message)
    end
end)

Remotes.TradeComplete.OnClientEvent:Connect(function()
    toast("Trade complete.")
end)

---------------------------------------------------------------- Hints
-- Three ghost prompts, once each per account. No tutorial level.
local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
local HINT_TEXT = {
    move = touch and "Drag the thumbstick to move" or "WASD to move",
    examine = touch and "Tap USE to examine a body" or "E to examine a body",
    coins = "Coins are on the floor",
}
local shown: { [string]: boolean } = {}
local hintBusy = false

local function showHint(id: string)
    if shown[id] or not ClientState.loaded or ClientState.data.hintsSeen[id] then
        return
    end
    while hintBusy do
        task.wait(0.25)
    end
    if shown[id] then
        return
    end
    shown[id] = true
    hintBusy = true
    gui.Hint.Text = HINT_TEXT[id]
    TweenService:Create(gui.Hint, FADE, { TextTransparency = 0.15 }):Play()
    task.wait(3.5)
    local out = TweenService:Create(gui.Hint, FADE, { TextTransparency = 1 })
    out:Play()
    out.Completed:Wait()
    hintBusy = false
    ClientState.data.hintsSeen[id] = true
    Remotes.HintSeen:FireServer(id)
end

task.spawn(function()
    while true do
        task.wait(0.25)
        if ClientState.GetRoundState() ~= "ACTIVE" or not ClientState.role or shown.examine then
            continue
        end
        local char = plr.Character
        if not char then
            continue
        end
        local here = char:GetPivot().Position
        for _, body in CollectionService:GetTagged("Body") do
            if
                body:IsA("Model")
                and (body:GetPivot().Position - here).Magnitude <= Config.EXAMINE_RANGE * 2
            then
                task.spawn(showHint, "examine")
                break
            end
        end
    end
end)

ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if ClientState.GetRoundState() == "ACTIVE" and ClientState.role then
        task.spawn(showHint, "move")
        task.delay(6, function()
            if ClientState.GetRoundState() == "ACTIVE" then
                showHint("coins")
            end
        end)
    end
end)

return NoticeController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">PedestalController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/PedestalController
-- Renders the knife a player has featured on a lobby pedestal: it hovers above
-- the stand, slowly spinning, with an owner + item nameplate. Driven entirely by
-- the pedestal's replicated attributes (Item / OwnerName), set by PedestalService.
-- Models come from the replicated ReplicatedStorage.PreviewModels; chroma blades
-- cycle their hue. This is the fixed-stand cousin of ShowcaseController.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Theme = require(Shared.Theme)
local ItemCard = require(Shared.Build.ItemCard)

type Display = { id: string, model: Model, chroma: boolean, platform: BasePart }
local displays: { [Model]: Display } = {}

local folder = Instance.new("Folder")
folder.Name = "PedestalDisplays"
folder.Parent = workspace

local function clear(ped: Model)
    local d = displays[ped]
    if d then
        d.model:Destroy()
        displays[ped] = nil
    end
end

local function build(ped: Model)
    clear(ped)
    local id = ped:GetAttribute("Item")
    local def = type(id) == "string" and id ~= "" and Catalog[id]
    local platform = ped.PrimaryPart
    if not (def and def.kind == "Knife" and platform) then
        return
    end
    local previews = ReplicatedStorage:FindFirstChild("PreviewModels")
    local template = previews and previews:FindFirstChild(id)
    if not (template and template:IsA("Model")) then
        return
    end
    local model = template:Clone()
    for _, part in model:GetDescendants() do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
            part.CanQuery = false
            part.CanTouch = false
            part.CastShadow = false
        end
    end
    pcall(function()
        model:ScaleTo(0.85)
    end)
    local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if anchor then
        local tag = Instance.new("BillboardGui")
        tag.Name = "Plate"
        tag.Size = UDim2.fromOffset(190, 24)
        tag.StudsOffset = Vector3.new(0, 2, 0)
        tag.AlwaysOnTop = true
        tag.MaxDistance = 60
        tag.LightInfluence = 0
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.FontFace = Theme.DISPLAY
        label.TextSize = 14
        label.Text = ("%s · %s"):format(
            ped:GetAttribute("OwnerName") or "",
            string.upper(def.name)
        )
        label.TextColor3 = ItemCard.RARITY_COLOUR[def.rarity] or Theme.INK
        label.TextStrokeTransparency = 0.5
        label.Parent = tag
        tag.Adornee = anchor
        tag.Parent = anchor
    end
    model.Parent = folder
    displays[ped] =
        { id = id :: string, model = model, chroma = def.chroma == true, platform = platform }
end

local function watch(ped: Model)
    ped:GetAttributeChangedSignal("Item"):Connect(function()
        build(ped)
    end)
    build(ped)
end
for _, ped in CollectionService:GetTagged("Pedestal") do
    watch(ped)
end
CollectionService:GetInstanceAddedSignal("Pedestal"):Connect(watch)
CollectionService:GetInstanceRemovedSignal("Pedestal"):Connect(clear)

RunService.RenderStepped:Connect(function()
    local t = os.clock()
    local chromaColour = Color3.fromHSV((t * 0.25) % 1, 0.85, 1)
    for _, d in displays do
        local pos = d.platform.Position + Vector3.new(0, 1.7, 0)
        d.model:PivotTo(
            CFrame.new(pos) * CFrame.Angles(0, t * 1.1, 0) * CFrame.Angles(math.rad(15), 0, 0)
        )
        if d.chroma then
            for _, part in d.model:GetDescendants() do
                if part:IsA("BasePart") then
                    part.Color = chromaColour
                end
            end
        end
    end
end)

return {}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">PetController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/PetController
-- Draws every player's pet locally from their "Pet" attribute (set by
-- CosmeticService). Pets follow at the shoulder with a slow bob and never touch
-- physics or raycasts. Models come from ReplicatedStorage.PetModels.<itemId>
-- in the place file; without one, a small rarity-coloured orb stands in.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local ItemCard = require(Shared.Build.ItemCard)

local PetController = {}
local pets: { [Player]: { id: string, model: Model, placed: boolean } } = {}
local dark = false

local folder = Instance.new("Folder")
folder.Name = "Pets"
folder.Parent = workspace

local function build(id: string): Model
    local templates = ReplicatedStorage:FindFirstChild("PetModels")
    local template = templates and templates:FindFirstChild(id)
    local model: Model
    if template and template:IsA("Model") then
        model = template:Clone()
    else
        model = Instance.new("Model")
        local orb = Instance.new("Part")
        orb.Shape = Enum.PartType.Ball
        orb.Size = Vector3.new(0.8, 0.8, 0.8)
        local def = Catalog[id]
        orb.Color = (def and ItemCard.RARITY_COLOUR[def.rarity]) or Color3.new(1, 1, 1)
        orb.Material = Enum.Material.SmoothPlastic
        orb.Parent = model
        model.PrimaryPart = orb
    end
    for _, d in model:GetDescendants() do
        if d:IsA("LuaSourceContainer") then
            d:Destroy()
        elseif d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.CanQuery = false
            d.CanTouch = false
            d.CastShadow = false
        elseif d:IsA("Light") then
            d:SetAttribute("BaseBrightness", d.Brightness)
        end
    end
    return model
end

-- Nightwatch "dims during Lights Out instead of helping"
local function applyDark()
    for _, pet in pets do
        for _, d in pet.model:GetDescendants() do
            if d:IsA("Light") then
                local base = d:GetAttribute("BaseBrightness") or d.Brightness
                d.Brightness = dark and base * 0.1 or base
            end
        end
    end
end

-- Where a pet sits for its owner, or nil while the owner is dead or absent
local function goalFor(plr: Player, t: number): CFrame?
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and root:IsA("BasePart") and hum and hum.Health > 0) then
        return nil
    end
    local bob = math.sin(t * 2 + plr.UserId % 7) * 0.25
    return root.CFrame * CFrame.new(2.2, 1.2 + bob, 1.4)
end

local function refresh(plr: Player)
    local id = plr:GetAttribute("Pet")
    local current = pets[plr]
    if current and current.id == id then
        return
    end
    if current then
        current.model:Destroy()
        pets[plr] = nil
    end
    local def = type(id) == "string" and Catalog[id]
    if def and def.kind == "Pet" then
        local model = build(id)
        model.Name = plr.Name
        -- Placed now rather than on the next rendered frame
        local goal = goalFor(plr, os.clock())
        if goal then
            model:PivotTo(goal)
            model.Parent = folder
        end
        pets[plr] = { id = id, model = model, placed = goal ~= nil }
        applyDark()
    end
end

local function watch(plr: Player)
    plr:GetAttributeChangedSignal("Pet"):Connect(function()
        refresh(plr)
    end)
    refresh(plr)
end
Players.PlayerAdded:Connect(watch)
for _, plr in Players:GetPlayers() do
    watch(plr)
end
Players.PlayerRemoving:Connect(function(plr)
    local pet = pets[plr]
    if pet then
        pet.model:Destroy()
        pets[plr] = nil
    end
end)

Remotes.EventFired.OnClientEvent:Connect(function(id: string)
    if id == "LIGHTS_OUT" or id == "POWER_SURGE" then
        dark = true
        applyDark()
    elseif id == "CLEAR" then
        dark = false
        applyDark()
    end
end)
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if dark and ReplicatedStorage:GetAttribute("RoundState") ~= "ACTIVE" then
        dark = false
        applyDark()
    end
end)

RunService.RenderStepped:Connect(function(dt)
    local t = os.clock()
    for plr, pet in pets do
        local goal = goalFor(plr, t)
        if not goal then
            -- Hidden with a dead owner, so a pet never marks a body
            pet.model.Parent = nil
            pet.placed = false
            continue
        end
        if pet.placed then
            pet.model:PivotTo(pet.model:GetPivot():Lerp(goal, math.min(1, dt * 8)))
        else
            pet.model:PivotTo(goal)
            pet.placed = true
        end
        pet.model.Parent = folder
    end
end)

return PetController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">ShowcaseController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/ShowcaseController
-- The lobby hangout: every player's equipped knife floats and slowly spins
-- above their head with a rarity-coloured nameplate, so you can walk the lobby
-- and see what everyone is carrying. Drawn locally from each player's public
-- "Knife" attribute (set by CosmeticService); models come from the already
-- replicated ReplicatedStorage.PreviewModels. Chroma blades cycle their hue.
-- Only ever shown in the lobby (INTERMISSION); during a round the real weapon
-- is in hand and this is hidden.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Theme = require(Shared.Theme)
local ItemCard = require(Shared.Build.ItemCard)

local ShowcaseController = {}
type Show = { id: string, model: Model, chroma: boolean }
local shows: { [Player]: Show } = {}

local folder = Instance.new("Folder")
folder.Name = "KnifeShowcase"
folder.Parent = workspace

local function inLobby(): boolean
    return ReplicatedStorage:GetAttribute("RoundState") == "INTERMISSION"
end

local function build(id: string, def): Model?
    local previews = ReplicatedStorage:FindFirstChild("PreviewModels")
    local template = previews and previews:FindFirstChild(id)
    if not (template and template:IsA("Model")) then
        return nil
    end
    local model = template:Clone()
    for _, d in model:GetDescendants() do
        if d:IsA("BasePart") then
            d.Anchored = true
            d.CanCollide = false
            d.CanQuery = false
            d.CanTouch = false
            d.CastShadow = false
        end
    end
    local ok = pcall(function()
        model:ScaleTo(0.8)
    end)
    if not ok then
        -- older engines: leave at natural size
    end
    -- A rarity-coloured nameplate above the blade.
    local anchor = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if anchor then
        local tag = Instance.new("BillboardGui")
        tag.Name = "Plate"
        tag.Size = UDim2.fromOffset(150, 24)
        tag.StudsOffset = Vector3.new(0, 2, 0)
        tag.AlwaysOnTop = true
        tag.MaxDistance = 60
        tag.LightInfluence = 0
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.FontFace = Theme.DISPLAY
        label.TextSize = 15
        label.Text = string.upper(def.name)
        label.TextColor3 = ItemCard.RARITY_COLOUR[def.rarity] or Theme.INK
        label.TextStrokeTransparency = 0.5
        label.Parent = tag
        tag.Adornee = anchor
        tag.Parent = anchor
    end
    return model
end

local function clear(plr: Player)
    local show = shows[plr]
    if show then
        show.model:Destroy()
        shows[plr] = nil
    end
end

local function refresh(plr: Player)
    local id = plr:GetAttribute("Knife")
    local current = shows[plr]
    if current and current.id == id and inLobby() then
        return
    end
    clear(plr)
    if not inLobby() then
        return
    end
    local def = type(id) == "string" and Catalog[id]
    if not (def and def.kind == "Knife") then
        return
    end
    local model = build(id :: string, def)
    if model then
        model.Name = plr.Name
        model.Parent = folder
        shows[plr] = { id = id :: string, model = model, chroma = def.chroma == true }
    end
end

local function watch(plr: Player)
    plr:GetAttributeChangedSignal("Knife"):Connect(function()
        refresh(plr)
    end)
    refresh(plr)
end
Players.PlayerAdded:Connect(watch)
for _, plr in Players:GetPlayers() do
    watch(plr)
end
Players.PlayerRemoving:Connect(clear)

ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if inLobby() then
        for _, plr in Players:GetPlayers() do
            refresh(plr)
        end
    else
        for plr in shows do
            clear(plr)
        end
    end
end)

-- Float above the head, spinning about its own axis (independent of which way
-- the owner faces), with a small showpiece tilt.
RunService.RenderStepped:Connect(function()
    if not inLobby() then
        return
    end
    local t = os.clock()
    local chromaColour = Color3.fromHSV((t * 0.25) % 1, 0.85, 1)
    for plr, show in shows do
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            local pos = head.Position + Vector3.new(0, 2.6, 0)
            -- The preview models stand blade-up (their long axis is local Y), so
            -- shown as-is they read as a vertical sliver. Tip them flat (90deg
            -- about X) so the blade lies horizontal and the shape is legible,
            -- then spin about the vertical for the slow showpiece turn.
            show.model:PivotTo(
                CFrame.new(pos) * CFrame.Angles(0, t * 1.4, 0) * CFrame.Angles(math.rad(90), 0, 0)
            )
            show.model.Parent = folder
            if show.chroma then
                for _, d in show.model:GetDescendants() do
                    if d:IsA("BasePart") then
                        d.Color = chromaColour
                    end
                end
            end
        else
            show.model.Parent = nil -- hidden while the owner has no character
        end
    end
end)

return ShowcaseController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">SocialController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/SocialController
-- The Radio and Emote pass dock for owners (bottom left, above the evidence
-- log), and emote labels over heads for everyone. Radio lines arrive in the
-- evidence log through HudController.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local SocialController = {}

local EMOTE_LABEL: { [string]: string } = {
    wave = "waves",
    point = "points",
    shrug = "shrugs",
    laugh = "laughs",
    panic = "panics",
}
-- Emotes the default Animate script can play; the rest are label only
local ANIMATED: { [string]: boolean } = { wave = true, point = true, laugh = true }

local gui = Instance.new("ScreenGui")
gui.Name = "SocialDock"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Parent = plr:WaitForChild("PlayerGui")

local dock = Instance.new("Frame")
dock.Name = "Dock"
dock.AnchorPoint = Vector2.new(0, 1)
dock.BackgroundTransparency = 1
dock.Parent = gui
local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 8)
layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = dock

local function skin(inst: GuiObject, colour: Color3?)
    inst.BackgroundColor3 = colour or Theme.PANEL
    inst.BorderSizePixel = 0
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = inst
    local stroke = Instance.new("UIStroke")
    stroke.Color = Theme.STROKE
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = inst
end

local function row(name: string, order: number): Frame
    local f = Instance.new("Frame")
    f.Name = name
    f.LayoutOrder = order
    f.Size = UDim2.new(1, 0, 0, Theme.TAP_MIN)
    f.BackgroundTransparency = 1
    f.Parent = dock
    return f
end

---------------------------------------------------------------- Radio
local radioRow = row("Radio", 1)

local box = Instance.new("TextBox")
box.Name = "Message"
box.Size = UDim2.new(1, -78, 1, 0)
box.Text = ""
box.PlaceholderText = "RADIO · to everyone"
box.PlaceholderColor3 = Theme.DIM
box.ClearTextOnFocus = false
box.FontFace = Theme.MONO
box.TextSize = 13
box.TextColor3 = Theme.INK
box.TextXAlignment = Enum.TextXAlignment.Left
box.TextTruncate = Enum.TextTruncate.AtEnd
skin(box)
local padding = Instance.new("UIPadding")
padding.PaddingLeft = UDim.new(0, 10)
padding.PaddingRight = UDim.new(0, 10)
padding.Parent = box
box.Parent = radioRow

local send = Instance.new("TextButton")
send.Name = "Send"
send.AnchorPoint = Vector2.new(1, 0)
send.Position = UDim2.fromScale(1, 0)
send.Size = UDim2.new(0, 70, 1, 0)
send.Text = "SEND"
send.FontFace = Theme.DISPLAY
send.TextSize = 18
send.TextColor3 = Theme.GROUND
skin(send, Theme.AMBER)
send.Parent = radioRow

local function sendRadio()
    local text = string.match(box.Text, "^%s*(.-)%s*$") or ""
    if text == "" then
        return
    end
    local cut = utf8.offset(text, Config.RADIO_MAX_CHARS + 1)
    if cut then
        text = string.sub(text, 1, cut - 1)
    end
    Remotes.RequestRadio:FireServer(text)
    box.Text = ""
end
send.Activated:Connect(sendRadio)
box.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        sendRadio()
    end
end)

---------------------------------------------------------------- Emotes
local emoteRow = row("Emotes", 2)
local emoteLayout = Instance.new("UIListLayout")
emoteLayout.FillDirection = Enum.FillDirection.Horizontal
emoteLayout.Padding = UDim.new(0, 6)
emoteLayout.SortOrder = Enum.SortOrder.LayoutOrder
emoteLayout.Parent = emoteRow

for i, id in Config.EMOTES do
    local b = Instance.new("TextButton")
    b.Name = id
    b.LayoutOrder = i
    b.Size = UDim2.new(1 / #Config.EMOTES, -5, 1, 0)
    b.Text = string.upper(id)
    b.FontFace = Theme.MONO
    b.TextSize = 11
    b.TextColor3 = Theme.SOFT
    skin(b)
    b.Parent = emoteRow
    b.Activated:Connect(function()
        Remotes.RequestEmote:FireServer(id)
    end)
end

Remotes.EmotePlayed.OnClientEvent:Connect(function(who: Player, emoteId: string)
    local text = EMOTE_LABEL[emoteId]
    local char = who and who.Character
    local head = char and char:FindFirstChild("Head")
    if not (text and head and head:IsA("BasePart")) then
        return
    end
    if who == plr and ANIMATED[emoteId] then
        local animate = (char :: Model):FindFirstChild("Animate")
        local play = animate and animate:FindFirstChild("PlayEmote")
        if play and play:IsA("BindableFunction") then
            pcall(play.Invoke, play, emoteId)
        end
    end

    local old = head:FindFirstChild("EmoteTag")
    if old then
        old:Destroy()
    end
    local tag = Instance.new("BillboardGui")
    tag.Name = "EmoteTag"
    tag.Size = UDim2.fromOffset(160, 28)
    tag.StudsOffset = Vector3.new(0, 2.4, 0)
    -- Name-tag range in fog, so an emote never shows someone you could not see
    tag.MaxDistance = Config.FOG_NAMETAG_RANGE
    tag.LightInfluence = 0
    local l = Instance.new("TextLabel")
    l.Size = UDim2.fromScale(1, 1)
    l.BackgroundTransparency = 1
    l.Text = text
    l.FontFace = Theme.MONO
    l.TextSize = 14
    l.TextColor3 = Theme.INK
    l.TextStrokeTransparency = 0.5
    l.Parent = tag
    tag.Adornee = head
    tag.Parent = head
    task.delay(3, function()
        tag:Destroy()
    end)
end)

---------------------------------------------------------------- Visibility + layout
local function render()
    local passes = ClientState.data.passes or {}
    -- Mid-round only the living transmit; the server refuses the rest anyway
    local canRadio = ClientState.GetRoundState() ~= "ACTIVE"
        or (ClientState.role ~= nil and not ClientState.spectating)
    radioRow.Visible = passes.radio == true and canRadio
    emoteRow.Visible = passes.emotes == true
    -- Menus own the screen while one is open
    dock.Visible = ClientState.screen == nil and (radioRow.Visible or emoteRow.Visible)

    -- Sits above the evidence log, which collapses on narrow screens
    local camera = workspace.CurrentCamera
    local width = camera and camera.ViewportSize.X or 1920
    local narrow = width < Theme.NARROW_WIDTH
    -- Bottom edge sits 8px above the evidence log, which collapses when narrow
    dock.Position = UDim2.new(0, 16, 1, narrow and -120 or -174)
    -- The touch action buttons sit round the jump button at the right edge and
    -- reach at most Theme.TOUCH_REACH in. On a short landscape screen the
    -- dock's right edge once reached underneath them - at 568x320 it covered a
    -- 38x4px corner of DRAG - so the dock never grows past the gap that leaves.
    -- 16 is the dock's own left margin, 8 a gap.
    local maxWidth = width - Theme.TOUCH_REACH - 16 - 8
    dock.Size =
        UDim2.new(0, math.clamp(maxWidth, 200, narrow and 240 or 340), 0, Theme.TAP_MIN * 2 + 8)
end

for _, key in { "data", "role", "screen", "spectating" } do
    ClientState.On(key, render)
end
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(render)

local viewportConn
local function watchCamera()
    if viewportConn then
        viewportConn:Disconnect()
    end
    local camera = workspace.CurrentCamera
    if camera then
        viewportConn = camera:GetPropertyChangedSignal("ViewportSize"):Connect(render)
    end
    render()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
watchCamera()

return SocialController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[--!strict
-- Plays the handbook's twenty-two cues. Server-emitted cues arrive on
-- PlayCue (already range-filtered); the rest are triggered locally from
-- events this client is entitled to know about.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local SoundCues = require(Shared.SoundCues)
local ClientState = require(script.Parent.Parent.ClientState)

local SoundController = {}
local warned = {}

local function build(cueId: string, pitch: number?, volumeScale: number?): Sound?
    local cue = SoundCues.cues[cueId]
    if not cue then
        return nil
    end
    if cue.soundId == "" then
        if RunService:IsStudio() and not warned[cueId] then
            warned[cueId] = true
            print("[Sound] no asset for cue", cueId)
        end
        return nil
    end
    local s = Instance.new("Sound")
    s.SoundId = cue.soundId
    s.Volume = cue.volume * (volumeScale or 1)
    s.PlaybackSpeed = pitch or 1
    return s
end

function SoundController.Play(
    cueId: string,
    position: Vector3?,
    pitch: number?,
    volumeScale: number?
)
    local s = build(cueId, pitch, volumeScale)
    if not s then
        return
    end
    local cue = SoundCues.cues[cueId]
    if position and cue.range then
        local holder = Instance.new("Attachment")
        holder.WorldPosition = position
        holder.Parent = workspace.Terrain
        s.RollOffMode = Enum.RollOffMode.InverseTapered
        s.RollOffMinDistance = 8
        s.RollOffMaxDistance = cue.range
        s.Parent = holder
        s.Ended:Connect(function()
            holder:Destroy()
        end)
        s:Play()
    else
        s.Parent = SoundService
        s.Ended:Connect(function()
            s:Destroy()
        end)
        s:Play()
    end
end

Remotes.PlayCue.OnClientEvent:Connect(function(cueId, position, pitch)
    SoundController.Play(cueId, position, pitch)
end)

---------------------------------------------------------------- local triggers
Remotes.RoleAssigned.OnClientEvent:Connect(function(role)
    SoundController.Play("round_reveal", nil, SoundCues.ROLE_PITCH[role])
end)

Remotes.Clue.OnClientEvent:Connect(function(clues)
    SoundController.Play(clues.cold and "trail_cold" or "clue_found")
end)

Remotes.RoundOver.OnClientEvent:Connect(function(winner)
    local role = ClientState.role
    if not role then
        return -- spectators get no verdict sting
    end
    local mySide = role == "murderer" and "murderer" or "innocents"
    SoundController.Play(mySide == winner and "round_win" or "round_lose")
end)

Remotes.CrateResult.OnClientEvent:Connect(function(result)
    if result.announce then
        return
    end
    SoundController.Play("crate_spin")
    if result.rarity == "Legendary" or result.rarity == "Godly" then
        task.delay(1.2, SoundController.Play, "crate_godly")
    end
end)

Remotes.TradeComplete.OnClientEvent:Connect(function()
    SoundController.Play("trade_complete")
end)

-- round_start on ACTIVE; timer_30 ticks once a second, fading in over the last 30s
local lastTick = -1
ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if ClientState.GetRoundState() == "ACTIVE" and ClientState.role then
        SoundController.Play("round_start")
    end
end)
RunService.Heartbeat:Connect(function()
    if ClientState.GetRoundState() ~= "ACTIVE" or not ClientState.role then
        return
    end
    local left = (ReplicatedStorage:GetAttribute("RoundEnds") or 0) - workspace:GetServerTimeNow()
    local whole = math.ceil(left)
    if whole <= 30 and whole > 0 and whole ~= lastTick then
        lastTick = whole
        SoundController.Play("timer_30", nil, 1, 1 - (whole - 1) / 30)
    end
end)

Players.LocalPlayer.CharacterAdded:Connect(function()
    lastTick = -1
end)

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">SpectatorController</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Controllers/SpectatorController
-- Dead players watch the living instead of their own body. The server sends
-- who is left; the camera is ours.
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Theme = require(ReplicatedStorage:WaitForChild("Shared").Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local SpectatorController = {}
local targets: { string } = {}
local index, active = 1, false

local gui = Instance.new("ScreenGui")
gui.Name = "SpectatorGui"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Enabled = false
gui.Parent = plr:WaitForChild("PlayerGui")

-- Bottom centre, clear of the middle of the screen
local bar = Instance.new("Frame")
bar.Name = "Bar"
bar.AnchorPoint = Vector2.new(0.5, 1)
bar.Position = UDim2.new(0.5, 0, 1, -24)
bar.Size = UDim2.fromOffset(360, 64)
bar.BackgroundColor3 = Theme.GROUND
bar.BackgroundTransparency = 0.15
bar.BorderSizePixel = 0
bar.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = bar
local stroke = Instance.new("UIStroke")
stroke.Color = Theme.STROKE
stroke.Parent = bar

local function label(
    name: string,
    text: string,
    size: number,
    y: number,
    colour: Color3,
    font: Font
)
    local l = Instance.new("TextLabel")
    l.Name = name
    l.Text = text
    l.FontFace = font
    l.TextSize = size
    l.TextColor3 = colour
    l.BackgroundTransparency = 1
    l.Position = UDim2.new(0, 60, 0, y)
    l.Size = UDim2.new(1, -120, 0, size + 6)
    l.TextTruncate = Enum.TextTruncate.AtEnd
    l.Parent = bar
    return l
end

label("Caption", "SPECTATING", 10, 8, Theme.DIM, Theme.MONO)
local who = label("Who", "—", 22, 24, Theme.INK, Theme.DISPLAY)

local function arrow(name: string, glyph: string, left: boolean): TextButton
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = glyph
    b.FontFace = Theme.DISPLAY
    b.TextSize = 26
    b.TextColor3 = Theme.AMBER
    b.BackgroundTransparency = 1
    b.AnchorPoint = Vector2.new(left and 0 or 1, 0.5)
    b.Position = UDim2.new(left and 0 or 1, left and 8 or -8, 0.5, 0)
    b.Size = UDim2.fromOffset(Theme.TAP_MIN, Theme.TAP_MIN)
    b.Parent = bar
    return b
end

local function restoreCamera()
    local camera = workspace.CurrentCamera
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = hum
    end
end

local function focus()
    if not active then
        return
    end
    if #targets == 0 then
        who.Text = "NOBODY LEFT"
        restoreCamera()
        return
    end
    index = ((index - 1) % #targets) + 1
    local name = targets[index]
    local target = Players:FindFirstChild(name)
    local char: Model? = if target and target:IsA("Player") then target.Character else nil
    if not char then
        -- NPCs are not Players; find their character by name
        for _, model in CollectionService:GetTagged("BotCharacter") do
            if model:IsA("Model") and model:GetAttribute("BotName") == name then
                char = model
                break
            end
        end
    end
    who.Text = string.upper(if target and target:IsA("Player") then target.DisplayName else name)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local camera = workspace.CurrentCamera
    if hum and camera then
        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = hum
    end
end

local function step(delta: number)
    if active and #targets > 0 then
        index += delta
        focus()
    end
end

arrow("Prev", "‹", true).Activated:Connect(function()
    step(-1)
end)
arrow("Next", "›", false).Activated:Connect(function()
    step(1)
end)

-- Arrow keys, not A/D: a respawned body in the lobby still walks on WASD
UserInputService.InputBegan:Connect(function(input, processed)
    if not active or processed then
        return
    end
    if input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.DPadLeft then
        step(-1)
    elseif input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.DPadRight then
        step(1)
    end
end)

local function setActive(on: boolean)
    active = on
    gui.Enabled = on
    ClientState.Set("spectating", on)
end

Remotes.Spectate.OnClientEvent:Connect(function(action: string, list: { string }?)
    if action == "enter" then
        targets, index = list or {}, 1
        setActive(true)
        focus()
    elseif action == "targets" then
        -- Keep watching the same person while they are still alive
        local current = targets[index]
        targets = list or {}
        index = (current and table.find(targets, current)) or index
        focus()
    elseif action == "exit" then
        targets = {}
        setActive(false)
        restoreCamera()
    end
end)

-- Respawning in the lobby hands the camera back to our own body; take it again
plr.CharacterAdded:Connect(function()
    if active then
        Remotes.RequestSpectate:FireServer()
        task.defer(focus)
    end
end)

ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if active and ClientState.GetRoundState() ~= "ACTIVE" then
        targets = {}
        setActive(false)
        restoreCamera()
    end
end)

return SpectatorController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">TradeController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/TradeController
-- Drives TradeGui. The server owns the table; this only shows it and asks.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Theme = require(Shared.Theme)
local Config = require(Shared.Config)
local Shop = require(Shared.Shop)
local ItemCard = require(Shared.Build.ItemCard)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local gui = plr:WaitForChild("PlayerGui"):WaitForChild("TradeGui")
local root = gui:WaitForChild("Root")
local TradeController = {}

local MAX_OFFER = Config.MAX_TRADE_OFFER
local GREEN = Color3.fromHex("4fb0a0")
local QUIET_STROKE = Color3.fromHex("1f252e")

type Entry = { uid: string, id: string, effect: string? }
local session: {
    id: string,
    mine: { Entry },
    theirs: { Entry },
    myLock: boolean,
    theirLock: boolean,
    myConfirm: boolean,
    theirConfirm: boolean,
    partner: Player?,
}? =
    nil

local function setEnabled(b: TextButton, on: boolean)
    b.AutoButtonColor = on
    b.BackgroundTransparency = on and 0 or 0.5
    b.TextTransparency = on and 0 or 0.45
end

local function status(text: string, colour: Color3?)
    root.Status.Text = text
    root.Status.TextColor3 = colour or Theme.MUTED
end

local function inLiveRound(): boolean
    local st = ClientState.GetRoundState()
    return ClientState.role ~= nil and st ~= "INTERMISSION" and st ~= "RESOLUTION"
end

local function clearCards(container: Instance)
    for _, c in container:GetChildren() do
        if c:IsA("Frame") then
            c:Destroy()
        end
    end
end

local function sendOffer(uids: { string })
    Remotes.RequestTrade:FireServer("offer", uids)
end

local function lockLabel(lock: boolean, confirm: boolean, idle: string): (string, Color3)
    if confirm then
        return "CONFIRMED", GREEN
    elseif lock then
        return "LOCKED", GREEN
    end
    return idle, Theme.MUTED
end

local function render()
    local s = session
    if not s then
        return
    end
    root.Header.Title.Text = ("TRADE WITH %s"):format(
        string.upper(s.partner and s.partner.DisplayName or "?")
    )

    clearCards(root.Mine.Slots)
    for i, e in s.mine do
        local card = ItemCard.new(root.Mine.Slots, e.id, nil, true)
        card.LayoutOrder = i
        card.Button.Activated:Connect(function()
            local uids = {}
            for _, other in s.mine do
                if other.uid ~= e.uid then
                    table.insert(uids, other.uid)
                end
            end
            sendOffer(uids)
        end)
    end
    clearCards(root.Theirs.Slots)
    for i, e in s.theirs do
        ItemCard.new(root.Theirs.Slots, e.id).LayoutOrder = i
    end

    root.Mine.Lock.Text, root.Mine.Lock.TextColor3 = lockLabel(s.myLock, s.myConfirm, "Editing")
    root.Theirs.Lock.Text, root.Theirs.Lock.TextColor3 =
        lockLabel(s.theirLock, s.theirConfirm, "Choosing")
    root.Mine.Stroke.Color = s.myLock and GREEN or QUIET_STROKE
    root.Theirs.Stroke.Color = s.theirLock and GREEN or QUIET_STROKE

    local mineV, theirV = Shop.ValueOf(s.mine), Shop.ValueOf(s.theirs)
    root.Mine.Value.Text = ("Table value · %d"):format(mineV)
    root.Theirs.Value.Text = ("Table value · %d"):format(theirV)

    -- Fairness meter, mirroring the prototype
    local total = mineV + theirV
    local ratio = total > 0 and (theirV - mineV) / total or 0
    local even = math.abs(ratio) < 0.08
    local fill = root.Fairness.Track.Fill
    fill.Position = UDim2.fromScale(math.min(0.5, 0.5 + ratio * 0.5), 0)
    fill.Size = UDim2.fromScale(math.abs(ratio * 0.5), 1)
    fill.BackgroundColor3 = if even then GREEN elseif ratio > 0 then Theme.CYAN else Theme.DANGER
    root.Fairness.Label.Text = if total == 0
        then "Empty table"
        elseif even then "Even trade"
        elseif ratio > 0 then "In your favour"
        else "You are losing value"

    local buttons = root.Buttons
    buttons.Lock.Text = s.myLock and "UNLOCK" or "LOCK MY OFFER"
    local canConfirm = s.myLock and s.theirLock and not s.myConfirm
    buttons.Confirm.Text = s.myConfirm and "WAITING…" or "CONFIRM TRADE"
    buttons.Confirm.BackgroundColor3 = canConfirm and Theme.AMBER or Color3.fromHex("2b323c")
    setEnabled(buttons.Confirm, canConfirm)

    local pool = root.Pool.Items
    clearCards(pool)
    local onTable = {}
    for _, e in s.mine do
        onTable[e.uid] = true
    end
    local inventory: { any } = ClientState.data.inventory or {}
    for i, item in inventory do
        local card = ItemCard.new(pool, item.id, nil, true)
        card.LayoutOrder = i
        if onTable[item.uid] then
            card.BackgroundTransparency = 0.6
            card.Stroke.Transparency = 0.6
        end
        card.Button.Activated:Connect(function()
            if onTable[item.uid] then
                return
            end
            local uids = {}
            for _, e in s.mine do
                table.insert(uids, e.uid)
            end
            if #uids >= MAX_OFFER then
                status(("%d items is the limit."):format(MAX_OFFER))
                return
            end
            table.insert(uids, item.uid)
            sendOffer(uids)
        end)
    end
end

Remotes.TradeUpdate.OnClientEvent:Connect(
    function(id, mine, theirs, myLock, theirLock, myConfirm, theirConfirm, partner)
        if mine == nil then
            if session and session.id == id then
                session = nil
                if gui.Enabled and ClientState.ShowScreen then
                    ClientState.ShowScreen("lobby")
                end
            end
            return
        end

        local previous = session
        session = {
            id = id,
            mine = mine,
            theirs = theirs,
            myLock = myLock,
            theirLock = theirLock,
            myConfirm = myConfirm,
            theirConfirm = theirConfirm,
            partner = partner,
        }
        if
            previous
            and previous.id == id
            and (previous.myLock or previous.theirLock)
            and not (myLock or theirLock)
        then
            status("Table changed. Both locks reset.")
        elseif myLock and theirLock then
            status("Both sides locked. Confirm to execute.", GREEN)
        elseif myLock then
            status("Locked. Waiting for them…")
        elseif not previous then
            status("")
        end

        if not gui.Enabled and not inLiveRound() and ClientState.ShowScreen then
            ClientState.ShowScreen("trade")
        end
        render()
    end
)

Remotes.TradeComplete.OnClientEvent:Connect(function()
    status("Trade complete. Items moved to your collection.", GREEN)
end)

ClientState.On("data", function()
    if session and gui.Enabled then
        render()
    end
end)

root.Buttons.Lock.Activated:Connect(function()
    local s = session
    if not s then
        return
    end
    if s.myLock then
        Remotes.RequestTrade:FireServer("unlock")
    elseif #s.mine == 0 then
        status("Put something on the table first.")
    else
        Remotes.RequestTrade:FireServer("lock")
    end
end)

root.Buttons.Confirm.Activated:Connect(function()
    local s = session
    if s and s.myLock and s.theirLock and not s.myConfirm then
        Remotes.RequestTrade:FireServer("confirm")
        status("Escrow holding. Verifying ownership on both sides…")
    end
end)

root.Buttons.Cancel.Activated:Connect(function()
    if session then
        Remotes.RequestTrade:FireServer("cancel")
    end
    if ClientState.ShowScreen then
        ClientState.ShowScreen("lobby")
    end
end)

return TradeController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">VisionController</string>
            <string name="Source"><![CDATA[-- StarterPlayerScripts/Controllers/VisionController
-- Vision radius, name-tag rules and the Last Call outline. All visual: the
-- server never trusts any of it, and an exploiter removing the fog gains
-- nothing the server would accept.
--
-- The radius is real distance fog (Lighting.FogStart/FogEnd, set locally),
-- so anything past it is actually hidden. Note: an Atmosphere in Lighting
-- disables legacy fog, so the place must not have one.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Theme = require(Shared.Theme)
local ClientState = require(script.Parent.Parent.ClientState)

local plr = Players.LocalPlayer
local VisionController = {}

local DARK = Color3.fromHex("05070a") -- Lights Out: the room really goes black
local NIGHT = Color3.fromHex("c6d2dc") -- every other moment: bright haze, never a void
local FOG_GREY = Color3.fromHex("6f7883")
local BASE = { start = Lighting.FogStart, finish = Lighting.FogEnd, colour = Lighting.FogColor }

local event: string? = nil
local lastCallNames: { [string]: boolean } = {}
local radius = Config.VISION_NORMAL
local surgeTarget, nextFlicker = Config.VISION_NORMAL, 0
local applied = false

if Lighting:FindFirstChildOfClass("Atmosphere") then
    warn("[ColdCase] Lighting has an Atmosphere; it disables the fog that draws vision radius")
end

Remotes.EventFired.OnClientEvent:Connect(function(id: string, _duration, extra)
    if id == "CLEAR" then
        event = nil
    elseif id == "LAST_CALL" then
        lastCallNames = {}
        for _, name in extra or {} do
            lastCallNames[name] = true
        end
    else
        event = id
    end
end)

ReplicatedStorage:GetAttributeChangedSignal("RoundState"):Connect(function()
    if ClientState.GetRoundState() ~= "ACTIVE" then
        event = nil
        lastCallNames = {}
    end
end)

local function inRound(): boolean
    return ClientState.GetRoundState() == "ACTIVE" and ClientState.role ~= nil
end

local function targetRadius(): number
    if event == "LIGHTS_OUT" then
        return Config.VISION_DARK
    elseif event == "POWER_SURGE" then
        -- Flickers between the surge radius and full, never on a clean rhythm
        if os.clock() >= nextFlicker then
            surgeTarget = math.random() > 0.5 and Config.VISION_SURGE or Config.VISION_NORMAL
            nextFlicker = os.clock() + math.random(8, 30) / 100
        end
        return surgeTarget
    end
    -- Hardcore keeps sight cut the whole round, with no event running.
    if ReplicatedStorage:GetAttribute("Mode") == "hardcore" then
        return Config.VISION_HARDCORE
    end
    return Config.VISION_NORMAL
end

-- When the room goes black (a Lights Out / Power Surge event, or the Hardcore
-- gloom), give every figure a warm light aura so people are visible and can
-- find their way and read a body. Each person carries their own glow.
local function isDarkNow(): boolean
    if event == "LIGHTS_OUT" or event == "POWER_SURGE" then
        return true
    end
    return ReplicatedStorage:GetAttribute("Mode") == "hardcore"
end

local function aura(char: Model, on: boolean)
    -- The light lives on the root part (a PointLight only emits from a BasePart),
    -- so it must be found there too - looking under the Model missed it, which
    -- both stacked a fresh light every frame (blinding) and never let it be
    -- removed when the lights came back. Find it where it actually lives.
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    local light = root and root:FindFirstChild("ColdCaseAura")
    local glow = char:FindFirstChild("ColdCaseAuraGlow")
    if on then
        if not light and root and root:IsA("BasePart") then
            local l = Instance.new("PointLight")
            l.Name = "ColdCaseAura"
            l.Color = Color3.fromHex("ffe1a6") -- warm lantern
            l.Brightness = 0.9
            l.Range = 9
            l.Shadows = false
            l.Parent = root
        end
        if not glow then
            local h = Instance.new("Highlight")
            h.Name = "ColdCaseAuraGlow"
            h.FillColor = Color3.fromHex("ffe1a6")
            h.FillTransparency = 0.92
            h.OutlineColor = Color3.fromHex("ffe1a6")
            h.OutlineTransparency = 0.6
            h.DepthMode = Enum.HighlightDepthMode.Occluded
            h.Parent = char
        end
    else
        if light then
            light:Destroy()
        end
        if glow then
            glow:Destroy()
        end
    end
end

local function outline(char: Model, on: boolean)
    local hl = char:FindFirstChild("LastCallOutline") :: Highlight?
    if on and not hl then
        local h = Instance.new("Highlight")
        h.Name = "LastCallOutline"
        h.FillTransparency = 1
        h.OutlineColor = Theme.ROLE.murderer
        h.OutlineTransparency = 0.55 -- faint, through walls
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = char
    elseif not on and hl then
        hl:Destroy()
    end
end

RunService.RenderStepped:Connect(function(dt)
    local active = inRound()
    local myChar = plr.Character

    if active then
        local target = targetRadius()
        if event == "POWER_SURGE" then
            radius = target
        else
            radius += (target - radius) * math.min(1, dt * 4)
        end
        Lighting.FogColor = if event == "FOG_BANK"
            then FOG_GREY
            elseif event == "LIGHTS_OUT" then DARK
            else NIGHT
        Lighting.FogStart = radius * 0.75
        Lighting.FogEnd = radius
        applied = true
    elseif applied then
        Lighting.FogStart, Lighting.FogEnd, Lighting.FogColor = BASE.start, BASE.finish, BASE.colour
        radius = Config.VISION_NORMAL
        applied = false
    end

    -- Spectators measure from whoever they are watching
    local camera = workspace.CurrentCamera
    local subject = camera and camera.CameraSubject
    local focus = if subject and subject:IsA("Humanoid") then subject.Parent else myChar
    local myPos = if focus and focus:IsA("Model") then focus:GetPivot().Position else nil
    local others: { { name: string, char: Model } } = {}
    for _, other in Players:GetPlayers() do
        if other ~= plr and other.Character then
            table.insert(others, { name = other.Name, char = other.Character })
        end
    end
    for _, model in CollectionService:GetTagged("BotCharacter") do
        if model:IsA("Model") then
            table.insert(
                others,
                { name = model:GetAttribute("BotName") or model.Name, char = model }
            )
        end
    end
    local dark = active and isDarkNow()
    if myChar then
        aura(myChar, dark == true)
    end
    for _, other in others do
        local char = other.char
        aura(char, dark == true)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if active and myPos then
                local d = (char:GetPivot().Position - myPos).Magnitude
                -- Nothing past the vision radius shows a name; in Fog Bank you
                -- see a shape, not a person, beyond 40 studs
                local visible = d <= radius
                    and not (event == "FOG_BANK" and d > Config.FOG_NAMETAG_RANGE)
                hum.DisplayDistanceType = visible and Enum.HumanoidDisplayDistanceType.Viewer
                    or Enum.HumanoidDisplayDistanceType.None
                hum.NameDisplayDistance = radius
            else
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                hum.NameDisplayDistance = 100
            end
        end
        outline(char, active and lastCallNames[other.name] == true)
    end
end)

return VisionController
]]></string>
