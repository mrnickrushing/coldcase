      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Theme</string>
          <string name="Source"><![CDATA[--!strict
-- COLD CASE · the only place UI colours and fonts are defined.
-- Handbook rule: two fonts in the whole game, one colour per role.
local Theme = {}

-- Big Shoulders Display and IBM Plex Mono are not on the Creator Store.
-- Oswald is the closest built-in condensed display face; RobotoMono stands in
-- for Plex Mono. Upload the real faces and swap these two lines.
Theme.DISPLAY = Font.new("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold)
Theme.DISPLAY_HEAVY = Font.new("rbxasset://fonts/families/Oswald.json", Enum.FontWeight.Bold)
Theme.MONO = Font.new("rbxasset://fonts/families/RobotoMono.json", Enum.FontWeight.Medium)

Theme.INK = Color3.fromHex("e8e6e1")
Theme.BODY = Color3.fromHex("c3c8ce")
Theme.SOFT = Color3.fromHex("a9afb7")
Theme.MUTED = Color3.fromHex("8b9199")
Theme.DIM = Color3.fromHex("7d858f") -- 4.6:1 on CARD; 6f7883 was 3.9 and failed to read
Theme.GROUND = Color3.fromHex("0b0d10")
Theme.PANEL = Color3.fromHex("12151a")
Theme.CARD = Color3.fromHex("111419")
Theme.STROKE = Color3.fromHex("262d36")
Theme.AMBER = Color3.fromHex("f2a63b")
Theme.CYAN = Color3.fromHex("37bcf0")
Theme.DANGER = Color3.fromHex("d9443f")

-- One colour per role. Used nowhere else in the UI.
Theme.ROLE = {
    innocent = Color3.fromHex("d8d5cf"),
    sheriff = Color3.fromHex("f2a63b"),
    murderer = Color3.fromHex("d9443f"),
    hero = Color3.fromHex("37bcf0"),
    medic = Color3.fromHex("4fb0a0"),
    snitch = Color3.fromHex("b45fe8"),
    assassin = Color3.fromHex("d9443f"),
}

-- Evidence log left-border colour per clue kind
Theme.CLUE = {
    direction = Color3.fromHex("8b9199"),
    fibre = Color3.fromHex("c3c8ce"),
    time = Color3.fromHex("37bcf0"),
    witness = Color3.fromHex("d9443f"),
    cold = Color3.fromHex("2b323c"),
    radio = Color3.fromHex("a9afb7"),
}

Theme.TAP_MIN = 44 -- px, every touch target
-- How far in from the right edge the leftmost touch action button may reach.
-- InputController keeps its buttons inside it; SocialController budgets the
-- dock against it, so the two never overlap on a short screen.
Theme.TOUCH_REACH = 250
Theme.NARROW_WIDTH = 500 -- px, Evidence collapses to two lines below this

return Theme
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="29">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="30">
      <Properties>
        <string name="Name">Bootstrap</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- ServerScriptService/Bootstrap — the only server entry point.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

-- Remotes, maps and lighting must exist before any service is required
require(ReplicatedStorage.Shared.RemoteSetup)()
require(ServerStorage.Build.BuildAssets)() -- models first: BuildMaps dresses maps with them
require(ServerStorage.Build.BuildMaps)()
require(ServerStorage.Build.BuildLighting)()
require(ServerStorage.Build.BuildLobby)()

local Services = script.Parent.Services
local RemoteGuard = require(Services.RemoteGuard)
local DataService = require(Services.DataService)
local RoundService = require(Services.RoundService)
local CombatService = require(Services.CombatService)
local EvidenceService = require(Services.EvidenceService)
local EconomyService = require(Services.EconomyService)
local CoinService = require(Services.CoinService)
local TradeService = require(Services.TradeService)
local OnboardingService = require(Services.OnboardingService)
local AbilityService = require(Services.AbilityService)
local CosmeticService = require(Services.CosmeticService)
local ShopService = require(Services.ShopService)
local LiveOpsClock = require(Services.LiveOpsClock)
local SocialService = require(Services.SocialService)
local SpectatorService = require(Services.SpectatorService)
local SnitchService = require(Services.SnitchService)
require(Services.LeaderboardService) -- starts the global-board refresh loop
require(Services.TradeTableService) -- lobby trade tables (needs BuildLobby's tags)
require(Services.PedestalService) -- lobby showcase pedestals (needs BuildLobby's tags)
require(Services.PlayerPolicy) -- regional policy for paid random items and trading
require(Services.MonetizationService) -- installs ProcessReceipt

-- Player lifecycle
Players.PlayerAdded:Connect(function(plr)
    DataService:Load(plr)
end)
for _, plr in Players:GetPlayers() do
    task.spawn(DataService.Load, DataService, plr)
end

-- Public live-ops state: seasonal crate, countdown, trading unlock
LiveOpsClock.Publish()
ServerStorage:GetAttributeChangedSignal("LiveOpsDay"):Connect(LiveOpsClock.Publish)
task.spawn(function()
    while true do
        task.wait(300)
        LiveOpsClock.Publish()
    end
end)

-- Client -> server entry points. Every one is rate-limited by RemoteGuard,
-- type-checked here, and re-validated inside the service. Handlers forward
-- only the arguments they expect, never `...`.
RemoteGuard.Connect("RequestStab", function(plr, target)
    if typeof(target) ~= "Instance" then
        return
    end
    if target:IsA("Player") then
        CombatService:RequestStab(plr, target)
    elseif target:IsA("Model") then
        -- NPCs are targeted by their character model
        local bot = RoundService:BotFromCharacter(target)
        if bot then
            CombatService:RequestStab(plr, bot)
        end
    end
end)

RemoteGuard.Connect("RequestThrow", function(plr, aimPoint)
    if RemoteGuard.IsFiniteVector(aimPoint) then
        CombatService:RequestThrow(plr, aimPoint)
    end
end)

RemoteGuard.Connect("RequestShoot", function(plr, aimPoint)
    if RemoteGuard.IsFiniteVector(aimPoint) then
        CombatService:RequestShoot(plr, aimPoint)
    end
end)

RemoteGuard.Connect("RequestExamine", function(plr, model)
    if typeof(model) == "Instance" then
        EvidenceService:Examine(plr, model)
    end
end)

RemoteGuard.Connect("RequestPickup", function(plr)
    CombatService:RequestPickup(plr)
end)

RemoteGuard.Connect("RequestCoin", function(plr, nodeId)
    CoinService:RequestCoin(plr, nodeId)
end)

RemoteGuard.Connect("RequestRevive", function(plr, model)
    if typeof(model) == "Instance" then
        AbilityService:RequestRevive(plr, model)
    end
end)

RemoteGuard.Connect("RequestDrag", function(plr, model, stop)
    if stop == true then
        AbilityService:StopDrag(plr)
    elseif typeof(model) == "Instance" then
        AbilityService:StartDrag(plr, model)
    end
end)

RemoteGuard.Connect("RequestVote", function(plr, mapName)
    -- Note only a vote the round accepted: that way the map name reaching
    -- analytics is one of Config.MAPS, never a string the client chose.
    if type(mapName) == "string" and RoundService:CastVote(plr, mapName) then
        OnboardingService:NoteVote(plr, mapName)
    end
end)

RemoteGuard.Connect("RequestCrate", function(plr, crateId)
    EconomyService:OpenCrate(plr, crateId)
end)

RemoteGuard.Connect("RequestCraft", function(plr, itemId)
    if type(itemId) == "string" then
        EconomyService:Craft(plr, itemId)
    end
end)

RemoteGuard.Connect("RequestEquip", function(plr, ref)
    if type(ref) == "string" then
        CosmeticService:Equip(plr, ref)
    end
end)

RemoteGuard.Connect("RequestBuy", function(plr, id)
    if type(id) == "string" then
        ShopService:Buy(plr, id)
    end
end)

RemoteGuard.Connect("RequestReroll", function(plr, uid)
    if type(uid) == "string" then
        ShopService:RerollEffect(plr, uid)
    end
end)

RemoteGuard.Connect("RequestTrade", function(plr, action, payload)
    TradeService:Handle(plr, action, payload)
end)

RemoteGuard.Connect("HintSeen", function(plr, hintId)
    OnboardingService:MarkHintSeen(plr, hintId)
end)

RemoteGuard.Connect("RequestRadio", function(plr, message)
    if type(message) == "string" then
        SocialService:Radio(plr, message)
    end
end)

RemoteGuard.Connect("RequestEmote", function(plr, emoteId)
    if type(emoteId) == "string" then
        SocialService:Emote(plr, emoteId)
    end
end)

RemoteGuard.Connect("RequestReport", function(plr, target, reason)
    if typeof(target) == "Instance" and target:IsA("Player") and type(reason) == "string" then
        SocialService:Report(plr, target, reason)
    end
end)

RemoteGuard.Connect("RequestSpectate", function(plr)
    SpectatorService:Send(plr, RoundService:AliveNames())
end)

RemoteGuard.Connect("RequestLobbyMode", function(plr, mode)
    if mode == "wait" or mode == "play" then
        DataService:SetWaitForPlayers(plr, mode == "wait")
    end
end)

RemoteGuard.Connect("RequestModeVote", function(plr, modeId)
    if type(modeId) == "string" then
        RoundService:CastModeVote(plr, modeId)
    end
end)

RemoteGuard.Connect("RequestExpose", function(plr)
    SnitchService:RequestExpose(plr)
end)

RemoteGuard.Connect("RequestAccuse", function(plr, targetName)
    require(Services.WhodunnitService):Accuse(plr, targetName)
end)

require(Services.BotService):Prepare() -- builds the NPC rig before the first round
RoundService:Start()
-- The place version says which publish this server is running, so a fix that
-- was merged but never published can be told apart from one that did not work.
print(("[ColdCase] server up · place version %d"):format(game.PlaceVersion))
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="31">
      <Properties>
        <string name="Name">Build</string>
      </Properties>
    </Item>
    <Item class="Folder" referent="32">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">AbilityService</string>
          <string name="Source"><![CDATA[-- Medic revive and body dragging (Design Bible · Roles, Counterplay).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Reach = require(script.Parent.Reach)
local Remotes = game.ReplicatedStorage.Remotes
local RoleService = require(script.Parent.RoleService)
local EvidenceService = require(script.Parent.EvidenceService)
local EconomyService = require(script.Parent.EconomyService)
local AudioService = require(script.Parent.AudioService)
local Participant = require(script.Parent.Participant)
local BotService = require(script.Parent.BotService)

local AbilityService = {}
local round: any = nil -- RoundService, handed over by BindRound
local reviveUsed: { [Player]: boolean } = {}
local channeling: { [Player]: boolean } = {}
local pendingDrag: { [Player]: Instance } = {}
local dragging: { [Player]: { model: Model, body: any, conn: RBXScriptConnection } } = {}

function AbilityService:BindRound(roundService)
    round = roundService
end

local function position(plr: Player): Vector3?
    local char = plr.Character
    return char and char:GetPivot().Position
end

-- Deliberately no PING_ALLOWANCE: that slack is for the reach checks a moving
-- player disputes (knife, gun pickup, coins). Examining and reviving are
-- stationary, so they use the plain range.
local function near(plr: Player, model: Instance): boolean
    return Reach.Within(plr, model, Config.EXAMINE_RANGE)
end

---------------------------------------------------------------- Revive
-- One revive per round, 3s channel, only on a body nobody has examined yet.
-- The channel breaks if the medic moves: standing still beside a body in a
-- room with a murderer is the whole cost of the ability.
--
-- Every refusal below says why. They used to return in silence, so a medic
-- pressing REVIVE on an NPC's body, or on one someone had already examined,
-- saw nothing happen at all and read the button as broken.
local function deny(plr: Player, reason: string)
    Remotes.Notify:FireClient(plr, reason)
end

function AbilityService:RequestRevive(plr: Player, model: Instance)
    -- Role and liveness are not explained: only a live medic's client ever
    -- sends this, so anything else is a forged call and is told nothing.
    if RoleService:Get(plr) ~= "medic" or channeling[plr] or not round:IsAlive(plr) then
        return
    end
    if reviveUsed[plr] then
        deny(plr, "You have already used your revive this round.")
        return
    end
    local body = EvidenceService:GetBody(model)
    if not body then
        return
    end
    if body.examined then
        deny(plr, "That body has already been examined. It is too late for them.")
        return
    end
    if body.draggedBy then
        deny(plr, "Someone is moving that body.")
        return
    end
    local victim = body.victimPlayer
    if not (victim and victim.Parent == Players and round:IsParticipant(victim)) then
        deny(plr, "There is nobody to bring back.")
        return
    end
    if not near(plr, model) then
        deny(plr, "Stand closer to the body.")
        return
    end

    channeling[plr] = true
    Remotes.AbilityState:FireClient(plr, "revive_start", Config.REVIVE_CHANNEL)
    local start = position(plr) :: Vector3
    local t0 = os.clock()
    while os.clock() - t0 < Config.REVIVE_CHANNEL do
        task.wait(0.1)
        local here = position(plr)
        local broken = not round:IsAlive(plr)
            or not here
            or (here - start).Magnitude > Config.REVIVE_MOVE_TOLERANCE
            or EvidenceService:GetBody(model) ~= body
            or body.examined
            or body.draggedBy
            or victim.Parent ~= Players
        if broken then
            channeling[plr] = nil
            Remotes.AbilityState:FireClient(plr, "revive_failed", 0)
            return
        end
    end
    channeling[plr] = nil

    -- They stand up where they fell. A person gets a fresh character; an NPC
    -- gets a fresh body in the same clothes (the one it died in is the
    -- corpse now). Either way the round then marks them alive.
    local rise = CFrame.new((model :: Model):GetPivot().Position + Vector3.new(0, 3, 0))
    if Participant.IsBot(victim) then
        if not BotService:Respawn(victim, rise) then
            Remotes.AbilityState:FireClient(plr, "revive_failed", 0)
            deny(plr, "They could not be brought back. Your revive is not spent.")
            return
        end
    else
        victim:LoadCharacter()
        local char = victim.Character
        if char then
            char:PivotTo(rise)
        end
    end
    -- Spent only on success, so a broken channel can be tried again
    reviveUsed[plr] = true
    EvidenceService:RemoveBody(model)
    round:Revive(victim)
    Remotes.AbilityState:FireClient(plr, "revive_done", 0)
    if not Participant.IsBot(victim) then
        Remotes.Notify:FireClient(victim, "You were revived.")
    end
    EconomyService:Grant(plr, Config.REVIVE_COINS, Config.REVIVE_XP, "revive")
end

---------------------------------------------------------------- Drag
-- Hold for DRAG_TIME to take hold, then the body follows at reduced walk
-- speed. Slow, loud, and worth it.
function AbilityService:StartDrag(plr: Player, model: Instance)
    if pendingDrag[plr] or dragging[plr] or not round:IsAlive(plr) then
        return
    end
    local body = EvidenceService:GetBody(model)
    if not body then
        return
    end
    if body.draggedBy then
        deny(plr, "Someone else has hold of that body.")
        return
    end
    if not near(plr, model) then
        deny(plr, "Stand closer to the body.")
        return
    end

    pendingDrag[plr] = model
    Remotes.AbilityState:FireClient(plr, "drag_start", Config.DRAG_TIME)
    task.delay(Config.DRAG_TIME, function()
        if pendingDrag[plr] ~= model then
            return -- released before taking hold
        end
        pendingDrag[plr] = nil
        if
            not round:IsAlive(plr)
            or EvidenceService:GetBody(model) ~= body
            or body.draggedBy
            or not near(plr, model)
        then
            Remotes.AbilityState:FireClient(plr, "drag_stop", 0)
            return
        end

        local hum = (plr.Character :: Model):FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = Config.DRAG_WALKSPEED
        end
        body.draggedBy = plr

        local corpse = model :: Model
        local lastSound = 0
        local conn = RunService.Heartbeat:Connect(function()
            local char = plr.Character
            if not (char and round:IsAlive(plr) and corpse.Parent) then
                self:StopDrag(plr)
                return
            end
            local pivot = char:GetPivot()
            local behind = pivot.Position - pivot.LookVector * 4
            -- Rest the body's underside on the ground behind the dragger, whether
            -- it is the generic figure or a full avatar: their pivots sit at
            -- different heights above the body, so a fixed drop is wrong for one.
            local cf, size = corpse:GetBoundingBox()
            local pivotToBottom = corpse:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = { char, corpse }
            local hit = workspace:Raycast(
                Vector3.new(behind.X, pivot.Position.Y + 3, behind.Z),
                Vector3.new(0, -40, 0),
                rp
            )
            local floorY = hit and hit.Position.Y or (pivot.Position.Y - 2.5)
            local spot = Vector3.new(behind.X, floorY + pivotToBottom, behind.Z)
            corpse:PivotTo(CFrame.new(spot) * pivot.Rotation)
            local now = os.clock()
            if now - lastSound >= Config.DRAG_SOUND_INTERVAL then
                lastSound = now
                AudioService:Emit("body_drag", spot)
            end
        end)
        dragging[plr] = { model = model :: Model, body = body, conn = conn }
        Remotes.AbilityState:FireClient(plr, "dragging", 0)
    end)
end

function AbilityService:StopDrag(plr: Player)
    pendingDrag[plr] = nil
    local d = dragging[plr]
    if not d then
        return
    end
    dragging[plr] = nil
    d.conn:Disconnect()
    d.body.draggedBy = nil
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if hum and round:IsAlive(plr) then
        hum.WalkSpeed = Config.WALKSPEED
    end
    if plr.Parent == Players then
        Remotes.AbilityState:FireClient(plr, "drag_stop", 0)
    end
end

function AbilityService:Reset()
    for plr in dragging do
        self:StopDrag(plr)
    end
    pendingDrag = {}
    reviveUsed = {}
    channeling = {}
end

Players.PlayerRemoving:Connect(function(plr)
    AbilityService:StopDrag(plr)
    reviveUsed[plr] = nil
    channeling[plr] = nil
end)

return AbilityService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Analytics</string>
          <string name="Source"><![CDATA[-- COLD CASE · the ten day-one analytics events (Handbook §05).
--
-- Roblox custom events carry one numeric value and at most three custom
-- fields, and each event is capped at 8,000 unique field combinations. So:
--   * the player is the event's player argument, never a field
--   * continuous numbers are the value, or bucketed when used as a field
--   * positions are grid cells (Config.HEATMAP_CELL studs)
--   * high-cardinality lists (trade itemIds) are not sent — see docs/analytics.md
local AnalyticsService = game:GetService("AnalyticsService")
local RunService = game:GetService("RunService")
local Config = require(game.ReplicatedStorage.Shared.Config)

local Analytics = {}
local IS_STUDIO = RunService:IsStudio()

local F1 = Enum.AnalyticsCustomFieldKeys.CustomField01.Name
local F2 = Enum.AnalyticsCustomFieldKeys.CustomField02.Name
local F3 = Enum.AnalyticsCustomFieldKeys.CustomField03.Name

local function fields(a: any?, b: any?, c: any?)
    local out = {}
    if a ~= nil then
        out[F1] = tostring(a)
    end
    if b ~= nil then
        out[F2] = tostring(b)
    end
    if c ~= nil then
        out[F3] = tostring(c)
    end
    return out
end

local function debugLog(name: string, ...)
    if IS_STUDIO then
        print("[Analytics]", name, ...)
    end
end

-- Buckets: stable, low-cardinality labels for a number
function Analytics.Bucket(n: number, edges: { number }): string
    for i, edge in edges do
        if n < edge then
            return i == 1 and ("<" .. edge) or (edges[i - 1] .. "-" .. edge)
        end
    end
    return edges[#edges] .. "+"
end

local RANK_EDGES = { 2, 5, 10, 25, 50 }
local VALUE_EDGES = { 100, 500, 1000, 5000, 20000 }

local function custom(plr: Player, name: string, value: number, f)
    debugLog(name, value, f[F1], f[F2], f[F3])
    pcall(AnalyticsService.LogCustomEvent, AnalyticsService, plr, name, value, f)
end

function Analytics.RoundComplete(
    reporter: Player,
    map: string,
    winner: string,
    duration: number,
    playerCount: number,
    event: string?
)
    -- playerCount is folded into the event field; 3 maps × 2 winners × 6 events × 5 sizes stays well under the cap
    local size = Analytics.Bucket(playerCount, { 6, 8, 10, 12, 14 })
    custom(
        reporter,
        "round_complete",
        math.floor(duration),
        fields(map, winner, (event or "NONE") .. "|" .. size)
    )
end

function Analytics.RoleAssigned(plr: Player, role: string, rank: number, isFirstRound: boolean)
    custom(
        plr,
        "role_assigned",
        rank,
        fields(role, Analytics.Bucket(rank, RANK_EDGES), isFirstRound)
    )
end

function Analytics.PlayerDeath(
    plr: Player,
    role: string,
    killerRole: string,
    timeAlive: number,
    map: string,
    pos: Vector3
)
    -- Roblox rejects a custom field containing a comma, a quote or an
    -- apostrophe, and drops the whole event, so the cell reads 4x4 not 4,4
    local cell = Config.HEATMAP_CELL
    local cx, cz = math.floor((pos.X + 480) / cell), math.floor((pos.Z + 300) / cell)
    custom(
        plr,
        "player_death",
        math.floor(timeAlive),
        fields(role, killerRole, ("%s:%dx%d"):format(map, cx, cz))
    )
end

function Analytics.EvidenceExamined(
    plr: Player,
    clueCount: number,
    timeSinceDeath: number,
    rank: number
)
    custom(
        plr,
        "evidence_examined",
        math.floor(timeSinceDeath),
        fields(clueCount, Analytics.Bucket(rank, RANK_EDGES))
    )
end

function Analytics.CrateOpened(
    plr: Player,
    crateId: string,
    rarity: string,
    itemId: string,
    coinsAfter: number
)
    custom(plr, "crate_opened", coinsAfter, fields(crateId, rarity, itemId))
end

function Analytics.CoinsEarned(
    plr: Player,
    source: string,
    amount: number,
    balance: number,
    sessionTotal: number
)
    debugLog("coins_earned", source, amount, balance, sessionTotal)
    local transaction = Enum.AnalyticsEconomyTransactionType.Gameplay.Name
    if source == "streak" then
        transaction = Enum.AnalyticsEconomyTransactionType.TimedReward.Name
    elseif source == "robux" then
        transaction = Enum.AnalyticsEconomyTransactionType.IAP.Name
    end
    pcall(
        AnalyticsService.LogEconomyEvent,
        AnalyticsService,
        plr,
        Enum.AnalyticsEconomyFlowType.Source,
        "Coins",
        amount,
        balance,
        transaction,
        source,
        fields(Analytics.Bucket(sessionTotal, { 100, 250, 500, 1000, 2500 }))
    )
end

function Analytics.CoinsSpent(plr: Player, sink: string, amount: number, balanceAfter: number)
    debugLog("coins_spent", sink, amount, balanceAfter)
    pcall(
        AnalyticsService.LogEconomyEvent,
        AnalyticsService,
        plr,
        Enum.AnalyticsEconomyFlowType.Sink,
        "Coins",
        amount,
        balanceAfter,
        Enum.AnalyticsEconomyTransactionType.Shop.Name,
        sink
    )
end

function Analytics.TradeComplete(plr: Player, valueA: number, valueB: number)
    local lo, hi = math.min(valueA, valueB), math.max(valueA, valueB)
    local ratio = if lo > 0 then hi / lo else hi
    custom(
        plr,
        "trade_complete",
        math.floor(ratio * 100) / 100,
        fields(
            Analytics.Bucket(valueA, VALUE_EDGES),
            Analytics.Bucket(valueB, VALUE_EDGES),
            Analytics.Bucket(ratio, { 1.5, 3, 5, 10 })
        )
    )
end

function Analytics.SessionEnd(
    plr: Player,
    duration: number,
    roundsPlayed: number,
    coinsEarned: number,
    isNew: boolean
)
    custom(
        plr,
        "session_end",
        math.floor(duration),
        fields(
            Analytics.Bucket(roundsPlayed, { 1, 3, 5, 8, 12 }),
            Analytics.Bucket(coinsEarned, { 100, 250, 500, 1000 }),
            isNew
        )
    )
end

function Analytics.FirstSessionExit(
    plr: Player,
    lastScreen: string,
    secondsPlayed: number,
    roundsPlayed: number
)
    custom(
        plr,
        "first_session_exit",
        math.floor(secondsPlayed),
        fields(lastScreen, Analytics.Bucket(roundsPlayed, { 1, 2, 3, 5 }))
    )
end

-- Not one of the handbook's ten: SocialService reports. The reported player is
-- never a field (cardinality); the value is how many reports they have here.
function Analytics.PlayerReport(plr: Player, reason: string, reportsOnTarget: number)
    custom(
        plr,
        "player_report",
        reportsOnTarget,
        fields(reason, Analytics.Bucket(reportsOnTarget, { 2, 3, 5, 10 }))
    )
end

-- Onboarding funnel: each step logs once per player, in order
-- Every step here must be one the player cannot avoid, in the order they
-- reach it. Voting used to sit at step 2 and it was neither: the free crate
-- lands automatically five seconds after joining, while voting needs a tap on
-- a map card that most players never make. So the real sequence was 1 -> 3,
-- with 2 either missing or arriving late, which reads as everyone dropping
-- out at step 2 while going on to finish two rounds. It is a custom event now.
Analytics.FUNNEL = {
    JOINED = { 1, "joined" },
    FREE_CRATE = { 2, "free_crate" },
    FIRST_ROUND_START = { 3, "first_round_start" },
    FIRST_ROUND_END = { 4, "first_round_end" },
    SECOND_ROUND_START = { 5, "second_round_start" },
}

function Analytics.Funnel(plr: Player, step: { any })
    debugLog("funnel", step[1], step[2])
    pcall(AnalyticsService.LogOnboardingFunnelStepEvent, AnalyticsService, plr, step[1], step[2])
end

-- The first map a new player votes for. Deliberately not a funnel step, and
-- the name is one RoundService already matched against Config.MAPS, so no
-- player-supplied string reaches the field.
function Analytics.FirstVote(plr: Player, mapName: string)
    custom(plr, "first_vote", 1, fields(mapName))
end

return Analytics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">AssassinService</string>
          <string name="Source"><![CDATA[-- Assassin free-for-all: each player is handed a target to hunt. You can knife
-- anyone, but your target is who to find; when your target dies you're given a
-- new living one, so there is always someone to chase. Last blade standing wins
-- (RoundService owns the win condition).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Modes = require(ReplicatedStorage.Shared.Modes)
local Remotes = ReplicatedStorage.Remotes
local RoleService = require(script.Parent.RoleService)
local Participant = require(script.Parent.Participant)

local AssassinService = {}
local round: any = nil
local target: { [any]: any } = {}

function AssassinService:BindRound(roundService)
    round = roundService
end

local function ffa(): boolean
    return round ~= nil and Modes.Get(ReplicatedStorage:GetAttribute("Mode")).ffa == true
end

local function livingOthers(plr): { any }
    local out = {}
    for _, p in RoleService:Participants() do
        if p ~= plr and round:IsAlive(p) then
            table.insert(out, p)
        end
    end
    return out
end

local function assign(plr)
    local opts = livingOthers(plr)
    if #opts == 0 then
        target[plr] = nil
        return
    end
    local t = opts[math.random(#opts)]
    target[plr] = t
    if not Participant.IsBot(plr) then
        Remotes.Notify:FireClient(plr, ("Your target: %s"):format(t.Name))
    end
end

function AssassinService:OnRoundStart()
    target = {}
    if not ffa() then
        return
    end
    for _, p in RoleService:Participants() do
        if round:IsAlive(p) then
            assign(p)
        end
    end
end

-- A death: anyone hunting the fallen player is handed a fresh target.
function AssassinService:OnDeath(victim)
    if not ffa() then
        return
    end
    target[victim] = nil
    for p, t in target do
        if t == victim and round:IsAlive(p) then
            assign(p)
        end
    end
end

return AssassinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">AudioService</string>
          <string name="Source"><![CDATA[--!strict
-- Server side of the sound spec (Handbook §04).
-- Positional cues are sent only to players inside the cue's range. Parenting
-- a replicated Sound at the source would hand an exploiter a live map of every
-- knife swing — role ESP through the audio channel.
local Players = game:GetService("Players")
local SoundCues = require(game.ReplicatedStorage.Shared.SoundCues)
local Remotes = game.ReplicatedStorage.Remotes
local Participant = require(script.Parent.Participant)

local AudioService = {}
local RANGE_SLACK = 1.1

function AudioService:Emit(cueId: string, position: Vector3)
    local cue = SoundCues.cues[cueId]
    if not cue then
        return
    end
    if not cue.range then
        Remotes.PlayCue:FireAllClients(cueId)
        return
    end
    local reach = cue.range * RANGE_SLACK
    for _, plr in Players:GetPlayers() do
        local char = plr.Character
        if char and (char:GetPivot().Position - position).Magnitude <= reach then
            Remotes.PlayCue:FireClient(plr, cueId, position)
        end
    end
end

function AudioService:Play2D(plr: Player?, cueId: string, pitch: number?)
    if plr then
        if Participant.IsBot(plr) then
            return
        end
        Remotes.PlayCue:FireClient(plr, cueId, nil, pitch)
    else
        Remotes.PlayCue:FireAllClients(cueId, nil, pitch)
    end
end

return AudioService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">BotService</string>
          <string name="Source"><![CDATA[-- NPCs that fill a quiet server (Config.BOTS_ENABLED) so one person can play.
-- They are round participants like players: RoleService deals them roles,
-- CombatService kills them, EvidenceService drops their bodies and reads
-- their shirt colour for the fibre clue. They act only through the same
-- server functions a player's remotes reach, so every range check, cooldown
-- and grace period applies to them too.
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(game.ReplicatedStorage.Shared.Config)
local MapPlan = require(game.ReplicatedStorage.Shared.MapPlan)
local FibreBands = require(game.ReplicatedStorage.Shared.FibreBands)
local Shuffle = require(game.ReplicatedStorage.Shared.Shuffle)
local RoleService = require(script.Parent.RoleService)
local CombatService = require(script.Parent.CombatService)

local BotService = {}
local round: any = nil -- RoundService, handed over by BindRound
local bots: { any } = {}
local byCharacter: { [Instance]: any } = {}
local points: { Vector3 } = {}
local plan, planAnalysis = nil, nil -- the map being played, for room-to-room routing
local RUN_SPEED = Config.WALKSPEED -- a player's walk speed; NPCs match it only when running

local NAMES = {
    "Otto",
    "Wren",
    "Mara",
    "Silas",
    "Iris",
    "June",
    "Felix",
    "Nell",
    "Hugo",
    "Ada",
    "Cyril",
    "Edith",
}
-- Every NPC is dressed from free Roblox-made catalogue assets, so they load
-- in any experience without ownership: a classic shirt and pants, a hair
-- accessory, a face, and a body of its own proportions. `colour` is the
-- shirt's real torso tone, measured from its template, and the torso part
-- is painted it under the texture so the fibre clue (which reads torso
-- colour) still tells the truth about what the killer wore.
local SHIRTS = {
    { id = 382537702, colour = "10c2a8" }, -- Teal Shirt
    { id = 382538059, colour = "3a5c42" }, -- Green Jersey
    { id = 607785314, colour = "1e1e1e" }, -- ROBLOX Jacket
    { id = 144076436, colour = "5e7c86" }, -- Grey Striped Shirt with Denim Jacket
    { id = 4047884046, colour = "486064" }, -- Guitar Tee with Black Jacket
    { id = 4047886060, colour = "29d6b9" }, -- Purple and Teal Top
    { id = 3670737444, colour = "111111" }, -- Roblox Shirt - Simple Pattern
    { id = 398635081, colour = "34506f" }, -- Blue Plaid Shirt
    { id = 398633584, colour = "a0a6ad" }, -- Denim Jacket with White Hoodie
    { id = 144076358, colour = "2a3a5a" }, -- Blue and Black Motorcycle Shirt
}
local PANTS = {
    382537569, -- Black Jeans
    398633812, -- Black Jeans with White Shoes
    144076760, -- Dark Green Jeans
    382538503, -- Black Jeans with Sneakers
    398634487, -- Beautiful You Jeans
    398635338, -- Ripped Skater Pants
    382537806, -- Jean Shorts
    382537950, -- Jean Shorts with White Shoes
}
local HAIR = {
    62234425, -- Brown Hair
    376526888, -- Straight Blonde Hair
    376548738, -- Brown Charmer Hair
    376524487, -- Blonde Spiked Hair
    7193454569, -- Braided Hair - Black
    9244150641, -- Braided Hair - Cool Brown
    2956239660, -- Belle Of Belfast Long Red Hair
    63690008, -- Pal Hair
    451221329, -- True Blue Hair
    9244148336, -- Braided Hair - Blonde
    7193455510, -- Braided Hair - Red
}
local FACES = {
    7074764, -- Chill
    7075469, -- :-/
    8560971, -- Stare
    10907549, -- Finn McCool
    15637848, -- -_-
    20418658, -- Err...
    28999228, -- Joyous Surprise
    7074864, -- Winky
    15432080, -- :3
    21635565, -- Heeeeeey...
}
local SKIN = { "f1c27d", "e0ac69", "c68642", "8d5524", "ffdbac", "a67c52" }
-- Body colours for the undressed fallback rig, when no catalogue asset loads
local TROUSERS = { "2b2b2b", "3d3a35", "1f2a38", "4a3b2c" }
-- Roblox's default R15 animations, which any experience may play
local ANIMATIONS = { walk = "rbxassetid://913402848", idle = "rbxassetid://507766666" }

-- The Player surface round code touches, so an NPC passes through unchanged
local Bot = {}
Bot.__index = Bot
function Bot:GetAttribute(key: string): any
    return self.attributes[key]
end
function Bot:SetAttribute(key: string, value: any)
    self.attributes[key] = value
end
function Bot:FindFirstChild(_name: string): Instance?
    return nil
end
function Bot:FindFirstChildOfClass(_className: string): Instance?
    return nil
end
function Bot:LoadCharacter() end
function Bot:Kick() end

local function between(bounds: { number }): number
    return bounds[1] + math.random() * (bounds[2] - bounds[1])
end

local function pick<T>(list: { T }): number
    return math.random(#list)
end

-- The fibre clue names the colour band of the killer's shirt, so a round where
-- three NPCs wear the same band narrows almost nothing. Shirts are dealt one
-- band at a time, and never handed out twice.
type Shirt = { id: number, colour: string }
local function shirtDeck(): { Shirt }
    local byBand: { [string]: { Shirt } } = {}
    local order = {}
    for _, shirt in Shuffle.Shuffled(SHIRTS) do
        local band = FibreBands.Describe(Color3.fromHex(shirt.colour):ToHSV())
        if not byBand[band] then
            byBand[band] = {}
            table.insert(order, band)
        end
        table.insert(byBand[band], shirt)
    end
    local deck = {}
    local more = true
    while more do
        more = false
        for _, band in order do
            local shirt = table.remove(byBand[band])
            if shirt then
                table.insert(deck, shirt)
                more = more or #byBand[band] > 0
            end
        end
    end
    return deck
end

function BotService:BindRound(roundService)
    round = roundService
end

---------------------------------------------------------------- The rig
-- One plain R15 rig, built once and cloned for every NPC. Building it loads
-- assets and can fail on a busy live server, so it retries, and as a last
-- resort copies a player's body stripped of everything that makes it theirs.
local rigTemplate: Model? = nil

local function copyOfPlayer(): Model?
    for _, plr in Players:GetPlayers() do
        local char = plr.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local was = char.Archivable
            char.Archivable = true
            local copy = char:Clone()
            char.Archivable = was
            if copy then
                for _, d in copy:GetDescendants() do
                    if
                        d:IsA("LuaSourceContainer")
                        or d:IsA("Accessory")
                        or d:IsA("Clothing")
                        or d:IsA("ShirtGraphic")
                        or d:IsA("Decal")
                        or d:IsA("Tool")
                        or d:IsA("ForceField")
                    then
                        d:Destroy()
                    end
                end
                return copy
            end
        end
    end
    return nil
end

local function rig(): Model?
    if rigTemplate then
        return rigTemplate
    end
    for attempt = 1, 3 do
        local ok, model = pcall(
            Players.CreateHumanoidModelFromDescription,
            Players,
            Instance.new("HumanoidDescription"),
            Enum.HumanoidRigType.R15
        )
        if ok and model then
            rigTemplate = model
            break
        end
        warn(("[ColdCase] NPC rig, attempt %d: %s"):format(attempt, tostring(model)))
        task.wait(attempt)
    end
    rigTemplate = rigTemplate or copyOfPlayer()
    local template = rigTemplate
    if template then
        local animateScript = template:FindFirstChild("Animate")
        if animateScript then
            animateScript:Destroy() -- a LocalScript; the server animates NPCs instead
        end
    end
    return template
end

---------------------------------------------------------------- Looks
-- Each named NPC has one look, built once on server start and cloned every
-- round, so Nell is always the same red-haired woman in the green jersey.
-- Shirts are dealt across the names from the band deck, so whichever six
-- turn up, their fibre bands are as spread as the wardrobe allows.
type Look = {
    shirt: Shirt,
    pants: number,
    hair: number?,
    face: number,
    skin: Color3,
    scale: {
        height: number,
        width: number,
        depth: number,
        head: number,
        body: number,
        prop: number,
    },
}
local looks: { [string]: Look } = {}
local dressed: { [string]: Model } = {}
local wardrobeReady = false

local function lookFor(index: number, shirt: Shirt): Look
    local rng = Random.new(index * 7919)
    -- Neighbouring seeds open with correlated draws (seven of twelve came
    -- out bald from a one-in-six roll); a few discarded draws spread them
    for _ = 1, 8 do
        rng:NextNumber()
    end
    return {
        shirt = shirt,
        pants = PANTS[rng:NextInteger(1, #PANTS)],
        -- Every sixth name goes without hair
        hair = if index % 6 == 0 then nil else HAIR[rng:NextInteger(1, #HAIR)],
        face = FACES[rng:NextInteger(1, #FACES)],
        skin = Color3.fromHex(SKIN[rng:NextInteger(1, #SKIN)]),
        scale = {
            height = rng:NextNumber(0.93, 1.06),
            width = rng:NextNumber(0.9, 1.08),
            depth = rng:NextNumber(0.95, 1.05),
            head = rng:NextNumber(0.96, 1.04),
            body = rng:NextNumber(0, 0.35),
            prop = rng:NextNumber(0, 0.6),
        },
    }
end

local function describe(look: Look): HumanoidDescription
    local d = Instance.new("HumanoidDescription")
    d.Shirt = look.shirt.id
    d.Pants = look.pants
    d.Face = look.face
    d.HairAccessory = if look.hair then tostring(look.hair) else ""
    local skin = look.skin
    d.HeadColor = skin
    d.LeftArmColor = skin
    d.RightArmColor = skin
    d.LeftLegColor = skin
    d.RightLegColor = skin
    d.TorsoColor = Color3.fromHex(look.shirt.colour)
    d.HeightScale = look.scale.height
    d.WidthScale = look.scale.width
    d.DepthScale = look.scale.depth
    d.HeadScale = look.scale.head
    d.BodyTypeScale = look.scale.body
    d.ProportionScale = look.scale.prop
    return d
end

local function stripClientScripts(model: Model)
    for _, d in model:GetDescendants() do
        if d:IsA("LuaSourceContainer") then
            d:Destroy() -- the Animate LocalScript; the server animates NPCs instead
        end
    end
end

-- Builds one dressed body from the catalogue. Nil when the assets will not
-- load, and the caller falls back to the plain rig in flat colours.
local function dress(look: Look): Model?
    local bald: Model? = nil
    for attempt = 1, 4 do
        local ok, model = pcall(
            Players.CreateHumanoidModelFromDescription,
            Players,
            describe(look),
            Enum.HumanoidRigType.R15
        )
        if ok and model then
            stripClientScripts(model)
            -- Accessories load separately and are silently dropped when a
            -- busy server start cannot fetch them in time, so a look that
            -- asked for hair and got none is tried again
            if not look.hair or model:FindFirstChildOfClass("Accessory") then
                if bald then
                    bald:Destroy()
                end
                return model
            end
            if bald then
                bald:Destroy()
            end
            bald = model
            warn(("[ColdCase] NPC hair did not load, attempt %d"):format(attempt))
        else
            warn(("[ColdCase] NPC outfit, attempt %d: %s"):format(attempt, tostring(model)))
        end
        task.wait(attempt)
    end
    return bald
end

local function buildWardrobe()
    task.wait(1.5) -- let the server's own asset loads settle first
    local deck = shirtDeck()
    for i, name in NAMES do
        local shirt = deck[((i - 1) % #deck) + 1]
        looks[name] = lookFor(i, shirt)
    end
    local store = Instance.new("Folder")
    store.Name = "NPCLooks"
    store.Parent = ServerStorage
    for _, name in NAMES do
        local model = dress(looks[name])
        if model then
            model.Name = name
            model.Parent = store
            dressed[name] = model
        end
    end
    wardrobeReady = true
end

-- Bootstrap warms the rig and the wardrobe on server start, so the first
-- round never waits on them
function BotService:Prepare()
    task.spawn(rig)
    task.spawn(buildWardrobe)
end

-- Paints the parts directly as well as BodyColors, so a corpse clone and the
-- fibre clue (which reads the torso part) see the same tones.
local function colour(char: Model, torso: Color3, skin: Color3, arms: Color3, legs: Color3)
    local body = char:FindFirstChildOfClass("BodyColors")
    if body then
        body.HeadColor3 = skin
        body.TorsoColor3 = torso
        body.LeftArmColor3 = arms
        body.RightArmColor3 = arms
        body.LeftLegColor3 = legs
        body.RightLegColor3 = legs
    end
    for _, part in char:GetDescendants() do
        if part:IsA("BasePart") then
            local name = part.Name
            if name == "Head" then
                part.Color = skin
            elseif string.find(name, "Torso") then
                part.Color = torso
            elseif string.find(name, "Arm") or string.find(name, "Hand") then
                part.Color = arms
            elseif string.find(name, "Leg") or string.find(name, "Foot") then
                part.Color = legs
            end
        end
    end
end

function BotService:FromCharacter(model: Instance): any
    return byCharacter[model]
end

---------------------------------------------------------------- Bodies
local function folder(): Folder
    local f = workspace:FindFirstChild("Bots")
    if not f then
        f = Instance.new("Folder")
        f.Name = "Bots"
        f.Parent = workspace
    end
    return f :: Folder
end

local function animate(hum: Humanoid)
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local tracks = {}
    for key, id in ANIMATIONS do
        local animation = Instance.new("Animation")
        animation.AnimationId = id
        local ok, track = pcall(function()
            return (animator :: Animator):LoadAnimation(animation)
        end)
        if ok and track then
            track.Looped = true
            tracks[key] = track
        end
    end
    if tracks.idle then
        tracks.idle:Play()
    end
    hum.Running:Connect(function(speed)
        local walk = tracks.walk
        if not walk then
            return
        end
        if speed > 0.5 and not walk.IsPlaying then
            walk:Play(0.2)
        elseif speed <= 0.5 and walk.IsPlaying then
            walk:Stop(0.2)
        end
    end)
end

-- What an NPC wears: the dressed outfit's tones when its wardrobe built, or
-- the plain rig's random ones. Kept on the NPC so a revive brings the same
-- person back, and the fibre clue keeps telling the truth about their shirt.
type Wear = { given: string?, torso: Color3, skin: Color3, arms: Color3, legs: Color3 }

local function wearFor(given: string?, index: number, shirts: { Shirt }): Wear
    local look = given and looks[given]
    if look and given and dressed[given] then
        local torso = Color3.fromHex(look.shirt.colour)
        return { given = given, torso = torso, skin = look.skin, arms = look.skin, legs = look.skin }
    end
    local shirt = shirts[index] or SHIRTS[pick(SHIRTS)]
    local shirtColour = Color3.fromHex(shirt.colour)
    return {
        given = given,
        torso = shirtColour,
        skin = Color3.fromHex(SKIN[pick(SKIN)]),
        arms = shirtColour,
        legs = Color3.fromHex(TROUSERS[pick(TROUSERS)]),
    }
end

-- A body in that wear: the dressed outfit if there is one, else the plain rig
local function bodyFor(wear: Wear, template: Model): Model
    local outfit = if wear.given then dressed[wear.given] else nil
    local char = if outfit then outfit:Clone() else template:Clone()
    colour(char, wear.torso, wear.skin, wear.arms, wear.legs)
    return char
end

-- Makes a body this NPC's: its name and tag, server-owned physics, animation,
-- and the tidy-up after it dies. Shared by Spawn and Respawn.
local function inhabit(bot, char: Model, hum: Humanoid, pivot: CFrame)
    local name = bot.Name
    char.Name = name
    hum.DisplayName = name
    hum.Health = hum.MaxHealth
    char:SetAttribute("BotName", name)
    char:AddTag("BotCharacter")
    char:PivotTo(pivot)
    char.Parent = folder()
    -- Server-owned physics: a nearby client can never fling or teleport an NPC
    for _, part in char:GetDescendants() do
        if part:IsA("BasePart") and part:CanSetNetworkOwnership() then
            part:SetNetworkOwner(nil)
        end
    end
    animate(hum)
    bot.Character = char
    byCharacter[char] = bot
    hum.Died:Connect(function()
        task.delay(4, function()
            if char.Parent then
                char:Destroy()
            end
            byCharacter[char] = nil
            -- A revive may already have given them a new body; forget only this one
            if bot.Character == char then
                bot.Character = nil
            end
        end)
    end)
end

function BotService:Spawn(count: number): { any }
    local made = {}
    if count <= 0 then
        return made
    end
    local names = Shuffle.Shuffled(NAMES)
    local shirts = shirtDeck()
    local lobby = workspace:FindFirstChild("Lobby")
    local spawnPart = lobby and lobby:FindFirstChild("LobbySpawn")
    local origin = if spawnPart and spawnPart:IsA("BasePart")
        then spawnPart.Position
        else Vector3.new(0, 2, -900)

    local template = rig()
    if not template then
        warn("[ColdCase] no NPC rig could be built")
        return made
    end
    -- The wardrobe is still dressing on a server that starts a round at once
    local deadline = os.clock() + 6
    while not wardrobeReady and os.clock() < deadline do
        task.wait(0.25)
    end

    for i = 1, count do
        local given = names[i]
        local wear = wearFor(given, i, shirts)
        local char = bodyFor(wear, template)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then
            char:Destroy()
            continue
        end

        -- "(NPC)" cannot appear in a Roblox username, so names never collide
        local name = (given or ("Guest" .. i)) .. " (NPC)"
        local bot = setmetatable({
            IsBot = true,
            Name = name,
            DisplayName = name,
            UserId = -i,
            Character = nil,
            Parent = Players, -- present, as far as round code is concerned
            attributes = { Rank = 1 },
            brain = {},
            wear = wear,
        }, Bot)
        inhabit(bot, char, hum, CFrame.new(origin + Vector3.new((i - count / 2) * 4, 4, 8)))
        table.insert(bots, bot)
        table.insert(made, bot)
    end
    return made
end

-- A medic brought an NPC back. The body it died in is a corpse now
-- (EvidenceService cloned it at death), so it gets a fresh one in the same
-- clothes at the spot the medic chose. RoundService:Revive then marks it
-- alive and wakes it. False if no body could be built; the revive is not
-- spent on that.
function BotService:Respawn(bot, pivot: CFrame): boolean
    local template = rig()
    if not (bot and bot.IsBot and bot.wear and template) then
        return false
    end
    local char = bodyFor(bot.wear, template)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then
        char:Destroy()
        return false
    end
    local old = bot.Character
    if old then
        byCharacter[old] = nil
        old:Destroy()
    end
    inhabit(bot, char, hum, pivot)
    return true
end

function BotService:Clear()
    for _, bot in bots do
        if bot.Character then
            bot.Character:Destroy()
        end
    end
    bots = {}
    byCharacter = {}
end

---------------------------------------------------------------- Senses and movement
local function rootOf(bot): BasePart?
    local char = bot.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    return if root and root:IsA("BasePart") then root else nil
end

local function humanoidOf(bot): Humanoid?
    local char = bot.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function positionOf(p): Vector3?
    local char = p.Character
    return char and char.Parent and char:GetPivot().Position
end

local function canSee(bot, target, maxDistance: number): boolean
    local char, other = bot.Character, target.Character
    local head = char and char:FindFirstChild("Head")
    if not (head and head:IsA("BasePart") and other) then
        return false
    end
    local to = other:GetPivot().Position - head.Position
    if to.Magnitude > maxDistance then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { char, other }
    return workspace:Raycast(head.Position, to, params) == nil
end

local function collectPoints()
    points = {}
    local roundFolder = workspace:FindFirstChild("Round")
    if not roundFolder then
        return
    end
    for _, d in roundFolder:GetDescendants() do
        if d:IsA("BasePart") and (d:HasTag("SpawnPoint") or d:HasTag("CoinNode")) then
            table.insert(points, d.Position)
        end
    end
end

-- NPCs cross a building a few rooms at a time: the plan says which cells lead
-- to the goal, and the NPC heads for one a short way along that route. Short
-- legs keep each path request cheap and reliable, and they send an NPC through
-- the doorways and up the stairs the plan knows about rather than guessing.
local function leg(root: BasePart, goal: Vector3): Vector3
    if not (plan and planAnalysis) then
        return goal
    end
    local here = root.Position
    local f1, x1, z1 = MapPlan.CellAt(plan, here.X, here.Y, here.Z)
    local f2, x2, z2 = MapPlan.CellAt(plan, goal.X, goal.Y, goal.Z)
    if f1 == f2 and math.abs(x1 - x2) <= 2 and math.abs(z1 - z2) <= 2 then
        return goal -- close enough to walk straight at it
    end
    local route = MapPlan.Route(
        plan,
        planAnalysis,
        { f = f1, x = x1, z = z1 },
        { f = f2, x = x2, z = z2 }
    )
    if not route or #route == 0 then
        return goal
    end
    local step = route[math.min(#route, 3)]
    local x, y, z = MapPlan.Position(plan, step.f, step.x, step.z)
    return Vector3.new(x, y + 3, z)
end

-- Walks toward `goal` along a computed path, recomputing when the goal moves
-- or the path goes stale
local function steer(bot, goal: Vector3, speed: number)
    local brain = bot.brain
    local root, hum = rootOf(bot), humanoidOf(bot)
    if not (root and hum) then
        return
    end
    if hum.WalkSpeed ~= speed then
        hum.WalkSpeed = speed
    end
    local now = os.clock()
    local here = leg(root, goal)
    if not brain.path or (brain.goal - here).Magnitude > 8 or now - brain.pathAt > 2.5 then
        brain.goal, brain.pathAt = here, now
        brain.pathObject = brain.pathObject
            or PathfindingService:CreatePath({
                AgentRadius = 2,
                AgentHeight = 5,
                AgentCanJump = false,
            })
        local path = brain.pathObject
        local ok = pcall(function()
            path:ComputeAsync(root.Position, here)
        end)
        if ok and path.Status == Enum.PathStatus.Success then
            brain.path, brain.step = path:GetWaypoints(), 2
            brain.lost = nil
        else
            -- Walking straight at a goal on another floor gets nowhere
            brain.path, brain.step = { { Position = here } }, 1
            brain.lost = goal
        end
    end
    local waypoint = brain.path[brain.step]
    while waypoint do
        local flat = Vector3.new(waypoint.Position.X, root.Position.Y, waypoint.Position.Z)
        if
            (flat - root.Position).Magnitude >= 3
            or math.abs(waypoint.Position.Y - root.Position.Y) > 6
        then
            break
        end
        brain.step += 1
        waypoint = brain.path[brain.step]
    end
    hum:MoveTo(if waypoint then waypoint.Position else here)
end

local function stop(bot)
    local root, hum = rootOf(bot), humanoidOf(bot)
    if root and hum then
        hum:MoveTo(root.Position)
    end
end

local function wander(bot, now: number)
    local brain = bot.brain
    local root = rootOf(bot)
    if not root or #points == 0 then
        return
    end
    if now < (brain.lingerUntil or 0) then
        stop(bot)
        return
    end
    local target = brain.wanderTo
    -- Arrived means the same floor too: a spot straight overhead is not reached
    local arrived = target ~= nil
        and (Vector3.new(target.X, root.Position.Y, target.Z) - root.Position).Magnitude < 5
        and math.abs(target.Y - root.Position.Y) < 6
    if not target or arrived or brain.lost == target or now > (brain.wanderUntil or 0) then
        if target then
            brain.wanderTo = nil
            brain.lingerUntil = now + 1 + math.random() * 3
            stop(bot)
            return
        end
        brain.wanderTo = points[math.random(#points)]
        brain.wanderUntil = now + 20
    end
    local speed = if now < (brain.fleeUntil or 0) then RUN_SPEED else Config.BOT_STROLL_SPEED
    steer(bot, brain.wanderTo, speed)
end

-- Heads for whichever of a few random spots is farthest from the danger
local function flee(bot, from: Vector3)
    if #points == 0 then
        return
    end
    local best, bestDistance = nil, -1
    for _ = 1, 6 do
        local p = points[math.random(#points)]
        local d = (p - from).Magnitude
        if d > bestDistance then
            best, bestDistance = p, d
        end
    end
    local now = os.clock()
    bot.brain.wanderTo = best
    bot.brain.wanderUntil = now + 12
    bot.brain.fleeUntil = now + 6
    bot.brain.lingerUntil = 0
end

---------------------------------------------------------------- Brains
-- Murderer: blends in, then stalks whoever is most alone
local function hunt(bot, now: number)
    local brain = bot.brain
    brain.nextHunt = brain.nextHunt or now + between(Config.BOT_FIRST_HUNT)
    if now < brain.nextHunt then
        wander(bot, now)
        return
    end
    local root = rootOf(bot)
    if not root then
        return
    end
    local target = brain.target
    if target and now - (brain.targetSince or now) > Config.BOT_CHASE_GIVE_UP then
        target = nil -- this one keeps getting away; look for someone easier
    end
    if not (target and round:IsAlive(target)) then
        target = nil
        local bestScore = math.huge
        local living = round:AliveParticipants()
        for _, p in living do
            local pos = positionOf(p)
            if p ~= bot and pos and RoleService:Get(p) ~= "murderer" then
                local crowd = 0
                for _, q in living do
                    local qpos = positionOf(q)
                    if q ~= p and q ~= bot and qpos and (qpos - pos).Magnitude < 25 then
                        crowd += 1
                    end
                end
                local score = (pos - root.Position).Magnitude + crowd * 60 + math.random() * 30
                if p == brain.target then
                    score += 80 -- just gave up on them
                end
                if score < bestScore then
                    target, bestScore = p, score
                end
            end
        end
        brain.target = target
        brain.targetSince = now
    end
    local pos = target and positionOf(target)
    if not pos then
        wander(bot, now)
        return
    end
    local distance = (pos - root.Position).Magnitude
    if distance <= Config.KNIFE_RANGE - 2 then
        CombatService:RequestStab(bot, target)
        if not round:IsAlive(target) then
            brain.target = nil
            brain.nextHunt = now + between(Config.BOT_HUNT_PAUSE)
            flee(bot, pos)
        end
    else
        -- Head for where they are going, not where they were
        local targetRoot = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        local lead = if targetRoot and targetRoot:IsA("BasePart")
            then targetRoot.AssemblyLinearVelocity * math.min(distance / RUN_SPEED, 1.2)
            else Vector3.zero
        steer(bot, pos + Vector3.new(lead.X, 0, lead.Z), RUN_SPEED)
    end
end

-- Sheriff or hero: only ever fires on a killer it saw, or the murderer Last
-- Call outlines for everyone
local function patrol(bot, now: number)
    local brain = bot.brain
    if
        round:TimeLeft() <= Config.LAST_CALL_AT
        and not (brain.suspect and round:IsAlive(brain.suspect))
    then
        for _, p in round:AliveParticipants() do
            if RoleService:Get(p) == "murderer" then
                brain.suspect = p
                brain.fireAt = now + between(Config.BOT_REACTION)
                break
            end
        end
    end
    local suspect = brain.suspect
    local pos = suspect and round:IsAlive(suspect) and positionOf(suspect)
    local root = rootOf(bot)
    if not (pos and root) then
        brain.suspect = nil
        wander(bot, now)
        return
    end
    local distance = (pos - root.Position).Magnitude
    if distance <= Config.GUN_RANGE * 0.3 and canSee(bot, suspect, Config.GUN_RANGE * 0.3) then
        stop(bot)
        if now >= (brain.fireAt or 0) then
            local spread = distance / 45
            local aim = pos
                + Vector3.new(
                    (math.random() - 0.5) * 2 * spread,
                    1.5 + (math.random() - 0.5) * spread,
                    (math.random() - 0.5) * 2 * spread
                )
            CombatService:RequestShoot(bot, aim)
            brain.fireAt = now + Config.GUN_COOLDOWN + between(Config.BOT_REACTION) * 0.5
        end
    else
        steer(bot, pos, RUN_SPEED)
    end
end

local function think(bot)
    local now = os.clock()
    local role = RoleService:Get(bot)
    if role == "murderer" then
        hunt(bot, now)
    elseif role == "sheriff" or role == "hero" then
        patrol(bot, now)
    else
        wander(bot, now)
    end
end

-- One NPC's mind, from now until it dies, the round ends, or a newer mind
-- takes over. The brain table is the mind's token: `think` can be mid-yield
-- (Path:ComputeAsync) when the NPC dies, and if a medic revives it before
-- that yield returns, the old loop would find it alive again and run on
-- beside the one Wake started. A replaced brain ends the old loop instead,
-- and only a loop that still owns the brain stops the body on its way out.
local function startThinking(bot)
    local mind = {}
    bot.brain = mind
    task.spawn(function()
        while bot.brain == mind and round:GetState() == "ACTIVE" and round:IsAlive(bot) do
            local ok, err = pcall(think, bot)
            if not ok then
                warn("[ColdCase] NPC " .. bot.Name .. ": " .. tostring(err))
                task.wait(1)
            end
            task.wait(0.25)
        end
        if bot.brain ~= mind then
            return -- a newer mind has the body now
        end
        local hum = humanoidOf(bot)
        if hum and hum.Health > 0 then
            stop(bot)
        end
    end)
end

function BotService:StartRound()
    collectPoints()
    plan = round and MapPlan.MAPS[round:MapName()] or nil
    planAnalysis = plan and MapPlan.Analyse(plan) or nil
    for _, bot in bots do
        startThinking(bot)
    end
end

-- Back on its feet after a revive: RoundService calls this once the NPC is
-- marked alive again, so the loop's first check passes
function BotService:Wake(bot)
    if bot and bot.IsBot and round:IsAlive(bot) then
        startThinking(bot)
    end
end

-- A kill someone saw: NPC sheriffs mark the killer, everyone else runs
function BotService:OnDeath(victim, killer, method: string, position: Vector3)
    if not killer or killer == victim then
        return
    end
    local now = os.clock()
    for _, bot in bots do
        if bot == killer or bot == victim or not round:IsAlive(bot) then
            continue
        end
        local root = rootOf(bot)
        if
            not root
            or (root.Position - position).Magnitude > Config.BOT_SIGHT
            or not canSee(bot, killer, Config.BOT_SIGHT)
        then
            continue
        end
        local role = RoleService:Get(bot)
        if (role == "sheriff" or role == "hero") and (method == "knife" or method == "throw") then
            bot.brain.suspect = killer
            bot.brain.fireAt = now + between(Config.BOT_REACTION)
        elseif role ~= "murderer" then
            flee(bot, position)
        end
    end
end

return BotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">CoinService</string>
          <string name="Source"><![CDATA[-- Coin pickups (Handbook §06 · Coin injection). The client only names a node
-- it believes it is standing on; the server owns the node list, the one-time
-- taken flag, the range check and the amount.
local Config = require(game.ReplicatedStorage.Shared.Config)
local EconomyService = require(script.Parent.EconomyService)
local CombatFx = require(game.ReplicatedStorage.Shared.CombatFx)

local CoinService = {}
local nodes: { [number]: BasePart } = {}
local armed = false
local round: any = nil -- RoundService, handed over by BindRound

function CoinService:BindRound(roundService)
    round = roundService
end

function CoinService:Arm(roundFolder: Instance)
    nodes = {}
    local nextId = 1
    for _, part in roundFolder:GetDescendants() do
        if part:IsA("BasePart") and part:HasTag("CoinNode") then
            part:SetAttribute("NodeId", nextId)
            nodes[nextId] = part
            nextId += 1
        end
    end
    armed = true
end

function CoinService:Disarm()
    armed = false
    for _, part in nodes do
        part:Destroy()
    end
    nodes = {}
end

function CoinService:RequestCoin(plr: Player, nodeId: any)
    if not armed or type(nodeId) ~= "number" then
        return
    end
    local node = nodes[nodeId]
    if not node then
        return -- unknown, or already taken
    end
    local char = plr.Character
    if not (char and round:IsAlive(plr)) then
        return
    end
    local reach = Config.COIN_PICKUP_RANGE + Config.PING_ALLOWANCE
    if (char:GetPivot().Position - node.Position).Magnitude > reach then
        return
    end

    nodes[nodeId] = nil -- one-time flag, set before anything can yield
    CombatFx.Pickup(node.Position)
    node:Destroy()
    EconomyService:Grant(plr, Config.COIN_PICKUP, 0, "pickup")
end

return CoinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">CombatService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Modes = require(game.ReplicatedStorage.Shared.Modes)
local RoleService = require(script.Parent.RoleService)
local AudioService = require(script.Parent.AudioService)
local EvidenceService = require(script.Parent.EvidenceService)
local CosmeticService = require(script.Parent.CosmeticService)
local CombatFx = require(game.ReplicatedStorage.Shared.CombatFx)
local Participant = require(script.Parent.Participant)
local Remotes = game.ReplicatedStorage.Remotes

local CombatService = {}
local lastAction = {} -- [Player] = { [action] = os.clock() }
local roundStart = 0
local droppedGun: BasePart? = nil
local round: any = nil -- RoundService, handed over by BindRound

function CombatService:BindRound(roundService)
    round = roundService
end

function CombatService:MarkRoundStart()
    roundStart = os.clock()
    lastAction = {}
    droppedGun = nil
end

-- The gun a fallen sheriff leaves behind for someone to pick up and become the
-- hero. Uses the real revolver mesh from Cosmetics, scaled up a little and given
-- a soft in-sight outline so it is unmistakably a gun and still easy to spot,
-- with a plain gold part as the fallback if the cosmetic is missing. Stays a
-- single BasePart, so RequestPickup's position and destroy logic is unchanged.
local function makeDroppedGun(pos: Vector3): BasePart
    local cos = game:GetService("ServerStorage"):FindFirstChild("Cosmetics")
    local template = cos and cos:FindFirstChild("gun")
    local handle = template and template:FindFirstChild("Handle")
    local gun: BasePart
    if handle and handle:IsA("BasePart") then
        gun = handle:Clone()
        for _, d in gun:GetChildren() do
            if not d:IsA("DataModelMesh") then
                d:Destroy() -- shed any emitters or outlines carried by the cosmetic
            end
        end
        gun.Size = gun.Size * 1.5
    else
        gun = Instance.new("Part")
        gun.Size = Vector3.new(2, 0.6, 1)
        gun.Color = Color3.fromHex("f2a63b")
        gun.Material = Enum.Material.SmoothPlastic
    end
    gun.Name = "DroppedPistol"
    gun.Anchored = true
    gun.CanCollide = false
    gun.CanQuery = false
    gun.Massless = true
    gun.CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(20))
    gun:AddTag("DroppedPistol")
    local glow = Instance.new("Highlight")
    glow.FillTransparency = 1
    glow.OutlineColor = Color3.fromHex("ffd98a")
    glow.OutlineTransparency = 0.15
    glow.DepthMode = Enum.HighlightDepthMode.Occluded
    glow.Parent = gun
    return gun
end

local function inGrace(): boolean
    return os.clock() - roundStart < Config.WEAPON_GRACE
end

-- Who may swing a knife: the murderer, or any assassin in the free-for-all.
local function knifeArmed(plr: Player): boolean
    local role = RoleService:Get(plr)
    return role == "murderer" or role == "assassin"
end

-- Server-side cooldown per player per action. The client cooldown is cosmetic.
local function ready(plr: Player, action: string, cooldown: number): boolean
    local t = os.clock()
    local mine = lastAction[plr]
    if not mine then
        mine = {}
        lastAction[plr] = mine
    end
    if t - (mine[action] or 0) < cooldown then
        return false
    end
    mine[action] = t
    return true
end

-- The character of a player who is alive in the round, or nil
local function liveCharacter(plr: Player): Model?
    if not round:IsAlive(plr) then
        return nil
    end
    return plr.Character
end

-- The player or NPC whose character this part belongs to
local function playerFromPart(part: Instance): any
    local model = part:FindFirstAncestorOfClass("Model")
    while model do
        local plr = Players:GetPlayerFromCharacter(model)
        if plr then
            return plr
        end
        local bot = round and round:BotFromCharacter(model)
        if bot then
            return bot
        end
        model = model:FindFirstAncestorOfClass("Model")
    end
    return nil
end

local function rayParams(char: Model): RaycastParams
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore: { Instance } = { char }
    local lobby = workspace:FindFirstChild("Lobby")
    if lobby then
        table.insert(ignore, lobby)
    end
    params.FilterDescendantsInstances = ignore
    return params
end

-- The client asks to stab. The server decides whether it happened.
function CombatService:RequestStab(plr: Player, target: Player)
    if target == plr or inGrace() or not knifeArmed(plr) then
        return
    end
    local myChar, theirChar = liveCharacter(plr), liveCharacter(target)
    if not (myChar and theirChar) then
        return
    end
    if not ready(plr, "knife", Config.KNIFE_COOLDOWN) then
        return
    end
    CosmeticService:DrawWeapon(plr, "knife", Config.WEAPON_DRAW_TIME)

    local a = myChar:GetPivot().Position
    AudioService:Emit("knife_swing", a)
    -- Real positions only, with a small allowance for ping
    local b = theirChar:GetPivot().Position
    if (a - b).Magnitude > Config.KNIFE_RANGE + Config.PING_ALLOWANCE then
        return
    end
    self:Eliminate(target, plr, "knife")
end

function CombatService:RequestThrow(plr: Player, aimPoint: Vector3)
    local char = liveCharacter(plr)
    if not char or inGrace() or not knifeArmed(plr) then
        return
    end
    local origin = char:GetPivot().Position + Vector3.new(0, 1.5, 0)
    local toAim = aimPoint - origin
    if toAim.Magnitude < 1 then
        return
    end
    if not ready(plr, "throw", Config.THROW_COOLDOWN) then
        return
    end
    CosmeticService:DrawWeapon(plr, "knife", Config.WEAPON_DRAW_TIME)

    local dir = toAim.Unit
    AudioService:Emit("knife_throw", origin)
    local params = rayParams(char)

    task.spawn(function()
        local pos, flown = origin, 0
        while flown < Config.THROW_MAX_FLIGHT do
            local dt = RunService.Heartbeat:Wait()
            if round:GetState() ~= "ACTIVE" then
                return
            end
            flown += dt
            local hit = workspace:Raycast(pos, dir * Config.THROW_SPEED * dt, params)
            if hit then
                local victim = playerFromPart(hit.Instance)
                if victim and victim ~= plr and round:IsAlive(victim) then
                    self:Eliminate(victim, plr, "throw")
                end
                return
            end
            pos += dir * Config.THROW_SPEED * dt
        end
    end)
end

function CombatService:RequestShoot(plr: Player, aimPoint: Vector3)
    local role = RoleService:Get(plr)
    local char = liveCharacter(plr)
    if not char or inGrace() or (role ~= "sheriff" and role ~= "hero") then
        return
    end
    if not ready(plr, "gun", Config.GUN_COOLDOWN) then
        return
    end
    CosmeticService:DrawWeapon(plr, "gun", Config.WEAPON_DRAW_TIME)

    -- Never trust a client origin: fire from the real character
    local head = char:FindFirstChild("Head")
    local origin = if head and head:IsA("BasePart") then head.Position else char:GetPivot().Position
    local toAim = aimPoint - origin
    if toAim.Magnitude < 1 then
        return
    end
    AudioService:Emit("gun_fire", origin)
    CombatFx.Muzzle(origin, toAim.Unit)

    local hit = workspace:Raycast(origin, toAim.Unit * Config.GUN_RANGE, rayParams(char))
    local victim = hit and playerFromPart(hit.Instance)
    if not victim or not round:IsAlive(victim) then
        return
    end

    self:Eliminate(victim, plr, "gun")

    -- Misfire penalty: without it, sheriffs spray on sight and deduction never happens.
    if Config.SHERIFF_MISFIRE_KILLS_SELF and RoleService:Get(victim) ~= "murderer" then
        AudioService:Play2D(plr, "misfire_death")
        self:Eliminate(plr, plr, "misfire")
    end
end

function CombatService:RequestPickup(plr: Player)
    local gun = droppedGun
    local char = liveCharacter(plr)
    if not (gun and gun.Parent and char) then
        return
    end
    local reach = Config.GUN_PICKUP_RANGE + Config.PING_ALLOWANCE
    if (char:GetPivot().Position - gun.Position).Magnitude > reach then
        return
    end
    -- Read before MakeHero, which overwrites it: a medic who takes the pistol
    -- becomes the hero and gives up the revive, and nothing else would say so.
    local was = RoleService:Get(plr)
    if RoleService:MakeHero(plr) then
        AudioService:Emit("gun_pickup", gun.Position)
        CombatFx.Hero(char:GetPivot().Position)
        gun:Destroy()
        droppedGun = nil
        if was ~= "innocent" and not Participant.IsBot(plr) then
            Remotes.Notify:FireClient(plr, "You took the pistol. You are the hero now.")
        end
    end
end

function CombatService:Eliminate(victim: Player, killer: Player, method: string)
    local char = liveCharacter(victim)
    if not char then
        return
    end

    -- Infection: a killer's blade converts a living survivor into a killer
    -- rather than eliminating them, and the infected never cut down their own.
    -- The gun is unaffected, so a sheriff's shot still kills an infected outright.
    if
        Modes.Get(game.ReplicatedStorage:GetAttribute("Mode")).infection
        and killer
        and (method == "knife" or method == "throw")
        and RoleService:Get(killer) == "murderer"
    then
        if RoleService:Get(victim) == "murderer" then
            return -- infected don't turn on each other
        end
        local hitPos = char:GetPivot().Position
        CombatFx.Impact(hitPos)
        AudioService:Emit("knife_hit", hitPos)
        RoleService:Infect(victim)
        if not Participant.IsBot(killer) then
            Remotes.KillConfirm:FireClient(killer, "infected")
        end
        round:CheckWinConditions(method) -- a survivor turned; the town may be gone
        return
    end

    local pos = char:GetPivot().Position
    CombatFx.Impact(pos)

    local role = RoleService:Get(victim)
    local roundFolder = workspace:FindFirstChild("Round")
    if roundFolder and (role == "sheriff" or role == "hero") and not droppedGun then
        local gun = makeDroppedGun(pos)
        gun.Parent = roundFolder
        droppedGun = gun
    end

    if method == "knife" or method == "throw" then
        AudioService:Emit("knife_hit", pos)
    end
    if method ~= "misfire" then
        EvidenceService:DropBody(victim, killer)
    end

    -- Mark dead before the humanoid dies so the Died listener is a no-op
    round:MarkDead(victim, killer, method)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Health = 0
    end

    -- Tell the killer they landed it (hitmarker, kill line, camera kick).
    -- Never on a misfire suicide, and never to an NPC with no client.
    if killer and killer ~= victim and not Participant.IsBot(killer) then
        Remotes.KillConfirm:FireClient(killer, role)
    end
end

Players.PlayerRemoving:Connect(function(plr)
    lastAction[plr] = nil
end)

return CombatService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">CosmeticService</string>
          <string name="Source"><![CDATA[-- Equipping, and the weapon a player carries into a round.
-- Cosmetic only — never touches lethality, speed or vision.
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local Catalog = require(game.ReplicatedStorage.Shared.Catalog)
local Shop = require(game.ReplicatedStorage.Shared.Shop)
local Theme = require(game.ReplicatedStorage.Shared.Theme)
local ItemCard = require(game.ReplicatedStorage.Shared.Build.ItemCard)
local CosmeticFx = require(game.ReplicatedStorage.Shared.CosmeticFx)
local Remotes = game.ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local Participant = require(script.Parent.Participant)

local CosmeticService = {}

local DEFAULTS: { [string]: string } = { knife = "ash", gun = "ledger" }
local drawToken: { [Player]: number } = {}

-- Roblox's own public tool animations (no upload). A knife use plays the lunge
-- so the arm thrusts on a stab or throw; if the id is ever unavailable it just
-- no-ops and the weapon still flashes as before. Gun recoil is the camera kick.
local LUNGE_ANIM = {
    [Enum.HumanoidRigType.R15] = "rbxassetid://522638767",
    [Enum.HumanoidRigType.R6] = "rbxassetid://129967478",
}

local function playSwing(hum: Humanoid)
    local animator = hum:FindFirstChildOfClass("Animator")
    local id = animator and LUNGE_ANIM[hum.RigType]
    if not (animator and id) then
        return
    end
    local anim = Instance.new("Animation")
    anim.AnimationId = id
    local ok, track = pcall(function()
        return animator:LoadAnimation(anim)
    end)
    anim:Destroy()
    if ok and track then
        track.Priority = Enum.AnimationPriority.Action
        track:Play(0.1)
        task.delay(track.Length > 0 and track.Length or 1, function()
            track:Stop(0.1)
            track:Destroy()
        end)
    end
end

local function owns(data, id: string): boolean
    if Catalog[id] and Catalog[id].starter then
        return true -- starters are owned by everyone and never enter the inventory
    end
    for _, item in data.inventory do
        if item.id == id then
            return true
        end
    end
    return false
end

-- `ref` is an inventory uid, or a starter item id
function CosmeticService:Equip(plr: Player, ref: string)
    local data = DataService:Get(plr)
    if not data then
        return
    end

    local id
    if Catalog[ref] and Catalog[ref].starter then
        id = ref
    else
        for _, item in data.inventory do
            if item.uid == ref then
                id = item.id
                break
            end
        end
    end
    local def = id and Catalog[id]
    local slot = def and Shop.SLOT_FOR_KIND[def.kind]
    if not slot then
        return
    end

    data.equipped[slot] = id
    plr:SetAttribute("Knife", data.equipped.knife) -- public: the lobby knife showcase
    Remotes.DataChanged:FireClient(plr, { equipped = data.equipped })
    if slot == "effect" or slot == "pet" then
        self:ApplyWorn(plr)
    end
    -- Broadcast so other clients can swap the visible model once models exist
    Remotes.CosmeticChanged:FireAllClients(plr, slot, id)
end

-- After items leave an inventory (trade, craft), unequip anything no longer owned
function CosmeticService:Reconcile(plr: Player)
    local data = DataService:Get(plr)
    if not data then
        return
    end
    local changed = false
    for slot, id in data.equipped do
        if not owns(data, id) then
            data.equipped[slot] = DEFAULTS[slot]
            changed = true
        end
    end
    if changed then
        Remotes.DataChanged:FireClient(plr, { equipped = data.equipped })
        self:ApplyWorn(plr)
    end
end

-- What a player wears outside the weapon slots: the Effect aura at the feet
-- (replicates to everyone) and the Pet id as a Player attribute, which each
-- client's PetController draws locally
function CosmeticService:ApplyWorn(plr: Player)
    local data = DataService:Get(plr)
    if not data then
        return
    end
    plr:SetAttribute("Pet", data.equipped.pet)
    plr:SetAttribute("Knife", data.equipped.knife) -- public: the lobby knife showcase
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    local old = root:FindFirstChild("CosmeticAura")
    if old then
        old:Destroy()
    end
    local look = data.equipped.effect and CosmeticFx.AURA[data.equipped.effect]
    if look then
        local attachment = Instance.new("Attachment")
        attachment.Name = "CosmeticAura"
        attachment.Position = Vector3.new(0, -2.8, 0)
        CosmeticFx.Emitter(look).Parent = attachment
        attachment.Parent = root
    end
end

-- The effect rolled onto the equipped knife, if any copy of it has one
-- Top-tier knives carry a built-in blade effect so a Legendary or Godly always
-- looks the part, even before the owner spends a re-roll. A re-rolled effect on
-- the item still overrides it.
local SIGNATURE_EFFECT: { [string]: string } = {
    cinder = "ember",
    coldsnap = "frost",
    verdict = "gold",
}
local RARITY_EFFECT: { [string]: string } = {
    Legendary = "gold",
    Godly = "gold",
}
local function knifeEffect(data, id: string): string?
    for _, item in data.inventory do
        if item.id == id and item.effect and item.effect ~= "none" then
            return item.effect
        end
    end
    local sig = SIGNATURE_EFFECT[id]
    if sig then
        return sig
    end
    local def = Catalog[id]
    return def and RARITY_EFFECT[def.rarity] or nil
end

---------------------------------------------------------------- Weapons
local function weaponsOf(plr: Player, slot: string?): { Tool }
    local containers: { Instance } = {}
    if plr.Character then
        table.insert(containers, plr.Character)
    end
    local backpack = plr:FindFirstChildOfClass("Backpack")
    if backpack then
        table.insert(containers, backpack)
    end
    local out = {}
    for _, container in containers do
        for _, child in container:GetChildren() do
            local tag = child:GetAttribute("Weapon")
            if child:IsA("Tool") and tag ~= nil and (slot == nil or tag == slot) then
                table.insert(out, child)
            end
        end
    end
    return out
end

-- How strongly a drawn weapon glows by rarity: outline transparency, and a
-- fill transparency (1 = no fill) that lets the top tiers shine.
local GLOW: { [string]: { outline: number, fill: number } } = {
    Uncommon = { outline = 0.5, fill = 1 },
    Rare = { outline = 0.35, fill = 1 },
    Legendary = { outline = 0.2, fill = 0.82 },
    Godly = { outline = 0.08, fill = 0.7 },
    Ancient = { outline = 0.05, fill = 0.6 },
}

local function blockout(slot: string, rarity: string?): Tool
    local tool = Instance.new("Tool")
    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = if slot == "knife"
        then Vector3.new(0.25, 0.4, 2.2)
        else Vector3.new(0.4, 0.9, 1.6)
    handle.Color = (rarity and ItemCard.RARITY_COLOUR[rarity]) or Theme.MUTED
    handle.Material = Enum.Material.SmoothPlastic
    handle.Parent = tool
    return tool
end

-- The weapon for a round, carried hidden in the backpack. A knife held all
-- round would name the murderer to anyone who looks, so CombatService draws
-- it for a moment on each use instead. Uses the Tool at
-- ServerStorage.Cosmetics.<itemId> when there is one, then the generic
-- Cosmetics.knife / Cosmetics.gun with a rarity outline, else a tinted blockout.
function CosmeticService:GiveWeapon(plr: Player, slot: string)
    local backpack = plr:FindFirstChildOfClass("Backpack")
    if not (plr.Character and backpack) then
        return
    end
    self:ClearWeapons(plr)
    local data = DataService:Get(plr)
    local id: string = (data and data.equipped[slot]) or DEFAULTS[slot]
    local def = Catalog[id]
    local folder = ServerStorage:FindFirstChild("Cosmetics")
    local own = folder and folder:FindFirstChild(id)
    local generic = folder and folder:FindFirstChild(slot)
    local template = if own and own:IsA("Tool")
        then own
        elseif generic and generic:IsA("Tool") then generic
        else nil
    local tool = if template then template:Clone() else blockout(slot, def and def.rarity)
    -- A rarity glow so a drawn weapon reads as rare in the moment it appears:
    -- a coloured outline for Uncommon and up, and a faint tinted fill that
    -- makes a Legendary or Godly blade glow. Also stands in for the mesh when
    -- one model serves the whole slot (a generic fallback or a blockout).
    local glow = def and GLOW[def.rarity]
    if glow then
        local c = ItemCard.RARITY_COLOUR[def.rarity] or Theme.MUTED
        local hl = Instance.new("Highlight")
        hl.OutlineColor = c
        hl.OutlineTransparency = glow.outline
        hl.FillColor = c
        hl.FillTransparency = glow.fill
        hl.DepthMode = Enum.HighlightDepthMode.Occluded
        hl.Parent = tool
    end
    tool.Name = def and def.name or id
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    tool.ManualActivationOnly = true
    tool:SetAttribute("Weapon", slot)
    local effect = slot == "knife" and data and knifeEffect(data, id)
    local look = effect and CosmeticFx.KNIFE[effect]
    local handle = tool:FindFirstChild("Handle")
    if look and handle then
        CosmeticFx.Emitter(look).Parent = handle
    end
    for _, d in tool:GetDescendants() do
        if d:IsA("LuaSourceContainer") then
            d:Destroy() -- a weapon model never runs code
        elseif d:IsA("BasePart") then
            -- Never in the way of a stab, a shot or a raycast
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.Massless = true
        end
    end
    tool.Parent = backpack
end

-- NPCs have no Backpack and cannot equip a Tool, so they would kill with empty
-- hands: no knife to witness, no tell to catch them by. They get the same
-- weapon model welded into the hand for the same moment a player shows one.
local function flashForBot(bot, slot: string, seconds: number)
    local char = bot.Character
    local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (hand and hum and hum.Health > 0) then
        return
    end
    local old = char:FindFirstChild("DrawnWeapon")
    if old then
        old:Destroy()
    end
    local folder = ServerStorage:FindFirstChild("Cosmetics")
    local generic = folder and folder:FindFirstChild(slot)
    local handle: BasePart?
    if generic and generic:IsA("Tool") and generic:FindFirstChild("Handle") then
        handle = (generic.Handle :: BasePart):Clone()
    else
        handle = blockout(slot, nil):FindFirstChild("Handle") :: BasePart
    end
    if not handle then
        return
    end
    handle.Name = "DrawnWeapon"
    handle.CanCollide = false
    handle.CanTouch = false
    handle.CanQuery = false
    handle.Massless = true
    handle.CFrame = hand.CFrame * CFrame.new(0, -0.8, 0) * CFrame.Angles(math.rad(-90), 0, 0)
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = hand
    weld.Part1 = handle
    weld.Parent = handle
    handle.Parent = char
    if slot == "knife" then
        playSwing(hum)
    end
    task.delay(seconds, function()
        if handle.Parent == char then
            handle:Destroy()
        end
    end)
end

function CosmeticService:DrawWeapon(plr: Player, slot: string, seconds: number)
    if Participant.IsBot(plr) then
        flashForBot(plr, slot, seconds)
        return
    end
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = weaponsOf(plr, slot)[1]
    if not (hum and tool and hum.Health > 0) then
        return
    end
    hum:EquipTool(tool)
    if slot == "knife" then
        playSwing(hum)
    end
    local token = (drawToken[plr] or 0) + 1
    drawToken[plr] = token
    task.delay(seconds, function()
        if drawToken[plr] == token and tool.Parent == char then
            hum:UnequipTools()
        end
    end)
end

function CosmeticService:ClearWeapons(plr: Player)
    for _, tool in weaponsOf(plr) do
        tool:Destroy()
    end
end

DataService.Loaded.Event:Connect(function(plr: Player)
    CosmeticService:ApplyWorn(plr)
    plr.CharacterAdded:Connect(function()
        task.defer(CosmeticService.ApplyWorn, CosmeticService, plr)
    end)
end)

Players.PlayerRemoving:Connect(function(plr)
    drawToken[plr] = nil
end)

return CosmeticService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- ProfileStore wrapper plus per-session counters for analytics.
-- In Studio without API access ProfileStore falls back to its mock store,
-- so playtests work either way (data just will not persist).
local Players = game:GetService("Players")
local ProfileStore = require(game.ServerScriptService.Packages.ProfileStore)
local Config = require(game.ReplicatedStorage.Shared.Config)
local Analytics = require(script.Parent.Analytics)
local Remotes = game.ReplicatedStorage.Remotes

local TEMPLATE = {
    coins = Config.STARTING_COINS,
    xp = 0,
    rank = 1,
    inventory = {}, -- { {id="nocturne", uid="...", at=0, effect="frost"?} }
    equipped = { knife = "ash", gun = "ledger" },
    passes = {}, -- { vip = true }
    seasonalKeys = 0,
    purchases = {}, -- [PurchaseId] = os.time(), so a receipt is never granted twice
    stats = { rounds = 0, wins = 0, murdererWins = 0 },
    lastLogin = 0,
    streak = 0,
    lastVipBonus = 0, -- day the VIP daily coin bonus was last handed out
    onboarding = { freeCrate = false, rankGift = false, vipSkin = false },
    hintsSeen = {}, -- { move = true, examine = true, coins = true }
    settings = { waitForPlayers = false }, -- no longer read: the lobby choice is per visit now
}

local Store = ProfileStore.New("PlayerData_v1", TEMPLATE)
local DataService = {}
local profiles = {}
local sessions = {}

-- Fires with (player) once their profile is live. Read data with :Get —
-- BindableEvents deep-copy tables, so data itself is never passed.
DataService.Loaded = Instance.new("BindableEvent")

export type Session = {
    joined: number,
    rounds: number,
    coinsEarned: number,
    isNew: boolean,
    lastScreen: string,
}

function DataService:Load(plr: Player)
    local profile = Store:StartSessionAsync("p_" .. plr.UserId, {
        Cancel = function()
            return plr.Parent ~= Players
        end,
    })
    if not profile then
        if plr.Parent == Players then
            plr:Kick("Data failed to load. Please rejoin.")
        end
        return
    end

    profile:AddUserId(plr.UserId) -- GDPR compliance
    profile:Reconcile() -- fill in keys added since this save was written

    profile.OnSessionEnd:Connect(function()
        profiles[plr] = nil
        plr:Kick("Session ended. Please rejoin.")
    end)

    if plr.Parent ~= Players then
        profile:EndSession()
        return
    end

    local data = profile.Data
    sessions[plr] = {
        joined = os.clock(),
        rounds = 0,
        coinsEarned = 0,
        isNew = data.lastLogin == 0,
        lastScreen = "LOBBY",
    }
    profiles[plr] = profile
    plr:SetAttribute("Rank", data.rank) -- public: shown in the lobby list
    -- Every visit starts on WAIT FOR PLAYERS: nobody is swept into a round
    -- before the rest of their group is in. They press PLAY NOW · NPCS in the
    -- lobby when they are ready, for this visit only - saved to the profile,
    -- one tap once left an account stuck for good. Public: RoundService and
    -- the lobby read it.
    plr:SetAttribute("WaitForPlayers", true)

    local reward = self:ApplyLoginStreak(data)
    if reward > 0 then
        Analytics.CoinsEarned(plr, "streak", reward, data.coins, 0)
        Remotes.Notify:FireClient(plr, ("Day %d streak · +%d coins"):format(data.streak, reward))
    end

    -- VIP owners collect a flat coin bonus once a day, on top of the streak.
    -- Read from the saved pass flag: a purchase this session grants it next login.
    local vipBonus = self:ApplyVipBonus(data)
    if vipBonus > 0 then
        Analytics.CoinsEarned(plr, "vip_daily", vipBonus, data.coins, 0)
        Remotes.Notify:FireClient(plr, ("VIP daily bonus · +%d coins"):format(vipBonus))
    end

    self:PushToClient(plr)
    Analytics.Funnel(plr, Analytics.FUNNEL.JOINED)
    DataService.Loaded:Fire(plr)
end

-- 50 coins on day one, +50 per consecutive day, capped at 400 (day eight)
function DataService:ApplyLoginStreak(data): number
    local today = math.floor(os.time() / 86400)
    if data.lastLogin == today then
        return 0
    end
    data.streak = (today - data.lastLogin == 1) and (data.streak + 1) or 1
    data.lastLogin = today
    local reward = math.min(Config.STREAK_COINS_PER_DAY * data.streak, Config.STREAK_COINS_MAX)
    data.coins += reward
    return reward
end

-- A flat VIP coin bonus, once per calendar day. Tracked apart from the streak
-- so a lapsed streak never costs a VIP their daily bonus, and vice versa.
function DataService:ApplyVipBonus(data): number
    if not (data.passes and data.passes.vip) then
        return 0
    end
    local today = math.floor(os.time() / 86400)
    if data.lastVipBonus == today then
        return 0
    end
    data.lastVipBonus = today
    data.coins += Config.VIP_DAILY_BONUS
    return Config.VIP_DAILY_BONUS
end

function DataService:Get(plr: Player)
    local p = profiles[plr]
    return p and p.Data or nil
end

function DataService:GetSession(plr: Player): Session?
    return sessions[plr]
end

-- The lobby choice: wait for a round of real players, or play now with NPCs.
-- Held on the player for this visit; see Load for why it is not saved.
function DataService:SetWaitForPlayers(plr: Player, on: boolean)
    if self:Get(plr) then
        plr:SetAttribute("WaitForPlayers", on)
    end
end

function DataService:SetScreen(plr: Player, screen: string)
    local s = sessions[plr]
    if s then
        s.lastScreen = screen
    end
end

function DataService:PushToClient(plr: Player)
    local data = self:Get(plr)
    if data then
        Remotes.DataChanged:FireClient(plr, data)
    end
end

Players.PlayerRemoving:Connect(function(plr)
    local s = sessions[plr]
    if s then
        local seconds = os.clock() - s.joined
        Analytics.SessionEnd(plr, seconds, s.rounds, s.coinsEarned, s.isNew)
        if s.isNew then
            Analytics.FirstSessionExit(plr, s.lastScreen, seconds, s.rounds)
        end
        sessions[plr] = nil
    end
    local p = profiles[plr]
    if p then
        p:EndSession()
    end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Rarities = require(Shared.RarityTable)
local Catalog = require(Shared.Catalog)
local LiveOps = require(Shared.LiveOps)
local Shop = require(Shared.Shop)
local Products = require(Shared.Products)
local Remotes = game.ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local RoleService = require(script.Parent.RoleService)
local Analytics = require(script.Parent.Analytics)
local LiveOpsClock = require(script.Parent.LiveOpsClock)

local EconomyService = {}
local TIER_ORDER = { "Common", "Uncommon", "Rare", "Legendary", "Godly", "Ancient" }

-- Gameplay faucets that Last Call doubles: coins earned DURING the final
-- thirty seconds - a pickup, an examine, a revive. The end-of-round
-- settlement is deliberately not here; `round` was removed so a win pays the
-- same whether or not the round reached Last Call. Doubling the settlement
-- rewarded lasting longer rather than playing better, and since lastCallFired
-- resets each round it made identical wins pay 1.25x or 2.5x on round length
-- alone. Streaks, gifts and Robux purchases never multiply either.
local LAST_CALL_SOURCES = { pickup = true, examine = true, revive = true }
local lastCall = false

-- Pre-bucket the catalog by rarity so a pull is O(1). The Locker and crafting
-- never see seasonal or starter items; each season's crate only sees its own.
local standardPool = {}
local seasonPools = {}
for id, item in Catalog do
    if item.starter or item.vip then
        continue
    end
    local pools = standardPool
    if item.season then
        seasonPools[item.season] = seasonPools[item.season] or {}
        pools = seasonPools[item.season]
    end
    pools[item.rarity] = pools[item.rarity] or {}
    table.insert(pools[item.rarity], id)
end
-- Deterministic order within each tier; table iteration order is not
for _, ids in standardPool do
    table.sort(ids)
end
for _, pools in seasonPools do
    for _, ids in pools do
        table.sort(ids)
    end
end

---------------------------------------------------------------- Friends
local friendsOf: { [Player]: { [Player]: boolean } } = {}

local function linkFriends(plr: Player)
    for _, other in Players:GetPlayers() do
        if other ~= plr then
            local ok, isFriend = pcall(plr.IsFriendsWithAsync, plr, other.UserId)
            if ok and isFriend and plr.Parent and other.Parent then
                friendsOf[plr] = friendsOf[plr] or {}
                friendsOf[other] = friendsOf[other] or {}
                friendsOf[plr][other] = true
                friendsOf[other][plr] = true
            end
        end
    end
end

function EconomyService:HasFriendInServer(plr: Player): boolean
    return next(friendsOf[plr] or {}) ~= nil
end

Players.PlayerAdded:Connect(linkFriends)
for _, plr in Players:GetPlayers() do
    task.spawn(linkFriends, plr)
end
Players.PlayerRemoving:Connect(function(plr)
    local friends = friendsOf[plr]
    if friends then
        for other in friends do
            if friendsOf[other] then
                friendsOf[other][plr] = nil
            end
        end
    end
    friendsOf[plr] = nil
end)

---------------------------------------------------------------- Items
-- The single place an item enters an inventory. Seasonal items only drop
-- while their season is open; a retired seasonal can never be minted again.
function EconomyService:GiveItem(data, id: string)
    local item = Catalog[id]
    if not item or item.starter or item.vip then
        return nil -- vip items are minted only by MonetizationService, never rolled
    end
    if item.season then
        local day = LiveOpsClock.Day()
        -- Two different questions: has this item's season closed for good, and
        -- is it the one running right now. The second alone would also block a
        -- season that has not opened yet, which is intended - but only the
        -- first is the "retired forever" rule, and it is the one under test.
        if LiveOps.IsRetired(item.season, day) then
            return nil
        end
        local season = LiveOps.ActiveSeason(day)
        if not season or season.id ~= item.season then
            return nil
        end
    end
    local entry = { id = id, uid = HttpService:GenerateGUID(false), at = os.time() }
    table.insert(data.inventory, entry)
    return entry
end

local function rollTier(pools)
    local total = 0
    for _, r in Rarities do
        if pools[r.name] then
            total += r.weight
        end
    end
    local n = math.random() * total
    for _, r in Rarities do
        if pools[r.name] then
            n -= r.weight
            if n <= 0 then
                return r
            end
        end
    end
    for _, r in Rarities do
        if pools[r.name] then
            return r
        end
    end
    return nil
end

local function giveRankGift(plr: Player, data)
    -- Grant first, then burn the once-per-account flag. The other way round,
    -- a refused GiveItem leaves rankGift true with nothing to show for it and
    -- the check at the call site never lets them have another go - the reward
    -- is gone for good. OnboardingService's free crate gets this right by
    -- un-setting its flag on failure; this simply does not set it early.
    local ids = standardPool[Config.RANK_GIFT_RARITY]
    local entry = EconomyService:GiveItem(data, ids[math.random(#ids)])
    if entry then
        data.onboarding.rankGift = true
        Remotes.CrateResult:FireClient(
            plr,
            { id = entry.id, uid = entry.uid, rarity = Config.RANK_GIFT_RARITY, gift = true }
        )
        Remotes.Notify:FireClient(
            plr,
            ("Rank %d gift · %s"):format(Config.RANK_GIFT_AT, Catalog[entry.id].name)
        )
    end
end

---------------------------------------------------------------- Coins + XP
function EconomyService:SetLastCall(on: boolean)
    lastCall = on
end

function EconomyService:CoinMultiplier(plr: Player, data, source: string): number
    local mult = LiveOps.CoinMultiplier(LiveOpsClock.Day())
    if self:HasFriendInServer(plr) then
        mult *= 1 + Config.FRIEND_COIN_BONUS
    end
    if data.passes.vip then
        mult *= Products.PASSES.vip.coinMultiplier
    end
    if lastCall and LAST_CALL_SOURCES[source] then
        mult *= Config.LAST_CALL_MULT
    end
    return mult
end

-- `source` names the faucet for analytics. `raw` grants skip every multiplier
-- (Robux purchases). Streak rewards are granted in DataService.
function EconomyService:Grant(
    plr: Player,
    coins: number?,
    xp: number?,
    source: string?,
    raw: boolean?
): number
    local data = DataService:Get(plr)
    if not data then
        return 0
    end
    local granted = 0
    if coins and coins > 0 then
        local mult = if raw then 1 else self:CoinMultiplier(plr, data, source or "unknown")
        granted = math.floor(coins * mult + 0.5)
        data.coins += granted
        local session = DataService:GetSession(plr)
        if session then
            session.coinsEarned += granted
        end
        Analytics.CoinsEarned(
            plr,
            source or "unknown",
            granted,
            data.coins,
            session and session.coinsEarned or 0
        )
    end

    data.xp += xp or 0
    local startRank = data.rank
    while data.xp >= Config.XP_PER_RANK do
        data.xp -= Config.XP_PER_RANK
        data.rank += 1
    end
    if data.rank ~= startRank then
        plr:SetAttribute("Rank", data.rank)
    end
    if data.rank >= Config.RANK_GIFT_AT and not data.onboarding.rankGift then
        giveRankGift(plr, data)
    end

    Remotes.DataChanged:FireClient(plr, { coins = data.coins, xp = data.xp, rank = data.rank })
    return granted
end

function EconomyService:PayOut(
    participants: { Player },
    winner: string,
    survivors: { [Player]: boolean },
    clueCounts
)
    local Participant = require(script.Parent.Participant)
    local withBots = false
    for _, p in participants do
        withBots = withBots or Participant.IsBot(p)
    end
    for _, plr in participants do
        local data = DataService:Get(plr)
        if not data then
            continue
        end

        local role = RoleService:Get(plr)
        -- In the free-for-all the last one alive is the winner; everyone else lost.
        local won = if role == "assassin"
            then survivors[plr] == true
            else ((role == "murderer") and "murderer" or "innocents") == winner

        local coins = won and Config.COINS_WIN or Config.COINS_LOSS
        local xp = won and Config.XP_WIN or Config.XP_LOSS
        if survivors[plr] then
            coins += Config.COINS_SURVIVE
            xp += Config.XP_SURVIVE
        end
        local clues = clueCounts[plr] or 0
        xp += clues * Config.XP_PER_CLUE

        data.stats.rounds += 1
        if won then
            data.stats.wins += 1
            if role == "murderer" then
                data.stats.murdererWins += 1
            end
        end
        local session = DataService:GetSession(plr)
        if session then
            session.rounds += 1
        end
        -- Feed the global boards (wins / murderer escapes / collection worth).
        require(script.Parent.LeaderboardService):Record(plr, data)

        if withBots then
            -- The lever for paying less in a round against NPCs, so an empty
            -- server cannot be farmed. It is set to 1 - full pay - because a
            -- solo player's first rounds are all NPC rounds and docking them
            -- punishes the newest players hardest. Left in place so the nerf
            -- is one number away if farming ever shows up in the numbers.
            coins = math.floor(coins * Config.BOT_ROUND_REWARD)
            xp = math.floor(xp * Config.BOT_ROUND_REWARD)
        end
        local granted = self:Grant(plr, coins, xp, "round")
        -- Near-miss messaging: honest, and shown only when they cannot afford a crate
        local cratePrice = Shop.CratePrice(Config.CRATE_COST, data.rank)
        Remotes.RoundReward:FireClient(plr, {
            won = won,
            coins = granted,
            xp = xp,
            clues = clues,
            balance = data.coins,
            short = math.max(0, cratePrice - data.coins),
        })
    end
end

---------------------------------------------------------------- Crates
function EconomyService:OpenCrate(plr: Player, crateId: any, free: boolean?)
    if crateId ~= "locker" and crateId ~= "seasonal" then
        return nil
    end
    local data = DataService:Get(plr)
    if not data then
        return nil
    end
    -- Paid random items are restricted in some regions (PolicyService).
    -- The one free onboarding crate is not a paid item.
    if not free and not require(script.Parent.PlayerPolicy):CanUsePaidRandomItems(plr) then
        Remotes.ShopResult:FireClient(plr, false, "Crates aren't available in your region.")
        return nil
    end

    local pools, cost, usesKey = nil, 0, false
    if crateId == "seasonal" then
        local season = LiveOps.ActiveSeason(LiveOpsClock.Day())
        if not season then
            return nil
        end
        pools = seasonPools[season.id]
        cost = Shop.CratePrice(season.crateCost, data.rank)
        -- A seasonal key (Robux) opens the crate instead of coins
        if not free and data.seasonalKeys > 0 then
            usesKey, cost = true, 0
        end
    else
        pools, cost = standardPool, Shop.CratePrice(Config.CRATE_COST, data.rank)
    end
    if not pools then
        return nil
    end
    if free then
        cost = 0
    end
    if data.coins < cost then
        Remotes.ShopResult:FireClient(
            plr,
            false,
            ("You are %d coins short."):format(cost - data.coins)
        )
        return nil
    end

    -- Roll the tier FIRST, then draw a name from that tier.
    local tier = rollTier(pools)
    if not tier then
        return nil
    end
    local ids = pools[tier.name]
    local entry = self:GiveItem(data, ids[math.random(#ids)])
    if not entry then
        return nil
    end
    data.coins -= cost
    if usesKey then
        data.seasonalKeys -= 1
    end

    Analytics.CrateOpened(plr, crateId, tier.name, entry.id, data.coins)
    if cost > 0 then
        Analytics.CoinsSpent(plr, crateId, cost, data.coins)
    end
    Remotes.CrateResult:FireClient(plr, {
        id = entry.id,
        uid = entry.uid,
        rarity = tier.name,
        crateId = crateId,
        free = free == true,
    })
    Remotes.DataChanged:FireClient(
        plr,
        { coins = data.coins, inventory = data.inventory, seasonalKeys = data.seasonalKeys }
    )

    if tier.announce then
        -- Other players seeing a big drop is the cheapest crate advert there is
        Remotes.CrateResult:FireAllClients({
            announce = true,
            player = plr.DisplayName,
            item = Catalog[entry.id].name,
            rarity = tier.name,
        })
    end
    return entry
end

function EconomyService:Craft(plr: Player, itemId: any)
    if type(itemId) ~= "string" or not Catalog[itemId] then
        return
    end
    local data = DataService:Get(plr)
    if not data then
        return
    end
    -- Crafting pays coins for a random next-tier item: a paid random item
    if not require(script.Parent.PlayerPolicy):CanUsePaidRandomItems(plr) then
        Remotes.ShopResult:FireClient(plr, false, "Crafting isn't available in your region.")
        return
    end
    local matches = {}
    for i, item in data.inventory do
        if item.id == itemId then
            table.insert(matches, i)
        end
    end
    if #matches < Config.CRAFT_DUPES then
        Remotes.ShopResult:FireClient(
            plr,
            false,
            ("Crafting needs %d of the same item."):format(Config.CRAFT_DUPES)
        )
        return
    end
    if data.coins < Config.CRAFT_FEE then
        Remotes.ShopResult:FireClient(
            plr,
            false,
            ("You are %d coins short."):format(Config.CRAFT_FEE - data.coins)
        )
        return
    end

    local nextTier
    for i, r in TIER_ORDER do
        if r == Catalog[itemId].rarity then
            nextTier = TIER_ORDER[i + 1]
        end
    end
    local pool = nextTier and standardPool[nextTier]
    if not pool then
        Remotes.ShopResult:FireClient(plr, false, "Nothing ranks above Godly.")
        return
    end

    -- Grant first, charge second. GiveItem can refuse (a starter, or a
    -- seasonal whose season has closed), and the old order took the fee and
    -- the five duplicates before finding out - leaving the player with
    -- nothing for 150 coins and five items. OpenCrate already works this way.
    local entry = self:GiveItem(data, pool[math.random(#pool)])
    if not entry then
        Remotes.ShopResult:FireClient(plr, false, "That craft is not available right now.")
        return
    end

    -- `matches` are indices taken before the grant. GiveItem appends, which
    -- shifts nothing already in the list, and removing high indices first
    -- keeps the rest valid - but neither of those is obvious, so remove by
    -- identity instead of trusting the arithmetic to stay true.
    local doomed = {}
    for i = 1, Config.CRAFT_DUPES do
        doomed[data.inventory[matches[i]]] = true
    end
    for i = #data.inventory, 1, -1 do
        if doomed[data.inventory[i]] then
            table.remove(data.inventory, i)
        end
    end

    data.coins -= Config.CRAFT_FEE
    Analytics.CoinsSpent(plr, "craft", Config.CRAFT_FEE, data.coins)
    Remotes.CrateResult:FireClient(
        plr,
        { id = entry.id, uid = entry.uid, rarity = nextTier, crafted = true }
    )
    require(script.Parent.CosmeticService):Reconcile(plr)
    Remotes.DataChanged:FireClient(plr, { coins = data.coins, inventory = data.inventory })
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Config = require(game.ReplicatedStorage.Shared.Config)
local AudioService = require(script.Parent.AudioService)
local Remotes = game.ReplicatedStorage.Remotes

local EventService = {}
local active = nil
local lastFiredId: string? = nil

-- Captured once so Clear restores whatever the place was built with.
-- Vision radius and fog are drawn per client by VisionController; the server
-- only changes shared light levels.
local BASE = {
    Brightness = Lighting.Brightness,
    Ambient = Lighting.Ambient,
    OutdoorAmbient = Lighting.OutdoorAmbient,
    EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
    ClockTime = Lighting.ClockTime,
}

-- Killing the lights means killing every source of it. On a daylit map the sun,
-- the sky and the outdoor ambient all have to go, or the blackout is not dark.
local function douse()
    Lighting.Brightness = 0
    Lighting.Ambient = Color3.fromRGB(8, 10, 14)
    Lighting.OutdoorAmbient = Color3.fromRGB(12, 14, 20)
    Lighting.EnvironmentDiffuseScale = 0
    Lighting.ClockTime = 0.2
end

local function relight()
    Lighting.Brightness = BASE.Brightness
    Lighting.Ambient = BASE.Ambient
    Lighting.OutdoorAmbient = BASE.OutdoorAmbient
    Lighting.EnvironmentDiffuseScale = BASE.EnvironmentDiffuseScale
    Lighting.ClockTime = BASE.ClockTime
end

-- Hardcore's steady gloom: dimmer than daylight but not the pitch black of a
-- Lights Out event, so a body can still just be read (IsDark stays false) while
-- sight is cut. Reverted by Clear() at round end like any other lighting change.
local function dim()
    Lighting.Brightness = 0.6
    Lighting.Ambient = Color3.fromRGB(28, 30, 40)
    Lighting.OutdoorAmbient = Color3.fromRGB(36, 40, 52)
    Lighting.EnvironmentDiffuseScale = 0.2
    Lighting.ClockTime = 2
end

function EventService:SetModeDark(on: boolean)
    if on then
        dim()
    else
        relight()
    end
end

-- One event per round. Chaos stops being an event when it is the weather.
-- `anywhere` events ignore the indoor/outdoor split. Lockdown is one of them:
-- every map builds LockdownDoor parts (the Pier has five) and MapPlan's
-- reachability test proves a shut door seals nobody in, on every map. Without
-- it the Pier had a pool of two, half of which was a blackout.
local EVENTS = {
    { id = "LIGHTS_OUT", weight = 30, duration = Config.LIGHTS_OUT_DUR, indoor = true },
    { id = "POWER_SURGE", weight = 25, duration = Config.LIGHTS_OUT_DUR, anywhere = true },
    { id = "LOCKDOWN", weight = 20, duration = Config.LOCKDOWN_DUR, anywhere = true },
    { id = "FOG_BANK", weight = 25, duration = Config.FOG_DUR, indoor = false },
}

local function lockdownDoors()
    local out = {}
    local round = workspace:FindFirstChild("Round")
    if round then
        for _, d in round:GetDescendants() do
            if d:IsA("BasePart") and d:HasTag("LockdownDoor") then
                table.insert(out, d)
            end
        end
    end
    return out
end

-- The map's lamps (BuildMaps tags them MapLight) go dark with the room
local function setMapLights(on: boolean)
    for _, lamp in CollectionService:GetTagged("MapLight") do
        if lamp:IsA("BasePart") and lamp:IsDescendantOf(workspace) then
            local light = lamp:FindFirstChildOfClass("PointLight")
            if light then
                light.Enabled = on
            end
            lamp.Material = on and Enum.Material.Neon or Enum.Material.SmoothPlastic
        end
    end
end

function EventService:FireWeighted(mapIsIndoor: boolean)
    local pool = {}
    for _, e in EVENTS do
        if e.anywhere or e.indoor == mapIsIndoor then
            table.insert(pool, e)
        end
    end
    local total = 0
    for _, e in pool do
        total += e.weight
    end
    local n = math.random() * total
    local chosen = pool[1]
    for _, e in pool do
        n -= e.weight
        if n <= 0 then
            chosen = e
            break
        end
    end
    self:Fire(chosen)
end

function EventService:Fire(event)
    if active then
        return
    end
    active = event
    lastFiredId = event.id
    Remotes.EventFired:FireAllClients(event.id, event.duration)

    if event.id == "LIGHTS_OUT" then
        AudioService:Play2D(nil, "lights_out")
        douse()
        setMapLights(false)
    elseif event.id == "POWER_SURGE" then
        AudioService:Play2D(nil, "power_surge")
        task.spawn(function()
            douse()
            local t0 = os.clock()
            while os.clock() - t0 < event.duration and active == event do
                local on = math.random() > 0.5
                -- The sun stays down; only the lights stutter
                Lighting.Brightness = if on then BASE.Brightness else 0
                Lighting.Ambient = if on then BASE.Ambient else Color3.fromRGB(8, 10, 14)
                setMapLights(on)
                task.wait(math.random(4, 22) / 100)
            end
        end)
    elseif event.id == "LOCKDOWN" then
        AudioService:Play2D(nil, "lockdown")
        for i, door in lockdownDoors() do
            task.delay((i - 1) * 0.2, function()
                if active ~= event then
                    return
                end
                door.CanCollide = true
                door.Transparency = 0
                AudioService:Emit("lockdown", door.Position)
            end)
        end
    end

    task.delay(event.duration, function()
        if active == event then
            self:Clear()
        end
    end)
end

function EventService:Clear()
    if not active then
        return
    end
    for _, door in lockdownDoors() do
        door.CanCollide = false
        door.Transparency = 1
    end
    active = nil
    relight()
    setMapLights(true)
    Remotes.EventFired:FireAllClients("CLEAR", 0)
end

function EventService:IsDark(): boolean
    return active ~= nil and (active.id == "LIGHTS_OUT" or active.id == "POWER_SURGE")
end

-- The event that fired this round, for round_complete analytics. Resets it.
function EventService:TakeRoundEvent(): string?
    local id = lastFiredId
    lastFiredId = nil
    return id
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">EvidenceService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.Config)
local FibreBands = require(Shared.FibreBands)
local Modes = require(Shared.Modes)
local Remotes = game.ReplicatedStorage.Remotes
local Reach = require(script.Parent.Reach)
local AudioService = require(script.Parent.AudioService)
local DataService = require(script.Parent.DataService)
local Analytics = require(script.Parent.Analytics)

local EvidenceService = {}
local bodies = {} -- [Model] = clueData
local channeling = {} -- [Player] = true while a 1.5s examine is running
local round: any = nil -- RoundService, handed over by BindRound

-- Who has seen whom. `since` is when the current unbroken sightline began;
-- `qualified` is the last moment that sightline had lasted WITNESS_LOS_TIME.
type Sight = { since: number?, qualified: number? }
local sight: { [Player]: { [Player]: Sight } } = {}

function EvidenceService:BindRound(roundService)
    round = roundService
end

local DIRS =
    { "north", "north-east", "east", "south-east", "south", "south-west", "west", "north-west" }

local function compass(from: Vector3, to: Vector3): string
    local d = to - from
    local deg = math.deg(math.atan2(d.X, -d.Z)) % 360
    return DIRS[(math.floor((deg + 22.5) / 45) % 8) + 1]
end

-- The killer's actual torso colour, bucketed into a broad band. Narrows,
-- never names. (Shirt textures are not readable, so this is body colour.)
function EvidenceService:ColourBandOf(plr: Player): string
    local char = plr.Character
    local torso = char and (char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))
    local colour = if torso and torso:IsA("BasePart")
        then torso.Color
        else Color3.fromRGB(128, 128, 128)
    return FibreBands.Describe(colour:ToHSV())
end

---------------------------------------------------------------- Sightlines
-- Called every SIGHTLINE_SAMPLE seconds by RoundService with the living
-- participants. A witness clue needs a real, unbroken raycast sightline, not
-- a facing check.
function EvidenceService:SampleSightlines(players: { Player }, now: number)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    for _, viewer in players do
        local vc = viewer.Character
        local head = vc and vc:FindFirstChild("Head")
        if not (head and head:IsA("BasePart")) then
            continue
        end
        local mine = sight[viewer]
        if not mine then
            mine = {}
            sight[viewer] = mine
        end
        for _, other in players do
            if other == viewer then
                continue
            end
            local st = mine[other]
            if not st then
                st = {}
                mine[other] = st
            end

            local seen = false
            local oc = other.Character
            if oc then
                local to = oc:GetPivot().Position - head.Position
                local dist = to.Magnitude
                if
                    dist > 0
                    and dist <= Config.SIGHTLINE_RANGE
                    and head.CFrame.LookVector:Dot(to / dist) >= 0.5
                then
                    params.FilterDescendantsInstances = { vc :: Model, oc }
                    seen = workspace:Raycast(head.Position, to, params) == nil
                end
            end

            if seen then
                st.since = st.since or now
                if now - (st.since :: number) >= Config.WITNESS_LOS_TIME then
                    st.qualified = now
                end
            else
                st.since = nil
            end
        end
    end
end

function EvidenceService:ResetSightlines()
    sight = {}
end

-- Did the victim watch the killer for a full second, recently enough to matter?
function EvidenceService:HadLineOfSight(victim: Player, killer: Player): boolean
    local st = sight[victim] and sight[victim][killer]
    return st ~= nil and st.qualified ~= nil and os.clock() - st.qualified <= Config.WITNESS_WINDOW
end

---------------------------------------------------------------- Bodies
local TweenService = game:GetService("TweenService")

-- A crime scene reads as one: a dark pool spreads under a fresh body. On the
-- round folder so it stays at the death spot (a dragged body leaves its mark)
-- and clears with the round. Scene-lit, no glow: like the impact spray it
-- shows in daylight and stays dark during Lights Out, so it reveals nothing a
-- blackout is meant to hide. Non-colliding and non-query, so it never blocks
-- movement or the examine raycast.
-- Everything a floor raycast in a crime scene must skip so it finds the ground,
-- not a person or a body: every character, every corpse, every NPC, plus any
-- extras the caller names (the body or victim being placed).
local function floorRayParams(extra: { Instance }): RaycastParams
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local exclude: { Instance } = table.clone(extra)
    for _, plr in Players:GetPlayers() do
        if plr.Character then
            table.insert(exclude, plr.Character)
        end
    end
    for _, corpse in CollectionService:GetTagged("Body") do
        table.insert(exclude, corpse)
    end
    for _, botChar in CollectionService:GetTagged("BotCharacter") do
        table.insert(exclude, botChar)
    end
    params.FilterDescendantsInstances = exclude
    return params
end

local function bloodPool(pos: Vector3, roundFolder: Instance, body: Instance)
    -- Raycast to the floor, ignoring the body just laid down, every character,
    -- and any other corpse, so the pool lands on the ground and never on a body.
    local params = floorRayParams({ body })
    local hit = workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -16, 0), params)
    local floorY = hit and hit.Position.Y or (pos.Y - 2.5)

    -- A spreading disc with a darker core reads as a pool with depth rather than
    -- a flat decal. Both are scene-lit and never glow, so like the impact spray
    -- they show in daylight and stay dark in Lights Out, and both are
    -- non-colliding and non-query so they block neither movement nor the examine
    -- ray. The core rides just above the spread so it always wins the z-fight.
    local function disc(colour: Color3, lift: number, grown: number)
        local d = Instance.new("Part")
        d.Name = "BloodPool"
        d.Shape = Enum.PartType.Cylinder
        d.Anchored = true
        d.CanCollide = false
        d.CanQuery = false
        d.CanTouch = false
        d.Material = Enum.Material.SmoothPlastic
        d.Color = colour
        d.Size = Vector3.new(0.1, 1.5 * (grown / 4.6), 1.5 * (grown / 4.6))
        d.CFrame = CFrame.new(pos.X, floorY + lift, pos.Z) * CFrame.Angles(0, 0, math.rad(90))
        d.Parent = roundFolder
        TweenService:Create(
            d,
            TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = Vector3.new(0.1, grown, grown) }
        ):Play()
    end
    disc(Color3.fromRGB(78, 10, 10), 0.06, 4.6)
    disc(Color3.fromRGB(46, 4, 4), 0.08, 2.7)
end

-- A fallen player reads best as their own avatar. Clone the living character,
-- strip anything that would move or label it - the Animate script, the
-- Humanoid's name/health gui, any carried Tool - anchor every part so the pose
-- freezes, and hand it back for DropBody to lay flat. Returns nil if the
-- character has no root to pivot by, so the caller can fall back to the generic
-- figure. NPCs never come here: their avatars are flat solid-colour dummies, so
-- the built figure (a head, torso and limbs in real tones) reads better.
local function buildAvatarCorpse(char: Model): Model?
    if not char.PrimaryPart then
        return nil
    end
    local wasArchivable = char.Archivable
    char.Archivable = true
    local clone = char:Clone()
    char.Archivable = wasArchivable
    local root = clone and clone.PrimaryPart
    if not clone or not root then
        if clone then
            clone:Destroy()
        end
        return nil
    end
    -- One pass strips, anchors and poses. The root (the model's pivot) is left
    -- upright and the rest pitch onto the floor around it. The generic figure is
    -- authored the same way, so dropping and dragging - both of which set the
    -- pivot to an upright frame - keep the body flat instead of standing it up.
    -- A small random roll and pitch keep two bodies from landing as one plank.
    local base = root.CFrame
    local upright = CFrame.new(base.Position)
    local lie = CFrame.Angles(
        -math.pi / 2 + (math.random() - 0.5) * math.rad(14),
        0,
        (math.random() - 0.5) * math.rad(22)
    )
    for _, d in clone:GetDescendants() do
        if d:IsA("BaseScript") or d:IsA("Tool") or d:IsA("ForceField") then
            d:Destroy() -- the Animate loop, any behaviour, a carried weapon, a spawn shield
        elseif d:IsA("BasePart") and d.Parent then
            -- `d.Parent` guards a part whose Tool ancestor was just destroyed.
            d.Anchored = true
            d.CanCollide = false
            d.CanQuery = false -- never block a shot, an examine ray or a sightline
            d.Massless = true
            d.CFrame = if d == root then upright else upright * lie * base:ToObjectSpace(d.CFrame)
        end
    end
    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then
        -- DropBody clones the still-living victim; make the copy plainly a corpse
        -- so nothing counts it as an active character.
        hum.Health = 0
        hum.EvaluateStateMachine = false
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    end
    return clone
end

function EvidenceService:DropBody(victim: Player, killer: Player)
    local char = victim.Character
    local roundFolder = workspace:FindFirstChild("Round")
    if not (char and roundFolder) then
        return
    end
    local pos = char:GetPivot().Position
    local killerPos = killer.Character and killer.Character:GetPivot().Position or pos

    -- Anyone falls as their own avatar, laid flat at the death spot: a player's,
    -- or a dressed NPC's. A clone that could not be made falls back to the
    -- generic figure.
    local model: any = buildAvatarCorpse(char)
    if model then
        model.Name = victim.DisplayName
        model:AddTag("Body")
        model.Parent = roundFolder
        -- Rest on the ground, not on a nearby character or another corpse.
        local params = floorRayParams({ char, model })
        local hit = workspace:Raycast(pos + Vector3.new(0, 3, 0), Vector3.new(0, -20, 0), params)
        local floorY = hit and hit.Position.Y or (pos.Y - 2.5)
        -- The pivot is the upright root; rest the body's underside on the floor.
        local cf, size = model:GetBoundingBox()
        local gap = model:GetPivot().Position.Y - (cf.Position.Y - size.Y / 2)
        local yaw = math.random() * math.pi * 2
        model:PivotTo(CFrame.new(pos.X, floorY + gap, pos.Z) * CFrame.Angles(0, yaw, 0))
    else
        model = game.ServerStorage.BodyTemplate:Clone()
        model.Name = victim.DisplayName -- a body on the floor is a person, not a template
        model:PivotTo(CFrame.new(pos - Vector3.new(0, 2.5, 0)))
        model:AddTag("Body")
        model.Parent = roundFolder
    end
    bloodPool(pos, roundFolder, model)

    -- The medic's button needs to know which bodies it can work on. A body
    -- carries this tag while a revive could still land - a person's or an
    -- NPC's, since BotService can rebuild one - and loses it once examined,
    -- because a read body is spent. Without it the REVIVE button lit up over
    -- corpses it could do nothing about.
    model:AddTag("Revivable")

    -- Facts the client is NEVER told until it earns them
    bodies[model] = {
        victim = victim.DisplayName,
        victimPlayer = victim,
        killer = killer.Name,
        dir = compass(killerPos, pos),
        fibre = self:ColourBandOf(killer),
        at = os.clock(),
        sawKiller = killer ~= victim and self:HadLineOfSight(victim, killer),
        examined = false,
        draggedBy = nil,
    }
    AudioService:Emit("body_drop", pos)
end

function EvidenceService:GetBody(model: any)
    return bodies[model]
end

function EvidenceService:RemoveBody(model: Instance)
    bodies[model] = nil
    model:Destroy()
end

local function inRange(plr: Player, model: Model): boolean
    return Reach.Within(plr, model, Config.EXAMINE_RANGE)
end

function EvidenceService:Examine(plr: Player, model: Instance)
    local data = bodies[model]
    if not data or data.examined or channeling[plr] then
        return
    end
    if not round:IsAlive(plr) then
        return
    end
    -- Range check before anything is sent back: clues, "cold", even the sound
    if not inRange(plr, model :: Model) then
        return
    end

    channeling[plr] = true
    AudioService:Emit("examine_start", (model :: Model):GetPivot().Position)
    task.wait(Config.EXAMINE_TIME)
    channeling[plr] = nil

    -- Re-validate after the channel: they may have died, walked off, or lost the race
    if
        bodies[model] ~= data
        or data.examined
        or not round:IsAlive(plr)
        or not inRange(plr, model :: Model)
    then
        return
    end

    -- Clues stay readable in the dark now: everyone carries a light aura, so a
    -- witness who gets to the body in time can still read it. Only real age
    -- (the mode's clue window) lets the trail go cold.
    local age = os.clock() - data.at
    local window = Modes.Get(game.ReplicatedStorage:GetAttribute("Mode")).clueWindow
        or Config.BODY_CLUE_WINDOW
    if age > window then
        Remotes.Clue:FireClient(plr, { cold = true })
        return
    end

    data.examined = true
    model:RemoveTag("Revivable") -- a body that has been read is spent; no revive on it
    local clues = {
        { kind = "direction", text = ("%s was struck from the %s."):format(data.victim, data.dir) },
        { kind = "fibre", text = ("Fibre trace: %s."):format(data.fibre) },
        { kind = "time", text = ("Time of death: %ds ago."):format(math.floor(age)) },
    }
    if data.sawKiller then
        table.insert(clues, {
            kind = "witness",
            text = ("Partial name on the lips: %s…"):format(data.killer:sub(1, 2)),
        })
    end
    Remotes.Clue:FireClient(plr, clues)

    round.clueCounts[plr] = (round.clueCounts[plr] or 0) + 1
    -- The snitch's board is fed the same clues, cross-referenced against the
    -- living. Fibre always helps (it clears suspects); a witness gives a name.
    if require(script.Parent.RoleService):Get(plr) == "snitch" then
        require(script.Parent.SnitchService):AddClue(plr, {
            fibre = data.fibre,
            prefix = data.sawKiller and data.killer:sub(1, 2) or nil,
        })
    end
    require(script.Parent.EconomyService):Grant(plr, Config.EXAMINE_REWARD, 0, "examine")
    local profile = DataService:Get(plr)
    Analytics.EvidenceExamined(plr, #clues, age, profile and profile.rank or 0)
end

function EvidenceService:Clear()
    bodies = {}
    channeling = {}
    sight = {}
end

Players.PlayerRemoving:Connect(function(plr)
    sight[plr] = nil
    for _, mine in sight do
        mine[plr] = nil
    end
end)

return EvidenceService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[-- Global leaderboards: most round wins, most murderer escapes, richest
-- collection. Backed by OrderedDataStores, which are live-only - in Studio
-- without API access every call is wrapped so the boards are simply empty
-- rather than erroring. Names are resolved once and cached.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Shared = game.ReplicatedStorage.Shared
local Shop = require(Shared.Shop)
local Remotes = game.ReplicatedStorage.Remotes
local Participant = require(script.Parent.Participant)

-- key: the field on the payload; stat: how to read it from a player's data.
local BOARDS = {
    { key = "wins", title = "TOP DETECTIVES", store = "lb_wins_v1" },
    { key = "killer", title = "TOP KILLERS", store = "lb_killer_v1" },
    { key = "worth", title = "RICHEST", store = "lb_worth_v1" },
}
local TOP_N = 8
local REFRESH = 60

local LeaderboardService = {}
local stores: { [string]: OrderedDataStore } = {}
for _, b in BOARDS do
    local ok, s = pcall(function()
        return DataStoreService:GetOrderedDataStore(b.store)
    end)
    if ok then
        stores[b.key] = s
    end
end

local nameCache: { [number]: string } = {}
local function nameFor(userId: number): string
    local cached = nameCache[userId]
    if cached then
        return cached
    end
    local ok, res = pcall(function()
        return Players:GetNameFromUserIdAsync(userId)
    end)
    local name = (ok and res) or ("User" .. userId)
    nameCache[userId] = name
    return name
end

-- Called after a round settles, for each real player. Cheap (rounds are minutes
-- apart), and bots have no profile so they never reach here.
function LeaderboardService:Record(plr: Player, data)
    if Participant.IsBot(plr) then
        return
    end
    local vals = {
        wins = data.stats.wins,
        killer = data.stats.murdererWins,
        worth = Shop.ValueOf(data.inventory),
    }
    for _, b in BOARDS do
        local store = stores[b.key]
        if store then
            pcall(function()
                store:SetAsync(tostring(plr.UserId), vals[b.key])
            end)
        end
    end
end

function LeaderboardService:Refresh()
    local payload = {}
    for _, b in BOARDS do
        local rows = {}
        local store = stores[b.key]
        if store then
            local ok, pages = pcall(function()
                return store:GetSortedAsync(false, TOP_N)
            end)
            if ok then
                for _, entry in pages:GetCurrentPage() do
                    local userId = tonumber(entry.key)
                    if userId and entry.value and entry.value > 0 then
                        table.insert(rows, { name = nameFor(userId), value = entry.value })
                    end
                end
            end
        end
        payload[b.key] = { title = b.title, rows = rows }
    end
    Remotes.Leaderboard:FireAllClients(payload)
    return payload
end

task.spawn(function()
    while true do
        LeaderboardService:Refresh()
        task.wait(REFRESH)
    end
end)

Players.PlayerAdded:Connect(function()
    task.wait(3) -- let the boards settle, then push to the new client
    LeaderboardService:Refresh()
end)

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">LightingMood</string>
          <string name="Source"><![CDATA[--!strict
-- COLD CASE · per-map lighting mood. Each scene gets its own colour grade and
-- bloom, applied as its map loads and reset to a neutral lobby look on return.
--
-- It only ever touches the ColorCorrection "Grade" and Bloom "Glow" that
-- BuildLighting created - never Brightness, Ambient or ClockTime, which
-- EventService captures once and restores after Lights Out. So a blackout is
-- unaffected, and moods are kept subtle to protect the readability the whole
-- game is built on.
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local LightingMood = {}

export type Profile = {
    tint: Color3,
    contrast: number,
    saturation: number,
    bloom: number,
    bloomSize: number,
    bloomThreshold: number,
}

-- Lobby matches BuildLighting's neutral warm base. The three scenes lean:
-- Blackwood warm and golden, the Pier cool and hazy, the Archive crisp and
-- cool-white. Contrast and saturation stay moderate so nothing hurts to read.
local PROFILES: { [string]: Profile } = {
    Lobby = {
        tint = Color3.fromRGB(255, 252, 245),
        contrast = 0.10,
        saturation = 0.18,
        bloom = 0.30,
        bloomSize = 24,
        bloomThreshold = 1.8,
    },
    BlackwoodManor = {
        tint = Color3.fromRGB(255, 244, 224),
        contrast = 0.16,
        saturation = 0.22,
        bloom = 0.42,
        bloomSize = 28,
        bloomThreshold = 1.6,
    },
    RustedPier = {
        tint = Color3.fromRGB(232, 242, 255),
        contrast = 0.08,
        saturation = 0.10,
        bloom = 0.35,
        bloomSize = 30,
        bloomThreshold = 1.9,
    },
    CityArchive = {
        tint = Color3.fromRGB(246, 248, 255),
        contrast = 0.20,
        saturation = 0.14,
        bloom = 0.22,
        bloomSize = 20,
        bloomThreshold = 2.0,
    },
}

local INFO = TweenInfo.new(1.0, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

function LightingMood.Apply(name: string)
    local p = PROFILES[name] or PROFILES.Lobby
    local grade = Lighting:FindFirstChild("Grade")
    local glow = Lighting:FindFirstChild("Glow")
    if grade and grade:IsA("ColorCorrectionEffect") then
        TweenService:Create(grade, INFO, {
            TintColor = p.tint,
            Contrast = p.contrast,
            Saturation = p.saturation,
        }):Play()
    end
    if glow and glow:IsA("BloomEffect") then
        TweenService:Create(glow, INFO, {
            Intensity = p.bloom,
            Size = p.bloomSize,
            Threshold = p.bloomThreshold,
        }):Play()
    end
end

return LightingMood
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">LiveOpsClock</string>
          <string name="Source"><![CDATA[--!strict
-- Server-side "what launch day is it". In Studio, set the attribute
-- ServerStorage.LiveOpsDay (number) to preview any day of the calendar.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local LiveOps = require(ReplicatedStorage.Shared.LiveOps)

local LiveOpsClock = {}

function LiveOpsClock.Day(): number
    if RunService:IsStudio() then
        local override = ServerStorage:GetAttribute("LiveOpsDay")
        if type(override) == "number" then
            return math.floor(override)
        end
    end
    return LiveOps.DayAt(os.time(), LiveOps.LAUNCH_UTC)
end

-- Publishes the public calendar state as ReplicatedStorage attributes so the
-- client can show the seasonal crate, its countdown, and whether trading is open.
function LiveOpsClock.Publish()
    local day = LiveOpsClock.Day()
    local season = LiveOps.ActiveSeason(day)
    ReplicatedStorage:SetAttribute("LiveOpsDay", day)
    ReplicatedStorage:SetAttribute("SeasonId", season and season.id or nil)
    ReplicatedStorage:SetAttribute("SeasonName", season and season.name or nil)
    ReplicatedStorage:SetAttribute("SeasonDaysLeft", LiveOps.DaysLeftInSeason(day))
    ReplicatedStorage:SetAttribute("SeasonCrateCost", season and season.crateCost or nil)
    ReplicatedStorage:SetAttribute("TradingOpen", LiveOps.IsTradingOpen(day))
    ReplicatedStorage:SetAttribute("TradingOpensDay", LiveOps.TRADING_UNLOCK_DAY)
end

return LiveOpsClock
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Gamepasses and developer products. Ids and prices live in Shared/Products.
-- Hard rule: nothing here touches lethality, speed or vision.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Products = require(game.ReplicatedStorage.Shared.Products)
local Config = require(game.ReplicatedStorage.Shared.Config)
local Catalog = require(game.ReplicatedStorage.Shared.Catalog)
local Remotes = game.ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local Analytics = require(script.Parent.Analytics)

local MonetizationService = {}
local MAX_RECEIPTS = 200
local charConns: { [Player]: RBXScriptConnection } = {}

-- Gold [VIP] over the head. Rides the core nametag, which VisionController
-- fog-gates every frame, so a VIP is never legible past the vision radius
-- mid-round - identity, never a tracking advantage.
local function markCharacter(plr: Player)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        (hum :: Humanoid).DisplayName = "[VIP] " .. plr.DisplayName
    end
end

-- Everything a VIP owner is owed: the public tag attribute, the once-only
-- exclusive aura, and the head marker. Safe to call more than once.
function MonetizationService:ApplyVip(plr: Player, data)
    local isVip = data.passes.vip == true
    plr:SetAttribute("Vip", isVip) -- public: read by the chat tag and future UI
    if not isVip then
        return
    end
    if not data.onboarding.vipSkin then
        local item = Catalog[Config.VIP_SKIN]
        if item then
            local entry =
                { id = Config.VIP_SKIN, uid = HttpService:GenerateGUID(false), at = os.time() }
            table.insert(data.inventory, entry)
            data.onboarding.vipSkin = true
            Remotes.CrateResult:FireClient(
                plr,
                { id = entry.id, uid = entry.uid, rarity = item.rarity, gift = true }
            )
            Remotes.DataChanged:FireClient(plr, { inventory = data.inventory })
            Remotes.Notify:FireClient(plr, ("VIP gift · %s"):format(item.name))
        end
    end
    if not charConns[plr] then
        charConns[plr] = plr.CharacterAdded:Connect(function()
            task.defer(markCharacter, plr)
        end)
    end
    markCharacter(plr)
end

function MonetizationService:HasPass(plr: Player, key: string): boolean
    local data = DataService:Get(plr)
    return data ~= nil and data.passes[key] == true
end

function MonetizationService:Refresh(plr: Player)
    local data = DataService:Get(plr)
    if not data then
        return
    end
    for key, pass in Products.PASSES do
        if pass.id ~= 0 then
            local ok, owns = pcall(
                MarketplaceService.UserOwnsGamePassAsync,
                MarketplaceService,
                plr.UserId,
                pass.id
            )
            if ok then
                data.passes[key] = owns or nil
            end
        end
    end
    Remotes.DataChanged:FireClient(plr, { passes = data.passes })
    MonetizationService:ApplyVip(plr, data)
end

DataService.Loaded.Event:Connect(function(plr: Player)
    MonetizationService:Refresh(plr)
end)

Players.PlayerRemoving:Connect(function(plr)
    local conn = charConns[plr]
    if conn then
        conn:Disconnect()
        charConns[plr] = nil
    end
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, passId, purchased)
    if not purchased then
        return
    end
    local data = DataService:Get(plr)
    for key, pass in Products.PASSES do
        if data and pass.id ~= 0 and pass.id == passId then
            data.passes[key] = true
            Remotes.DataChanged:FireClient(plr, { passes = data.passes })
            if key == "vip" then
                MonetizationService:ApplyVip(plr, data) -- mint the aura and tag on the spot
            end
        end
    end
end)

local function productById(productId: number)
    for _, product in Products.PRODUCTS do
        if product.id ~= 0 and product.id == productId then
            return product
        end
    end
    return nil
end

-- Keep the receipt log bounded; Roblox only redelivers unacknowledged receipts
local function prune(purchases)
    local ids = {}
    for id, at in purchases do
        table.insert(ids, { id = id, at = at })
    end
    if #ids <= MAX_RECEIPTS then
        return
    end
    table.sort(ids, function(a, b)
        return a.at < b.at
    end)
    for i = 1, #ids - MAX_RECEIPTS do
        purchases[ids[i].id] = nil
    end
end

MarketplaceService.ProcessReceipt = function(receipt)
    local plr = Players:GetPlayerByUserId(receipt.PlayerId)
    local data = plr and DataService:Get(plr)
    local product = productById(receipt.ProductId)
    if not (plr and data and product) then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end

    -- A receipt can arrive more than once. Grant each PurchaseId exactly once.
    if data.purchases[receipt.PurchaseId] then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end

    if product.coins then
        data.coins += product.coins -- raw: purchases never pick up gameplay multipliers
        Analytics.CoinsEarned(plr, "robux", product.coins, data.coins, 0)
    end
    if product.seasonalKeys then
        data.seasonalKeys += product.seasonalKeys
    end
    data.purchases[receipt.PurchaseId] = os.time()
    prune(data.purchases)

    Remotes.DataChanged:FireClient(plr, { coins = data.coins, seasonalKeys = data.seasonalKeys })
    return Enum.ProductPurchaseDecision.PurchaseGranted
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">OnboardingService</string>
          <string name="Source"><![CDATA[-- The first ninety seconds (Handbook §02), server side:
--   0:05  one free Locker pull the moment a new player lands
--   hints tracked once per account ("move", "examine", "coins")
--   onboarding funnel steps for analytics
-- Forced-innocent first rounds live in RoleService; the ghost prompts
-- themselves are drawn by the client.
local Players = game:GetService("Players")
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Analytics = require(script.Parent.Analytics)

local OnboardingService = {}
local HINTS = { move = true, examine = true, coins = true }
local FREE_CRATE_DELAY = 5
local logged: { [Player]: { [any]: boolean } } = {}

-- True the first time a new player's session reaches `key`, false after that
-- and false for anyone who is not new.
local function once(plr: Player, key: any): boolean
    local session = DataService:GetSession(plr)
    if not (session and session.isNew) then
        return false
    end
    logged[plr] = logged[plr] or {}
    if logged[plr][key] then
        return false
    end
    logged[plr][key] = true
    return true
end

local function funnel(plr: Player, step)
    if once(plr, step[1]) then
        Analytics.Funnel(plr, step)
    end
end

local function grantFreeCrate(plr: Player)
    local data = DataService:Get(plr)
    if not data or data.onboarding.freeCrate then
        return
    end
    task.wait(FREE_CRATE_DELAY)
    data = DataService:Get(plr)
    if not data or data.onboarding.freeCrate then
        return
    end
    data.onboarding.freeCrate = true -- flag first; a failed pull is refunded below
    if EconomyService:OpenCrate(plr, "locker", true) then
        funnel(plr, Analytics.FUNNEL.FREE_CRATE)
    else
        data.onboarding.freeCrate = false
    end
end

DataService.Loaded.Event:Connect(function(plr: Player)
    task.spawn(grantFreeCrate, plr)
end)

function OnboardingService:MarkHintSeen(plr: Player, hintId: any)
    if type(hintId) ~= "string" or not HINTS[hintId] then
        return
    end
    local data = DataService:Get(plr)
    if data then
        data.hintsSeen[hintId] = true
    end
end

-- Not a funnel step; see the note on Analytics.FUNNEL. Only reached for a vote
-- the round accepted, so mapName is always one of Config.MAPS.
function OnboardingService:NoteVote(plr: Player, mapName: string)
    if once(plr, "voted") then
        Analytics.FirstVote(plr, mapName)
    end
end

function OnboardingService:NoteRoundStart(participants: { Player })
    for _, plr in participants do
        local session = DataService:GetSession(plr)
        if session then
            funnel(
                plr,
                session.rounds == 0 and Analytics.FUNNEL.FIRST_ROUND_START
                    or Analytics.FUNNEL.SECOND_ROUND_START
            )
        end
    end
end

function OnboardingService:NoteRoundEnd(participants: { Player })
    for _, plr in participants do
        funnel(plr, Analytics.FUNNEL.FIRST_ROUND_END)
    end
end

Players.PlayerRemoving:Connect(function(plr)
    logged[plr] = nil
end)

return OnboardingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">Participant</string>
          <string name="Source"><![CDATA[--!strict
-- A round participant is a Player or an NPC from BotService. NPCs are plain
-- tables carrying the few Player fields round code reads (Name, DisplayName,
-- UserId, Character), so anything that talks to a client, a profile or
-- analytics must ask first.
local Participant = {}

function Participant.IsBot(p: any): boolean
    return type(p) == "table" and p.IsBot == true
end

return Participant
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">PedestalService</string>
          <string name="Source"><![CDATA[-- Lobby showcase pedestals: hold the prompt to feature your equipped knife on a
-- stand, hold it again to take it down. One pedestal per player. The state lives
-- in replicated attributes on each pedestal (Owner, OwnerName, Item) so clients
-- render the featured knife straight from them - no remote needed.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")

local PedestalService = {}
local ownedBy: { [Player]: Model } = {}

local function release(ped: Model)
    ped:SetAttribute("Owner", 0)
    ped:SetAttribute("OwnerName", "")
    ped:SetAttribute("Item", "")
end

local function claim(ped: Model, plr: Player)
    local knife = plr:GetAttribute("Knife")
    if type(knife) ~= "string" or knife == "" then
        return
    end
    local prev = ownedBy[plr]
    if prev and prev ~= ped then
        release(prev)
    end
    ownedBy[plr] = ped
    ped:SetAttribute("Owner", plr.UserId)
    ped:SetAttribute("OwnerName", plr.DisplayName)
    ped:SetAttribute("Item", knife)
end

local function onTrigger(ped: Model, plr: Player)
    local owner = ped:GetAttribute("Owner") or 0
    if owner == plr.UserId then
        release(ped)
        ownedBy[plr] = nil
    elseif owner == 0 then
        claim(ped, plr)
    end
    -- occupied by someone else: leave it be
end

local function wire(ped: Model)
    release(ped) -- start empty every server
    for _, d in ped:GetDescendants() do
        if d:IsA("ProximityPrompt") then
            d.Triggered:Connect(function(plr)
                onTrigger(ped, plr)
            end)
        end
    end
end

for _, ped in CollectionService:GetTagged("Pedestal") do
    wire(ped)
end
CollectionService:GetInstanceAddedSignal("Pedestal"):Connect(wire)

-- Keep a featured knife in step with the owner's equipped knife.
local function watch(plr: Player)
    plr:GetAttributeChangedSignal("Knife"):Connect(function()
        local ped = ownedBy[plr]
        local knife = plr:GetAttribute("Knife")
        if ped and type(knife) == "string" and knife ~= "" then
            ped:SetAttribute("Item", knife)
        end
    end)
end
Players.PlayerAdded:Connect(watch)
for _, plr in Players:GetPlayers() do
    watch(plr)
end
Players.PlayerRemoving:Connect(function(plr)
    local ped = ownedBy[plr]
    if ped then
        release(ped)
        ownedBy[plr] = nil
    end
end)

return PedestalService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">PlayerPolicy</string>
          <string name="Source"><![CDATA[--!strict
-- Roblox policy APIs for paid random items and paid item trading.
-- Resolved once per player on join and published as Player attributes, so the
-- client can explain why a feature is unavailable. Fails closed: while the
-- lookup is pending or has failed, the player is treated as restricted.
local Players = game:GetService("Players")
local PolicyService = game:GetService("PolicyService")

local PlayerPolicy = {}
local cache: { [Player]: { randomItemsRestricted: boolean, tradingAllowed: boolean } } = {}
local RETRY_DELAY = 10
local MAX_TRIES = 3

local function apply(plr: Player, randomItemsRestricted: boolean, tradingAllowed: boolean)
    cache[plr] = { randomItemsRestricted = randomItemsRestricted, tradingAllowed = tradingAllowed }
    plr:SetAttribute("PaidRandomItemsRestricted", randomItemsRestricted)
    plr:SetAttribute("PaidItemTradingAllowed", tradingAllowed)
end

local function resolve(plr: Player)
    apply(plr, true, false)
    for _ = 1, MAX_TRIES do
        local ok, info = pcall(PolicyService.GetPolicyInfoForPlayerAsync, PolicyService, plr)
        if plr.Parent ~= Players then
            return
        end
        if ok and type(info) == "table" then
            apply(
                plr,
                info.ArePaidRandomItemsRestricted == true,
                info.IsPaidItemTradingAllowed == true
            )
            return
        end
        task.wait(RETRY_DELAY)
    end
end

-- Crates bought with coins or keys, crafting and effect re-rolls all hand out
-- a random result for something that can be bought with Robux
function PlayerPolicy:CanUsePaidRandomItems(plr: Player): boolean
    local c = cache[plr]
    return c ~= nil and not c.randomItemsRestricted
end

function PlayerPolicy:CanTradePaidItems(plr: Player): boolean
    local c = cache[plr]
    return c ~= nil and c.tradingAllowed
end

Players.PlayerAdded:Connect(function(plr)
    task.spawn(resolve, plr)
end)
for _, plr in Players:GetPlayers() do
    task.spawn(resolve, plr)
end
Players.PlayerRemoving:Connect(function(plr)
    cache[plr] = nil
end)

return PlayerPolicy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">Reach</string>
          <string name="Source"><![CDATA[--!strict
-- One proximity check for the server-side actions that re-validate after a
-- yield. EvidenceService and AbilityService each had their own copy of this
-- with the same guards and the same constant under different names, and both
-- gate anti-cheat re-checks, so they must not drift apart.
--
-- Note what is NOT here: Config.PING_ALLOWANCE. That slack exists for the
-- reach checks a moving player disputes - knife swings, gun pickups, coins -
-- where the server's view of where they stood lags theirs. Examining a body
-- and reviving are done standing still, so they use the plain range.
local Reach = {}

function Reach.Within(plr: Player, model: Instance, range: number): boolean
    local char = plr.Character
    if not char or model.Parent == nil then
        return false
    end
    return (char:GetPivot().Position - (model :: Model):GetPivot().Position).Magnitude <= range
end

return Reach
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">RemoteGuard</string>
          <string name="Source"><![CDATA[--!strict
-- Every client -> server remote goes through here (Handbook §06 · Remote spam).
-- A ceiling per player across every remote, and a tighter one per remote from
-- Config.REMOTE_LIMITS. Over-limit calls are rejected silently; sustained
-- abuse of either kicks. Handlers never learn about the limiter and never
-- tell the client why a call failed.
local Players = game:GetService("Players")
local Config = require(game.ReplicatedStorage.Shared.Config)
local RateLimiter = require(game.ReplicatedStorage.Shared.RateLimiter)
local Remotes = game.ReplicatedStorage.Remotes

local RemoteGuard = {}
local PER_REMOTE: { [string]: number } = Config.REMOTE_LIMITS :: any

local function newLimiter(perSec: number): RateLimiter.RateLimiter
    return RateLimiter.new(perSec, Config.REMOTE_STRIKES_TO_KICK, Config.REMOTE_STRIKE_WINDOW)
end

local global = newLimiter(Config.REMOTE_CALLS_PER_SEC)
local limiters: { RateLimiter.RateLimiter } = { global }

-- A flood arrives as hundreds of queued calls, and the limiter keeps saying
-- "kick" for every one of them. Kick the player once and drop the rest, or the
-- log fills with identical disconnect lines and buries everything else.
local kicked: { [Player]: boolean } = {}

function RemoteGuard.Connect(remoteName: string, handler: (Player, ...any) -> ())
    local remote = Remotes:FindFirstChild(remoteName) :: RemoteEvent
    assert(remote, "RemoteGuard: no remote named " .. remoteName)
    local perSec = PER_REMOTE[remoteName]
    local own = if perSec then newLimiter(perSec) else nil
    if own then
        table.insert(limiters, own)
    end
    remote.OnServerEvent:Connect(function(plr, ...)
        local now = os.clock()
        local allowed, kick = global:Hit(plr, now)
        if allowed and own then
            allowed, kick = own:Hit(plr, now)
        end
        if kick then
            if not kicked[plr] then
                kicked[plr] = true
                plr:Kick("Disconnected.")
            end
            return
        end
        if not allowed then
            return
        end
        handler(plr, ...)
    end)
end

-- Rejects NaN and infinite components, which slip past typeof() checks
function RemoteGuard.IsFiniteVector(v: any): boolean
    if typeof(v) ~= "Vector3" then
        return false
    end
    for _, n in { v.X, v.Y, v.Z } do
        if n ~= n or n == math.huge or n == -math.huge then
            return false
        end
    end
    return true
end

Players.PlayerRemoving:Connect(function(plr)
    kicked[plr] = nil
    for _, limiter in limiters do
        limiter:Remove(plr)
    end
end)

return RemoteGuard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">RoleService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Shuffle = require(game.ReplicatedStorage.Shared.Shuffle)
local Modes = require(game.ReplicatedStorage.Shared.Modes)
local DataService = require(script.Parent.DataService)
local Analytics = require(script.Parent.Analytics)
local CosmeticService = require(script.Parent.CosmeticService)
local Participant = require(script.Parent.Participant)
local Remotes = game.ReplicatedStorage.Remotes

local RoleService = {}
local roles = {} -- [Player] = "murderer" | "sheriff" | "innocent" | "hero" | ...
local sinceMurderer = {} -- [Player] = rounds since they last held the knife
local PISTOL_ROLES: { [string]: boolean } = Config.PISTOL_ROLES :: any

-- Weighted draw so nobody gets the knife twice in three rounds while a
-- friend goes ten without it.
local function drawMurderer(pool)
    local weights, total = {}, 0
    for i, plr in pool do
        local since = sinceMurderer[plr] or 99
        local w = math.clamp(since / Config.MURDERER_COOLOFF, 0.1, 1) * 100
        weights[i] = w
        total += w
    end
    local n = math.random() * total
    for i, w in weights do
        n -= w
        if n <= 0 then
            return table.remove(pool, i)
        end
    end
    return table.remove(pool)
end

local function isFirstRound(plr: Player): boolean
    local data = DataService:Get(plr)
    return data ~= nil and data.stats.rounds == 0
end

function RoleService:Assign(participants: { Player })
    roles = {}
    local mode = Modes.Get(ReplicatedStorage:GetAttribute("Mode"))
    local count = #participants
    local murderers = count >= Config.SECOND_MURDERER_AT and 2 or 1
    -- Whodunnit has no sheriff: the town convicts the killer by vote, not the gun.
    local sheriffs = if mode.noSheriff then 0 elseif count >= Config.SECOND_SHERIFF_AT then 2 else 1

    -- Assassin is a free-for-all: everyone is armed and hunts a target.
    if mode.ffa then
        for _, plr in participants do
            roles[plr] = "assassin"
        end
    else
        -- Onboarding: a player's first round is always innocent. Newcomers only
        -- enter the special-role pool when there are not enough veterans to fill it.
        local pool, newcomers = {}, {}
        for _, plr in participants do
            table.insert(isFirstRound(plr) and newcomers or pool, plr)
        end
        Shuffle.Shuffle(pool)
        Shuffle.Shuffle(newcomers)
        while #pool < murderers + sheriffs and #newcomers > 0 do
            table.insert(pool, table.remove(newcomers))
        end

        for _ = 1, murderers do
            local m = drawMurderer(pool)
            if m then
                roles[m] = "murderer"
            end
        end
        for _ = 1, sheriffs do
            local s = table.remove(pool)
            if s then
                roles[s] = "sheriff"
            end
        end
        -- An NPC medic never revives anyone and an NPC snitch's reveal reaches no
        -- screen, so these two lean toward a person. Only a lean: preferring a
        -- human every time handed the same player medic round after round.
        local function drawPreferHuman(): Player?
            if math.random() < 0.5 then
                for i = #pool, 1, -1 do
                    if not Participant.IsBot(pool[i]) then
                        return table.remove(pool, i)
                    end
                end
            end
            return table.remove(pool)
        end
        -- A medic can bring back a person or an NPC (BotService rebuilds the
        -- body), so a round filled with NPCs is a full round for the medic too.
        if count >= Config.MEDIC_AT and #pool > 2 and not mode.noMedic then
            local medic = drawPreferHuman()
            if medic then
                roles[medic] = "medic"
            end
        end
        if count >= Config.SNITCH_AT and #pool > 2 then
            local snitch = drawPreferHuman()
            if snitch then
                roles[snitch] = "snitch"
            end
        end
        for _, plr in pool do
            roles[plr] = "innocent"
        end
        for _, plr in newcomers do
            roles[plr] = "innocent"
        end

        -- Studio only: set ServerStorage.ForceRole = "medic" to play a role on
        -- demand. The first person swaps roles with whoever drew it, so the
        -- round still has exactly the roles it would have had.
        local force = RunService:IsStudio() and ServerStorage:GetAttribute("ForceRole")
        if type(force) == "string" then
            for _, plr in participants do
                if not Participant.IsBot(plr) then
                    for other, role in roles do
                        if role == force then
                            roles[other] = roles[plr]
                            break
                        end
                    end
                    roles[plr] = force
                    break
                end
            end
        end
    end

    for _, plr in participants do
        self:Arm(plr)
        if Participant.IsBot(plr) then
            continue -- an NPC has no client, no history and no profile
        end
        if roles[plr] == "murderer" then
            sinceMurderer[plr] = 0
        else
            sinceMurderer[plr] = (sinceMurderer[plr] or 0) + 1
        end
        -- CRITICAL: FireClient per player, never FireAllClients.
        -- Anything the client receives, an exploiter reads.
        Remotes.RoleAssigned:FireClient(plr, roles[plr])

        local data = DataService:Get(plr)
        Analytics.RoleAssigned(plr, roles[plr], data and data.rank or 0, isFirstRound(plr))
    end
end

-- Weapons are carried hidden and drawn by CombatService on each use. A knife
-- held all round would name the murderer to anyone who looks.
function RoleService:Arm(plr: Player)
    local role = roles[plr]
    if role == "murderer" or role == "assassin" then
        CosmeticService:GiveWeapon(plr, "knife")
    elseif role == "sheriff" or role == "hero" then
        CosmeticService:GiveWeapon(plr, "gun")
    end
end

function RoleService:Get(plr: Player): string?
    return roles[plr]
end

-- Taking the fallen sheriff's pistol. Every unarmed civilian role can, not
-- innocents alone (Config.PISTOL_ROLES): a medic or snitch who cannot pick up
-- the gun in front of them reads as a broken game. Whoever takes it becomes
-- the hero, so a medic trades the rest of their kit for the revolver -
-- CombatService tells them so.
function RoleService:MakeHero(plr: Player): boolean
    local role = roles[plr]
    if not (role and PISTOL_ROLES[role]) then
        return false
    end
    roles[plr] = "hero"
    if not Participant.IsBot(plr) then
        Remotes.RoleAssigned:FireClient(plr, "hero")
    end
    self:Arm(plr)
    return true
end

-- Infection: an infected's blade turns a living survivor into a killer instead
-- of eliminating them. They keep their body, take a knife, and join the hunt.
-- The gun still kills outright, so the sheriff can thin the infected out.
function RoleService:Infect(plr: Player)
    if roles[plr] == "murderer" then
        return -- already infected
    end
    roles[plr] = "murderer"
    if not Participant.IsBot(plr) then
        Remotes.RoleAssigned:FireClient(plr, "murderer")
        Remotes.Notify:FireClient(plr, "You've been infected! Hunt the survivors.")
    end
    self:Arm(plr)
end

-- Snitch: at 30s remaining, the snitch and the murderer(s) learn each other.
-- A full round can hold two murderers (SECOND_MURDERER_AT), so the snitch
-- learns every murderer and every murderer learns the snitch - a single
-- `murderer` variable would have named only whichever the table iterated last
-- and left the other unwarned.
function RoleService:RevealSnitch()
    local snitch
    local murderers = {}
    for plr, role in roles do
        if role == "snitch" then
            snitch = plr
        elseif role == "murderer" then
            table.insert(murderers, plr)
        end
    end
    if not (snitch and #murderers > 0) then
        return
    end
    if not Participant.IsBot(snitch) then
        local names = {}
        for _, murderer in murderers do
            table.insert(names, murderer.Name)
        end
        Remotes.RoleAssigned:FireClient(snitch, "snitch", table.concat(names, " and "))
    end
    for _, murderer in murderers do
        if not Participant.IsBot(murderer) then
            Remotes.RoleAssigned:FireClient(murderer, "murderer", snitch.Name)
        end
    end
end

-- Only ever called AFTER the round has resolved
function RoleService:GetPublicReveal(): { [string]: string }
    local out = {}
    for plr, role in roles do
        out[plr.Name] = role
    end
    return out
end

-- Every participant this round (players and bots), for the snitch's board.
function RoleService:Participants(): { any }
    local out = {}
    for p in roles do
        table.insert(out, p)
    end
    return out
end

-- The real murderer participants. Server truth for the snitch's Expose, so a
-- whistle-blow always names the actual killer, never a wrong guess.
function RoleService:Murderers(): { any }
    local out = {}
    for p, role in roles do
        if role == "murderer" then
            table.insert(out, p)
        end
    end
    return out
end

function RoleService:Clear()
    roles = {}
end

Players.PlayerRemoving:Connect(function(plr)
    sinceMurderer[plr] = nil
end)

return RoleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[-- The heartbeat. Every transition is server-authoritative.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Shuffle = require(ReplicatedStorage.Shared.Shuffle)
local Modes = require(ReplicatedStorage.Shared.Modes)
local Remotes = ReplicatedStorage.Remotes
local RoleService = require(script.Parent.RoleService)
local EventService = require(script.Parent.EventService)
local EconomyService = require(script.Parent.EconomyService)
local EvidenceService = require(script.Parent.EvidenceService)
local CombatService = require(script.Parent.CombatService)
local CoinService = require(script.Parent.CoinService)
local AbilityService = require(script.Parent.AbilityService)
local DataService = require(script.Parent.DataService)
local Analytics = require(script.Parent.Analytics)
local OnboardingService = require(script.Parent.OnboardingService)
local SpectatorService = require(script.Parent.SpectatorService)
local BotService = require(script.Parent.BotService)
local Participant = require(script.Parent.Participant)
local LightingMood = require(script.Parent.LightingMood)
local SnitchService = require(script.Parent.SnitchService)
local WhodunnitService = require(script.Parent.WhodunnitService)
local AssassinService = require(script.Parent.AssassinService)
local Lobby = require(ReplicatedStorage.Shared.Lobby)

local RoundService = {}
local state, stateEnds = "INTERMISSION", math.huge -- no deadline until the lobby arms
local participants: { Player } = {} -- Players and NPCs (see Participant)
local pendingBots = 0
local votes: { [Player]: string } = {}
local modeVotes: { [Player]: string } = {} -- lobby vote for the next round's mode
local alive: { [Player]: boolean } = {}
local diedConnections: { RBXScriptConnection } = {}
local eventFired, snitchRevealed, lastCallFired = false, false, false
local roundsPlayed = 0
local currentMode = "classic"

-- Classic by default; a special mode every MODE_ROTATE_EVERY rounds, cycling
-- through Modes.ROTATION. Studio can force one with ServerStorage.ForceMode.
local function pickMode(): string
    local forced = RunService:IsStudio() and ServerStorage:GetAttribute("ForceMode")
    if type(forced) == "string" and Modes.DEFS[forced] then
        return forced
    end
    roundsPlayed += 1
    -- The lobby's pick wins when anyone voted; the votes are spent each round.
    local tally, voted, votedN = {}, nil, 0
    for _, id in modeVotes do
        tally[id] = (tally[id] or 0) + 1
        if tally[id] > votedN then
            voted, votedN = id, tally[id]
        end
    end
    modeVotes = {}
    if voted and Modes.DEFS[voted] then
        return voted
    end
    if #Modes.ROTATION > 0 and roundsPlayed % Config.MODE_ROTATE_EVERY == 0 then
        local slot = (roundsPlayed // Config.MODE_ROTATE_EVERY - 1) % #Modes.ROTATION + 1
        return Modes.ROTATION[slot]
    end
    return "classic"
end
local currentMapName, mapIsIndoor = "none", true
local activeStart, roundLength = 0, Config.ROUND_LENGTH
-- Public only after the round resolves: { at, killer?, victim, method }
local timeline: { { at: number, killer: string?, victim: string, method: string, pos: Vector3? } } =
    {}
RoundService.clueCounts = {} :: { [Player]: number }

local function setState(new: string, duration: number)
    state, stateEnds = new, os.clock() + duration
    -- Attributes let late joiners and the HUD timer sync without os.clock drift.
    -- RoundEnds goes first: every client handler for the RoundState change reads
    -- RoundEnds inside that handler, so setting it second handed them the
    -- previous state's deadline. Usually the stale value had only just expired
    -- and nobody noticed; after LOADING, which overruns by a couple of seconds
    -- while the map clones, it was nearly four seconds out of date.
    ReplicatedStorage:SetAttribute("RoundEnds", workspace:GetServerTimeNow() + duration)
    ReplicatedStorage:SetAttribute("RoundState", new)
    for _, plr in Players:GetPlayers() do
        DataService:SetScreen(plr, (new == "ACTIVE" and not alive[plr]) and "SPECTATING" or new)
    end
end

-- The lobby with no countdown: nobody has asked for a round yet. RoundEnds
-- is 0, which the lobby reads as "choose how to play" rather than a timer.
local function idleLobby()
    state, stateEnds = "INTERMISSION", math.huge
    ReplicatedStorage:SetAttribute("RoundEnds", 0)
    ReplicatedStorage:SetAttribute("RoundState", "INTERMISSION")
    for _, plr in Players:GetPlayers() do
        DataService:SetScreen(plr, "INTERMISSION")
    end
end

local function aliveList(): { Player }
    local out = {}
    for plr in alive do
        table.insert(out, plr)
    end
    return out
end

-- Sorted so every spectator cycles through the same order
local function aliveNames(): { string }
    local out = {}
    for plr in alive do
        table.insert(out, plr.Name)
    end
    table.sort(out)
    return out
end

local function broadcastAlive()
    Remotes.AliveChanged:FireAllClients(#aliveList())
end

local function broadcastTally()
    local tally = {}
    for _, m in votes do
        tally[m] = (tally[m] or 0) + 1
    end
    Remotes.VoteTally:FireAllClients(tally)
end

local function broadcastModeTally()
    local tally = {}
    for _, id in modeVotes do
        tally[id] = (tally[id] or 0) + 1
    end
    Remotes.ModeTally:FireAllClients(tally)
end

local function minPlayers(): number
    -- Studio only: set ServerStorage.MinPlayers = 1 to test solo
    local override = RunService:IsStudio() and ServerStorage:GetAttribute("MinPlayers")
    return type(override) == "number" and override or Config.MIN_PLAYERS
end

local function lengthFor(count: number): number
    if count < Config.ROUND_SMALL_UNDER then
        return Config.ROUND_LENGTH_SMALL
    elseif count >= Config.ROUND_LARGE_AT then
        return Config.ROUND_LENGTH_LARGE
    end
    return Config.ROUND_LENGTH
end

function RoundService:GetState(): string
    return state
end

-- Who would play if the countdown ended now: those who pressed PLAY NOW,
-- and only them. Everyone else waits in the lobby for real players
-- (Lobby.Plan has the reasoning).
--
-- Counted by loaded profile, not by character. A player who resets has no
-- Character for a moment, and counting them out for that moment idled the
-- lobby and restarted the whole countdown when they were back - in a full
-- lobby, repeated resets kept a round from ever starting. Whoever still has
-- no character once the round loads is dropped there, by the `present`
-- filter in Advance.
local function lobbyPlan(): (Lobby.Plan, { Player }, { Player })
    local humans, playing = {}, {}
    for _, plr in Players:GetPlayers() do
        if DataService:Get(plr) then
            table.insert(humans, plr)
            if plr:GetAttribute("WaitForPlayers") == false then
                table.insert(playing, plr)
            end
        end
    end
    local plan =
        Lobby.Plan(#humans, #playing, minPlayers(), Config.BOT_FILL_TO, Config.BOTS_ENABLED)
    return plan, humans, playing
end

-- The countdown runs only while a round could start: someone has pressed
-- PLAY NOW, or enough real players are in. Until then the lobby idles with
-- no deadline, so a fresh join meets the choice before any timer. It starts
-- the moment the plan allows and stops the moment it no longer does.
local lobbyArmed = false
function RoundService:ArmLobby()
    local plan = lobbyPlan()
    if plan.start and not lobbyArmed then
        lobbyArmed = true
        setState("INTERMISSION", Config.INTERMISSION)
    elseif not plan.start and lobbyArmed then
        lobbyArmed = false
        idleLobby()
    end
end

-- Back to the lobby between rounds: idle, then arm at once if the players
-- who chose PLAY NOW are still here, so a chosen game keeps going by itself
function RoundService:EnterLobby()
    lobbyArmed = false
    idleLobby()
    self:ArmLobby()
end

function RoundService:TimeLeft(): number
    return math.max(0, stateEnds - os.clock())
end

-- True only for a participant who is still alive in an ACTIVE round
function RoundService:IsAlive(plr: Player): boolean
    return state == "ACTIVE" and alive[plr] == true and plr.Character ~= nil
end

function RoundService:IsParticipant(plr: Player): boolean
    return table.find(participants, plr) ~= nil
end

function RoundService:MapName(): string
    return currentMapName
end

function RoundService:AliveNames(): { string }
    return aliveNames()
end

function RoundService:AliveParticipants(): { any }
    return aliveList()
end

function RoundService:BotFromCharacter(model: Instance): any
    return BotService:FromCharacter(model)
end

-- Returns whether the vote was accepted, so the caller can tell a real vote
-- from a rejected one without re-checking the map name itself.
function RoundService:CastVote(plr: Player, mapName: string): boolean
    if state ~= "INTERMISSION" or not table.find(Config.MAPS, mapName) then
        return false
    end
    votes[plr] = mapName
    broadcastTally()
    return true
end

function RoundService:CastModeVote(plr: Player, modeId: string): boolean
    if state ~= "INTERMISSION" or not Modes.DEFS[modeId] then
        return false
    end
    modeVotes[plr] = modeId
    broadcastModeTally()
    return true
end

local function winningMap(): string
    local tally = {}
    for _, m in votes do
        tally[m] = (tally[m] or 0) + 1
    end
    local best, bestN = nil, 0
    for m, n in tally do
        if n > bestN then
            best, bestN = m, n
        end
    end
    return best or Config.MAPS[math.random(#Config.MAPS)]
end

-- Built as LOADING begins rather than as it ends. Cloning a map floods
-- replication, and a client that receives the burst late receives the state
-- change behind it late too: measured, the server ran a full 4s REVEAL while
-- clients saw 2.5s, so a role card meant to be readable for four seconds was
-- on screen for two and a half. Building here gives the LOADING window
-- something to do - absorbing that burst is the reason it exists.
function RoundService:BuildVotedMap()
    local old = workspace:FindFirstChild("Round")
    if old then
        old:Destroy()
    end
    local folder = Instance.new("Folder")
    folder.Name = "Round"
    folder.Parent = workspace

    currentMapName = winningMap()
    mapIsIndoor = currentMapName ~= "RustedPier"
    -- The loading screen names the scene; set before the state flips to
    -- LOADING so no client shows the screen before it knows the name
    ReplicatedStorage:SetAttribute("RoundMap", currentMapName)
    local template = ServerStorage.Maps:FindFirstChild(currentMapName)
    if template then
        template:Clone().Parent = folder
    else
        warn("[ColdCase] missing map " .. currentMapName)
    end
    LightingMood.Apply(currentMapName)
    votes = {}
    broadcastTally()
end

-- Kept separate from building because it needs the final participant list:
-- NPCs are spawned and absent players dropped after the map is already up.
function RoundService:PlaceParticipants()
    local folder = workspace:FindFirstChild("Round")
    if not folder then
        return
    end

    local spawns = {}
    for _, part in folder:GetDescendants() do
        if part:IsA("BasePart") and part:HasTag("SpawnPoint") then
            table.insert(spawns, part)
        end
    end
    Shuffle.Shuffle(spawns)

    -- Spawn with a minimum pairwise separation, or someone dies before they
    -- have moved. When no spawn clears the minimum, take the one farthest
    -- from everyone already placed rather than leaving a player in the lobby.
    -- More participants than pads would otherwise leave people standing in the
    -- lobby while the round runs without them: at a full server that stranded
    -- five of twelve, the human among them. Refill from the same pads instead.
    local allSpawns = table.clone(spawns)
    local used = {}
    for _, plr in participants do
        local char = plr.Character
        if not char then
            continue
        end
        if #spawns == 0 then
            spawns = table.clone(allSpawns)
            used = {}
        end
        local bestIndex, bestGap = 1, -1
        for i, s in spawns do
            local gap = math.huge
            for _, u in used do
                gap = math.min(gap, (s.Position - u).Magnitude)
            end
            if gap >= Config.SPAWN_MIN_SEP then
                bestIndex = i
                break
            elseif gap > bestGap then
                bestIndex, bestGap = i, gap
            end
        end
        local s = table.remove(spawns, bestIndex)
        char:PivotTo(s.CFrame + Vector3.new(0, 3, 0))
        table.insert(used, s.Position)
    end
end

function RoundService:SetMovementLocked(locked: boolean)
    for _, plr in participants do
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = locked and 0 or Config.WALKSPEED
            hum.JumpHeight = locked and 0 or 7.2
            hum.JumpPower = locked and 0 or 50
        end
    end
end

local function watchDeath(self, plr: Player)
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        table.insert(
            diedConnections,
            hum.Died:Connect(function()
                self:MarkDead(plr, nil, "reset")
            end)
        )
    end
end

-- Every death funnels through here, whatever caused it
function RoundService:MarkDead(plr: Player, killer: Player?, method: string)
    if not alive[plr] then
        return
    end
    alive[plr] = nil
    local killerRole = method
    if method == "misfire" then
        killerRole = "self"
    elseif killer then
        killerRole = RoleService:Get(killer) or method
    end
    local pos = plr.Character and plr.Character:GetPivot().Position or Vector3.zero
    local elapsed = os.clock() - activeStart
    if not Participant.IsBot(plr) then
        Analytics.PlayerDeath(
            plr,
            RoleService:Get(plr) or "unknown",
            killerRole,
            elapsed,
            currentMapName,
            pos
        )
    end
    if killer then
        table.insert(
            timeline,
            { at = elapsed, killer = killer.Name, victim = plr.Name, method = method, pos = pos }
        )
    end
    AbilityService:StopDrag(plr)
    DataService:SetScreen(plr, "SPECTATING")
    broadcastAlive()
    if state == "ACTIVE" then
        local names = aliveNames()
        SpectatorService:Broadcast(names)
        if method ~= "left" then
            SpectatorService:Enter(plr, names)
        end
        BotService:OnDeath(plr, killer, method, pos)
    end
    WhodunnitService:Recheck() -- a death drops stale votes / can tip a conviction
    AssassinService:OnDeath(plr) -- FFA: rehunt anyone who was hunting the fallen
    self:CheckWinConditions(method)
end

-- A medic brought them back. Their role is unchanged. A person or an NPC:
-- the caller has already given them a body (LoadCharacter, or
-- BotService:Respawn), so this only marks them alive and, for an NPC, sets
-- it thinking again.
function RoundService:Revive(plr: Player): boolean
    if state ~= "ACTIVE" or alive[plr] or not self:IsParticipant(plr) or not plr.Character then
        return false
    end
    alive[plr] = true
    watchDeath(self, plr)
    table.insert(timeline, { at = os.clock() - activeStart, victim = plr.Name, method = "revived" })
    DataService:SetScreen(plr, "ACTIVE")
    broadcastAlive()
    SpectatorService:Exit(plr)
    SpectatorService:Broadcast(aliveNames())
    RoleService:Arm(plr) -- LoadCharacter took their weapon
    if Participant.IsBot(plr) then
        BotService:Wake(plr) -- its old mind stopped with its old body
    end
    return true
end

local function murdererNames(): { string }
    local names = {}
    for plr in alive do
        if RoleService:Get(plr) == "murderer" then
            table.insert(names, plr.Name)
        end
    end
    return names
end

-- Everything below runs in one coroutine, and an uncaught error inside it
-- would end that coroutine for good: the round loop simply stops and the
-- server sits in whatever state it was in until it shuts down, for everyone
-- on it. Nothing else watches the loop, so a bad tick has to be survivable
-- here. The error is logged with a traceback rather than swallowed, and the
-- round is dropped back to the lobby so the next cycle starts from a known
-- state instead of half a round.
local function recover(self, err: string)
    warn("[ColdCase] round loop error, returning to the lobby:\n" .. tostring(err))
    -- ReturnToLobby must not be able to kill the loop either
    local ok, cleanupErr = pcall(function()
        self:ReturnToLobby()
    end)
    if not ok then
        warn("[ColdCase] cleanup after that error also failed:\n" .. tostring(cleanupErr))
    end
    for _, c in diedConnections do
        c:Disconnect()
    end
    diedConnections = {}
    alive = {}
    pendingBots = 0
    self:EnterLobby()
end

function RoundService:Start()
    task.spawn(function()
        while true do
            task.wait(Config.SIGHTLINE_SAMPLE)
            local ok, err = xpcall(function()
                self:Tick()
            end, debug.traceback)
            if not ok then
                recover(self, err)
            end
        end
    end)
end

-- One tick of the round loop. Split out so Start's coroutine has something it
-- can wrap: the per-tick work matters as much as the transition, since an
-- event, a snitch reveal or a sightline sample erroring would kill the loop
-- just as dead as Advance would.
function RoundService:Tick()
    if state == "INTERMISSION" then
        self:ArmLobby()
    end
    if os.clock() < stateEnds then
        if state == "ACTIVE" then
            local left = stateEnds - os.clock()
            if not eventFired and roundLength - left >= roundLength * Config.EVENT_AT_PCT then
                eventFired = true
                EventService:FireWeighted(mapIsIndoor)
            end
            if not snitchRevealed and left <= Config.SNITCH_REVEAL_AT then
                snitchRevealed = true
                RoleService:RevealSnitch()
                SnitchService:OnReveal()
            end
            -- Last Call: coins double and the murderer is outlined for
            -- everyone. Forces an ending instead of a hide-out.
            if not lastCallFired and left <= Config.LAST_CALL_AT then
                lastCallFired = true
                EconomyService:SetLastCall(true)
                Remotes.EventFired:FireAllClients("LAST_CALL", math.ceil(left), murdererNames())
            end
            -- Witness clues need real observation time, not a facing check
            EvidenceService:SampleSightlines(aliveList(), os.clock())
        end
        -- The state has not run out yet, so there is nothing to advance
        return
    end
    self:Advance()
end

function RoundService:Advance()
    if state == "INTERMISSION" then
        -- A quiet server fills the round with NPCs around whoever is playing;
        -- players who chose to wait stay in the lobby for real players
        local plan, humans, playing = lobbyPlan()
        if not plan.start then
            self:EnterLobby() -- someone changed their mind at the last second
            return
        end
        participants = if plan.full then humans else playing
        pendingBots = plan.npcs
        lobbyArmed = false
        -- Clone the map now, so the LOADING window covers its replication
        self:BuildVotedMap()
        setState("LOADING", Config.LOADING_TIME)
    elseif state == "LOADING" then
        local wanted = pendingBots
        local joined = 0
        for _, bot in BotService:Spawn(wanted) do
            table.insert(participants, bot)
            joined += 1
        end
        pendingBots = 0
        -- Never drop someone into a round alone: if the NPCs could not be
        -- built, go back to the lobby and try again next intermission
        if wanted > 0 and #participants < minPlayers() then
            warn(
                ("[ColdCase] only %d of %d players and NPCs ready"):format(
                    #participants,
                    minPlayers()
                )
            )
            BotService:Clear()
            participants = {}
            -- The map is already standing by the time we get here, so take it
            -- back down instead of leaving it in view behind the lobby.
            local built = workspace:FindFirstChild("Round")
            if built then
                built:Destroy()
            end
            Remotes.Notify:FireAllClients("The NPCs could not join. Trying again next round.")
            self:EnterLobby()
            return
        end
        if joined > 0 then
            Remotes.Notify:FireAllClients(("%d NPCs joined this round."):format(joined))
        end
        self:PlaceParticipants()
        local present = {}
        for _, plr in participants do
            if plr.Parent == Players and plr.Character then
                table.insert(present, plr)
            end
        end
        participants = present
        self:SetMovementLocked(true)
        -- Pick the mode before roles are dealt, so RoleService can read it.
        currentMode = pickMode()
        ReplicatedStorage:SetAttribute("Mode", currentMode)
        broadcastModeTally() -- pickMode spent the votes; clear the lobby's counts
        RoleService:Assign(participants)

        alive = {}
        for _, plr in participants do
            alive[plr] = true
            watchDeath(self, plr)
        end
        broadcastAlive()
        setState("REVEAL", Config.REVEAL_TIME)
    elseif state == "REVEAL" then
        eventFired, snitchRevealed, lastCallFired = false, false, false
        self.clueCounts = {}
        timeline = {}
        EventService:TakeRoundEvent()
        EvidenceService:ResetSightlines()
        AbilityService:Reset()
        EconomyService:SetLastCall(false)
        roundLength = lengthFor(#participants)
        self:SetMovementLocked(false)
        CombatService:MarkRoundStart()
        CoinService:Arm(workspace.Round)
        activeStart = os.clock()
        OnboardingService:NoteRoundStart(participants)
        setState("ACTIVE", roundLength)
        BotService:StartRound()
        SnitchService:OnRoundStart()
        WhodunnitService:Reset()
        AssassinService:OnRoundStart()
        -- Mode effects. Hardcore dims the whole round (so it never fires a
        -- random event) and announces itself; the client reads the Mode
        -- attribute for reduced vision.
        local modeDef = Modes.Get(currentMode)
        if modeDef.dark then
            eventFired = true
            EventService:SetModeDark(true)
        end
        if currentMode ~= "classic" then
            Remotes.Notify:FireAllClients(("%s — %s"):format(modeDef.name, modeDef.blurb))
        end
    elseif state == "ACTIVE" then
        -- Time out: innocents survived, or in the free-for-all whoever is left.
        self:Resolve(Modes.Get(currentMode).ffa and "assassin" or "innocents", "time")
    elseif state == "RESOLUTION" then
        self:ReturnToLobby()
        self:EnterLobby()
    end
end

-- Called after every elimination. `method` is how the last one went out, so a
-- murderer who disconnects is not reported to the room as one who was killed.
function RoundService:CheckWinConditions(method: string?)
    if state ~= "ACTIVE" then
        return
    end
    -- Assassin free-for-all: the last blade standing wins.
    if Modes.Get(currentMode).ffa then
        local living = 0
        for _ in alive do
            living += 1
        end
        if living <= 1 then
            self:Resolve("assassin", "lastStanding")
        end
        return
    end
    local murdererAlive, othersAlive = false, 0
    for plr in alive do
        if RoleService:Get(plr) == "murderer" then
            murdererAlive = true
        else
            othersAlive += 1
        end
    end
    if not murdererAlive then
        self:Resolve("innocents", method == "left" and "left" or "killed")
    elseif othersAlive == 0 then
        self:Resolve("murderer", "wiped")
    end
end

function RoundService:Resolve(winner: string, reason: string)
    if state ~= "ACTIVE" then
        return
    end
    state = "RESOLVING" -- blocks re-entry while payouts run
    AbilityService:Reset()
    local survivors = table.clone(alive)
    EconomyService:PayOut(participants, winner, survivors, self.clueCounts)
    EconomyService:SetLastCall(false)
    Remotes.RoundOver:FireAllClients(winner, reason, RoleService:GetPublicReveal(), timeline)

    for _, plr in participants do
        if plr.Parent == Players and not Participant.IsBot(plr) then
            Analytics.RoundComplete(
                plr,
                currentMapName,
                winner,
                os.clock() - activeStart,
                #participants,
                EventService:TakeRoundEvent()
            )
            break
        end
    end
    OnboardingService:NoteRoundEnd(participants)

    for _, c in diedConnections do
        c:Disconnect()
    end
    diedConnections = {}
    alive = {}
    SpectatorService:Reset()
    CoinService:Disarm()
    EventService:Clear()
    ReplicatedStorage:SetAttribute("Mode", "classic") -- lobby is never a special mode
    setState("RESOLUTION", Config.RESOLUTION_TIME)
end

function RoundService:ReturnToLobby()
    EvidenceService:Clear()
    RoleService:Clear()
    SnitchService:Clear()
    LightingMood.Apply("Lobby")
    local round = workspace:FindFirstChild("Round")
    if round then
        round:Destroy()
    end
    for _, plr in participants do
        if plr.Parent == Players and not Participant.IsBot(plr) then
            task.spawn(plr.LoadCharacter, plr)
        end
    end
    BotService:Clear()
    participants = {}
end

Players.PlayerRemoving:Connect(function(plr)
    if votes[plr] then
        votes[plr] = nil
        broadcastTally()
    end
    if modeVotes[plr] then
        modeVotes[plr] = nil
        broadcastModeTally()
    end
    RoundService.clueCounts[plr] = nil
    if alive[plr] then
        RoundService:MarkDead(plr, nil, "left")
    end
end)

ReplicatedStorage:SetAttribute("RoundState", state)
ReplicatedStorage:SetAttribute("RoundEnds", 0)

-- These services need round state but RoundService requires them, so it
-- hands itself over instead of being required back (a require cycle).
CombatService:BindRound(RoundService)
EvidenceService:BindRound(RoundService)
CoinService:BindRound(RoundService)
AbilityService:BindRound(RoundService)
BotService:BindRound(RoundService)
SnitchService:BindRound(RoundService)
WhodunnitService:BindRound(RoundService)
AssassinService:BindRound(RoundService)

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[-- Direct coin purchases and knife-effect re-rolls (Design Bible · Sinks).
-- Prices come from Shared/Shop so the client shows exactly what is charged.
local Shared = game.ReplicatedStorage.Shared
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Shop = require(Shared.Shop)
local Remotes = game.ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local Analytics = require(script.Parent.Analytics)

local ShopService = {}

local function reply(plr: Player, ok: boolean, message: string)
    Remotes.ShopResult:FireClient(plr, ok, message)
end

function ShopService:Buy(plr: Player, id: string)
    if not table.find(Shop.SHELF, id) then
        return
    end
    local data = DataService:Get(plr)
    local price = Shop.PriceOf(id)
    if not (data and price) then
        return
    end
    if data.coins < price then
        reply(plr, false, ("You are %d coins short."):format(price - data.coins))
        return
    end

    local entry = EconomyService:GiveItem(data, id)
    if not entry then
        return
    end
    data.coins -= price
    Analytics.CoinsSpent(plr, "shop", price, data.coins)
    reply(plr, true, ("%s added to your collection."):format(Catalog[id].name))
    Remotes.DataChanged:FireClient(plr, { coins = data.coins, inventory = data.inventory })
end

-- Re-roll the cosmetic effect on an owned knife. Always lands on a
-- different effect, so the coins are never spent on nothing.
function ShopService:RerollEffect(plr: Player, uid: string)
    local data = DataService:Get(plr)
    if not data then
        return
    end
    -- A random outcome bought with coins counts as a paid random item
    if not require(script.Parent.PlayerPolicy):CanUsePaidRandomItems(plr) then
        reply(plr, false, "Effect re-rolls aren't available in your region.")
        return
    end
    local target
    for _, item in data.inventory do
        if item.uid == uid then
            target = item
            break
        end
    end
    local def = target and Catalog[target.id]
    if not def or def.kind ~= "Knife" then
        return
    end
    if data.coins < Config.REROLL_COST then
        reply(plr, false, ("You are %d coins short."):format(Config.REROLL_COST - data.coins))
        return
    end

    local options = {}
    for _, effect in Shop.EFFECTS do
        if effect ~= (target.effect or "none") then
            table.insert(options, effect)
        end
    end
    target.effect = options[math.random(#options)]
    data.coins -= Config.REROLL_COST
    Analytics.CoinsSpent(plr, "reroll", Config.REROLL_COST, data.coins)
    reply(plr, true, ("%s effect: %s"):format(def.name, target.effect))
    Remotes.DataChanged:FireClient(plr, { coins = data.coins, inventory = data.inventory })
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">SnitchService</string>
          <string name="Source"><![CDATA[-- The snitch's investigation. Reading a body builds a private suspect board
-- from its clues, and once the snitch has read enough bodies (or the 30s reveal
-- fires) they may EXPOSE the real killer to everyone - once.
-- Handbook rule: the snitch trades identity, not advantage. Expose names the
-- server's true killer (never a guess) and does NOT end the round; the sheriff
-- still has to stop them, and the murderer already knows the snitch by then.
local Players = game:GetService("Players")
local Shared = game.ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Remotes = game.ReplicatedStorage.Remotes
local RoleService = require(script.Parent.RoleService)
local EvidenceService = require(script.Parent.EvidenceService)
local Participant = require(script.Parent.Participant)

local SnitchService = {}
local round: any = nil

-- [snitch] = { fibres={[band]=true}, prefixes={[prefix]=true}, examined=n,
--             revealed=bool, used=bool }
local state: { [any]: any } = {}

function SnitchService:BindRound(roundService)
    round = roundService
end

local function ev(snitch)
    local e = state[snitch]
    if not e then
        e = { fibres = {}, prefixes = {}, examined = 0, revealed = false, used = false }
        state[snitch] = e
    end
    return e
end

local function alive(p): boolean
    return round == nil or round:IsAlive(p)
end

-- Score one living suspect against what the snitch has gathered. A fibre band
-- clears or keeps a suspect; a name fragment pins them.
local function score(e, name: string, band: string): (number, string)
    local haveFibre = next(e.fibres) ~= nil
    local fibreMatch = e.fibres[band] == true
    local prefixMatch = false
    for pre in e.prefixes do
        if name:sub(1, #pre):lower() == pre:lower() then
            prefixMatch = true
            break
        end
    end
    if haveFibre and not fibreMatch then
        return 0, "cleared"
    end
    if prefixMatch then
        return (fibreMatch and 4 or 3), (fibreMatch and "near-certain" or "likely")
    end
    if fibreMatch then
        return 2, "person of interest"
    end
    return 1, "unknown"
end

function SnitchService:BuildBoard(snitch): { any }
    local e = ev(snitch)
    local rows = {}
    for _, p in RoleService:Participants() do
        if p ~= snitch and alive(p) then
            local band = EvidenceService:ColourBandOf(p)
            local bar, label = score(e, p.Name, band)
            table.insert(rows, { name = p.Name, bar = bar, label = label })
        end
    end
    table.sort(rows, function(a, b)
        if a.bar ~= b.bar then
            return a.bar > b.bar
        end
        return a.name < b.name
    end)
    return rows
end

local function canExpose(e): boolean
    return not e.used and (e.revealed or e.examined >= Config.SNITCH_EXPOSE_CLUES)
end

function SnitchService:Push(snitch)
    if Participant.IsBot(snitch) then
        return -- an NPC snitch has no client to send a board to
    end
    local e = ev(snitch)
    Remotes.Deduction:FireClient(snitch, {
        suspects = self:BuildBoard(snitch),
        canExpose = canExpose(e),
        used = e.used,
    })
end

-- EvidenceService calls this when a snitch reads a body.
function SnitchService:AddClue(snitch, clue)
    local e = ev(snitch)
    e.examined += 1
    if clue.fibre then
        e.fibres[clue.fibre] = true
    end
    if clue.prefix then
        e.prefixes[clue.prefix] = true
    end
    self:Push(snitch)
end

-- Round has begun: show the snitch the live suspect list at once (all unknown
-- until they read a body), so the panel and its gated button are correct from
-- the start rather than blank until the first clue.
function SnitchService:OnRoundStart()
    for _, p in RoleService:Participants() do
        if RoleService:Get(p) == "snitch" then
            self:Push(p)
        end
    end
end

-- The 30s mutual reveal has fired: every human snitch may now Expose.
function SnitchService:OnReveal()
    for _, p in RoleService:Participants() do
        if RoleService:Get(p) == "snitch" then
            ev(p).revealed = true
            self:Push(p)
        end
    end
end

function SnitchService:RequestExpose(plr: Player)
    if RoleService:Get(plr) ~= "snitch" or not alive(plr) then
        return
    end
    local e = ev(plr)
    if not canExpose(e) then
        Remotes.Notify:FireClient(plr, "You do not have enough on the killer yet.")
        return
    end
    local murderers = RoleService:Murderers()
    if #murderers == 0 then
        return
    end
    e.used = true
    local names = {}
    for _, m in murderers do
        table.insert(names, m.Name)
    end
    -- Everyone hears it and sees the killer light up; the round runs on.
    Remotes.Expose:FireAllClients(names, Config.SNITCH_EXPOSE_HIGHLIGHT)
    self:Push(plr)
end

function SnitchService:Clear()
    state = {}
end

Players.PlayerRemoving:Connect(function(plr)
    state[plr] = nil
end)

return SnitchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">SocialService</string>
          <string name="Source"><![CDATA[--!strict
-- The Radio and Emote passes, and player reports.
-- Handbook rule: sell identity, not advantage. Radio is refused to the dead
-- during a round — a spectator feeding the living breaks deduction.
local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")
local TextService = game:GetService("TextService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Remotes = game.ReplicatedStorage.Remotes
local MonetizationService = require(script.Parent.MonetizationService)
local RoundService = require(script.Parent.RoundService)
local Analytics = require(script.Parent.Analytics)

local SocialService = {}
local lastRadio: { [Player]: number } = {}
local lastEmote: { [Player]: number } = {}
local reportedBy: { [Player]: { [number]: boolean } } = {}
local reportCount: { [number]: number } = {} -- UserId -> reports this server

local function cooled(last: { [Player]: number }, plr: Player, cooldown: number): boolean
    local now = os.clock()
    if now - (last[plr] or 0) < cooldown then
        return false
    end
    last[plr] = now
    return true
end

local function mayTransmit(plr: Player): boolean
    return RoundService:GetState() ~= "ACTIVE" or RoundService:IsAlive(plr)
end

function SocialService:Radio(plr: Player, message: string)
    if not MonetizationService:HasPass(plr, "radio") or not mayTransmit(plr) then
        return
    end
    local text = string.match(message, "^%s*(.-)%s*$") or ""
    local length = utf8.len(text)
    if not length or length == 0 or length > Config.RADIO_MAX_CHARS then
        return
    end
    if not cooled(lastRadio, plr, Config.RADIO_COOLDOWN) then
        return
    end

    -- Players whose account settings disable chat do not get to broadcast
    local okChat, canChat = pcall(TextChatService.CanUserChatAsync, TextChatService, plr.UserId)
    if okChat and canChat == false then
        return
    end
    local ok, filtered = pcall(function()
        local result =
            TextService:FilterStringAsync(text, plr.UserId, Enum.TextFilterContext.PublicChat)
        return result:GetNonChatStringForBroadcastAsync()
    end)
    -- The filter yields: the sender may have left or died in the meantime
    if not ok or type(filtered) ~= "string" or filtered == "" then
        return
    end
    if plr.Parent ~= Players or not mayTransmit(plr) then
        return
    end
    Remotes.RadioMessage:FireAllClients(plr.DisplayName, filtered)
end

function SocialService:Emote(plr: Player, emoteId: string)
    if not MonetizationService:HasPass(plr, "emotes") or not table.find(Config.EMOTES, emoteId) then
        return
    end
    local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or not cooled(lastEmote, plr, Config.EMOTE_COOLDOWN) then
        return
    end
    Remotes.EmotePlayed:FireAllClients(plr, emoteId)
end

-- Roblox's own report flow does the moderation; this feeds the dashboard.
-- One report per reporter per player per session.
function SocialService:Report(plr: Player, target: Player, reason: string)
    if
        target == plr
        or target.Parent ~= Players
        or not table.find(Config.REPORT_REASONS, reason)
    then
        return
    end
    local mine = reportedBy[plr]
    if not mine then
        mine = {}
        reportedBy[plr] = mine
    end
    if mine[target.UserId] then
        Remotes.Notify:FireClient(plr, ("You already reported %s."):format(target.DisplayName))
        return
    end
    mine[target.UserId] = true
    reportCount[target.UserId] = (reportCount[target.UserId] or 0) + 1
    Analytics.PlayerReport(plr, reason, reportCount[target.UserId])
    Remotes.Notify:FireClient(plr, ("Reported %s. Thank you."):format(target.DisplayName))
end

Players.PlayerRemoving:Connect(function(plr)
    lastRadio[plr], lastEmote[plr], reportedBy[plr] = nil, nil, nil
end)

return SocialService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">SpectatorService</string>
          <string name="Source"><![CDATA[--!strict
-- Dead participants follow the living. Two minutes staring at your own body
-- is the biggest quit risk in a round game. The client owns the camera; the
-- server only says who is left to watch. Who is alive is public already (the
-- HUD shows the count and bodies drop in view), so the list gives nothing away.
local Players = game:GetService("Players")
local Remotes = game.ReplicatedStorage.Remotes
local Participant = require(script.Parent.Participant)

local SpectatorService = {}
local watching: { [Player]: boolean } = {}

function SpectatorService:Enter(plr: Player, targets: { string })
    if Participant.IsBot(plr) or plr.Parent ~= Players then
        return
    end
    watching[plr] = true
    Remotes.Spectate:FireClient(plr, "enter", targets)
end

function SpectatorService:Exit(plr: Player)
    if not watching[plr] then
        return
    end
    watching[plr] = nil
    Remotes.Spectate:FireClient(plr, "exit")
end

-- Keep every spectator's list current as people die and are revived
function SpectatorService:Broadcast(targets: { string })
    for plr in watching do
        Remotes.Spectate:FireClient(plr, "targets", targets)
    end
end

function SpectatorService:Send(plr: Player, targets: { string })
    if watching[plr] then
        Remotes.Spectate:FireClient(plr, "targets", targets)
    end
end

function SpectatorService:Reset()
    for plr in watching do
        if plr.Parent == Players then
            Remotes.Spectate:FireClient(plr, "exit")
        end
    end
    watching = {}
end

Players.PlayerRemoving:Connect(function(plr)
    watching[plr] = nil
end)

return SpectatorService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">TradeService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local Config = require(game.ReplicatedStorage.Shared.Config)
local Shop = require(game.ReplicatedStorage.Shared.Shop)
local LiveOps = require(game.ReplicatedStorage.Shared.LiveOps)
local Remotes = game.ReplicatedStorage.Remotes
local DataService = require(script.Parent.DataService)
local CosmeticService = require(script.Parent.CosmeticService)
local Analytics = require(script.Parent.Analytics)
local LiveOpsClock = require(script.Parent.LiveOpsClock)

local TradeService = {}
local sessions = {} -- [id] = session
local sessionOf = {} -- [Player] = id
local invites = {} -- [Player] = Player they asked to trade with
local MAX_OFFER = Config.MAX_TRADE_OFFER

-- What each side has on the table, resolved to catalog ids for display
local function describe(owner: Player, uids: { string })
    local out = {}
    local data = DataService:Get(owner)
    if not data then
        return out
    end
    for _, uid in uids do
        for _, item in data.inventory do
            if item.uid == uid then
                table.insert(out, { uid = uid, id = item.id, effect = item.effect })
                break
            end
        end
    end
    return out
end

-- TradeUpdate(id, mine, theirs, myLock, theirLock, myConfirm, theirConfirm, partner)
local function push(s)
    local a, b = describe(s.a, s.offerA), describe(s.b, s.offerB)
    Remotes.TradeUpdate:FireClient(s.a, s.id, a, b, s.lockA, s.lockB, s.confirmA, s.confirmB, s.b)
    Remotes.TradeUpdate:FireClient(s.b, s.id, b, a, s.lockB, s.lockA, s.confirmB, s.confirmA, s.a)
end

-- Any change to the table resets both locks and both confirms. Non-negotiable.
local function invalidate(s)
    s.lockA, s.lockB, s.confirmA, s.confirmB = false, false, false, false
    push(s)
end

function TradeService:Open(a: Player, b: Player)
    if sessionOf[a] or sessionOf[b] then
        return
    end
    local id = HttpService:GenerateGUID(false)
    local s = {
        id = id,
        a = a,
        b = b,
        offerA = {},
        offerB = {},
        lockA = false,
        lockB = false,
        confirmA = false,
        confirmB = false,
    }
    sessions[id] = s
    sessionOf[a], sessionOf[b] = id, id
    invites[a], invites[b] = nil, nil
    push(s)
end

-- Close whatever session a player is in, if any (a trade-table seat emptied).
function TradeService:CloseFor(plr: Player)
    local id = sessionOf[plr]
    local s = id and sessions[id]
    if s then
        self:Close(s)
    end
end

-- Two players sat down across a lobby trade table: the seating is the mutual
-- consent an invite needs, so open directly after the same gating an invite runs.
function TradeService:OpenAtTable(a: Player, b: Player)
    if a == b or sessionOf[a] or sessionOf[b] then
        return
    end
    if not LiveOps.IsTradingOpen(LiveOpsClock.Day()) then
        return
    end
    local PlayerPolicy = require(script.Parent.PlayerPolicy)
    if not (PlayerPolicy:CanTradePaidItems(a) and PlayerPolicy:CanTradePaidItems(b)) then
        return
    end
    if not (DataService:Get(a) and DataService:Get(b)) then
        return
    end
    self:Open(a, b)
end

-- Both players must ask for each other before a table opens
function TradeService:Invite(from: Player, to: Player)
    if to == from or to.Parent ~= Players then
        return
    end
    if not LiveOps.IsTradingOpen(LiveOpsClock.Day()) then
        return
    end
    -- Paid item trading is not allowed in some regions (PolicyService)
    local PlayerPolicy = require(script.Parent.PlayerPolicy)
    if not PlayerPolicy:CanTradePaidItems(from) then
        Remotes.Notify:FireClient(from, "Trading isn't available in your region.")
        return
    end
    if not PlayerPolicy:CanTradePaidItems(to) then
        Remotes.Notify:FireClient(from, ("%s can't trade."):format(to.DisplayName))
        return
    end
    if not (DataService:Get(from) and DataService:Get(to)) then
        return
    end
    if invites[to] == from then
        self:Open(from, to)
    else
        invites[from] = to
        Remotes.Notify:FireClient(
            to,
            ("%s wants to trade — press TRADE by their name"):format(from.DisplayName)
        )
    end
end

function TradeService:SetOffer(plr: Player, uids: any)
    local s = sessions[sessionOf[plr]]
    if not s or type(uids) ~= "table" or #uids > MAX_OFFER then
        return
    end
    local data = DataService:Get(plr)
    if not data then
        return
    end

    -- Verify every uid is a unique string actually owned RIGHT NOW
    local seen, clean = {}, {}
    for _, uid in uids do
        if type(uid) ~= "string" or seen[uid] then
            return
        end
        seen[uid] = true
        local owned = false
        for _, item in data.inventory do
            if item.uid == uid then
                owned = true
                break
            end
        end
        if not owned then
            return
        end
        table.insert(clean, uid)
    end

    if plr == s.a then
        s.offerA = clean
    else
        s.offerB = clean
    end
    invalidate(s)
end

function TradeService:Lock(plr: Player)
    local s = sessions[sessionOf[plr]]
    if not s then
        return
    end
    if plr == s.a then
        s.lockA = true
    else
        s.lockB = true
    end
    push(s)
end

-- Unlocking is a change to the table, so it resets both sides
function TradeService:Unlock(plr: Player)
    local s = sessions[sessionOf[plr]]
    if s then
        invalidate(s)
    end
end

function TradeService:Confirm(plr: Player)
    local s = sessions[sessionOf[plr]]
    if not s or not (s.lockA and s.lockB) then
        return
    end
    if plr == s.a then
        s.confirmA = true
    else
        s.confirmB = true
    end
    if s.confirmA and s.confirmB then
        self:Execute(s)
    else
        push(s)
    end
end

function TradeService:Execute(s)
    local da, db = DataService:Get(s.a), DataService:Get(s.b)
    if not (da and db) then
        return
    end

    -- Re-verify ownership at the moment of transfer, in the same synchronous
    -- block as the removal. Nothing in here may yield.
    local function pull(data, uids)
        local out = {}
        for _, uid in uids do
            for i, item in data.inventory do
                if item.uid == uid then
                    table.insert(out, table.remove(data.inventory, i))
                    break
                end
            end
        end
        return out
    end

    local fromA, fromB = pull(da, s.offerA), pull(db, s.offerB)
    if #fromA ~= #s.offerA or #fromB ~= #s.offerB then
        -- Something moved mid-trade. Put it all back and abort; nothing is lost.
        for _, it in fromA do
            table.insert(da.inventory, it)
        end
        for _, it in fromB do
            table.insert(db.inventory, it)
        end
        invalidate(s)
        return
    end

    for _, it in fromA do
        table.insert(db.inventory, it)
    end
    for _, it in fromB do
        table.insert(da.inventory, it)
    end

    Analytics.TradeComplete(s.a, Shop.ValueOf(fromA), Shop.ValueOf(fromB))
    CosmeticService:Reconcile(s.a)
    CosmeticService:Reconcile(s.b)
    Remotes.TradeComplete:FireClient(s.a)
    Remotes.TradeComplete:FireClient(s.b)
    DataService:PushToClient(s.a)
    DataService:PushToClient(s.b)
    self:Close(s)
end

function TradeService:Close(s)
    sessionOf[s.a], sessionOf[s.b] = nil, nil
    sessions[s.id] = nil
    for _, plr in { s.a, s.b } do
        if plr.Parent == Players then
            Remotes.TradeUpdate:FireClient(plr, s.id, nil)
        end
    end
end

function TradeService:Handle(plr: Player, action: any, payload: any)
    if action == "open" then
        if typeof(payload) == "Instance" and payload:IsA("Player") then
            self:Invite(plr, payload)
        end
    elseif action == "offer" then
        self:SetOffer(plr, payload)
    elseif action == "lock" then
        self:Lock(plr)
    elseif action == "unlock" then
        self:Unlock(plr)
    elseif action == "confirm" then
        self:Confirm(plr)
    elseif action == "cancel" then
        local s = sessions[sessionOf[plr]]
        if s then
            self:Close(s)
        end
    end
end

Players.PlayerRemoving:Connect(function(plr)
    invites[plr] = nil
    local s = sessions[sessionOf[plr]]
    if s then
        TradeService:Close(s)
    end
end)

return TradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">TradeTableService</string>
          <string name="Source"><![CDATA[-- Lobby trade tables: when two players are seated across the same table, open a
-- trade between them; when a chair empties, close it. The existing TradeService
-- owns everything after that (offers, locks, confirms, the value/fairness UI).
-- Sitting together is the mutual consent an invite would otherwise require.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TradeService = require(script.Parent.TradeService)
local LiveOps = require(ReplicatedStorage.Shared.LiveOps)
local Remotes = ReplicatedStorage.Remotes

local TradeTableService = {}
local seated: { [Model]: { Player } } = {} -- the pair a table last opened

local function tradingOpen(): boolean
    return ReplicatedStorage:GetAttribute("TradingOpen") == true
end

local function playerOf(seat: Seat): Player?
    local occupant = seat.Occupant
    local char = occupant and occupant.Parent
    return char and Players:GetPlayerFromCharacter(char) or nil
end

local function chairsOf(model: Model): { Seat }
    local out = {}
    for _, d in model:GetDescendants() do
        if d:IsA("Seat") then
            table.insert(out, d)
        end
    end
    return out
end

local function evaluate(model: Model)
    local chairs = chairsOf(model)
    if #chairs < 2 then
        return
    end
    local a, b = playerOf(chairs[1]), playerOf(chairs[2])
    if a and b and a ~= b then
        TradeService:OpenAtTable(a, b)
        seated[model] = { a, b }
    else
        -- a chair emptied: end whatever trade this table had going
        local prev = seated[model]
        if prev then
            for _, plr in prev do
                if plr.Parent == Players then
                    TradeService:CloseFor(plr)
                end
            end
            seated[model] = nil
        end
    end
end

-- Seat a player at a free chair of this table when they trigger the prompt.
-- Sitting is still the mutual consent: two players in the two chairs open the
-- trade (evaluate). Before the Day-28 unlock, say so instead of a dead press.
local function sitAt(model: Model, plr: Player)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then
        return
    end
    if not tradingOpen() then
        local day = ReplicatedStorage:GetAttribute("TradingOpensDay") or LiveOps.TRADING_UNLOCK_DAY
        Remotes.Notify:FireClient(plr, ("Trading unlocks on Day %d."):format(day))
        return
    end
    for _, seat in chairsOf(model) do
        if not seat.Occupant then
            seat:Sit(hum)
            return
        end
    end
    Remotes.Notify:FireClient(plr, "Both seats are taken.")
end

-- The table's floating sign reflects whether trading is open yet.
local function refreshSign(model: Model)
    local top = model.PrimaryPart or model:FindFirstChild("Top")
    local sign = top and top:FindFirstChild("Sign")
    local label = sign and sign:FindFirstChild("Label")
    if label and label:IsA("TextLabel") then
        if tradingOpen() then
            label.Text = "TRADE · SIT TO DEAL"
        else
            local day = ReplicatedStorage:GetAttribute("TradingOpensDay")
                or LiveOps.TRADING_UNLOCK_DAY
            label.Text = ("TRADE · OPENS DAY %d"):format(day)
        end
    end
end

local function watch(model: Model)
    for _, seat in chairsOf(model) do
        seat:GetPropertyChangedSignal("Occupant"):Connect(function()
            evaluate(model)
        end)
    end
    local top = model.PrimaryPart or model:FindFirstChild("Top")
    local prompt = top and top:FindFirstChild("TradePrompt")
    if prompt and prompt:IsA("ProximityPrompt") then
        prompt.Triggered:Connect(function(plr)
            sitAt(model, plr)
        end)
    end
    refreshSign(model)
end

for _, model in CollectionService:GetTagged("TradeTable") do
    watch(model)
end
CollectionService:GetInstanceAddedSignal("TradeTable"):Connect(watch)

-- Keep every sign current when the trading window opens or closes.
ReplicatedStorage:GetAttributeChangedSignal("TradingOpen"):Connect(function()
    for _, model in CollectionService:GetTagged("TradeTable") do
        refreshSign(model)
    end
end)

return TradeTableService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">WhodunnitService</string>
          <string name="Source"><![CDATA[-- Whodunnit: the town convicts the killer by accusation, not the gun. Each
-- living player may name one living suspect; when a suspect draws accusations
-- from a majority of the living human voters they are convicted. If they are the
-- murderer, the town wins; if not, the town has lynched one of its own and the
-- round plays on with a fresh slate.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Modes = require(ReplicatedStorage.Shared.Modes)
local Remotes = ReplicatedStorage.Remotes
local RoleService = require(script.Parent.RoleService)
local Participant = require(script.Parent.Participant)

local WhodunnitService = {}
local round: any = nil
local accusation: { [any]: any } = {} -- voter -> accused participant

function WhodunnitService:BindRound(roundService)
    round = roundService
end

local function active(): boolean
    return round ~= nil and Modes.Get(ReplicatedStorage:GetAttribute("Mode")).vote == true
end

-- Humans still alive who may cast a vote (bots do not accuse).
local function livingVoters(): number
    local n = 0
    for _, p in RoleService:Participants() do
        if not Participant.IsBot(p) and round:IsAlive(p) then
            n += 1
        end
    end
    return n
end

local function tally(): ({ [string]: number }, any, number)
    local counts = {}
    local top, topN = nil, 0
    for voter, accused in accusation do
        if round:IsAlive(voter) and round:IsAlive(accused) then
            local name = accused.Name
            counts[name] = (counts[name] or 0) + 1
            if counts[name] > topN then
                top, topN = accused, counts[name]
            end
        end
    end
    return counts, top, topN
end

-- The living suspects (players and bots) the town may vote on.
local function suspects(): { string }
    local out = {}
    for _, p in RoleService:Participants() do
        if round:IsAlive(p) then
            table.insert(out, p.Name)
        end
    end
    table.sort(out)
    return out
end

-- Push the board to every client: outside Whodunnit it clears theirs.
local function broadcast()
    if not active() then
        Remotes.AccuseTally:FireAllClients({ suspects = {}, counts = {} })
        return
    end
    Remotes.AccuseTally:FireAllClients({ suspects = suspects(), counts = (tally()) })
end

function WhodunnitService:Reset()
    accusation = {}
    broadcast()
end

function WhodunnitService:Convict(target)
    if RoleService:Get(target) == "murderer" then
        round:Resolve("innocents", "convicted")
    else
        Remotes.Notify:FireAllClients(("%s was convicted — and innocent."):format(target.Name))
        self:Reset()
        round:MarkDead(target, nil, "convicted")
    end
end

function WhodunnitService:Accuse(plr, targetName)
    if not active() or not round:IsAlive(plr) or type(targetName) ~= "string" then
        return
    end
    local target
    for _, p in RoleService:Participants() do
        if p.Name == targetName and p ~= plr and round:IsAlive(p) then
            target = p
            break
        end
    end
    if not target then
        return
    end
    accusation[plr] = target
    broadcast()
    local _, top, topN = tally()
    if top and topN > livingVoters() / 2 then
        self:Convict(top)
    end
end

-- Called when someone dies: drop stale votes, re-broadcast, and convict if a
-- death has tipped a suspect over the (now smaller) majority.
function WhodunnitService:Recheck()
    if not active() then
        return
    end
    broadcast()
    local _, top, topN = tally()
    if top and topN > livingVoters() / 2 then
        task.defer(function()
            self:Convict(top)
        end)
    end
end

return WhodunnitService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="64">
      <Properties>
        <string name="Name">Packages</string>
      </Properties>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source">--[[
MAD STUDIO (by loleris)

-[ProfileStore]---------------------------------------

	Periodic DataStore saving solution with session locking
	
	WARNINGS FOR "Profile.Data" VALUES:
	 	! Do not create numeric tables with gaps - attempting to store such tables will result in an error.
		! Do not create mixed tables (some values indexed by number and others by a string key)
			- only numerically indexed  data will be stored.
		! Do not index tables by anything other than numbers and strings.
		! Do not reference Roblox Instances
		! Do not reference userdata (Vector3, Color3, CFrame...) - Serialize userdata before referencing
		! Do not reference functions
		
	Members:
	
		ProfileStore.IsClosing          [bool]
			-- Set to true after a game:BindToClose() trigger
			
		ProfileStore.IsCriticalState    [bool]
			-- Set to true when ProfileStore experiences too many consecutive errors
		
		ProfileStore.OnError            [Signal] (message, store_name, profile_key)
			-- Most ProfileStore errors will be caught and passed to this signal
			
		ProfileStore.OnOverwrite        [Signal] (store_name, profile_key)
			-- Triggered when a DataStore key was likely used to store data that wasn't
			a ProfileStore profile or the ProfileStore structure was invalidly manually
			altered for that DataStore key
			
		ProfileStore.OnCriticalToggle   [Signal] (is_critical)
			-- Triggered when ProfileStore experiences too many consecutive errors
		
		ProfileStore.DataStoreState     [string] ("NotReady", "NoInternet", "NoAccess", "Access")
			-- This value resembles ProfileStore's access to the DataStore; The value starts
			as "NotReady" and will eventually change to one of the other 3 possible values.
	
	Functions:
	
		ProfileStore.New(store_name, template?) --&gt; [ProfileStore]
			store_name   [string] -- DataStore name
			template     [table] or nil -- Profiles will default to given table (hard-copy) when no data was saved previously
			
		ProfileStore.SetConstant(name, value)
			name    [string]
			value   [number]
				
	Members [ProfileStore]:
	
		ProfileStore.Mock   [ProfileStore]
			-- Reflection of ProfileStore methods, but the methods will now query a mock
			DataStore with no relation to the real DataStore
			
		ProfileStore.Name   [string]
		
	Methods [ProfileStore]:
	
		ProfileStore:StartSessionAsync(profile_key, params?) --&gt; [Profile] or nil
			profile_key [string] -- DataStore key
			params      nil or [table]: -- Custom params; E.g. {Steal = true}
				{
					Steal = true, -- Pass this to disregard an existing session lock
					Cancel = fn() -&gt; (boolean), -- Pass this to create a request cancel condition.
						-- If the cancel function returns true, ProfileStore will stop trying to
						-- start the session and return nil
				}
			
		ProfileStore:MessageAsync(profile_key, message) --&gt; is_success [bool]
			profile_key [string] -- DataStore key
			message     [table] -- Data to be messaged to the profile
			
		ProfileStore:GetAsync(profile_key, version?) --&gt; [Profile] or nil
			-- Reads a profile without starting a session - will not autosave
			profile_key   [string] -- DataStore key
			version       nil or [string] -- DataStore key version

		ProfileStore:VersionQuery(profile_key, sort_direction?, min_date?, max_date?) --&gt; [VersionQuery]
			profile_key      [string]
			sort_direction   nil or [Enum.SortDirection]
			min_date         nil or [DateTime]
			max_date         nil or [DateTime]
			
		ProfileStore:RemoveAsync(profile_key) --&gt; is_success [bool]
			-- Completely removes profile data from the DataStore / mock DataStore with no way to recover it.

	Methods [VersionQuery]:

		VersionQuery:NextAsync() --&gt; [Profile] or nil -- (Yields)
			-- Returned profile is similar to profiles returned by ProfileStore:GetAsync()
		
	Members [Profile]:
	
		Profile.Data               [table]
			-- When the profile is active changes to this table are guaranteed to be saved
		Profile.LastSavedData      [table] (Read-only)
			-- Last snapshot of "Profile.Data" that has been successfully saved to the DataStore;
			Useful for proper developer product purchase receipt handling
		
		Profile.FirstSessionTime   [number] (Read-only)
			-- os.time() timestamp of the first profile session
			
		Profile.SessionLoadCount   [number] (Read-only) -- Amount of times a session was started for this profile
			
		Profile.Session            [table] (Read-only) {PlaceId = number, JobId = string} / nil
			-- Set to a table if this profile is in use by a server; nil if released

		Profile.RobloxMetaData     [table] -- Writable table that gets saved automatically and once the profile is released
		Profile.UserIds            [table] -- (Read-only) -- {user_id [number], ...} -- User ids associated with this profile

		Profile.KeyInfo            [DataStoreKeyInfo] -- Changes before OnAfterSave signal
		
		Profile.OnSave             [Signal] ()
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			
		Profile.OnLastSave         [Signal] (reason [string]: "Manual", "External", "Shutdown")
			-- Triggered right before changes to Profile.Data are saved to the DataStore
			for the last time; A reason is provided for the last save:
				- "Manual"   - Profile:EndSession() was called
				- "Shutdown" - The server that has ownership of this profile is shutting down
				- "External" - Another server has started a session for this profile
			Note that this event will not trigger for when a profile session is ended by
			another server trying to take ownership of the session - this is impossible to
			do without compromising on ProfileStore's speed.
			
		Profile.OnSessionEnd       [Signal] ()
			-- Triggered when the profile session is terminated on this server
		
		Profile.OnAfterSave        [Signal] (last_saved_data)
			-- Triggered after a successful save
			last_saved_data [table] -- Profile.LastSavedData
			
		Profile.ProfileStore       [ProfileStore] -- ProfileStore object this profile belongs to
		Profile.Key                [string] -- DataStore key
		
	Methods [Profile]:
	
		Profile:IsActive() --&gt; [bool] -- If "true" is returned, changes to Profile.Data are guaranteed to save;
			This guarantee is only valid until code yields (e.g. task.wait() is used).
			
		Profile:Reconcile() -- Fills in missing (nil) [string_key] = [value] pairs to the Profile.Data structure
			from the "template" argument that was passed to "ProfileStore.New()"
			
		Profile:EndSession() -- Call after the server has finished working with this profile
			e.g., after the player leaves (Profile object will become inactive)

		Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)
			user_id   [number]

		Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)
			user_id   [number]
			
		Profile:MessageHandler(fn) -- Sets a message handler for this profile
			fn [function] (message [table], processed [function]())
			-- The handler function receives a message table and a callback function;
			The callback function is to be called when a message has been processed
			- this will discard the message from the profile message cache; If the
			callback function is not called, other message handlers will also be triggered
			with unprocessed message data.
			
		Profile:Save() -- If the profile session is still active makes an UpdateAsync call
			to the DataStore to immediately save profile data

		Profile:SetAsync() -- Forcefully saves changes to the profile; Only for profiles
			loaded with ProfileStore:GetAsync() or ProfileStore:VersionQuery()
		
--]]

local AUTO_SAVE_PERIOD = 300 -- (Seconds) Time between when changes to a profile are saved to the DataStore
local LOAD_REPEAT_PERIOD = 10 -- (Seconds) Time between successive profile reads when handling a session conflict
local FIRST_LOAD_REPEAT = 5 -- (Seconds) Time between first and second profile read when handling a session conflict
local SESSION_STEAL = 40 -- (Seconds) Time until a session conflict is resolved with the waiting server stealing the session
local ASSUME_DEAD = 630 -- (Seconds) If a profile hasn't had updates for this long, quickly assume an active session belongs to a crashed server
local START_SESSION_TIMEOUT = 120 -- (Seconds) If a session can't be started for a profile for this long, stop repeating calls to the DataStore

local CRITICAL_STATE_ERROR_COUNT = 5 -- Assume critical state if this many issues happen in a short amount of time
local CRITICAL_STATE_ERROR_EXPIRE = 120 -- (Seconds) Individual issue expiration
local CRITICAL_STATE_EXPIRE = 120 -- (Seconds) Critical state expiration

local MAX_MESSAGE_QUEUE = 1000 -- Max messages saved in a profile that were sent using "ProfileStore:MessageAsync()"

----- Dependencies -----

-- local Util = require(game.ReplicatedStorage.Shared.Util)
-- local Signal = Util.Signal

local Signal do

	local FreeRunnerThread

	--[[
		Yield-safe coroutine reusing by stravant;
		Sources:
		https://devforum.roblox.com/t/lua-signal-class-comparison-optimal-goodsignal-class/1387063
		https://gist.github.com/stravant/b75a322e0919d60dde8a0316d1f09d2f
	--]]

	local function AcquireRunnerThreadAndCallEventHandler(fn, ...)
		local acquired_runner_thread = FreeRunnerThread
		FreeRunnerThread = nil
		fn(...)
		-- The handler finished running, this runner thread is free again.
		FreeRunnerThread = acquired_runner_thread
	end

	local function RunEventHandlerInFreeThread(...)
		AcquireRunnerThreadAndCallEventHandler(...)
		while true do
			AcquireRunnerThreadAndCallEventHandler(coroutine.yield())
		end
	end

	local Connection = {}
	Connection.__index = Connection

	local SignalClass = {}
	SignalClass.__index = SignalClass

	function Connection:Disconnect()

		if self.is_connected == false then
			return
		end

		local signal = self.signal
		self.is_connected = false
		signal.listener_count -= 1

		if signal.head == self then
			signal.head = self.next
		else
			local prev = signal.head
			while prev ~= nil and prev.next ~= self do
				prev = prev.next
			end
			if prev ~= nil then
				prev.next = self.next
			end
		end

	end

	function SignalClass.New()

		local self = {
			head = nil,
			listener_count = 0,
		}
		setmetatable(self, SignalClass)

		return self

	end

	function SignalClass:Connect(listener: (...any) -&gt; ())

		if type(listener) ~= "function" then
			error(`[{script.Name}]: \"listener\" must be a function; Received {typeof(listener)}`)
		end

		local connection = {
			listener = listener,
			signal = self,
			next = self.head,
			is_connected = true,
		}
		setmetatable(connection, Connection)

		self.head = connection
		self.listener_count += 1

		return connection

	end

	function SignalClass:GetListenerCount(): number
		return self.listener_count
	end

	function SignalClass:Fire(...)
		local item = self.head
		while item ~= nil do
			if item.is_connected == true then
				if not FreeRunnerThread then
					FreeRunnerThread = coroutine.create(RunEventHandlerInFreeThread)
				end
				task.spawn(FreeRunnerThread, item.listener, ...)
			end
			item = item.next
		end
	end

	function SignalClass:Wait()
		local co = coroutine.running()
		local connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(co, ...)
		end)
		return coroutine.yield()
	end

	Signal = table.freeze({
		New = SignalClass.New,
	})

end

----- Private -----

local ActiveSessionCheck = {} -- {[session_token] = profile, ...}
local AutoSaveList = {} -- {profile, ...} -- Loaded profile table which will be circularly auto-saved
local IssueQueue = {} -- {issue_time, ...}

local DataStoreService = game:GetService("DataStoreService")
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

local PlaceId = game.PlaceId
local JobId = game.JobId

local AutoSaveIndex = 1 -- Next profile to auto save
local LastAutoSave = os.clock()

local LoadIndex = 0

local ActiveProfileLoadJobs = 0 -- Number of active threads that are loading in profiles
local ActiveProfileSaveJobs = 0 -- Number of active threads that are saving profiles

local CriticalStateStart = 0 -- os.clock()

local IsStudio = RunService:IsStudio()
local DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access" = "NotReady"

local MockStore = {}
local UserMockStore = {}
local MockFlag = false

local OnError = Signal.New() -- (message, store_name, profile_key)
local OnOverwrite = Signal.New() -- (store_name, profile_key)

local UpdateQueue = { -- For stability sake, we won't do UpdateAsync calls for the same key until all previous calls finish
	--[[
		[session_token] = {
			coroutine, ...
		},
		...
	--]]
}

local function WaitInUpdateQueue(session_token) --&gt; next_in_queue()

	local is_first = false

	if UpdateQueue[session_token] == nil then
		is_first = true
		UpdateQueue[session_token] = {}
	end

	local queue = UpdateQueue[session_token]

	if is_first == false then
		table.insert(queue, coroutine.running())
		coroutine.yield()
	end

	return function()
		local next_co = table.remove(queue, 1)
		if next_co ~= nil then
			coroutine.resume(next_co)
		else
			UpdateQueue[session_token] = nil
		end
	end

end

local function SessionToken(store_name, profile_key, is_mock)

	local session_token = "L_" -- Live

	if is_mock == true then
		session_token = "U_" -- User mock
	elseif DataStoreState ~= "Access" then
		session_token = "M_" -- Mock, cause no DataStore access
	end

	session_token ..= store_name .. "\0" .. profile_key

	return session_token

end

local function DeepCopyTable(t)
	local copy = {}
	for key, value in pairs(t) do
		if type(value) == "table" then
			copy[key] = DeepCopyTable(value)
		else
			copy[key] = value
		end
	end
	return copy
end

local function ReconcileTable(target, template)
	for k, v in pairs(template) do
		if type(k) == "string" then -- Only string keys will be reconciled
			if target[k] == nil then
				if type(v) == "table" then
					target[k] = DeepCopyTable(v)
				else
					target[k] = v
				end
			elseif type(target[k]) == "table" and type(v) == "table" then
				ReconcileTable(target[k], v)
			end
		end
	end
end

local function RegisterError(error_message, store_name, profile_key) -- Called when a DataStore API call errors
	warn(`[{script.Name}]: DataStore API error (STORE:{store_name}; KEY:{profile_key}) - {tostring(error_message)}`)
	table.insert(IssueQueue, os.clock()) -- Adding issue time to queue
	OnError:Fire(tostring(error_message), store_name, profile_key)
end

local function RegisterOverwrite(store_name, profile_key) -- Called when a corrupted profile is loaded
	warn(`[{script.Name}]: Invalid profile was overwritten (STORE:{store_name}; KEY:{profile_key})`)
	OnOverwrite:Fire(store_name, profile_key)
end

local function NewMockDataStoreKeyInfo(params)

	local version_id_string = tostring(params.VersionId or 0)
	local meta_data = params.MetaData or {}
	local user_ids = params.UserIds or {}

	return {
		CreatedTime = params.CreatedTime,
		UpdatedTime = params.UpdatedTime,
		Version = string.rep("0", 16) .. "."
			.. string.rep("0", 10 - string.len(version_id_string)) .. version_id_string
			.. "." .. string.rep("0", 16) .. "." .. "01",

		GetMetadata = function()
			return DeepCopyTable(meta_data)
		end,

		GetUserIds = function()
			return DeepCopyTable(user_ids)
		end,
	}

end

local function MockUpdateAsync(mock_data_store, profile_store_name, key, transform_function, is_get_call) --&gt; loaded_data, key_info

	local profile_store = mock_data_store[profile_store_name]

	if profile_store == nil then
		profile_store = {}
		mock_data_store[profile_store_name] = profile_store
	end

	local epoch_time = math.floor(os.time() * 1000)
	local mock_entry = profile_store[key]
	local mock_entry_was_nil = false

	if mock_entry == nil then
		mock_entry_was_nil = true
		if is_get_call ~= true then
			mock_entry = {
				Data = nil,
				CreatedTime = epoch_time,
				UpdatedTime = epoch_time,
				VersionId = 0,
				UserIds = {},
				MetaData = {},
			}
			profile_store[key] = mock_entry
		end
	end

	local mock_key_info = mock_entry_was_nil == false and NewMockDataStoreKeyInfo(mock_entry) or nil

	local transform, user_ids, roblox_meta_data = transform_function(mock_entry and mock_entry.Data, mock_key_info)

	if transform == nil then
		return nil
	else
		if mock_entry ~= nil and is_get_call ~= true then
			mock_entry.Data = DeepCopyTable(transform)
			mock_entry.UserIds = DeepCopyTable(user_ids or {})
			mock_entry.MetaData = DeepCopyTable(roblox_meta_data or {})
			mock_entry.VersionId += 1
			mock_entry.UpdatedTime = epoch_time
		end

		return DeepCopyTable(transform), mock_entry ~= nil and NewMockDataStoreKeyInfo(mock_entry) or nil
	end

end

local function UpdateAsync(profile_store, profile_key, transform_params, is_user_mock, is_get_call, version) --&gt; loaded_data, key_info
	--transform_params = {
	--	ExistingProfileHandle = function(latest_data),
	--	MissingProfileHandle = function(latest_data),
	--	EditProfile = function(latest_data),
	--}

	local loaded_data, key_info
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(profile_store.Name, profile_key, is_user_mock))

	local success = true

	local success, error_message = pcall(function()
		local transform_function = function(latest_data)

			local missing_profile = false
			local overwritten = false
			local global_updates = {0, {}}

			if latest_data == nil then

				missing_profile = true

			elseif type(latest_data) ~= "table" then

				missing_profile = true
				overwritten = true

			else

				if type(latest_data.Data) == "table" and type(latest_data.MetaData) == "table" and type(latest_data.GlobalUpdates) == "table" then

					-- Regular profile structure detected:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates

					if transform_params.ExistingProfileHandle ~= nil then
						transform_params.ExistingProfileHandle(latest_data)
					end

				elseif latest_data.Data == nil and latest_data.MetaData == nil and type(latest_data.GlobalUpdates) == "table" then

					-- Regular structure not detected, but GlobalUpdate data exists:

					latest_data.WasOverwritten = false -- Must be set to false if set previously
					global_updates = latest_data.GlobalUpdates or global_updates
					missing_profile = true

				else

					missing_profile = true
					overwritten = true

				end

			end

			-- Profile was not created or corrupted and no GlobalUpdate data exists:
			if missing_profile == true then
				latest_data = {
					-- Data = nil,
					-- MetaData = nil,
					GlobalUpdates = global_updates,
				}
				if transform_params.MissingProfileHandle ~= nil then
					transform_params.MissingProfileHandle(latest_data)
				end
			end

			-- Editing profile:
			if transform_params.EditProfile ~= nil then
				transform_params.EditProfile(latest_data)
			end

			-- Invalid data handling (Silently override with empty profile)
			if overwritten == true then
				latest_data.WasOverwritten = true -- Temporary tag that will be removed on first save
			end

			return latest_data, latest_data.UserIds, latest_data.RobloxMetaData
		end

		if is_user_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

			loaded_data, key_info = MockUpdateAsync(UserMockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		elseif DataStoreState ~= "Access" then -- Used when API access is disabled

			loaded_data, key_info = MockUpdateAsync(MockStore, profile_store.Name, profile_key, transform_function, is_get_call)
			task.wait() -- Simulate API call yield

		else

			if is_get_call == true then

				if version ~= nil then

					local success, error_message = pcall(function()
						loaded_data, key_info = profile_store.data_store:GetVersionAsync(profile_key, version)
					end)

					if success == false and type(error_message) == "string" and string.find(error_message, "not valid") ~= nil then
						warn(`[{script.Name}]: Passed version argument is not valid; Traceback:\n` .. debug.traceback())
					end

				else

					loaded_data, key_info = profile_store.data_store:GetAsync(profile_key)

				end

				loaded_data = transform_function(loaded_data)

			else

				loaded_data, key_info = profile_store.data_store:UpdateAsync(profile_key, transform_function)

			end

		end

	end)

	next_in_queue()

	if success == true and type(loaded_data) == "table" then
		-- Invalid data handling:
		if loaded_data.WasOverwritten == true and is_get_call ~= true then
			RegisterOverwrite(
				profile_store.Name,
				profile_key
			)
		end
		-- Return loaded_data:
		return loaded_data, key_info
	else
		-- Error handling:
		RegisterError(
			error_message or "Undefined error",
			profile_store.Name,
			profile_key
		)
		-- Return nothing:
		return nil
	end

end

local function IsThisSession(session_tag)
	return session_tag[1] == PlaceId and session_tag[2] == JobId
end

local function ReadMockFlag(): boolean
	local is_mock = MockFlag
	MockFlag = false
	return is_mock
end

local function WaitForStoreReady(profile_store)
	while profile_store.is_ready == false do
		task.wait()
	end
end

local function AddProfileToAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = profile

	-- Add at AutoSaveIndex and move AutoSaveIndex right:

	table.insert(AutoSaveList, AutoSaveIndex, profile)

	if #AutoSaveList &gt; 1 then
		AutoSaveIndex = AutoSaveIndex + 1
	elseif #AutoSaveList == 1 then
		-- First profile created - make sure it doesn't get immediately auto saved:
		LastAutoSave = os.clock()
	end

end

local function RemoveProfileFromAutoSave(profile)

	ActiveSessionCheck[profile.session_token] = nil

	local auto_save_index = table.find(AutoSaveList, profile)

	if auto_save_index ~= nil then
		table.remove(AutoSaveList, auto_save_index)
		if auto_save_index &lt; AutoSaveIndex then
			AutoSaveIndex = AutoSaveIndex - 1 -- Table contents were moved left before AutoSaveIndex so move AutoSaveIndex left as well
		end
		if AutoSaveList[AutoSaveIndex] == nil then -- AutoSaveIndex was at the end of the AutoSaveList - reset to 1
			AutoSaveIndex = 1
		end
	end

end

local function SaveProfileAsync(profile, is_ending_session, is_overwriting, last_save_reason)

	if type(profile.Data) ~= "table" then
		error(`[{script.Name}]: Developer code likely set "Profile.Data" to a non-table value! (STORE:{profile.ProfileStore.Name}; KEY:{profile.Key})`)
	end

	profile.OnSave:Fire()
	if is_ending_session == true then
		profile.OnLastSave:Fire(last_save_reason or "Manual")
	end

	if is_ending_session == true and is_overwriting ~= true then
		if profile.roblox_message_subscription ~= nil then
			profile.roblox_message_subscription:Disconnect()
		end
		RemoveProfileFromAutoSave(profile)
		profile.OnSessionEnd:Fire()
	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs + 1

	-- Compare "SessionLoadCount" when writing to profile to prevent a rare case of repeat last save when the profile is loaded on the same server again

	local repeat_save_flag = true -- Released Profile save calls have to repeat until they succeed
	local exp_backoff = 1

	while repeat_save_flag == true do

		if is_ending_session ~= true then
			repeat_save_flag = false
		end

		local loaded_data, key_info = UpdateAsync(
			profile.ProfileStore,
			profile.Key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)
					
					-- Check if this session still owns the profile:

					local session_owns_profile = false

					if is_overwriting ~= true then

						local active_session = latest_data.MetaData.ActiveSession
						local session_load_count = latest_data.MetaData.SessionLoadCount

						if type(active_session) == "table" then
							session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
						end

					else
						session_owns_profile = true
					end

					-- We may only edit the profile if this server has ownership of the profile:

					if session_owns_profile == true then

						-- Clear processed updates (messages):

						local locked_updates = profile.locked_global_updates -- [index] = true, ...
						local active_updates = latest_data.GlobalUpdates[2]
						-- ProfileService module format: {{update_id, version_id, update_locked, update_data}, ...}
						-- ProfileStore module format: {{update_id, update_data}, ...}

						if next(locked_updates) ~= nil then
							local i = 1
							while i &lt;= #active_updates do
								local update = active_updates[i]
								if locked_updates[update[1]] == true then
									table.remove(active_updates, i)
								else
									i += 1
								end
							end
						end

						-- Save profile data:

						latest_data.Data = profile.Data
						latest_data.RobloxMetaData = profile.RobloxMetaData
						latest_data.UserIds = profile.UserIds

						if is_overwriting ~= true then

							latest_data.MetaData.LastUpdate = os.time()

							if is_ending_session == true then
								latest_data.MetaData.ActiveSession = nil
							end

						else

							latest_data.MetaData.ActiveSession = nil
							latest_data.MetaData.ForceLoadSession = nil

						end

					end

				end,
			},
			profile.is_mock
		)

		if loaded_data ~= nil and key_info ~= nil then

			if is_overwriting == true then
				break
			end
			
			repeat_save_flag = false
			
			local active_session = loaded_data.MetaData.ActiveSession
			local session_load_count = loaded_data.MetaData.SessionLoadCount
			local session_owns_profile = false

			if type(active_session) == "table" then
				session_owns_profile = IsThisSession(active_session) and session_load_count == profile.load_index
			end
			
			local force_load_session = loaded_data.MetaData.ForceLoadSession
			local force_load_pending = false
			if type(force_load_session) == "table" then
				force_load_pending = not IsThisSession(force_load_session)
			end
			
			local is_active = profile:IsActive()
			
			-- If another server is trying to start a session for this profile - end the session:

			if force_load_pending == true and session_owns_profile == true then
				if is_active == true then
					SaveProfileAsync(profile, true, false, "External")
				end
				break
			end
			
			-- Clearing processed update list / Detecting new updates:

			local locked_updates = profile.locked_global_updates -- [index] = true, ...
			local received_updates = profile.received_global_updates -- [index] = true, ...
			local active_updates = loaded_data.GlobalUpdates[2]

			local new_updates = {} -- {}, ...
			local still_pending = {} -- [index] = true, ...

			for _, update in ipairs(active_updates) do
				if locked_updates[update[1]] == true then
					still_pending[update[1]] = true
				elseif received_updates[update[1]] ~= true then
					received_updates[update[1]] = true
					table.insert(new_updates, update)
				end
			end

			for index in pairs(locked_updates) do
				if still_pending[index] ~= true then
					locked_updates[index] = nil
				end
			end

			-- Updating profile values:

			profile.KeyInfo = key_info
			profile.LastSavedData = loaded_data.Data
			profile.global_updates = loaded_data.GlobalUpdates and loaded_data.GlobalUpdates[2] or {}

			if session_owns_profile == true then
				if is_active == true and is_ending_session ~= true then

					-- Processing new global updates (messages):

					for _, update in ipairs(new_updates) do

						local index = update[1]
						local update_data = update[#update] -- Backwards compatibility with ProfileService

						for _, handler in ipairs(profile.message_handlers) do

							local is_processed = false
							local processed_callback = function()
								is_processed = true
								locked_updates[index] = true
							end
							
							local send_update_data = DeepCopyTable(update_data)

							task.spawn(handler, send_update_data, processed_callback)

							if is_processed == true then
								break
							end

						end

					end

				end
			else
				
				if profile.roblox_message_subscription ~= nil then
					profile.roblox_message_subscription:Disconnect()
				end

				if is_active == true then
					RemoveProfileFromAutoSave(profile)
					profile.OnSessionEnd:Fire()
				end

			end

			profile.OnAfterSave:Fire(profile.LastSavedData)

		elseif repeat_save_flag == true then
			
			-- DataStore call likely resulted in an error; Repeat the DataStore call shortly
			task.wait(exp_backoff)
			exp_backoff = math.min(if last_save_reason == "Shutdown" then 8 else 20, exp_backoff * 2)

		end

	end

	ActiveProfileSaveJobs = ActiveProfileSaveJobs - 1

end

----- Public -----

--[[
	Saved profile structure:
	
	{
		Data = {},
		
		MetaData = {
			ProfileCreateTime = 0,
			SessionLoadCount = 0,
			ActiveSession = {place_id, game_job_id, unique_session_id} / nil,
			ForceLoadSession = {place_id, game_job_id} / nil,
			LastUpdate = 0, -- os.time()
			MetaTags = {}, -- Backwards compatibility with ProfileService
		},
		
		RobloxMetaData = {},
		UserIds = {},
		
		GlobalUpdates = {
			update_index,
			{
				{update_index, data}, ...
			},
		},
	}

--]]

export type JSONAcceptable = { JSONAcceptable } | { [string]: JSONAcceptable } | number | string | boolean | buffer

export type Profile&lt;T&gt; = {
	Data: T &amp; JSONAcceptable,
	LastSavedData: T &amp; JSONAcceptable,
	FirstSessionTime: number,
	SessionLoadCount: number,
	Session: {PlaceId: number, JobId: string}?,
	RobloxMetaData: JSONAcceptable,
	UserIds: {number},
	KeyInfo: DataStoreKeyInfo,
	OnSave: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnLastSave: {Connect: (self: any, listener: (reason: "Manual" | "External" | "Shutdown") -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnSessionEnd: {Connect: (self: any, listener: () -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnAfterSave: {Connect: (self: any, listener: (last_saved_data: T &amp; JSONAcceptable) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	ProfileStore: JSONAcceptable,
	Key: string,

	IsActive: (self: any) -&gt; (boolean),
	Reconcile: (self: any) -&gt; (),
	EndSession: (self: any) -&gt; (),
	AddUserId: (self: any, user_id: number) -&gt; (),
	RemoveUserId: (self: any, user_id: number) -&gt; (),
	MessageHandler: (self: any, fn: (message: JSONAcceptable, processed: () -&gt; ()) -&gt; ()) -&gt; (),
	Save: (self: any) -&gt; (),
	SetAsync: (self: any) -&gt; (),
}

export type VersionQuery&lt;T&gt; = {
	NextAsync: (self: any) -&gt; (Profile&lt;T&gt;?),
}

type ProfileStoreStandard&lt;T&gt; = {
	Name: string,
	StartSessionAsync: (self: any, profile_key: string, params: {Steal: boolean?}) -&gt; (Profile&lt;T&gt;?),
	MessageAsync: (self: any, profile_key: string, message: JSONAcceptable) -&gt; (boolean),
	GetAsync: (self: any, profile_key: string, version: string?) -&gt; (Profile&lt;T&gt;?),
	VersionQuery: (self: any, profile_key: string, sort_direction: Enum.SortDirection?, min_date: DateTime | number | nil, max_date: DateTime | number | nil) -&gt; (VersionQuery&lt;T&gt;),
	RemoveAsync: (self: any, profile_key: string) -&gt; (boolean),
}

export type ProfileStore&lt;T&gt; = {
	Mock: ProfileStoreStandard&lt;T&gt;,
} &amp; ProfileStoreStandard&lt;T&gt;

type ConstantName = "AUTO_SAVE_PERIOD" | "LOAD_REPEAT_PERIOD" | "FIRST_LOAD_REPEAT" | "SESSION_STEAL"
| "ASSUME_DEAD" | "START_SESSION_TIMEOUT" | "CRITICAL_STATE_ERROR_COUNT" | "CRITICAL_STATE_ERROR_EXPIRE"
| "CRITICAL_STATE_EXPIRE" | "MAX_MESSAGE_QUEUE"

export type ProfileStoreModule = {
	IsClosing: boolean,
	IsCriticalState: boolean,
	OnError: {Connect: (self: any, listener: (message: string, store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnOverwrite: {Connect: (self: any, listener: (store_name: string, profile_key: string) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	OnCriticalToggle: {Connect: (self: any, listener: (is_critical: boolean) -&gt; ()) -&gt; ({Disconnect: (self: any) -&gt; ()})},
	DataStoreState: "NotReady" | "NoInternet" | "NoAccess" | "Access",
	New: &lt;T&gt;(store_name: string, template: (T &amp; JSONAcceptable)?) -&gt; (ProfileStore&lt;T&gt;),
	SetConstant: (name: ConstantName, value: number) -&gt; ()
}

local Profile = {}
Profile.__index = Profile

function Profile.New(raw_data, key_info, profile_store, key, is_mock, session_token)

	local data = raw_data.Data or {}
	local session = raw_data.MetaData and raw_data.MetaData.ActiveSession or nil

	local global_updates = raw_data.GlobalUpdates and raw_data.GlobalUpdates[2] or {}
	local received_global_updates = {}

	for _, update in ipairs(global_updates) do
		received_global_updates[update[1]] = true
	end

	local self = {

		Data = data,
		LastSavedData = DeepCopyTable(data),

		FirstSessionTime = raw_data.MetaData and raw_data.MetaData.ProfileCreateTime or 0,
		SessionLoadCount = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		Session = session and {PlaceId = session[1], JobId = session[2]},

		RobloxMetaData = raw_data.RobloxMetaData or {},
		UserIds = raw_data.UserIds or {},
		KeyInfo = key_info,

		OnAfterSave = Signal.New(),
		OnSave = Signal.New(),
		OnLastSave = Signal.New(),
		OnSessionEnd = Signal.New(),

		ProfileStore = profile_store,
		Key = key,

		load_timestamp = os.clock(),
		is_mock = is_mock,
		session_token = session_token or "",
		load_index = raw_data.MetaData and raw_data.MetaData.SessionLoadCount or 0,
		locked_global_updates = {},
		received_global_updates = received_global_updates,
		message_handlers = {},
		global_updates = global_updates,

	}
	setmetatable(self, Profile)

	return self

end

function Profile:IsActive()
	return ActiveSessionCheck[self.session_token] == self
end

function Profile:Reconcile()
	ReconcileTable(self.Data, self.ProfileStore.template)
end

function Profile:EndSession()
	if self:IsActive() == true then
		task.spawn(SaveProfileAsync, self, true, nil, "Manual") -- Call save function in a new thread with release_from_session = true
	end
end

function Profile:AddUserId(user_id) -- Associates user_id with profile (GDPR compliance)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :AddUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	if user_id &lt; 0 and self.is_mock ~= true and DataStoreState == "Access" then
		return -- Avoid giving real Roblox APIs negative UserId's
	end

	if table.find(self.UserIds, user_id) == nil then
		table.insert(self.UserIds, user_id)
	end

end

function Profile:RemoveUserId(user_id) -- Removes user_id association with profile (safe function)

	if type(user_id) ~= "number" or user_id % 1 ~= 0 then
		warn(`[{script.Name}]: Invalid UserId argument for :RemoveUserId() ({tostring(user_id)}); Traceback:\n` .. debug.traceback())
		return
	end

	local index = table.find(self.UserIds, user_id)

	if index ~= nil then
		table.remove(self.UserIds, index)
	end

end

function Profile:SetAsync() -- Saves the profile to the DataStore and removes the session lock

	if self.view_mode ~= true then
		error(`[{script.Name}]: :SetAsync() can only be used in view mode`)
	end

	SaveProfileAsync(self, nil, true)

end

function Profile:MessageHandler(fn)

	if type(fn) ~= "function" then
		error(`[{script.Name}]: fn argument is not a function`)
	end

	if self.view_mode ~= true and self:IsActive() ~= true then
		return -- Don't process messages if the profile session was ended
	end

	local locked_updates = self.locked_global_updates
	table.insert(self.message_handlers, fn)

	for _, update in ipairs(self.global_updates) do

		local index = update[1]
		local update_data = update[#update] -- Backwards compatibility with ProfileService

		if locked_updates[index] ~= true then

			local processed_callback = function()
				locked_updates[index] = true
			end
			
			local send_update_data = DeepCopyTable(update_data)

			task.spawn(fn, send_update_data, processed_callback)

		end

	end

end

function Profile:Save()
	
	if self.view_mode == true then
		error(`[{script.Name}]: Can't save profile in view mode; Should you be calling :SetAsync() instead?`)
	end
	
	if self:IsActive() == false then
		warn(`[{script.Name}]: Attempted saving an inactive profile (STORE:{self.ProfileStore.Name}; KEY:{self.Key});`
			.. ` Traceback:\n` .. debug.traceback())
		return
	end
	
	-- Move the profile right behind the auto save index to delay the next auto save for it:
	RemoveProfileFromAutoSave(self)
	AddProfileToAutoSave(self)
	
	-- Perform save in new thread:
	task.spawn(SaveProfileAsync, self)

end

local ProfileStore: ProfileStoreModule = {

	IsClosing = false,
	IsCriticalState = false,
	OnError = OnError, -- (message, store_name, profile_key)
	OnOverwrite = OnOverwrite, -- (store_name, profile_key)
	OnCriticalToggle = Signal.New(), -- (is_critical)
	DataStoreState = "NotReady", -- ("NotReady", "NoInternet", "NoAccess", "Access")

}
ProfileStore.__index = ProfileStore

function ProfileStore.SetConstant(name, value)

	if type(value) ~= "number" then
		error(`[{script.Name}]: Invalid value type`)
	end

	if name == "AUTO_SAVE_PERIOD" then
		AUTO_SAVE_PERIOD = value
	elseif name == "LOAD_REPEAT_PERIOD" then
		LOAD_REPEAT_PERIOD = value
	elseif name == "FIRST_LOAD_REPEAT" then
		FIRST_LOAD_REPEAT = value
	elseif name == "SESSION_STEAL" then
		SESSION_STEAL = value
	elseif name == "ASSUME_DEAD" then
		ASSUME_DEAD = value
	elseif name == "START_SESSION_TIMEOUT" then
		START_SESSION_TIMEOUT = value
	elseif name == "CRITICAL_STATE_ERROR_COUNT" then
		CRITICAL_STATE_ERROR_COUNT = value
	elseif name == "CRITICAL_STATE_ERROR_EXPIRE" then
		CRITICAL_STATE_ERROR_EXPIRE = value
	elseif name == "CRITICAL_STATE_EXPIRE" then
		CRITICAL_STATE_EXPIRE = value
	elseif name == "MAX_MESSAGE_QUEUE" then
		MAX_MESSAGE_QUEUE = value
	else
		error(`[{script.Name}]: Invalid constant name was provided`)
	end

end

function ProfileStore.Test()
	return {
		ActiveSessionCheck = ActiveSessionCheck,
		AutoSaveList = AutoSaveList,
		ActiveProfileLoadJobs = ActiveProfileLoadJobs,
		ActiveProfileSaveJobs = ActiveProfileSaveJobs,
		MockStore = MockStore,
		UserMockStore = UserMockStore,
		UpdateQueue = UpdateQueue,
	}
end

function ProfileStore.New(store_name, template)

	template = template or {}

	if type(store_name) ~= "string" then
		error(`[{script.Name}]: Invalid or missing "store_name"`)
	elseif string.len(store_name) == 0 then
		error(`[{script.Name}]: store_name cannot be an empty string`)
	elseif string.len(store_name) &gt; 50 then
		error(`[{script.Name}]: store_name is too long`)
	end

	if type(template) ~= "table" then
		error(`[{script.Name}]: Invalid template argument`)
	end

	local self
	self = {

		Mock = {

			Name = store_name,

			StartSessionAsync = function(_, profile_key)
				MockFlag = true
				return self:StartSessionAsync(profile_key)
			end,
			MessageAsync = function(_, profile_key, message)
				MockFlag = true
				return self:MessageAsync(profile_key, message)
			end,
			GetAsync = function(_, profile_key, version)
				MockFlag = true
				return self:GetAsync(profile_key, version)
			end,
			VersionQuery = function(_, profile_key, sort_direction, min_date, max_date)
				MockFlag = true
				return self:VersionQuery(profile_key, sort_direction, min_date, max_date)
			end,
			RemoveAsync = function(_, profile_key)
				MockFlag = true
				return self:RemoveAsync(profile_key)
			end
		},

		Name = store_name,

		template = template,
		data_store = nil,
		load_jobs = {},
		mock_load_jobs = {},
		is_ready = true,

	}
	setmetatable(self, ProfileStore)

	local options = Instance.new("DataStoreOptions")
	options:SetExperimentalFeatures({v2 = true})

	if DataStoreState == "NotReady" then

		-- The module is not sure whether DataStores are accessible yet:

		self.is_ready = false

		task.spawn(function()

			repeat task.wait() until DataStoreState ~= "NotReady"

			if DataStoreState == "Access" then
				self.data_store = DataStoreService:GetDataStore(store_name, nil, options)
			end

			self.is_ready = true

		end)

	elseif DataStoreState == "Access" then

		self.data_store = DataStoreService:GetDataStore(store_name, nil, options)

	end

	return self

end

local function RobloxMessageSubscription(profile, unique_session_id)

	local last_roblox_message = 0
	
	local roblox_message_subscription = MessagingService:SubscribeAsync("PS_" .. unique_session_id, function(message)
		if type(message.Data) == "table" and message.Data.LoadCount == profile.SessionLoadCount then
			-- High reaction rate, based on numPlayers × 10 DataStore budget as of writing
			if os.clock() - last_roblox_message &gt; 6 then 
				last_roblox_message = os.clock()
				if profile:IsActive() == true then
					if message.Data.EndSession == true then
						SaveProfileAsync(profile, true, false, "External")
					else
						profile:Save()
					end
				end
			end
		end
	end)

	if profile:IsActive() == true then
		profile.roblox_message_subscription = roblox_message_subscription
	else
		roblox_message_subscription:Disconnect()
	end

end

function ProfileStore:StartSessionAsync(profile_key, params)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end
	
	if params ~= nil and type(params) ~= "table" then
		error(`[{script.Name}]: Invalid params`)
	end
	
	params = params or {}

	if ProfileStore.IsClosing == true then
		return nil
	end
	
	WaitForStoreReady(self)

	local session_token = SessionToken(self.Name, profile_key, is_mock)

	if ActiveSessionCheck[session_token] ~= nil then
		error(`[{script.Name}]: Profile (STORE:{self.Name}; KEY:{profile_key}) is already loaded in this session`)
	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs + 1
	
	local is_user_cancel = false
	
	local function cancel_condition()
		if is_user_cancel == false then
			if params.Cancel ~= nil then
				is_user_cancel = params.Cancel() == true
			end
			return is_user_cancel
		end
		return true
	end
	
	local user_steal = params.Steal == true

	local force_load_steps = 0 -- Session conflict handling values
	local request_force_load = true
	local steal_session = false

	local start = os.clock()
	local exp_backoff = 1

	while ProfileStore.IsClosing == false and cancel_condition() == false do

		-- Load profile:

		-- SPECIAL CASE - If StartSessionAsync is called for the same key again before another StartSessionAsync finishes,
		-- grab the DataStore return for the new call. The early call will return nil. This is supposed to retain
		-- expected and efficient behavior in cases where a player would quickly rejoin the same server.

		LoadIndex += 1
		local load_id = LoadIndex
		local profile_load_jobs = is_mock == true and self.mock_load_jobs or self.load_jobs
		local profile_load_job = profile_load_jobs[profile_key] -- {load_id, {loaded_data, key_info} or nil}

		local loaded_data, key_info
		local unique_session_id = HttpService:GenerateGUID(false)

		if profile_load_job ~= nil then

			profile_load_job[1] = load_id -- Steal load job
			while profile_load_job[2] == nil do -- Wait for job to finish
				task.wait()
			end
			if profile_load_job[1] == load_id then -- Load job hasn't been double-stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end

		else

			profile_load_job = {load_id, nil}
			profile_load_jobs[profile_key] = profile_load_job

			profile_load_job[2] = table.pack(UpdateAsync(
				self,
				profile_key,
				{
					ExistingProfileHandle = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						local force_load_session = latest_data.MetaData.ForceLoadSession

						if active_session == nil then
							latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
							latest_data.MetaData.ForceLoadSession = nil
						elseif type(active_session) == "table" then
							if IsThisSession(active_session) == false then
								local last_update = latest_data.MetaData.LastUpdate
								if last_update ~= nil then
									if os.time() - last_update &gt; ASSUME_DEAD then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
										return
									end
								end
								if steal_session == true or user_steal == true then
									local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true
									if force_load_interrupted == false or user_steal == true then
										latest_data.MetaData.ActiveSession = {PlaceId, JobId, unique_session_id}
										latest_data.MetaData.ForceLoadSession = nil
									end
								elseif request_force_load == true then
									latest_data.MetaData.ForceLoadSession = {PlaceId, JobId}
								end
							else
								latest_data.MetaData.ForceLoadSession = nil
							end
						end

					end,
					MissingProfileHandle = function(latest_data)
						
						local is_cancel = ProfileStore.IsClosing == true or cancel_condition() == true

						latest_data.Data = DeepCopyTable(self.template)
						latest_data.MetaData = {
							ProfileCreateTime = os.time(),
							SessionLoadCount = 0,
							ActiveSession = if is_cancel == false then {PlaceId, JobId, unique_session_id} else nil,
							ForceLoadSession = nil,
							MetaTags = {}, -- Backwards compatibility with ProfileService
						}

					end,
					EditProfile = function(latest_data)

						if ProfileStore.IsClosing == true or cancel_condition() == true then
							return
						end

						local active_session = latest_data.MetaData.ActiveSession
						if active_session ~= nil and IsThisSession(active_session) == true then
							latest_data.MetaData.SessionLoadCount = latest_data.MetaData.SessionLoadCount + 1
							latest_data.MetaData.LastUpdate = os.time()
						end

					end,
				},
				is_mock
				))
			if profile_load_job[1] == load_id then -- Load job hasn't been stolen
				loaded_data, key_info = table.unpack(profile_load_job[2])
				profile_load_jobs[profile_key] = nil
			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- Load job stolen
			end
		end

		-- Handle load_data:

		if loaded_data ~= nil and key_info ~= nil then
			local active_session = loaded_data.MetaData.ActiveSession
			if type(active_session) == "table" then

				if IsThisSession(active_session) == true then

					-- Profile is now taken by this session:

					local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock, session_token)
					AddProfileToAutoSave(profile)
					
					if is_mock ~= true and DataStoreState == "Access" then
						
						-- Use MessagingService to quickly detect session conflicts and resolve them quickly:
						task.spawn(RobloxMessageSubscription, profile, unique_session_id) -- Blocking prevention
						
					end

					if ProfileStore.IsClosing == true or cancel_condition() == true then
						-- The server has initiated a shutdown by the time this profile was loaded
						SaveProfileAsync(profile, true) -- Release profile and yield until the DataStore call is finished
						profile = nil -- Don't return the profile object
					end

					ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
					return profile

				else
					
					if ProfileStore.IsClosing == true or cancel_condition() == true then
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					-- Profile is taken by some other session:

					local force_load_session = loaded_data.MetaData.ForceLoadSession
					local force_load_interrupted = if force_load_session ~= nil then not IsThisSession(force_load_session) else true

					if force_load_interrupted == false then

						if request_force_load == false then
							force_load_steps = force_load_steps + 1
							if force_load_steps &gt;= math.ceil(SESSION_STEAL / LOAD_REPEAT_PERIOD) then
								steal_session = true
							end
						end
						
						-- Request the remote server to end its session:
						if type(active_session[3]) == "string" then
							local session_load_count = loaded_data.MetaData.SessionLoadCount or 0
							task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count, EndSession = true})
						end
						
						-- Attempt to load the profile again after a delay
						local wait_until = os.clock() + if request_force_load == true then FIRST_LOAD_REPEAT else LOAD_REPEAT_PERIOD
						repeat task.wait() until os.clock() &gt;= wait_until or ProfileStore.IsClosing == true

					else
						-- Another session tried to load this profile:
						ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
						return nil
					end

					request_force_load = false -- Only request a force load once

				end

			else
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil -- In this scenario it is likely that this server started shutting down
			end
		else
			
			-- A DataStore call has likely ended in an error:

			local default_timeout = false

			if params.Cancel == nil then
				default_timeout = os.clock() - start &gt;= START_SESSION_TIMEOUT
			end
			
			if default_timeout == true or ProfileStore.IsClosing == true or cancel_condition() == true then
				ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
				return nil
			end
			
			task.wait(exp_backoff)  -- Repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)
			
		end

	end

	ActiveProfileLoadJobs = ActiveProfileLoadJobs - 1
	return nil -- Game started shutting down or the request was cancelled - don't return the profile

end

function ProfileStore:MessageAsync(profile_key, message)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if type(message) ~= "table" then
		error(`[{script.Name}]: message must be a table`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Updating profile:

		local loaded_data = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = nil,
				EditProfile = function(latest_data)

					local global_updates = latest_data.GlobalUpdates
					local update_list = global_updates[2]
					--{
					--	update_index,
					--	{
					--		{update_index, data}, ...
					--	},
					--},

					global_updates[1] += 1
					table.insert(update_list, {global_updates[1], message})

					-- Clearing queue if above limit:

					while #update_list &gt; MAX_MESSAGE_QUEUE do
						table.remove(update_list, 1)
					end

				end,
			},
			is_mock
		)

		if loaded_data ~= nil then
			
			local session_token = SessionToken(self.Name, profile_key, is_mock)
			
			local profile = ActiveSessionCheck[session_token]
			
			if profile ~= nil then
				
				-- The message was sent to a profile that is active in this server:
				profile:Save()
				
			else
				
				local meta_data = loaded_data.MetaData or {}
				local active_session = meta_data.ActiveSession
				local session_load_count = meta_data.SessionLoadCount or 0
				
				if type(active_session) == "table" and type(active_session[3]) == "string" then
					-- Request the remote server to auto-save sooner and receive the message:
					task.spawn(MessagingService.PublishAsync, MessagingService, "PS_" .. active_session[3], {LoadCount = session_load_count})
				end
				
			end

			return true

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return false

end

function ProfileStore:GetAsync(profile_key, version)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" then
		error(`[{script.Name}]: profile_key must be a string`)
	elseif string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	elseif string.len(profile_key) &gt; 50 then
		error(`[{script.Name}]: profile_key is too long`)
	end

	if ProfileStore.IsClosing == true then
		return nil
	end

	WaitForStoreReady(self)

	if version ~= nil and (is_mock or DataStoreState ~= "Access") then
		return nil -- No version support in mock mode
	end

	local exp_backoff = 1

	while ProfileStore.IsClosing == false do

		-- Load profile:

		local loaded_data, key_info = UpdateAsync(
			self,
			profile_key,
			{
				ExistingProfileHandle = nil,
				MissingProfileHandle = function(latest_data)

					latest_data.Data = DeepCopyTable(self.template)
					latest_data.MetaData = {
						ProfileCreateTime = os.time(),
						SessionLoadCount = 0,
						ActiveSession = nil,
						ForceLoadSession = nil,
						MetaTags = {}, -- Backwards compatibility with ProfileService
					}

				end,
				EditProfile = nil,
			},
			is_mock,
			true, -- Use :GetAsync()
			version -- DataStore key version
		)

		-- Handle load_data:

		if loaded_data ~= nil then

			if key_info == nil then
				return nil -- Load was successful, but the key was empty - return no profile object
			end

			local profile = Profile.New(loaded_data, key_info, self, profile_key, is_mock)
			profile.view_mode = true

			return profile

		else

			task.wait(exp_backoff) -- A DataStore call has likely ended in an error - repeat the call shortly
			exp_backoff = math.min(20, exp_backoff * 2)

		end

	end

	return nil -- Game started shutting down - don't return the profile

end

function ProfileStore:RemoveAsync(profile_key)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	if ProfileStore.IsClosing == true then
		return false
	end

	WaitForStoreReady(self)

	local wipe_status = false
	
	local next_in_queue = WaitInUpdateQueue(SessionToken(self.Name, profile_key, is_mock))

	if is_mock == true then -- Used when the profile is accessed through ProfileStore.Mock

		local mock_data_store = UserMockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				UserMockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	elseif DataStoreState ~= "Access" then -- Used when API access is disabled

		local mock_data_store = MockStore[self.Name]

		if mock_data_store ~= nil then
			mock_data_store[profile_key] = nil
			if next(mock_data_store) == nil then
				MockStore[self.Name] = nil
			end
		end

		wipe_status = true
		task.wait() -- Simulate API call yield

	else -- Live DataStore

		wipe_status = pcall(function()
			self.data_store:RemoveAsync(profile_key)
		end)

	end
	
	next_in_queue()

	return wipe_status

end

local ProfileVersionQuery = {}
ProfileVersionQuery.__index = ProfileVersionQuery

function ProfileVersionQuery.New(profile_store, profile_key, sort_direction, min_date, max_date, is_mock)

	local self = {
		profile_store = profile_store,
		profile_key = profile_key,
		sort_direction = sort_direction,
		min_date = min_date,
		max_date = max_date,

		query_pages = nil,
		query_index = 0,
		query_failure = false,

		is_query_yielded = false,
		query_queue = {},

		is_mock = is_mock,
	}
	setmetatable(self, ProfileVersionQuery)

	return self

end

function MoveVersionQueryQueue(self) -- Hidden ProfileVersionQuery method
	while #self.query_queue &gt; 0 do

		local queue_entry = table.remove(self.query_queue, 1)

		task.spawn(queue_entry)

		if self.is_query_yielded == true then
			break
		end

	end
end

local VersionQueryNextAsyncStackingFlag = false
local WarnAboutVersionQueryOnce = false

function ProfileVersionQuery:NextAsync()

	local is_stacking = VersionQueryNextAsyncStackingFlag == true
	VersionQueryNextAsyncStackingFlag = false

	WaitForStoreReady(self.profile_store)

	if ProfileStore.IsClosing == true then
		return nil -- Silently fail :NextAsync() requests
	end

	if self.is_mock == true or DataStoreState ~= "Access" then
		if IsStudio == true and WarnAboutVersionQueryOnce == false then
			WarnAboutVersionQueryOnce = true
			warn(`[{script.Name}]: :VersionQuery() is not supported in mock mode!`)
		end
		return nil -- Silently fail :NextAsync() requests
	end

	local profile
	local is_finished = false

	local function query_job()

		if self.query_failure == true then
			is_finished = true
			return
		end

		-- First "next" call loads version pages:

		if self.query_pages == nil then

			self.is_query_yielded = true

			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local list_success, error_message = pcall(function()
				self.query_pages = self.profile_store.data_store:ListVersionsAsync(
					self.profile_key,
					self.sort_direction,
					self.min_date,
					self.max_date
				)
				self.query_index = 0
			end)

			if list_success == false or self.query_pages == nil then
				warn(`[{script.Name}]: Version query fail - {tostring(error_message)}`)
				self.query_failure = true
			end

			self.is_query_yielded = false

			MoveVersionQueryQueue(self)

			return

		end

		local current_page = self.query_pages:GetCurrentPage()
		local next_item = current_page[self.query_index + 1]

		-- No more entries:

		if self.query_pages.IsFinished == true and next_item == nil then
			is_finished = true
			return
		end

		-- Load next page when this page is over:

		if next_item == nil then

			self.is_query_yielded = true
			task.spawn(function()
				VersionQueryNextAsyncStackingFlag = true
				profile = self:NextAsync()
				is_finished = true
			end)

			local success, error_message = pcall(function()
				self.query_pages:AdvanceToNextPageAsync()
				self.query_index = 0
			end)

			if success == false or #self.query_pages:GetCurrentPage() == 0 then
				self.query_failure = true
			end

			self.is_query_yielded = false
			MoveVersionQueryQueue(self)

			return

		end

		-- Next page item:

		self.query_index += 1
		profile = self.profile_store:GetAsync(self.profile_key, next_item.Version)
		is_finished = true

	end

	if self.is_query_yielded == false then
		query_job()
	else
		if is_stacking == true then
			table.insert(self.query_queue, 1, query_job)
		else
			table.insert(self.query_queue, query_job)
		end
	end

	while is_finished == false do
		task.wait()
	end

	return profile

end

function ProfileStore:VersionQuery(profile_key, sort_direction, min_date, max_date)

	local is_mock = ReadMockFlag()

	if type(profile_key) ~= "string" or string.len(profile_key) == 0 then
		error(`[{script.Name}]: Invalid profile_key`)
	end

	-- Type check:

	if sort_direction ~= nil and (typeof(sort_direction) ~= "EnumItem"
		or sort_direction.EnumType ~= Enum.SortDirection) then
		error(`[{script.Name}]: Invalid sort_direction ({tostring(sort_direction)})`)
	end

	if min_date ~= nil and typeof(min_date) ~= "DateTime" and typeof(min_date) ~= "number" then
		error(`[{script.Name}]: Invalid min_date ({tostring(min_date)})`)
	end

	if max_date ~= nil and typeof(max_date) ~= "DateTime" and typeof(max_date) ~= "number" then
		error(`[{script.Name}]: Invalid max_date ({tostring(max_date)})`)
	end

	min_date = typeof(min_date) == "DateTime" and min_date.UnixTimestampMillis or min_date
	max_date = typeof(max_date) == "DateTime" and max_date.UnixTimestampMillis or max_date

	return ProfileVersionQuery.New(self, profile_key, sort_direction, min_date, max_date, is_mock)

end

-- DataStore API access check:

if IsStudio == true then

	task.spawn(function()

		local new_state = "NoAccess"

		local status, message = pcall(function()
			-- This will error if current instance has no Studio API access:
			DataStoreService:GetDataStore("____PS"):SetAsync("____PS", os.time())
		end)

		local no_internet_access = status == false and string.find(message, "ConnectFail", 1, true) ~= nil

		if no_internet_access == true then
			warn(`[{script.Name}]: No internet access - check your network connection`)
		end

		if status == false and
			(string.find(message, "403", 1, true) ~= nil or -- Cannot write to DataStore from studio if API access is not enabled
				string.find(message, "must publish", 1, true) ~= nil or -- Game must be published to access live keys
				no_internet_access == true) then -- No internet access

			new_state = if no_internet_access == true then "NoInternet" else "NoAccess"
			print(`[{script.Name}]: Roblox API services unavailable - data will not be saved`)
		else
			new_state = "Access"
			print(`[{script.Name}]: Roblox API services available - data will be saved`)
		end

		DataStoreState = new_state
		ProfileStore.DataStoreState = new_state

	end)

else
	
	DataStoreState = "Access"
	ProfileStore.DataStoreState = "Access"
	
end

-- Update loop:

RunService.Heartbeat:Connect(function()

	-- Auto saving:

	local auto_save_list_length = #AutoSaveList
	if auto_save_list_length &gt; 0 then
		local auto_save_index_speed = AUTO_SAVE_PERIOD / auto_save_list_length
		local os_clock = os.clock()
		while os_clock - LastAutoSave &gt; auto_save_index_speed do
			LastAutoSave = LastAutoSave + auto_save_index_speed
			local profile = AutoSaveList[AutoSaveIndex]
			if os_clock - profile.load_timestamp &lt; AUTO_SAVE_PERIOD / 2 then
				-- This profile is freshly loaded - auto saving immediately is not necessary:
				profile = nil
				for _ = 1, auto_save_list_length - 1 do
					-- Move auto save index to the right:
					AutoSaveIndex = AutoSaveIndex + 1
					if AutoSaveIndex &gt; auto_save_list_length then
						AutoSaveIndex = 1
					end
					profile = AutoSaveList[AutoSaveIndex]
					if os_clock - profile.load_timestamp &gt;= AUTO_SAVE_PERIOD / 2 then
						break
					else
						profile = nil
					end
				end
			end
			-- Move auto save index to the right:
			AutoSaveIndex = AutoSaveIndex + 1
			if AutoSaveIndex &gt; auto_save_list_length then
				AutoSaveIndex = 1
			end
			-- Perform save call:
			if profile ~= nil then
				task.spawn(SaveProfileAsync, profile) -- Auto save profile in new thread
			end
		end
	end

	-- Critical state handling:

	if ProfileStore.IsCriticalState == false then
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			ProfileStore.IsCriticalState = true
			ProfileStore.OnCriticalToggle:Fire(true)
			CriticalStateStart = os.clock()
			warn(`[{script.Name}]: Entered critical state`)
		end
	else
		if #IssueQueue &gt;= CRITICAL_STATE_ERROR_COUNT then
			CriticalStateStart = os.clock()
		elseif os.clock() - CriticalStateStart &gt; CRITICAL_STATE_EXPIRE then
			ProfileStore.IsCriticalState = false
			ProfileStore.OnCriticalToggle:Fire(false)
			warn(`[{script.Name}]: Critical state ended`)
		end
	end

	-- Issue queue:

	while true do
		local issue_time = IssueQueue[1]
		if issue_time == nil then
			break
		elseif os.clock() - issue_time &gt; CRITICAL_STATE_ERROR_EXPIRE then
			table.remove(IssueQueue, 1)
		else
			break
		end
	end

end)

-- Release all loaded profiles when the server is shutting down:

task.spawn(function()

	while DataStoreState == "NotReady" do
		task.wait()
	end

	if DataStoreState ~= "Access" then

		game:BindToClose(function()
			ProfileStore.IsClosing = true
			task.wait() -- Mock shutdown delay
		end)

		return -- Don't wait for profiles to properly save in mock mode so studio could end the simulation faster

	end

	game:BindToClose(function()

		ProfileStore.IsClosing = true

		-- Release all active profiles:
		-- (Clone AutoSaveList to a new table because AutoSaveList changes when profiles are released)

		local on_close_save_job_count = 0
		local active_profiles = {}
		for index, profile in ipairs(AutoSaveList) do
			active_profiles[index] = profile
		end

		-- Release the profiles; Releasing profiles can trigger listeners that release other profiles, so check active state:
		for _, profile in ipairs(active_profiles) do
			if profile:IsActive() == true then
				on_close_save_job_count = on_close_save_job_count + 1
				task.spawn(function() -- Save profile on new thread
					SaveProfileAsync(profile, true, nil, "Shutdown")
					on_close_save_job_count = on_close_save_job_count - 1
				end)
			end
		end

		-- Yield until all active profile jobs are finished:
		while on_close_save_job_count &gt; 0 or ActiveProfileLoadJobs &gt; 0 or ActiveProfileSaveJobs &gt; 0 do
			task.wait()
		end

		return -- We're done!

	end)

end)

return ProfileStore</string>
